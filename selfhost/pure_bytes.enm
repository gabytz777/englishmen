$- Pure Englishmen module object builder for the native `bytes` module.

   A buffer is an ordinary array of whole numbers from 0 to 255. Every
   conversion packs into a fresh array; `pbySet` is the one mutating helper
   and returns the same buffer it was given. Every global helper is prefixed
   with `pby` so this file can be concatenated with the other self-hosted
   pieces without collisions. `pbyBytesModule()` returns an object whose keys
   match the native module, ready to be installed as an import table entry.

   Only global builtins are used for computation. The `host` module is read
   from the ambient VM environment and used solely by `pbyWrite`, which calls
   `host.writeBytes`; the Rust CLI has no `host` module, so that function is
   not exercised by the native oracle self-test below.

   The native `bytes` module is imported only inside the self-test guard at
   the bottom, where it acts as a reference oracle. `os` is imported here only
   so that guard can read EM_SELFTEST; no other native import exists.

   Englishmen functions have fixed arity, so the module adapts native
   variadics to eight padded parameters:
     - pbyOf collects non-null arguments into one buffer.
     - pbyConcat collects non-null buffers into one buffer.
     - pbySlice takes three arguments, with a null end meaning "to the end".
   The returned object includes `__arities` for the self-hosted VM's adapter
   padding, matching the convention in `selfhost/full.enm`. When installing
   this object under the `bytes` key of an import table, lift `__arities` to
   that import table's root. `read` is deliberately absent: the C bootstrap
   host supplies `readFile`, and only file writing is wrapped here.
-$
import os
$- ---------------------------------------------------------------------------
   Argument validation
   --------------------------------------------------------------------------- -$
function pbyIsNumber(pbyValue_arg)
    return type(pbyValue_arg) == "number"
end
function pbyIsFiniteNumber(pbyValue_arg)
    if not pbyIsNumber(pbyValue_arg)
        return false
    end
    if isNaN(pbyValue_arg)
        return false
    end
    return pbyValue_arg <=  and pbyValue_arg >= -
end
function pbyIsWhole(pbyValue_arg)
    if not pbyIsFiniteNumber(pbyValue_arg)
        return false
    end
    return pbyValue_arg == floor(pbyValue_arg)
end
function pbyAssertWhole(pbyValue_arg, pbyContext_arg)
    assert(pbyIsWhole(pbyValue_arg), "Expected a whole number " + pbyContext_arg)
end
function pbyByte(pbyValue_arg, pbyContext_arg)
    pbyAssertWhole(pbyValue_arg, pbyContext_arg)
    assert(pbyValue_arg >= 0 and pbyValue_arg <= 255, "Expected a byte from 0 to 255 " + pbyContext_arg)
    return pbyValue_arg
end
function pbyBuffer(pbyBuffer_arg, pbyContext_arg)
    assert(type(pbyBuffer_arg) == "array", "Expected a byte buffer " + pbyContext_arg)
    pbyBuffer_i = 0
    while pbyBuffer_i < len(pbyBuffer_arg)
    pbyByte(pbyBuffer_arg[pbyBuffer_i], "at index " + toString(pbyBuffer_i) + " " + pbyContext_arg)
    pbyBuffer_i += 1
end
return pbyBuffer_arg
end
function pbyExactIndex(pbyLength_arg, pbyIndex_arg, pbyContext_arg)
    pbyAssertWhole(pbyIndex_arg, pbyContext_arg)
    pbyResolved = pbyIndex_arg
    if pbyIndex_arg < 0
        pbyResolved = pbyLength_arg + pbyIndex_arg
    end
    assert(pbyResolved >= 0 and pbyResolved < pbyLength_arg, "Index " + toString(pbyIndex_arg) + " is outside a buffer of " + toString(pbyLength_arg) + " bytes")
    return pbyResolved
end
function pbySliceIndex(pbyLength_arg, pbyIndex_arg, pbyContext_arg)
    pbyAssertWhole(pbyIndex_arg, pbyContext_arg)
    if pbyIndex_arg < 0
        pbyResolved = pbyLength_arg + pbyIndex_arg
        if pbyResolved < 0
            return 0
        end
        return pbyResolved
    end
    if pbyIndex_arg > pbyLength_arg
        return pbyLength_arg
    end
    return pbyIndex_arg
end
$- ---------------------------------------------------------------------------
   Text conversion
   --------------------------------------------------------------------------- -$
function pbyFromString(pbyText_arg)
    assert(type(pbyText_arg) == "string", "pbyFromString expects a string")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyText_arg)
    pbyCode = charCode(pbyText_arg[pbyIndex])
    if pbyCode <= 127
        pbyOut.add(pbyCode)
    else if pbyCode <= 2047
        pbyOut.add(192 | ((pbyCode >> 6) & 31))
        pbyOut.add(128 | (pbyCode & 63))
    else if pbyCode <= 65535
        pbyOut.add(224 | ((pbyCode >> 12) & 15))
        pbyOut.add(128 | ((pbyCode >> 6) & 63))
        pbyOut.add(128 | (pbyCode & 63))
    else
        pbyOut.add(240 | ((pbyCode >> 18) & 7))
        pbyOut.add(128 | ((pbyCode >> 12) & 63))
        pbyOut.add(128 | ((pbyCode >> 6) & 63))
        pbyOut.add(128 | (pbyCode & 63))
    end
    pbyIndex += 1
end
return pbyOut
end
function pbyUtf8Continuation(pbyByte_arg)
    return pbyByte_arg >= 128 and pbyByte_arg <= 191
end
function pbyToString(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyToString")
    pbyOut = ""
    pbySize = len(pbyBuffer_arg)
    pbyIndex = 0
    while pbyIndex < pbySize
    pbyLead = pbyBuffer_arg[pbyIndex]
    if pbyLead < 128
        pbyOut += fromCharCode(pbyLead)
    else if pbyLead >= 194 and pbyLead <= 223
        assert(pbyIndex + 1 < pbySize, "Truncated UTF-8 sequence for pbyToString")
        pbyNext = pbyBuffer_arg[pbyIndex + 1]
        assert(pbyUtf8Continuation(pbyNext), "Invalid UTF-8 continuation byte for pbyToString")
        pbyCode = ((pbyLead & 31) << 6) | (pbyNext & 63)
        assert(pbyCode >= 128, "Overlong UTF-8 sequence for pbyToString")
        pbyOut += fromCharCode(pbyCode)
        pbyIndex += 1
    else if pbyLead >= 224 and pbyLead <= 239
        assert(pbyIndex + 2 < pbySize, "Truncated UTF-8 sequence for pbyToString")
        pbyNext = pbyBuffer_arg[pbyIndex + 1]
        pbyLast = pbyBuffer_arg[pbyIndex + 2]
        assert(pbyUtf8Continuation(pbyNext) and pbyUtf8Continuation(pbyLast), "Invalid UTF-8 continuation byte for pbyToString")
        if pbyLead == 224
            assert(pbyNext >= 160, "Overlong UTF-8 sequence for pbyToString")
        end
        if pbyLead == 237
            assert(pbyNext <= 159, "UTF-8 surrogate is not a scalar value for pbyToString")
        end
        pbyCode = ((pbyLead & 15) << 12) | ((pbyNext & 63) << 6) | (pbyLast & 63)
        assert(pbyCode >= 2048 and not (pbyCode >= 55296 and pbyCode <= 57343), "Invalid UTF-8 code point for pbyToString")
        pbyOut += fromCharCode(pbyCode)
        pbyIndex += 2
    else if pbyLead >= 240 and pbyLead <= 244
        assert(pbyIndex + 3 < pbySize, "Truncated UTF-8 sequence for pbyToString")
        pbyNext = pbyBuffer_arg[pbyIndex + 1]
        pbySecond = pbyBuffer_arg[pbyIndex + 2]
        pbyLast = pbyBuffer_arg[pbyIndex + 3]
        assert(pbyUtf8Continuation(pbyNext) and pbyUtf8Continuation(pbySecond) and pbyUtf8Continuation(pbyLast), "Invalid UTF-8 continuation byte for pbyToString")
        if pbyLead == 240
            assert(pbyNext >= 144, "Overlong UTF-8 sequence for pbyToString")
        end
        if pbyLead == 244
            assert(pbyNext <= 143, "UTF-8 code point above U+10FFFF for pbyToString")
        end
        pbyCode = ((pbyLead & 7) << 18) | ((pbyNext & 63) << 12) | ((pbySecond & 63) << 6) | (pbyLast & 63)
        assert(pbyCode >= 65536 and pbyCode <= 1114111, "Invalid UTF-8 code point for pbyToString")
        pbyOut += fromCharCode(pbyCode)
        pbyIndex += 3
    else
        assert(false, "Invalid UTF-8 lead byte for pbyToString")
    end
    pbyIndex += 1
end
return pbyOut
end
$- ---------------------------------------------------------------------------
   Buffers, indexing and slicing
   --------------------------------------------------------------------------- -$
function pbyOfValues(pbyValues_arg)
    if type(pbyValues_arg) == "number"
        return [pbyByte(pbyValues_arg, "as a byte for bytes.of")]
    end
    assert(type(pbyValues_arg) == "array", "bytes.of expects a number or an array of numbers")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyValues_arg)
    pbyOut.add(pbyByte(pbyValues_arg[pbyIndex], "as byte " + toString(pbyIndex + 1) + " for bytes.of"))
    pbyIndex += 1
end
return pbyOut
end
$- The self-hosted VM pads this adapter with nulls up to eight arguments. -$
function pbyOf(pbyA_arg, pbyB_arg, pbyC_arg, pbyD_arg, pbyE_arg, pbyF_arg, pbyG_arg, pbyH_arg)
    pbyValues = []
    if not isNull(pbyA_arg)
        pbyValues.add(pbyA_arg)
    end
    if not isNull(pbyB_arg)
        pbyValues.add(pbyB_arg)
    end
    if not isNull(pbyC_arg)
        pbyValues.add(pbyC_arg)
    end
    if not isNull(pbyD_arg)
        pbyValues.add(pbyD_arg)
    end
    if not isNull(pbyE_arg)
        pbyValues.add(pbyE_arg)
    end
    if not isNull(pbyF_arg)
        pbyValues.add(pbyF_arg)
    end
    if not isNull(pbyG_arg)
        pbyValues.add(pbyG_arg)
    end
    if not isNull(pbyH_arg)
        pbyValues.add(pbyH_arg)
    end
    return pbyOfValues(pbyValues)
end
function pbyLength(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyLength")
    return len(pbyBuffer_arg)
end
function pbyGet(pbyBuffer_arg, pbyIndex_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyGet")
    pbyResolved = pbyExactIndex(len(pbyBuffer_arg), pbyIndex_arg, "as the index for pbyGet")
    return pbyBuffer_arg[pbyResolved]
end
function pbySet(pbyBuffer_arg, pbyIndex_arg, pbyValue_arg)
$- Validate the whole buffer before changing any of it, like the native module. -$
    pbyBuffer(pbyBuffer_arg, "for pbySet")
    pbyResolved = pbyExactIndex(len(pbyBuffer_arg), pbyIndex_arg, "as the index for pbySet")
    pbyByte(pbyValue_arg, "as the byte for pbySet")
    pbyBuffer_arg[pbyResolved] = pbyValue_arg
    return pbyBuffer_arg
end
function pbyConcatBuffers(pbyBuffers_arg)
    assert(type(pbyBuffers_arg) == "array", "bytes.concat expects an array of buffers")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyBuffers_arg)
    pbyPart = pbyBuffer(pbyBuffers_arg[pbyIndex], "as buffer " + toString(pbyIndex + 1) + " for bytes.concat")
    pbyInner = 0
    while pbyInner < len(pbyPart)
    pbyOut.add(pbyPart[pbyInner])
    pbyInner += 1
end
pbyIndex += 1
end
return pbyOut
end
$- The self-hosted VM pads this adapter with nulls up to eight arguments. -$
function pbyConcat(pbyA_arg, pbyB_arg, pbyC_arg, pbyD_arg, pbyE_arg, pbyF_arg, pbyG_arg, pbyH_arg)
    pbyBuffers = []
    if not isNull(pbyA_arg)
        pbyBuffers.add(pbyA_arg)
    end
    if not isNull(pbyB_arg)
        pbyBuffers.add(pbyB_arg)
    end
    if not isNull(pbyC_arg)
        pbyBuffers.add(pbyC_arg)
    end
    if not isNull(pbyD_arg)
        pbyBuffers.add(pbyD_arg)
    end
    if not isNull(pbyE_arg)
        pbyBuffers.add(pbyE_arg)
    end
    if not isNull(pbyF_arg)
        pbyBuffers.add(pbyF_arg)
    end
    if not isNull(pbyG_arg)
        pbyBuffers.add(pbyG_arg)
    end
    if not isNull(pbyH_arg)
        pbyBuffers.add(pbyH_arg)
    end
    return pbyConcatBuffers(pbyBuffers)
end
function pbySlice(pbyBuffer_arg, pbyStart_arg, pbyEnd_arg)
    pbyBuffer(pbyBuffer_arg, "for pbySlice")
    if pbyEnd_arg == null
        pbyStop = len(pbyBuffer_arg)
    else
        pbyStop = pbyEnd_arg
    end
    pbyFrom = pbySliceIndex(len(pbyBuffer_arg), pbyStart_arg, "as the start index for pbySlice")
    pbyTo = pbySliceIndex(len(pbyBuffer_arg), pbyStop, "as the end index for pbySlice")
    pbyOut = []
    pbyIndex = pbyFrom
    while pbyIndex < pbyTo
    pbyOut.add(pbyBuffer_arg[pbyIndex])
    pbyIndex += 1
end
return pbyOut
end
function pbyCopy(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyCopy")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyBuffer_arg)
    pbyOut.add(pbyBuffer_arg[pbyIndex])
    pbyIndex += 1
end
return pbyOut
end
$- ---------------------------------------------------------------------------
   Hex conversion
   --------------------------------------------------------------------------- -$
function pbyHexDigit(pbyChar_arg)
    pbyCode = charCode(pbyChar_arg)
    if pbyCode >= 48 and pbyCode <= 57
        return pbyCode - 48
    end
    if pbyCode >= 97 and pbyCode <= 102
        return pbyCode - 87
    end
    if pbyCode >= 65 and pbyCode <= 70
        return pbyCode - 55
    end
    return -1
end
function pbyIsAsciiWhitespace(pbyCode_arg)
    return pbyCode_arg == 9 or pbyCode_arg == 10 or pbyCode_arg == 11 or pbyCode_arg == 12 or pbyCode_arg == 13 or pbyCode_arg == 32
end
function pbyFromHex(pbyText_arg)
    assert(type(pbyText_arg) == "string", "pbyFromHex expects hex text")
    pbyCompact = ""
    pbyIndex = 0
    while pbyIndex < len(pbyText_arg)
    pbyChar = pbyText_arg[pbyIndex]
    if not pbyIsAsciiWhitespace(charCode(pbyChar))
        pbyCompact += pbyChar
    end
    pbyIndex += 1
end
assert(len(pbyCompact) % 2 == 0, "pbyFromHex expects an even number of hex digits")
pbyOut = []
pbyIndex = 0
while pbyIndex < len(pbyCompact)
pbyHigh = pbyHexDigit(pbyCompact[pbyIndex])
pbyLow = pbyHexDigit(pbyCompact[pbyIndex + 1])
assert(pbyHigh >= 0 and pbyLow >= 0, "Invalid hex byte for pbyFromHex")
pbyOut.add(pbyHigh * 16 + pbyLow)
pbyIndex += 2
end
return pbyOut
end
function pbyHexPair(pbyByte_arg)
    pbyDigits = "0123456789abcdef"
    return pbyDigits[floor(pbyByte_arg / 16)] + pbyDigits[pbyByte_arg % 16]
end
function pbyToHex(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyToHex")
    pbyParts = []
    pbyIndex = 0
    while pbyIndex < len(pbyBuffer_arg)
    pbyParts.add(pbyHexPair(pbyBuffer_arg[pbyIndex]))
    pbyIndex += 1
end
return join(pbyParts, " ")
end
$- ---------------------------------------------------------------------------
   Little-endian integer packing
   --------------------------------------------------------------------------- -$
function pbyLeBytes(pbyValue_arg, pbyCount_arg)
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < pbyCount_arg
    pbyOut.add(pbyValue_arg % 256)
    pbyValue_arg = floor(pbyValue_arg / 256)
    pbyIndex += 1
end
return pbyOut
end
function pbyUnsignedArg(pbyValue_arg, pbyUpper_arg, pbyName_arg, pbyMaxLabel_arg)
    pbyAssertWhole(pbyValue_arg, "as the number for " + pbyName_arg)
    assert(pbyValue_arg >= 0 and pbyValue_arg < pbyUpper_arg, pbyName_arg + " expects a whole number from 0 to " + pbyMaxLabel_arg)
    return pbyValue_arg
end
function pbySignedLeBytes(pbyValue_arg, pbyCount_arg)
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < pbyCount_arg
    pbyOut.add(pbyValue_arg & 255)
    pbyValue_arg = pbyValue_arg >> 8
    pbyIndex += 1
end
return pbyOut
end
function pbySignedArg(pbyValue_arg, pbyLower_arg, pbyUpper_arg, pbyName_arg, pbyMinLabel_arg, pbyMaxLabel_arg)
    pbyAssertWhole(pbyValue_arg, "as the number for " + pbyName_arg)
    assert(pbyValue_arg >= pbyLower_arg and pbyValue_arg < pbyUpper_arg, pbyName_arg + " expects a whole number from " + pbyMinLabel_arg + " to " + pbyMaxLabel_arg)
    return pbyValue_arg
end
function pbyU8(pbyValue_arg)
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, 256, "bytes.u8", "255"), 1)
end
function pbyU16(pbyValue_arg)
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, 65536, "bytes.u16", "65535"), 2)
end
function pbyU32(pbyValue_arg)
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, 4294967296, "bytes.u32", "4294967295"), 4)
end
function pbyU64(pbyValue_arg)
$- 2^64 is exactly representable as an f64 and keeps an out-of-range input from becoming u64::MAX. -$
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, pow(2, 64), "bytes.u64", "18446744073709551615"), 8)
end
$- bytes.i8 is not present in the native module, but the round-4 surface list
   asks for it. It follows the same two's-complement little-endian rule. -$
function pbyI8(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -128, 128, "bytes.i8", "-128", "127"), 1)
end
function pbyI16(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -32768, 32768, "bytes.i16", "-32768", "32767"), 2)
end
function pbyI32(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -2147483648, 2147483648, "bytes.i32", "-2147483648", "2147483647"), 4)
end
function pbyI64(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -9223372036854776000, 9223372036854776000, "bytes.i64", "-9223372036854775808", "9223372036854775807"), 8)
end
$- ---------------------------------------------------------------------------
   IEEE-754 binary64 packing and unpacking
   --------------------------------------------------------------------------- -$
function pbySetBit(pbyBytes_arg, pbyIndex_arg, pbyBit_arg)
    pbyByteIndex = floor(pbyIndex_arg / 8)
    pbyBitIndex = pbyIndex_arg % 8
    pbyBytes_arg[pbyByteIndex] = pbyBytes_arg[pbyByteIndex] + (pbyBit_arg << pbyBitIndex)
end
function pbyPutBits(pbyBytes_arg, pbyValue_arg, pbyStart_arg, pbyCount_arg)
    pbyIndex = 0
    while pbyIndex < pbyCount_arg
    pbyBit = floor(pbyValue_arg / pow(2, pbyIndex)) % 2
    pbySetBit(pbyBytes_arg, pbyStart_arg + pbyIndex, pbyBit)
    pbyIndex += 1
end
end
function pbyBitAt(pbyBytes_arg, pbyIndex_arg)
    pbyByteIndex = floor(pbyIndex_arg / 8)
    pbyBitIndex = pbyIndex_arg % 8
    return floor(pbyBytes_arg[pbyByteIndex] / pow(2, pbyBitIndex)) % 2
end
function pbyF64Bits(pbyValue_arg)
    pbyNegative = pbyValue_arg < 0
    if pbyValue_arg == 0 and pow(pbyValue_arg, -1) < 0
        pbyNegative = true
    end
    pbyBytes = [0, 0, 0, 0, 0, 0, 0, 0]
    if isNaN(pbyValue_arg)
$- Englishmen arithmetic produces a negative quiet NaN; keep its sign bit. -$
        pbyNegative = true
        pbyExponent = 2047
        pbyMantissa = pow(2, 51)
    else if pbyValue_arg >  or pbyValue_arg < -
        pbyExponent = 2047
        pbyMantissa = 0
    else if pbyValue_arg == 0
        pbyExponent = 0
        pbyMantissa = 0
    else
        pbyMagnitude = abs(pbyValue_arg)
        pbyScale = pbyMagnitude
        pbyExponentCount = 0
        while pbyScale >= 2
        pbyScale = pbyScale / 2
        pbyExponentCount += 1
    end
    while pbyScale < 1
    pbyScale = pbyScale * 2
    pbyExponentCount -= 1
end
if pbyExponentCount >= -1022
    pbyExponent = pbyExponentCount + 1023
    pbyMantissa = floor((pbyScale - 1) * pow(2, 52))
else
$- Subnormals have no implicit leading 1: divide by the smallest double. -$
    pbyExponent = 0
    pbyMantissa = floor(pbyMagnitude / pow(2, -1074))
end
end
if pbyNegative
    pbySetBit(pbyBytes, 63, 1)
end
pbyPutBits(pbyBytes, pbyExponent, 52, 11)
pbyPutBits(pbyBytes, pbyMantissa, 0, 52)
return pbyBytes
end
function pbyF64(pbyValue_arg)
    assert(pbyIsNumber(pbyValue_arg), "pbyF64 expects a number")
    return pbyF64Bits(pbyValue_arg)
end
function pbyReadU16(pbyBuffer_arg, pbyOffset_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyReadU16")
    pbyAssertWhole(pbyOffset_arg, "as the offset for pbyReadU16")
    assert(pbyOffset_arg >= 0 and pbyOffset_arg + 2 <= len(pbyBuffer_arg), "pbyReadU16 needs two bytes inside the buffer")
    return pbyBuffer_arg[pbyOffset_arg] + pbyBuffer_arg[pbyOffset_arg + 1] * 256
end
function pbyReadU32(pbyBuffer_arg, pbyOffset_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyReadU32")
    pbyAssertWhole(pbyOffset_arg, "as the offset for pbyReadU32")
    assert(pbyOffset_arg >= 0 and pbyOffset_arg + 4 <= len(pbyBuffer_arg), "pbyReadU32 needs four bytes inside the buffer")
    return pbyBuffer_arg[pbyOffset_arg] + pbyBuffer_arg[pbyOffset_arg + 1] * 256 + pbyBuffer_arg[pbyOffset_arg + 2] * 65536 + pbyBuffer_arg[pbyOffset_arg + 3] * 16777216
end
function pbyReadF64(pbyBuffer_arg, pbyOffset_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyReadF64")
    pbyAssertWhole(pbyOffset_arg, "as the offset for pbyReadF64")
    assert(pbyOffset_arg >= 0 and pbyOffset_arg + 8 <= len(pbyBuffer_arg), "pbyReadF64 needs eight bytes inside the buffer")
    pbyExponent = 0
    pbyBit = 0
    while pbyBit < 11
    pbyExponent += pbyBitAt(pbyBuffer_arg, pbyOffset_arg * 8 + 52 + pbyBit) * pow(2, pbyBit)
    pbyBit += 1
end
pbyMantissa = 0
pbyBit = 0
while pbyBit < 52
pbyMantissa += pbyBitAt(pbyBuffer_arg, pbyOffset_arg * 8 + pbyBit) * pow(2, pbyBit)
pbyBit += 1
end
if pbyExponent == 2047
    if pbyMantissa == 0
        pbyValue = pow(2, 1024)
    else
        pbyValue = pow(-1, 0.5)
    end
else if pbyExponent == 0
    pbyValue = pbyMantissa * pow(2, -1074)
else
    pbyValue = pow(2, pbyExponent - 1023) * (1 + pbyMantissa / pow(2, 52))
end
if pbyBitAt(pbyBuffer_arg, pbyOffset_arg * 8 + 63) == 1
    pbyValue = -pbyValue
end
return pbyValue
end
$- ---------------------------------------------------------------------------
   Module object and host file writing
   --------------------------------------------------------------------------- -$
$- `host` is supplied by the C bootstrap VM. The Rust CLI has no such module,
   so referencing it here is harmless until pbyWrite is actually called. -$
function pbyWrite(pbyPath_arg, pbyBuffer_arg)
    assert(type(pbyPath_arg) == "string", "bytes.write expects a path string")
    pbyBuffer(pbyBuffer_arg, "for bytes.write")
    pbyWriteResult = host.writeBytes(pbyPath_arg, pbyBuffer_arg)
    if isObject(pbyWriteResult) and contains(keys(pbyWriteResult), "__hostError")
        assert(false, "Could not write '" + pbyPath_arg + "'")
    end
    return pbyWriteResult
end
function pbyBytesModule()
    return {__arities: {of: 8, concat: 8, slice: 3}, of: pbyOf, fromString: pbyFromString, toString: pbyToString, concat: pbyConcat, slice: pbySlice, copy: pbyCopy, length: pbyLength, get: pbyGet, set: pbySet, u8: pbyU8, u16: pbyU16, u32: pbyU32, u64: pbyU64, i8: pbyI8, i16: pbyI16, i32: pbyI32, i64: pbyI64, f64: pbyF64, fromHex: pbyFromHex, toHex: pbyToHex, write: pbyWrite}
end
$- ---------------------------------------------------------------------------
   Self-tests: the native bytes module is an oracle only inside this guard.
   --------------------------------------------------------------------------- -$
if os.env("EM_SELFTEST", "") == "1"
    import bytes
    function pbySameBuffer(pbyLeft_arg, pbyRight_arg)
        if type(pbyLeft_arg) != "array" or type(pbyRight_arg) != "array"
            return false
        end
        if len(pbyLeft_arg) != len(pbyRight_arg)
            return false
        end
        pbyIndex = 0
        while pbyIndex < len(pbyLeft_arg)
        if pbyLeft_arg[pbyIndex] != pbyRight_arg[pbyIndex]
            return false
        end
        pbyIndex += 1
    end
    return true
end
function pbyCheck(pbyActual_arg, pbyExpected_arg, pbyLabel_arg)
    assert(pbySameBuffer(pbyActual_arg, pbyExpected_arg), "self-test failed: " + pbyLabel_arg)
end
function pbyModuleField(pbyObject_arg, pbyKey_arg)
    pbyPairs = entries(pbyObject_arg)
    pbyIndex = 0
    while pbyIndex < len(pbyPairs)
    if pbyPairs[pbyIndex][0] == pbyKey_arg
        return pbyPairs[pbyIndex][1]
    end
    pbyIndex += 1
end
return null
end
pbyTexts = ["", "hi", "héllo ☃", "日本語", "🙂", "a\nb\tc", "ÿ", "aé🙂z"]
for pbyText in pbyTexts
    pbyCheck(pbyFromString(pbyText), bytes.fromString(pbyText), "pbyFromString " + pbyText)
    assert(pbyToString(pbyFromString(pbyText)) == pbyText, "pbyToString round-trip " + pbyText)
    assert(pbyToString(bytes.fromString(pbyText)) == pbyText, "pbyToString oracle " + pbyText)
end
pbyCheck(pbyOfValues([]), bytes.of(), "pbyOfValues empty")
pbyCheck(pbyOfValues(7), bytes.of(7), "pbyOfValues single")
pbyCheck(pbyOfValues([0, 1, 127, 128, 255]), bytes.of(0, 1, 127, 128, 255), "pbyOfValues many")
pbyCheck(pbyOf(null, null, null, null, null, null, null, null), bytes.of(), "pbyOf padded empty")
pbyCheck(pbyOf(7, null, null, null, null, null, null, null), bytes.of(7), "pbyOf padded single")
pbyCheck(pbyOf(0, 1, 127, 128, 255, null, null, null), bytes.of(0, 1, 127, 128, 255), "pbyOf padded many")
pbySample = bytes.of(1, 2, 3, 4, 5, 255, 0)
assert(pbyLength(pbySample) == bytes.length(pbySample), "pbyLength")
assert(pbyLength([]) == bytes.length([]), "pbyLength empty")
for pbyIndex in [-7, -6, -3, -1, 0, 1, 3, 6]
    assert(pbyGet(pbySample, pbyIndex) == bytes.get(pbySample, pbyIndex), "pbyGet " + toString(pbyIndex))
end
pbyMutable = bytes.copy(pbySample)
pbyReturned = pbySet(pbyMutable, -2, 99)
assert(pbyReturned == pbyMutable, "pbySet returns the same buffer")
assert(pbySameBuffer(pbyMutable, bytes.set(bytes.copy(pbySample), -2, 99)), "pbySet contents")
pbyCheck(pbyConcatBuffers([]), bytes.concat(), "pbyConcatBuffers empty")
pbyCheck(pbyConcatBuffers([pbySample]), bytes.concat(pbySample), "pbyConcatBuffers one")
pbyCheck(pbyConcatBuffers([bytes.of(1, 2), bytes.of(3), bytes.of(4, 5)]), bytes.concat(bytes.of(1, 2), bytes.of(3), bytes.of(4, 5)), "pbyConcatBuffers many")
pbyCheck(pbyConcat(null, null, null, null, null, null, null, null), bytes.concat(), "pbyConcat padded empty")
pbyCheck(pbyConcat(bytes.of(1, 2), bytes.of(3), bytes.of(4, 5), null, null, null, null, null), bytes.concat(bytes.of(1, 2), bytes.of(3), bytes.of(4, 5)), "pbyConcat padded many")
pbyBounds = [[0, null], [1, null], [-2, null], [99, null], [-99, null], [0, 0], [1, 3], [0, -1], [-2, -1], [3, 1], [-99, 4], [0, 99], [-99, 99]]
for pbyBound in pbyBounds
    pbyStart = pbyBound[0]
    pbyStop = pbyBound[1]
    if pbyStop == null
        pbyCheck(pbySlice(pbySample, pbyStart, null), bytes.slice(pbySample, pbyStart), "pbySlice open " + toString(pbyStart))
    else
        pbyCheck(pbySlice(pbySample, pbyStart, pbyStop), bytes.slice(pbySample, pbyStart, pbyStop), "pbySlice closed")
    end
end
pbyClone = pbyCopy(pbySample)
pbyCheck(pbyClone, bytes.copy(pbySample), "pbyCopy contents")
pbySet(pbyClone, 0, 42)
assert(pbyGet(pbyClone, 0) == 42 and pbyGet(pbySample, 0) == 1, "pbyCopy independence")
pbyHexTexts = ["", "aabbcc", "aa bb cc", "AA\tBB\nCC", "a ab bcc", "0a0b0c", "00 ff 7f 80", "de ad be ef", "1 2 3 4"]
for pbyHexText in pbyHexTexts
    pbyCheck(pbyFromHex(pbyHexText), bytes.fromHex(pbyHexText), "pbyFromHex " + pbyHexText)
end
pbyHexBuffers = [[], [0], [0, 15, 255], bytes.fromHex("00 0a 7f 80 fe ff")]
for pbyHexBuffer in pbyHexBuffers
    assert(pbyToHex(pbyHexBuffer) == bytes.toHex(pbyHexBuffer), "pbyToHex")
end
for pbyValue in [0, 1, 127, 255]
    pbyCheck(pbyU8(pbyValue), bytes.u8(pbyValue), "pbyU8")
end
pbyCheck(pbyI8(-128), pbyOfValues([128]), "pbyI8 -128")
pbyCheck(pbyI8(-2), pbyOfValues([254]), "pbyI8 -2")
pbyCheck(pbyI8(0), pbyOfValues([0]), "pbyI8 0")
pbyCheck(pbyI8(127), pbyOfValues([127]), "pbyI8 127")
for pbyValue in [0, 1, 255, 4660, 65535]
    pbyCheck(pbyU16(pbyValue), bytes.u16(pbyValue), "pbyU16")
end
for pbyValue in [0, 1, 65535, 305419896, 4294967295]
    pbyCheck(pbyU32(pbyValue), bytes.u32(pbyValue), "pbyU32")
end
for pbyValue in [0, 1, 255, 4294967295, 9223372036854776000, pow(2, 64) - 2048]
    pbyCheck(pbyU64(pbyValue), bytes.u64(pbyValue), "pbyU64")
end
for pbyValue in [-32768, -258, -2, -1, 0, 1, 32767]
    pbyCheck(pbyI16(pbyValue), bytes.i16(pbyValue), "pbyI16")
end
for pbyValue in [-2147483648, -65537, -2, 0, 2147483647]
    pbyCheck(pbyI32(pbyValue), bytes.i32(pbyValue), "pbyI32")
end
for pbyValue in [-9223372036854776000, -4294967297, -2, 0, 9223372036854775000]
    pbyCheck(pbyI64(pbyValue), bytes.i64(pbyValue), "pbyI64")
end
pbyFloats = [0, 1, -1, 0.5, -2.5, 1.5, 3.141592653589793, 0., , 0., 0., pow(2, 1024), -pow(2, 1024)]
pbyZero = 0
pbyNegativeZero = pbyZero * -1
pbyFloats.add(pbyNegativeZero)
for pbyValue in pbyFloats
    pbyCheck(pbyF64(pbyValue), bytes.f64(pbyValue), "pbyF64 " + toString(pbyValue))
end
pbyQuietNaN = pow(-1, 0.5)
pbyCheck(pbyF64(pbyQuietNaN), bytes.f64(pbyQuietNaN), "pbyF64 NaN")
for pbyValue in [0, 1, 255, 4660, 65535]
    assert(pbyReadU16(bytes.u16(pbyValue), 0) == pbyValue, "pbyReadU16")
end
for pbyValue in [0, 1, 65535, 305419896, 4294967295]
    assert(pbyReadU32(bytes.u32(pbyValue), 0) == pbyValue, "pbyReadU32")
end
for pbyValue in pbyFloats
    pbyPacked = bytes.f64(pbyValue)
    assert(pbySameBuffer(pbyF64(pbyReadF64(pbyPacked, 0)), pbyPacked), "pbyReadF64 " + toString(pbyValue))
end
pbyWithPrefix = bytes.concat(bytes.of(9, 8, 7), bytes.u16(4660), bytes.u32(305419896), bytes.f64(-2.5))
assert(pbyReadU16(pbyWithPrefix, 3) == 4660, "pbyReadU16 offset")
assert(pbyReadU32(pbyWithPrefix, 5) == 305419896, "pbyReadU32 offset")
assert(pbyReadF64(pbyWithPrefix, 9) == -2.5, "pbyReadF64 offset")
pbyModule = pbyBytesModule()
pbyExposed = ["of", "fromString", "toString", "concat", "slice", "copy", "length", "get", "set", "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "f64", "fromHex", "toHex", "write"]
for pbyKey in pbyExposed
    assert(contains(keys(pbyModule), pbyKey), "pbyBytesModule missing " + pbyKey)
    pbyField = pbyModuleField(pbyModule, pbyKey)
    assert(isFunction(pbyField), "pbyBytesModule field is not callable: " + pbyKey)
end
assert(contains(keys(pbyModule), "__arities"), "pbyBytesModule missing __arities")
pbyArities = pbyModuleField(pbyModule, "__arities")
assert(isObject(pbyArities), "pbyBytesModule __arities is not an object")
assert(pbyModuleField(pbyArities, "of") == 8, "pbyBytesModule of arity")
assert(pbyModuleField(pbyArities, "concat") == 8, "pbyBytesModule concat arity")
assert(pbyModuleField(pbyArities, "slice") == 3, "pbyBytesModule slice arity")
say("ok")
end
