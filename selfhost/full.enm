            for previous in seen
                if rtEquals(previous, value)
                    known = true
                end
            end
            if not known
                seen.add(value)
                rtFlattenInto(value, out, seen)
                seen.pop()
            end
        else
            out.add(value)
        end
    end
    return null
end
function rtObjectMethod(object, method, args)
    if method == "keys"
        return rtObjectKeys(object)
    end
    if method == "values"
        return rtObjectValues(object)
    end
    if method == "has"
        return rtObjectHas(object, rtExpectString(rtArg(args, 0, null), "as a key"))
    end
    if method == "get"
        key = rtExpectString(rtArg(args, 0, null), "as a key")
        return rtObjectGet(object, key, rtArg(args, 1, null))
    end
    if method == "set"
        key = rtExpectString(rtArg(args, 0, null), "as a key")
        return rtObjectSet(object, key, rtArg(args, 1, null))
    end
    if method == "delete"
        return rtObjectDelete(object, rtExpectString(rtArg(args, 0, null), "as a key"))
    end
    if method == "length"
        return len(rtObjectKeys(object))
    end
    if method == "merge"
        other = rtArg(args, 0, null)
        if not isObject(other)
            rtError("merge() expects an object to merge")
        end
        for key in rtObjectKeys(other)
            rtObjectSet(object, key, other.get(key, null))
        end
        return object
    end
    if method == "copy"
        out = {}
        for key in rtObjectKeys(object)
            rtObjectSet(out, key, object.get(key, null))
        end
        return out
    end
    if method == "isEmpty"
        return len(rtObjectKeys(object)) == 0
    end
    if method == "pick"
        out = {}
        for key in args
            name = rtExpectString(key, "as a key")
            if rtObjectHas(object, name)
                rtObjectSet(out, name, object.get(name, null))
            end
        end
        return out
    end
    if method == "omit"
        out = {}
        for key in rtObjectKeys(object)
            if keys(args).indexOf(key) < 0
                rtObjectSet(out, key, object.get(key, null))
            end
        end
        return out
    end
    if method == "entries"
        out = []
        for key in rtObjectKeys(object)
            out.add([key, object.get(key, null)])
        end
        return out
    end
    rtError("Object has no method '" + method + "'")
end
function rtBoolMethod(value, method, args)
    if method == "toggle"
        return not value
    end
    if method == "toString"
        if value
            return "true"
        end
        return "false"
    end
    if method == "and"
        return value and rtExpectBool(rtArg(args, 0, null), "an operand")
    end
    if method == "or"
        return value or rtExpectBool(rtArg(args, 0, null), "an operand")
    end
    if method == "xor"
        return value != rtExpectBool(rtArg(args, 0, null), "an operand")
    end
    if method == "implies"
        other = rtExpectBool(rtArg(args, 0, null), "an operand")
        return not value or other
    end
    if method == "nand"
        other = rtExpectBool(rtArg(args, 0, null), "an operand")
        return not (value and other)
    end
    rtError("Boolean has no method '" + method + "'")
end
function rtExpectBool(value, context)
    if not isBool(value)
        rtError("expected a boolean " + context + ", found " + rtTypeName(value))
    end
    return value
end
$- Object fields that hold functions win over builtin methods, as in the VM. -$
function rtMethodCall(receiver, method, args)
    if isObject(receiver) and rtObjectHas(receiver, method)
        candidate = receiver.get(method, null)
        if rtIsCallable(candidate)
            return rtInvoke(candidate, args, method)
        end
    end
    if isArray(receiver)
        value = rtArrayMethod(receiver, method, args)
    else if isObject(receiver)
        value = rtObjectMethod(receiver, method, args)
    else if isString(receiver)
        value = rtStringMethod(receiver, method, args)
    else if isNumber(receiver)
        value = rtNumberMethod(receiver, method, args)
    else if isBool(receiver)
        value = rtBoolMethod(receiver, method, args)
    else
        rtError("Cannot call method '" + method + "' on a " + rtTypeName(receiver))
    end
    return {rtPushed: false, rtValue: value}
end
$- Delegate the remaining host builtins; these are language intrinsics, not
   modules, and are documented as a remaining native dependency in VM.md. -$
function rtNativeCall(name, args)
    if name == "say" or name == "print"
        return rtSay(args)
    end
    if name == "len"
        return rtLen(rtArg(args, 0, null))
    end
    if name == "type"
        return rtTypeName(rtArg(args, 0, null))
    end
    if name == "toString"
        return rtDisplay(rtArg(args, 0, null))
    end
    if name == "toNumber"
        return toNumber(rtArg(args, 0, null))
    end
    if name == "toBool"
        return rtTruthy(rtArg(args, 0, null))
    end
    if name == "isNumber"
        return isNumber(rtArg(args, 0, null))
    end
    if name == "isString"
        return isString(rtArg(args, 0, null))
    end
    if name == "isArray"
        return isArray(rtArg(args, 0, null))
    end
    if name == "isObject"
        return isObject(rtArg(args, 0, null))
    end
    if name == "isBool"
        return isBool(rtArg(args, 0, null))
    end
    if name == "isNull"
        return isNull(rtArg(args, 0, null))
    end
    if name == "isFunction"
        return isFunction(rtArg(args, 0, null)) or rtIsCallable(rtArg(args, 0, null))
    end
    if name == "isNaN"
        return isNaN(rtArg(args, 0, null))
    end
    if name == "parseInt"
        return parseInt(rtArg(args, 0, null), rtArg(args, 1, 10))
    end
    if name == "parseFloat"
        return parseFloat(rtArg(args, 0, null))
    end
    if name == "range"
        if len(args) == 1
            return range(rtArg(args, 0, 0))
        end
        if len(args) == 2
            return range(rtArg(args, 0, 0), rtArg(args, 1, 0))
        end
        return range(rtArg(args, 0, 0), rtArg(args, 1, 0), rtArg(args, 2, 1))
    end
    if name == "sum"
        return sum(rtArg(args, 0, []))
    end
    if name == "average"
        return average(rtArg(args, 0, []))
    end
    if name == "min"
        return min(rtArg(args, 0, []))
    end
    if name == "max"
        return max(rtArg(args, 0, []))
    end
    if name == "abs"
        return abs(rtArg(args, 0, 0))
    end
    if name == "clamp"
        return clamp(rtArg(args, 0, 0), rtArg(args, 1, 0), rtArg(args, 2, 0))
    end
    if name == "sorted"
        return sorted(rtArg(args, 0, []))
    end
    if name == "reversed"
        return reversed(rtArg(args, 0, []))
    end
    if name == "zip"
        return zip(rtArg(args, 0, []), rtArg(args, 1, []))
    end
    if name == "take"
        return take(rtArg(args, 0, []), rtArg(args, 1, 0))
    end
    if name == "drop"
        return drop(rtArg(args, 0, []), rtArg(args, 1, 0))
    end
    if name == "keys"
        return rtObjectKeys(rtArg(args, 0, null))
    end
    if name == "values"
        return values(rtArg(args, 0, null))
    end
    if name == "entries"
        return entries(rtArg(args, 0, null))
    end
    if name == "fromEntries"
        return fromEntries(rtArg(args, 0, []))
    end
    if name == "first"
        return first(rtArg(args, 0, []))
    end
    if name == "last"
        return last(rtArg(args, 0, []))
    end
    if name == "indexOf"
        return indexOf(rtArg(args, 0, ""), rtArg(args, 1, null))
    end
    if name == "contains"
        return contains(rtArg(args, 0, ""), rtArg(args, 1, null))
    end
    if name == "slice"
        if len(args) == 2
            return slice(rtArg(args, 0, ""), rtArg(args, 1, 0))
        end
        return slice(rtArg(args, 0, ""), rtArg(args, 1, 0), rtArg(args, 2, 0))
    end
    if name == "pow"
        return pow(rtArg(args, 0, 0), rtArg(args, 1, 0))
    end
    if name == "sqrt"
        return sqrt(rtArg(args, 0, 0))
    end
    if name == "floor"
        return floor(rtArg(args, 0, 0))
    end
    if name == "ceil"
        return ceil(rtArg(args, 0, 0))
    end
    if name == "round"
        return round(rtArg(args, 0, 0))
    end
    if name == "sign"
        return sign(rtArg(args, 0, 0))
    end
    if name == "trim"
        return trim(rtArg(args, 0, ""))
    end
    if name == "upper"
        return upper(rtArg(args, 0, ""))
    end
    if name == "lower"
        return lower(rtArg(args, 0, ""))
    end
    if name == "split"
        return split(rtArg(args, 0, ""), rtArg(args, 1, ""))
    end
    if name == "join"
        if len(args) == 1
            return join(rtArg(args, 0, []), "")
        end
        return join(rtArg(args, 0, []), rtArg(args, 1, ""))
    end
    if name == "replace"
        return replace(rtArg(args, 0, ""), rtArg(args, 1, ""), rtArg(args, 2, ""))
    end
    if name == "startsWith"
        return startsWith(rtArg(args, 0, ""), rtArg(args, 1, ""))
    end
    if name == "endsWith"
        return endsWith(rtArg(args, 0, ""), rtArg(args, 1, ""))
    end
    if name == "repeat"
        return rtStringRepeat(rtArg(args, 0, ""), rtArg(args, 1, 0))
    end
    if name == "padStart" or name == "padEnd"
        width = rtArg(args, 1, 0)
        padding = rtArg(args, 2, " ")
        return rtStringPad(rtArg(args, 0, ""), width, padding, name == "padStart")
    end
    if name == "charCode"
        return charCode(rtArg(args, 0, ""))
    end
    if name == "fromCharCode"
        return fromCharCode(rtArg(args, 0, 0))
    end
    if name == "random"
        return random()
    end
    if name == "randomInt"
        if len(args) == 0
            return randomInt()
        end
        return randomInt(rtArg(args, 0, 0), rtArg(args, 1, 0))
    end
    if name == "seed"
        return seed(rtArg(args, 0, 0))
    end
    if name == "format"
        if len(args) == 1
            return format(rtArg(args, 0, ""))
        end
        return format(rtArg(args, 0, ""), rtArg(args, 1, null))
    end
    rtError("native builtin '" + name + "' is not available in the self-hosted VM")
end
function rtBinary(op, left, right)
    if op == "Eq"
        return rtEquals(left, right)
    end
    if op == "NotEq"
        return not rtEquals(left, right)
    end
    if op == "Add"
        if isNumber(left) and isNumber(right)
            return left + right
        end
        if isString(left)
            return left + rtDisplay(right)
        end
        if isString(right)
            return rtDisplay(left) + right
        end
        rtError("Cannot add " + rtTypeName(left) + " and " + rtTypeName(right))
    end
    if op == "Mul"
        if isString(left) and isNumber(right)
            return rtStringRepeat(left, right)
        end
        if isNumber(left) and isString(right)
            return rtStringRepeat(right, left)
        end
    end
    context = "on the left of the operator"
    if op == "Gt" or op == "Lt" or op == "GtEq" or op == "LtEq"
        context = "on the left of the comparison"
    end
    a = rtExpectNumber(left, context)
    rightContext = "on the right of the operator"
    if op == "Gt" or op == "Lt" or op == "GtEq" or op == "LtEq"
        rightContext = "on the right of the comparison"
    end
    b = rtExpectNumber(right, rightContext)
    if op == "Sub"
        return a - b
    end
    if op == "Mul"
        return a * b
    end
    if op == "Div"
        if b == 0
            rtError("Division by zero")
        end
        return a / b
    end
    if op == "Mod"
        if b == 0
            rtError("Division by zero")
        end
        return a % b
    end
    if op == "FloorDiv"
        if b == 0
            rtError("Division by zero")
        end
        return floor(a / b)
    end
    if op == "Pow"
        return a ** b
    end
    if op == "BitAnd"
        return a & b
    end
    if op == "BitOr"
        return a | b
    end
    if op == "BitXor"
        return a ^ b
    end
    if op == "Shl"
        return a << b
    end
    if op == "Shr"
        return a >> b
    end
    if op == "Gt"
        return a > b
    end
    if op == "Lt"
        return a < b
    end
    if op == "GtEq"
        return a >= b
    end
    if op == "LtEq"
        return a <= b
    end
    rtError("unknown binary operator '" + op + "'")
end
$- ---------------------------------------------------------------------------
   Instruction execution. The `a` and `b` operands follow the Rust Op order.
   --------------------------------------------------------------------------- -$
function rtGetProperty(base, name)
    if not isObject(base)
        rtError("Cannot access property '" + name + "' on a " + rtTypeName(base))
    end
    if rtObjectHas(base, name)
        return base.get(name, null)
    end
    rtError("Unknown property '" + name + "'")
end
function rtGetIndex(base, index)
    if isArray(base)
        at = rtTrunc(index)
        if at < 0 or at >= len(base)
            rtError("Array index " + toString(at) + " is out of bounds (length " + len(base) + ")")
        end
        return base[at]
    end
    if isString(base)
        chars = rtStringChars(base)
        at = rtTrunc(index)
        if at < 0 or at >= len(chars)
            rtError("String index " + toString(at) + " is out of bounds (length " + len(chars) + ")")
        end
        return chars[at]
    end
    rtError("Cannot index into a " + rtTypeName(base))
end
function rtSetIndex(base, index, value)
    if not isArray(base)
        rtError("Cannot index into a " + rtTypeName(base))
    end
    at = rtTrunc(index)
    if at < 0 or at >= len(base)
        rtError("Array index " + toString(at) + " is out of bounds (length " + len(base) + ")")
    end
    base[at] = value
    return null
end
function rtStep(op, chunk, frame)
    name = op.get("op", "")
    a = op.get("a", 0)
    b = op.get("b", 0)
    if name == "LoadConst"
        rtStackPush(rtConstValue(chunk, a))
        return null
    end
    if name == "Pop"
        rtStackPop()
        return null
    end
    if name == "GetVar"
        rtStackPush(rtEnvGet(frame.rtEnv, rtName(chunk, a)))
        return null
    end
    if name == "SetVar"
        rtEnvAssign(frame.rtEnv, rtName(chunk, a), rtStackPop())
        return null
    end
    if name == "DefineVar"
        rtEnvDefine(frame.rtEnv, rtName(chunk, a), rtStackPop())
        return null
    end
    if name == "GetProp"
        base = rtStackPop()
        rtStackPush(rtGetProperty(base, rtName(chunk, a)))
        return null
    end
    if name == "SetProp"
        base = rtStackPop()
        value = rtStackPop()
        if not isObject(base)
            rtError("Cannot set property '" + rtName(chunk, a) + "' on a " + rtTypeName(base))
        end
        rtObjectSet(base, rtName(chunk, a), value)
        return null
    end
    if name == "GetVarOrObject"
        variable = rtName(chunk, a)
        if not rtEnvHas(frame.rtEnv, variable)
            rtEnvDefine(frame.rtEnv, variable, {})
        end
        rtStackPush(rtEnvGet(frame.rtEnv, variable))
        return null
    end
    if name == "GetPropOrObject"
        base = rtStackPop()
        property = rtName(chunk, a)
        if isObject(base)
            if not rtObjectHas(base, property)
                rtObjectSet(base, property, {})
            end
            rtStackPush(base.get(property, null))
        else
            rtStackPush(rtGetProperty(base, property))
        end
        return null
    end
    if name == "GetPropKeep"
        rtStackPush(rtGetProperty(rtStackPeek(), rtName(chunk, a)))
        return null
    end
    if name == "GetIndex"
        index = rtStackPop()
        base = rtStackPop()
        rtStackPush(rtGetIndex(base, index))
        return null
    end
    if name == "GetIndexKeep"
        index = rtStackPeek()
        base = rtVm.stack[len(rtVm.stack) - 2]
        rtStackPush(rtGetIndex(base, index))
        return null
    end
    if name == "SetIndex"
        index = rtStackPop()
        base = rtStackPop()
        value = rtStackPop()
        rtSetIndex(base, index, value)
        return null
    end
    if name == "MakeArray"
        rtStackPush(rtStackDrain(a))
        return null
    end
    if name == "MakeObject"
        flat = rtStackDrain(a * 2)
        object = {}
        i = 0
        while i < len(flat)
        rtObjectSet(object, rtDisplay(flat[i]), flat[i + 1])
        i += 2
    end
    rtStackPush(object)
    return null
end
if name == "MakeClosure"
    functions = rtChunkFunctions(chunk)
    if a < 0 or a >= len(functions)
        rtError("function index " + toString(a) + " is out of range")
    end
    rtStackPush({rtKind: "closure", rtProto: functions[a], rtEnv: frame.rtEnv})
    return null
end
if name == "Call"
    args = rtStackDrain(a)
    callee = rtStackPop()
    result = rtInvoke(callee, args, rtName(chunk, b))
    if not result.rtPushed
        rtStackPush(result.rtValue)
    end
    return null
end
if name == "MethodCall"
    args = rtStackDrain(b)
    receiver = rtStackPop()
    result = rtMethodCall(receiver, rtName(chunk, a), args)
    if not result.rtPushed
        rtStackPush(result.rtValue)
    end
    return null
end
if name == "Say"
    rtSay(rtStackDrain(a))
    rtStackPush(null)
    return null
end
binaryOps = ["Add", "Sub", "Mul", "Div", "Mod", "FloorDiv", "Pow", "BitAnd", "BitOr", "BitXor", "Shl", "Shr", "Eq", "NotEq", "Gt", "Lt", "GtEq", "LtEq"]
if binaryOps.indexOf(name) >= 0
    right = rtStackPop()
    left = rtStackPop()
    rtStackPush(rtBinary(name, left, right))
    return null
end
if name == "Neg"
    rtStackPush(-rtExpectNumber(rtStackPop(), "for unary '-'"))
    return null
end
if name == "Not"
    rtStackPush(not rtTruthy(rtStackPop()))
    return null
end
if name == "BitNot"
    rtStackPush(~rtExpectNumber(rtStackPop(), "for bitwise '~'"))
    return null
end
if name == "ToBool"
    rtStackPush(rtTruthy(rtStackPop()))
    return null
end
if name == "Dup"
    rtStackPush(rtStackPeek())
    return null
end
if name == "Rotate"
    count = a + 1
    if len(rtVm.stack) < count
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    rtSplitAt = len(rtVm.stack) - count
    top = rtStackPop()
    rtArrayInsert(rtVm.stack, rtSplitAt, top)
    return null
end
if name == "Jump"
    frame.rtIp = a
    return null
end
if name == "JumpIfFalse"
    if not rtTruthy(rtStackPop())
        frame.rtIp = a
    end
    return null
end
if name == "JumpIfFalsePeek"
    if not rtTruthy(rtStackPeek())
        frame.rtIp = a
    end
    return null
end
if name == "JumpIfTruePeek"
    if rtTruthy(rtStackPeek())
        frame.rtIp = a
    end
    return null
end
if name == "JumpIfNullPeek"
    if isNull(rtStackPeek())
        frame.rtIp = a
    end
    return null
end
if name == "RepeatSetup"
    count = rtExpectNumber(rtStackPop(), "as a repeat count")
    if count < 0
        rtError("repeat count must not be negative")
    end
    rtStackPush(rtTrunc(count))
    return null
end
if name == "RepeatNext"
    remaining = rtStackPeek()
    if not isNumber(remaining)
        rtError("Corrupt bytecode: unexpected value on the stack")
    end
    if remaining <= 0
        rtStackPop()
        frame.rtIp = a
    else
        rtVm.stack[len(rtVm.stack) - 1] = remaining - 1
    end
    return null
end
if name == "IterSetup"
    iterable = rtStackPop()
    if not isArray(iterable)
        rtError("Cannot iterate over a " + rtTypeName(iterable))
    end
    rtStackPush(rtArrayCopy(iterable))
    rtStackPush(0)
    return null
end
if name == "IterNext"
    cursor = rtStackPeek()
    if not isNumber(cursor)
        rtError("Corrupt bytecode: unexpected value on the stack")
    end
    source = rtVm.stack[len(rtVm.stack) - 2]
    if cursor < len(source)
        rtEnvDefine(frame.rtEnv, rtName(chunk, a), source[cursor])
        rtVm.stack[len(rtVm.stack) - 1] = cursor + 1
    else
        rtStackPop()
        rtStackPop()
        frame.rtIp = b
    end
    return null
end
if name == "Return"
    rtPopFrame(rtStackPop())
    return null
end
if name == "ReturnNull"
    rtPopFrame(null)
    return null
end
if name == "Import"
    rtError("module '" + rtName(chunk, a) + "' needs a native module; imports are not self-hosted yet")
end
rtError("unknown instruction '" + name + "'")
end
function rtExecute()
    while len(rtVm.frames) > 0
    frame = rtVm.frames[len(rtVm.frames) - 1]
    code = rtChunkCode(frame.rtUnit.rtChunk)
    if frame.rtIp >= len(code)
        done = rtPopFrame(null)
        if done
            return null
        end
    else
        op = code[frame.rtIp]
        frame.rtIp = frame.rtIp + 1
        rtStep(op, frame.rtUnit.rtChunk, frame)
    end
end
return null
end
function vmRunWithRuntime(ir)
    rtVm = {stack: [], frames: [], output: [], globals: rtGlobalEnv()}
    unit = {rtKind: "program", rtChunk: ir}
    rtVm.frames.add(rtFrameNew(unit, 0, rtVm.globals, 0))
    rtExecute()
    return rtVm.output
end
$- ---------------------------------------------------------------------------
   Inline self-tests. With EM_SELFTEST=1 the whole file prints exactly `ok`.
   --------------------------------------------------------------------------- -$
function rtSelfTest()
    assert(rtLen("héllo") == 5, "rtLen string")
    assert(rtLen([1, 2, 3]) == 3, "rtLen array")
    assert(rtLen({a: 1, b: 2}) == 2, "rtLen object")
    assert(rtSay(["a", 2]) == null, "rtSay returns null")
    assert(rtVm.output[len(rtVm.output) - 1] == "a 2", "rtSay output")
    assert(rtNumberMethod(-3, "abs", []) == 3, "number abs")
    assert(rtNumberMethod(255, "toHex", []) == "ff", "number toHex")
    assert(rtStringMethod("Hello", "lower", []) == "hello", "string lower")
    pieces = rtStringMethod("a,b,c", "split", [","])
    assert(rtArrayMethod(pieces, "join", ["-"]) == "a-b-c", "string split")
    array = [3, 1, 2]
    rtArrayMethod(array, "sort", [])
    assert(array[0] == 1, "array sort")
    assert(rtArrayMethod(array, "join", ["-"]) == "1-2-3", "array join")
    object = {a: 1}
    assert(rtObjectMethod(object, "get", ["b", 7]) == 7, "object get default")
    assert(rtObjectMethod(object, "length", []) == 1, "object length")
    hello = {version: 2, constants: [{tag: "string", value: "hello from rt"}], functions: [], code: [{op: "LoadConst", a: 0}, {op: "Say", a: 1}, {op: "ReturnNull"}]}
    output = vmRunWithRuntime(hello)
    assert(len(output) == 1 and output[0] == "hello from rt", "IR fixture: hello")
    math = {version: 2, constants: [{tag: "number", value: 2}, {tag: "number", value: 3}], functions: [], code: [{op: "LoadConst", a: 0}, {op: "LoadConst", a: 1}, {op: "Add"}, {op: "Say", a: 1}, {op: "ReturnNull"}]}
    output = vmRunWithRuntime(math)
    assert(len(output) == 1 and output[0] == "5", "IR fixture: arithmetic")
    methodIr = {version: 2, constants: [{tag: "string", value: "abc"}, {tag: "string", value: "upper"}], functions: [], code: [{op: "LoadConst", a: 0}, {op: "MethodCall", a: 1, b: 0}, {op: "Say", a: 1}, {op: "ReturnNull"}]}
    output = vmRunWithRuntime(methodIr)
    assert(len(output) == 1 and output[0] == "ABC", "IR fixture: method call")
    return null
end
function rtCli()
    argv = os.args()
$- os.args() begins with the `run` subcommand and the script path. -$
    if len(argv) < 3
        say("usage: em run selfhost/vm_runtime.enm <ir.json>")
        return null
    end
    ir = jsonDecode(fs.read(argv[2]))
    say(jsonEncode(vmRunWithRuntime(ir)))
    return null
end
$- === combined full-self-hosting pipeline ===
   Reads an .enm source file, runs the Englishmen lexer/parser, generates
   emb IR in Englishmen, encodes it to bytes in Englishmen, and executes the
   IR on the Englishmen runtime. The host is still the Rust `em` VM.

   Driver flags, parsed from the host argv before reading the source:
     --write-emb <path>  write encodedFull to <path> with native bytes.write
     --                  stop parsing driver flags; everything after this is
                         left in programArgsFull for the compiled program's
                         args(). Without `--`, argument handling is unchanged.
-$
argvFull = args()
scriptIndexFull = -1
for i in range(len(argvFull))
    if argvFull[i].endsWith("full.enm")
        scriptIndexFull = i
        break
    end
end
scanStartFull = 0
if scriptIndexFull >= 0
    scanStartFull = scriptIndexFull + 1
end
separatorIndexFull = -1
for i in range(scanStartFull, len(argvFull))
    if argvFull[i] == "--"
        separatorIndexFull = i
        break
    end
end
scanEndFull = len(argvFull)
if separatorIndexFull >= 0
    scanEndFull = separatorIndexFull
end
programArgsFull = []
if separatorIndexFull >= 0
    for i in range(separatorIndexFull + 1, len(argvFull))
        programArgsFull.add(argvFull[i])
    end
end
writePathFull = null
sourcePathFull = null
skipPathFull = false
for i in range(scanStartFull, scanEndFull)
    if skipPathFull
        skipPathFull = false
        continue
    end
    candidateFull = argvFull[i]
    if candidateFull == "--write-emb"
        assert(i + 1 < scanEndFull, "--write-emb expects a path")
        writePathFull = argvFull[i + 1]
        skipPathFull = true
        continue
    end
    if scriptIndexFull >= 0
        if candidateFull != "" and not candidateFull.startsWith("-") and sourcePathFull == null
            sourcePathFull = candidateFull
        end
    else
$- Keep the original no-script fallback: the last argument wins. -$
        sourcePathFull = candidateFull
    end
end
if sourcePathFull == null
    if separatorIndexFull >= 0
        assert(false, "full.enm expects a source file before '--'")
    end
    sourcePathFull = argvFull[len(argvFull) - 1]
end
sourceFull = fs.read(sourcePathFull)
astFull = parse(lex(sourceFull))
irFull = cgCodegen(astFull)
encodedFull = ieEncode(irFull)
if writePathFull != null
$- Import at the point of use: ieEncode has a temporary named `bytes`. -$
    import bytes
    bytes.write(writePathFull, encodedFull)
end
outputFull = vmRunWithRuntime(irFull)
say(jsonEncode({source: sourcePathFull, astStatements: len(astFull.get("statements", [])), irInstructions: len(irFull.get("code", [])), encodedBytes: len(encodedFull), output: outputFull}))
