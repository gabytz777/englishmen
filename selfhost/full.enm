    if vmError != null
        return
    end
    vmPush(vmUnary(vmExec_op, vmExec_value, vmExec_instr))
    return
end
if vmExec_op == "Dup"
    vmPush(vmPeek(vmExec_instr))
    return
end
if vmExec_op == "Rotate"
    vmExec_count = vmExec_a + 1
    if vmExec_count > len(vmStack)
        vmRaiseAt("runtime", "value stack underflow", vmExec_instr)
        return
    end
    vmExec_split = len(vmStack) - vmExec_count
    vmExec_top = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmStack.insert(vmExec_split, vmExec_top)
    return
end
if vmExec_op == "GetPropKeep"
    vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_value = vmGetProperty(vmPeek(vmExec_instr), vmExec_name, vmExec_instr)
    if vmError != null
        return
    end
    vmPush(vmExec_value)
    return
end
if vmExec_op == "Jump"
    vmJump(vmExec_a, vmExec_instr)
    return
end
if vmExec_op == "JumpIfFalse"
    vmExec_value = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    if not toBool(vmExec_value)
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "JumpIfFalsePeek"
    if not toBool(vmPeek(vmExec_instr))
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "JumpIfTruePeek"
    if toBool(vmPeek(vmExec_instr))
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "JumpIfNullPeek"
    if isNull(vmPeek(vmExec_instr))
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "RepeatSetup"
    vmExec_value = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmExec_n = vmRequireNumber(vmExec_value, "as a repeat count", vmExec_instr)
    if vmError != null
        return
    end
    if vmExec_n < 0 or isNaN(vmExec_n)
        vmRaiseAt("runtime", "repeat count must not be negative", vmExec_instr)
        return
    end
    vmPush(floor(vmExec_n))
    return
end
if vmExec_op == "RepeatNext"
    vmExec_remaining = vmPeek(vmExec_instr)
    if vmError != null
        return
    end
    if not isNumber(vmExec_remaining)
        vmRaiseAt("runtime", "corrupt repeat counter", vmExec_instr)
        return
    end
    if vmExec_remaining <= 0
        vmStack.pop()
        vmJump(vmExec_a, vmExec_instr)
    else
        vmStack[len(vmStack) - 1] = vmExec_remaining - 1
    end
    return
end
if vmExec_op == "IterSetup"
    vmExec_iterable = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    if not isArray(vmExec_iterable)
        vmRaiseAt("runtime", "cannot iterate over a " + type(vmExec_iterable) + "; 'for ... in' expects an array", vmExec_instr)
        return
    end
    vmPush(vmExec_iterable.copy())
    vmPush(0)
    return
end
if vmExec_op == "IterNext"
    vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    if len(vmStack) < 2
        vmRaiseAt("runtime", "value stack underflow", vmExec_instr)
        return
    end
    vmExec_cursor = vmStack[len(vmStack) - 1]
    vmExec_items = vmStack[len(vmStack) - 2]
    if not isNumber(vmExec_cursor) or not isArray(vmExec_items)
        vmRaiseAt("runtime", "corrupt iterator state", vmExec_instr)
        return
    end
    if vmExec_cursor < len(vmExec_items)
        vmScopeDefine(vmExec_frame.scope, vmExec_name, vmExec_items[vmExec_cursor])
        vmStack[len(vmStack) - 1] = vmExec_cursor + 1
    else
        vmStack.pop()
        vmStack.pop()
        vmJump(vmExec_b, vmExec_instr)
    end
    return
end
if vmExec_op == "Return"
    vmExec_value = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmPopFrame(vmExec_value)
    return
end
if vmExec_op == "ReturnNull"
    vmPopFrame(null)
    return
end
if vmExec_op == "Import"
    vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_value = vmImport(vmExec_name, vmExec_instr)
    if vmError != null
        return
    end
    vmScopeDefine(vmExec_frame.scope, vmExec_name, vmExec_value)
    return
end
vmRaiseAt("runtime", "unsupported opcode '" + vmExec_op + "'", vmExec_instr)
end
function vmStep()
    vmStep_frame = vmFrame()
    if vmStep_frame == null
        return
    end
    vmStep_code = vmStep_frame.chunk.get("code", [])
    if vmStep_frame.ip >= len(vmStep_code)
        vmPopFrame(null)
        return
    end
    vmStep_ip = vmStep_frame.ip
    vmStep_instr = vmStep_code[vmStep_ip]
    vmStep_frame.ip = vmStep_ip + 1
    vmExec(vmStep_instr)
end
function vmRun(vmRun_ir)
    vmReset()
    if not vmValidate(vmRun_ir)
        return vmError
    end
    vmRun_scope = {vars: {}, parent: null}
    vmFrames.add({chunk: vmRun_ir, ip: 0, scope: vmRun_scope, base: 0})
    while len(vmFrames) > 0 and vmError == null
    vmStep()
end
if vmError != null
    return vmError
end
return vmOutput
end
$- ---------------------------------------------------------------------------
   Self-tests. Every fixture is built by hand; no native emb/VM calls are used
   as oracles. With EM_SELFTEST=1 the script prints exactly one line: ok.
   --------------------------------------------------------------------------- -$
function vmTestConst(vmTestConst_tag, vmTestConst_value)
    if vmTestConst_tag == "null"
        return {tag: vmTestConst_tag}
    end
    return {tag: vmTestConst_tag, value: vmTestConst_value}
end
function vmTestInstr(vmTestInstr_op, vmTestInstr_a, vmTestInstr_b)
    return {op: vmTestInstr_op, a: vmTestInstr_a, b: vmTestInstr_b, line: 1, col: 1}
end
function vmTestChunk(vmTestChunk_constants, vmTestChunk_functions, vmTestChunk_code)
    return {constants: vmTestChunk_constants, functions: vmTestChunk_functions, code: vmTestChunk_code}
end
function vmTestIr(vmTestIr_constants, vmTestIr_functions, vmTestIr_code)
    return {version: 2, constants: vmTestIr_constants, functions: vmTestIr_functions, code: vmTestIr_code}
end
function vmTestArrayEq(vmTestArrayEq_actual, vmTestArrayEq_expected)
    if not isArray(vmTestArrayEq_actual) or not isArray(vmTestArrayEq_expected)
        return false
    end
    if len(vmTestArrayEq_actual) != len(vmTestArrayEq_expected)
        return false
    end
    vmTestArrayEq_i = 0
    while vmTestArrayEq_i < len(vmTestArrayEq_actual)
    if vmTestArrayEq_actual[vmTestArrayEq_i] != vmTestArrayEq_expected[vmTestArrayEq_i]
        return false
    end
    vmTestArrayEq_i += 1
end
return true
end
function vmTestOutput(vmTestOutput_ir, vmTestOutput_expected, vmTestOutput_label)
    vmTestOutput_result = vmRun(vmTestOutput_ir)
    assert(not vmIsError(vmTestOutput_result), vmTestOutput_label + ": " + toString(vmTestOutput_result))
    assert(vmTestArrayEq(vmTestOutput_result, vmTestOutput_expected), vmTestOutput_label + ": expected " + toString(vmTestOutput_expected) + " but got " + toString(vmTestOutput_result))
end
function vmTestError(vmTestError_ir, vmTestError_needle, vmTestError_label)
    vmTestError_result = vmRun(vmTestError_ir)
    assert(vmIsError(vmTestError_result), vmTestError_label + ": expected a structured error")
    assert(contains(vmTestError_result.error, vmTestError_needle), vmTestError_label + ": expected '" + vmTestError_needle + "' in " + toString(vmTestError_result))
    assert(isNumber(vmTestError_result.line) and isNumber(vmTestError_result.col), vmTestError_label + ": error needs a source position")
end
function vmTestConstantsAndArithmetic()
$- 2 + 3 * 4 = 14, 7 // 2 = 3, 2 ** 8 = 256, 5 & 3 = 1, not true = false. -$
    vmTestConstantsAndArithmetic_ir = vmTestIr([vmTestConst("number", 2), vmTestConst("number", 3), vmTestConst("number", 4), vmTestConst("number", 7), vmTestConst("number", 2), vmTestConst("number", 8), vmTestConst("number", 5), vmTestConst("number", 3), vmTestConst("bool", true)], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("Mul", 0, 0), vmTestInstr("Add", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("LoadConst", 3, 0), vmTestInstr("LoadConst", 4, 0), vmTestInstr("FloorDiv", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("LoadConst", 4, 0), vmTestInstr("LoadConst", 5, 0), vmTestInstr("Pow", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("LoadConst", 6, 0), vmTestInstr("LoadConst", 7, 0), vmTestInstr("BitAnd", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("LoadConst", 8, 0), vmTestInstr("Not", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestConstantsAndArithmetic_ir, [14, 3, 256, 1, false], "constants and arithmetic")
end
function vmTestConditionals()
$- if 2 < 3 say "yes", otherwise say "no". -$
    vmTestConditionals_ir = vmTestIr([vmTestConst("number", 2), vmTestConst("number", 3), vmTestConst("string", "yes"), vmTestConst("string", "no")], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("Lt", 0, 0), vmTestInstr("JumpIfFalse", 6, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("Jump", 7, 0), vmTestInstr("LoadConst", 3, 0), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestConditionals_ir, ["yes"], "conditional jumps")
    vmTestConditionals_or = vmTestIr([vmTestConst("bool", true), vmTestConst("string", "shown"), vmTestConst("string", "hidden")], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("JumpIfTruePeek", 5, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("Jump", 6, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestConditionals_or, ["shown"], "peek jumps")
end
function vmTestGlobalsAndStrings()
$- DefineVar/GetVar/SetVar and string concatenation with mixed operands. -$
    vmTestGlobalsAndStrings_ir = vmTestIr([vmTestConst("string", "x"), vmTestConst("number", 4), vmTestConst("number", 5), vmTestConst("string", " value:")], [], [vmTestInstr("LoadConst", 1, 0), vmTestInstr("DefineVar", 0, 0), vmTestInstr("GetVar", 0, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("SetVar", 0, 0), vmTestInstr("LoadConst", 3, 0), vmTestInstr("GetVar", 0, 0), vmTestInstr("Add", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestGlobalsAndStrings_ir, [" value:5"], "globals and strings")
end
function vmTestFunctions()
$- double(5) and a recursive factorial(5). -$
    vmTestFunctions_double = {name: "double", params: ["x"], chunk: vmTestChunk([vmTestConst("number", 2), vmTestConst("string", "x")], [], [vmTestInstr("GetVar", 1, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("Mul", 0, 0), vmTestInstr("Return", 0, 0)])}
    vmTestFunctions_ir = vmTestIr([vmTestConst("number", 2), vmTestConst("number", 5), vmTestConst("string", "double")], [vmTestFunctions_double], [vmTestInstr("MakeClosure", 0, 0), vmTestInstr("DefineVar", 2, 0), vmTestInstr("GetVar", 2, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("Call", 1, 2), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestFunctions_ir, [10], "function calls")
    vmTestFunctions_factorial = {name: "fact", params: ["n"], chunk: vmTestChunk([vmTestConst("number", 1), vmTestConst("string", "n"), vmTestConst("string", "fact")], [], [vmTestInstr("GetVar", 1, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("Lt", 0, 0), vmTestInstr("JumpIfFalse", 6, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("Return", 0, 0), vmTestInstr("GetVar", 1, 0), vmTestInstr("GetVar", 2, 0), vmTestInstr("GetVar", 1, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("Sub", 0, 0), vmTestInstr("Call", 1, 2), vmTestInstr("Mul", 0, 0), vmTestInstr("Return", 0, 0)])}
    vmTestFunctions_factorialIr = vmTestIr([vmTestConst("number", 5), vmTestConst("string", "fact")], [vmTestFunctions_factorial], [vmTestInstr("MakeClosure", 0, 0), vmTestInstr("DefineVar", 1, 0), vmTestInstr("GetVar", 1, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("Call", 1, 1), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestFunctions_factorialIr, [120], "recursion and returns")
end
function vmTestArraysAndObjects()
    vmTestArraysAndObjects_arrayIr = vmTestIr([vmTestConst("number", 1), vmTestConst("number", 2), vmTestConst("number", 0), vmTestConst("string", "a")], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("MakeArray", 2, 0), vmTestInstr("DefineVar", 3, 0), vmTestInstr("GetVar", 3, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("GetIndex", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("GetVar", 3, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("SetIndex", 0, 0), vmTestInstr("GetVar", 3, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("GetIndex", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestArraysAndObjects_arrayIr, [1, 2], "arrays and indexes")
    vmTestArraysAndObjects_objectIr = vmTestIr([vmTestConst("string", "a"), vmTestConst("number", 7), vmTestConst("string", "b"), vmTestConst("string", "o"), vmTestConst("number", 9)], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("MakeObject", 1, 0), vmTestInstr("DefineVar", 3, 0), vmTestInstr("GetVar", 3, 0), vmTestInstr("GetProp", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("LoadConst", 4, 0), vmTestInstr("GetVar", 3, 0), vmTestInstr("SetProp", 2, 0), vmTestInstr("GetVar", 3, 0), vmTestInstr("GetProp", 2, 0), vmTestInstr("Say", 1, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestArraysAndObjects_objectIr, [7, 9], "objects and properties")
end
function vmTestLoops()
    vmTestLoops_repeatIr = vmTestIr([vmTestConst("number", 3), vmTestConst("string", "x")], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("RepeatSetup", 0, 0), vmTestInstr("RepeatNext", 7, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("Say", 1, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("Jump", 2, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestLoops_repeatIr, ["x", "x", "x"], "repeat loop")
    vmTestLoops_forIr = vmTestIr([vmTestConst("number", 1), vmTestConst("number", 2), vmTestConst("number", 3), vmTestConst("string", "n")], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("LoadConst", 2, 0), vmTestInstr("MakeArray", 3, 0), vmTestInstr("IterSetup", 0, 0), vmTestInstr("IterNext", 3, 10), vmTestInstr("GetVar", 3, 0), vmTestInstr("Say", 1, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("Jump", 5, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestLoops_forIr, [1, 2, 3], "for-in loop")
end
function vmTestStackShapes()
$- Rotate and the *Keep instructions must not consume their targets. -$
    vmTestStackShapes_ir = vmTestIr([vmTestConst("number", 1), vmTestConst("number", 2), vmTestConst("string", "a"), vmTestConst("number", 7)], [], [vmTestInstr("LoadConst", 2, 0), vmTestInstr("LoadConst", 3, 0), vmTestInstr("MakeObject", 1, 0), vmTestInstr("GetPropKeep", 2, 0), vmTestInstr("Say", 1, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("MakeArray", 2, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("GetIndexKeep", 0, 0), vmTestInstr("Say", 1, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("Pop", 0, 0), vmTestInstr("LoadConst", 0, 0), vmTestInstr("LoadConst", 1, 0), vmTestInstr("Rotate", 1, 0), vmTestInstr("Say", 2, 0), vmTestInstr("ReturnNull", 0, 0)])
    vmTestOutput(vmTestStackShapes_ir, [7, 2, 2, 1], "keep and rotate stack shapes")
end
function vmTestErrors()
    vmTestError(vmTestIr([], [], [vmTestInstr("Nope", 0, 0)]), "unknown opcode", "unknown opcode")
    vmTestError(vmTestIr([], [], [vmTestInstr("LoadConst", 5, 0)]), "constant index", "bad constant index")
    vmTestError(vmTestIr([], [], [vmTestInstr("Jump", 9, 0)]), "jump target", "bad jump target")
    vmTestError(vmTestIr([vmTestConst("string", "x")], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("RepeatNext", 2, 0)]), "corrupt repeat counter", "corrupt repeat counter")
    vmTestError(vmTestIr([], [], [vmTestInstr("Pop", 0, 0)]), "stack underflow", "stack underflow")
    vmTestError(vmTestIr([], [], [vmTestInstr("Div", 0, 0)]), "stack underflow", "binary underflow")
    vmTestError(vmTestIr([vmTestConst("number", 1)], [], [vmTestInstr("LoadConst", 0, 0), vmTestInstr("GetProp", 0, 0)]), "name index", "name index")
    vmTestError({constants: [], functions: [], code: []}, "version", "missing version")
end
$- === inlined selfhost/vm_runtime.enm === -$
$-!
    selfhost/vm_runtime.enm

    A self-hosted Englishmen VM runtime. It executes the EMB IR object shape
    described in docs/selfhost/EMB_AND_MANIFEST.md and collects `Say` output in
    an array instead of printing it, so a caller can compare the result with the
    native VM. Englishmen has no local .enm imports, so all helpers are global
    and prefixed with `rt` to make this file safe to inline into full.enm.

    CLI:  em run selfhost/vm_runtime.enm <ir.json>
          prints jsonEncode(outputArray)
    Test: EM_SELFTEST=1 em run selfhost/vm_runtime.enm   prints ok
!-$
import fs
import os
$- One VM at a time; every helper reaches the mutable state through rtVm. -$
rtVm = null
function rtError(message)
    assert(false, "ENM VM: " + message)
end
function rtArg(args, index, fallback)
    if index >= 0 and index < len(args)
        return args[index]
    end
    return fallback
end
function rtTypeName(value)
    if isObject(value)
        kind = value.get("rtKind", "")
        if kind == "closure" or kind == "native"
            return "function"
        end
    end
    return type(value)
end
function rtDebugDisplay(value)
    if isString(value)
        return "\"" + value + "\""
    end
    return rtDisplay(value)
end
function rtDisplay(value)
    if isNull(value)
        return "null"
    end
    if isBool(value)
        if value
            return "true"
        end
        return "false"
    end
    if isNumber(value)
        return toString(value)
    end
    if isString(value)
        return value
    end
    if isObject(value)
        kind = value.get("rtKind", "")
        if kind == "closure"
            return "<function " + value.get("rtProto", {}).get("name", "?") + ">"
        end
        if kind == "native"
            return "<native function " + value.get("rtName", "?") + ">"
        end
        parts = []
        for key in keys(value)
            parts.add(key + ": " + rtDebugDisplay(value.get(key, null)))
        end
        return "\{" + join(parts, ", ") + "\}"
    end
    if isArray(value)
        parts = []
        for item in value
            parts.add(rtDebugDisplay(item))
        end
        return "[" + join(parts, ", ") + "]"
    end
    return "<function ?>"
end
function rtTruthy(value)
    if isBool(value)
        return value
    end
    if isNull(value)
        return false
    end
    if isNumber(value)
        return value != 0
    end
    if isString(value)
        return value != ""
    end
    if isArray(value)
        return len(value) > 0
    end
    return true
end
function rtEquals(left, right)
    return left == right
end
function rtExpectNumber(value, context)
    if not isNumber(value)
        rtError("Type mismatch: expected a number " + context + ", found " + rtTypeName(value))
    end
    return value
end
function rtExpectString(value, context)
    if not isString(value)
        rtError("Type mismatch: expected a string " + context + ", found " + rtTypeName(value))
    end
    return value
end
function rtTrunc(value)
    n = rtExpectNumber(value, "as a whole number")
    if n >= 0
        return floor(n)
    end
    return ceil(n)
end
function rtClampIndex(length, raw)
    n = rtExpectNumber(raw, "as an index")
    if isNaN(n)
        if n < 0
            return 0
        end
        return length
    end
    if n < 0
        index = length + n
        if index < 0
            return 0
        end
        return index
    end
    if n > length
        return length
    end
    return n
end
function rtExactIndex(length, raw)
    n = rtExpectNumber(raw, "as an index")
    if isNaN(n) or n % 1 != 0
        return -1
    end
    if n < 0
        index = length + n
        if index < 0
            return -1
        end
        return index
    end
    if n >= length
        return -1
    end
    return n
end
function rtSliceRange(length, start, finish)
    from = rtClampIndex(length, start)
    to = rtClampIndex(length, finish)
    if to < from
        return [from, from]
    end
    return [from, to]
end
function rtArrayCopy(array)
    out = []
    for item in array
        out.add(item)
    end
    return out
end
function rtArrayReplace(array, items)
    while len(array) > 0
    array.pop()
end
for item in items
    array.add(item)
end
return array
end
function rtArrayInsert(array, index, value)
    out = []
    at = rtClampIndex(len(array), index)
    i = 0
    while i < at
    out.add(array[i])
    i += 1
end
out.add(value)
while i < len(array)
out.add(array[i])
i += 1
end
return rtArrayReplace(array, out)
end
function rtArrayRemoveAt(array, index)
    at = rtTrunc(index)
    if at < 0 or at >= len(array)
        return false
    end
    out = []
    i = 0
    while i < len(array)
    if i != at
        out.add(array[i])
    end
    i += 1
end
rtArrayReplace(array, out)
return true
end
function rtArraySlice(array, from, to)
    out = []
    i = from
    while i < to and i < len(array)
    out.add(array[i])
    i += 1
end
return out
end
function rtCompareValues(left, right, numeric)
    if numeric and isNumber(left) and isNumber(right)
        if left < right
            return -1
        end
        if left > right
            return 1
        end
        return 0
    end
    leftText = rtDisplay(left)
    rightText = rtDisplay(right)
    if leftText < rightText
        return -1
    end
    if leftText > rightText
        return 1
    end
    return 0
end
function rtArraySort(array)
    numeric = true
    for item in array
        if not isNumber(item)
            numeric = false
        end
    end
    items = rtArrayCopy(array)
    i = 1
    while i < len(items)
    key = items[i]
    j = i - 1
    while j >= 0 and rtCompareValues(items[j], key, numeric) > 0
    items[j + 1] = items[j]
    j -= 1
end
items[j + 1] = key
i += 1
end
return rtArrayReplace(array, items)
end
function rtObjectKeys(object)
    if not isObject(object)
        rtError("expected an object, found " + rtTypeName(object))
    end
    return keys(object)
end
function rtObjectValues(object)
    out = []
    for key in rtObjectKeys(object)
        out.add(object.get(key, null))
    end
    return out
end
function rtObjectHas(object, key)
    found = keys(object).indexOf(key)
    return found >= 0
end
function rtObjectGet(object, key, fallback)
    if rtObjectHas(object, key)
        return object.get(key, fallback)
    end
    return fallback
end
