        vmCallValue_params = vmCallValue_proto.get("params", null)
        if not isArray(vmCallValue_params)
            return vmRaiseAt("runtime", "closure has no parameter list", vmCallValue_instr)
        end
        if len(vmCallValue_params) != len(vmCallValue_args)
            vmCallValue_signature = "(" + vmCallValue_params.join(", ") + ")"
            return vmRaiseAt("runtime", "function '" + toString(vmCallValue_proto.get("name", "")) + vmCallValue_signature + "' expects " + toString(len(vmCallValue_params)) + " argument(s) but got " + toString(len(vmCallValue_args)), vmCallValue_instr)
