$- Pure Englishmen implementations of the native `string` and `json` modules.

   This file is self-contained: it never imports another `.enm` file and every
   globally visible helper is prefixed with `lm`. `lmStringModule()` and
   `lmJsonModule()` return ordinary objects whose keys are native-style member
   names and whose values are Englishmen functions. `lmAllModules()` bundles
   both objects for the round-3 import bridge.

   Optional native arguments are passed as `null` because Englishmen functions
   have fixed arity. For example `string.slice(text, 1, null)` means the same
   thing as native `string.slice(text, 1)`, and `string.pad(text, 5, null,
   null)` uses the default fill and alignment.

   Native `string` and `json` modules are imported only inside the self-test
   guard at the bottom, where they act as reference oracles.
-$
import os
$- ---------------------------------------------------------------------------
   Shared argument helpers
   --------------------------------------------------------------------------- -$
function lmText(lmText_value)
    assert(type(lmText_value) == "string", "Expected a string")
    return lmText_value
end
function lmFinite(lmFinite_value)
    if type(lmFinite_value) != "number"
        return false
    end
    if isNaN(lmFinite_value)
        return false
    end
    return lmFinite_value <=  and lmFinite_value >= -
end
function lmWhole(lmWhole_value)
    if not lmFinite(lmWhole_value)
        return false
    end
    return floor(lmWhole_value) == lmWhole_value
end
function lmIndex(lmIndex_value)
    if not lmWhole(lmIndex_value) or lmIndex_value < 0
        return false
    end
    return true
end
function lmChars(lmChars_source)
    return split(lmChars_source, "")
end
function lmByteLength(lmByteLength_source)
    lmByteLength_chars = lmChars(lmByteLength_source)
    lmByteLength_total = 0
    lmByteLength_i = 0
    while lmByteLength_i < len(lmByteLength_chars)
    lmByteLength_code = charCode(lmByteLength_chars[lmByteLength_i])
    if lmByteLength_code <= 127
        lmByteLength_total += 1
    else if lmByteLength_code <= 2047
        lmByteLength_total += 2
    else if lmByteLength_code <= 65535
        lmByteLength_total += 3
    else
        lmByteLength_total += 4
    end
    lmByteLength_i += 1
end
return lmByteLength_total
end
function lmClampIndex(lmClampIndex_length, lmClampIndex_value)
    if not lmFinite(lmClampIndex_value)
        if lmClampIndex_value < 0
            return 0
        end
        return lmClampIndex_length
    end
    if lmClampIndex_value < 0
        lmClampIndex_resolved = lmClampIndex_length - floor(-lmClampIndex_value)
        if lmClampIndex_resolved < 0
            return 0
        end
        return lmClampIndex_resolved
    end
    lmClampIndex_resolved = floor(lmClampIndex_value)
    if lmClampIndex_resolved > lmClampIndex_length
        return lmClampIndex_length
    end
    return lmClampIndex_resolved
end
function lmSliceChars(lmSliceChars_source, lmSliceChars_from, lmSliceChars_to)
    lmSliceChars_chars = lmChars(lmSliceChars_source)
    if lmSliceChars_to < lmSliceChars_from
        lmSliceChars_to = lmSliceChars_from
    end
    return join(slice(lmSliceChars_chars, lmSliceChars_from, lmSliceChars_to), "")
end
function lmAsciiDigit(lmAsciiDigit_char)
    lmAsciiDigit_code = charCode(lmAsciiDigit_char)
    return lmAsciiDigit_code >= 48 and lmAsciiDigit_code <= 57
end
function lmNumericText(lmNumericText_source)
    lmNumericText_chars = lmChars(lmNumericText_source)
    lmNumericText_size = len(lmNumericText_chars)
    lmNumericText_pos = 0
    if lmNumericText_size == 0
        return false
    end
    if lmNumericText_chars[0] == "+" or lmNumericText_chars[0] == "-"
        lmNumericText_pos = 1
    end
    lmNumericText_before = 0
    lmNumericText_after = 0
    lmNumericText_dot = false
    while lmNumericText_pos < lmNumericText_size
    lmNumericText_char = lmNumericText_chars[lmNumericText_pos]
    if lmAsciiDigit(lmNumericText_char)
        if lmNumericText_dot
            lmNumericText_after += 1
        else
            lmNumericText_before += 1
        end
        lmNumericText_pos += 1
        continue
    end
    if lmNumericText_char == "." and not lmNumericText_dot
        lmNumericText_dot = true
        lmNumericText_pos += 1
        continue
    end
    if lmNumericText_char == "e" or lmNumericText_char == "E"
        lmNumericText_pos += 1
        if lmNumericText_pos < lmNumericText_size
            if lmNumericText_chars[lmNumericText_pos] == "+" or lmNumericText_chars[lmNumericText_pos] == "-"
                lmNumericText_pos += 1
            end
        end
        lmNumericText_exp = 0
        while lmNumericText_pos < lmNumericText_size
        if not lmAsciiDigit(lmNumericText_chars[lmNumericText_pos])
            return false
        end
        lmNumericText_exp += 1
        lmNumericText_pos += 1
    end
    if lmNumericText_exp == 0
        return false
    end
    break
end
return false
end
if lmNumericText_before + lmNumericText_after == 0
    return false
end
return lmNumericText_pos == lmNumericText_size
end
function lmRepeatText(lmRepeatText_source, lmRepeatText_count)
    lmRepeatText_out = ""
    lmRepeatText_i = 0
    while lmRepeatText_i < lmRepeatText_count
    lmRepeatText_out += lmRepeatText_source
    lmRepeatText_i += 1
end
return lmRepeatText_out
end
function lmRepeatChar(lmRepeatChar_char, lmRepeatChar_count)
    return lmRepeatText(lmRepeatChar_char, lmRepeatChar_count)
end
function lmIsUpperChar(lmIsUpperChar_char)
    return lmIsUpperChar_char == upper(lmIsUpperChar_char) and lower(lmIsUpperChar_char) != lmIsUpperChar_char
end
function lmIsLowerChar(lmIsLowerChar_char)
    return lmIsLowerChar_char == lower(lmIsLowerChar_char) and upper(lmIsLowerChar_char) != lmIsLowerChar_char
end
$- ---------------------------------------------------------------------------
   String module functions
   --------------------------------------------------------------------------- -$
function lmStringLength(lmStringLength_source)
    return len(lmText(lmStringLength_source))
end
function lmStringUpper(lmStringUpper_source)
    return upper(lmText(lmStringUpper_source))
end
function lmStringLower(lmStringLower_source)
    return lower(lmText(lmStringLower_source))
end
function lmStringTrim(lmStringTrim_source)
    return trim(lmText(lmStringTrim_source))
end
function lmStringSplit(lmStringSplit_source, lmStringSplit_separator)
    lmStringSplit_text = lmText(lmStringSplit_source)
    if lmStringSplit_separator == null
        return lmChars(lmStringSplit_text)
    end
    lmStringSplit_sep = lmText(lmStringSplit_separator)
    if lmStringSplit_sep == ""
        return lmChars(lmStringSplit_text)
    end
    return split(lmStringSplit_text, lmStringSplit_sep)
end
function lmStringJoin(lmStringJoin_items, lmStringJoin_separator)
    assert(type(lmStringJoin_items) == "array", "Expected an array for join")
    if lmStringJoin_separator == null
        return join(lmStringJoin_items, "")
    end
    return join(lmStringJoin_items, lmText(lmStringJoin_separator))
end
function lmStringContains(lmStringContains_source, lmStringContains_needle)
    return contains(lmText(lmStringContains_source), lmText(lmStringContains_needle))
end
function lmStringStartsWith(lmStringStartsWith_source, lmStringStartsWith_prefix)
    return startsWith(lmText(lmStringStartsWith_source), lmText(lmStringStartsWith_prefix))
end
function lmStringEndsWith(lmStringEndsWith_source, lmStringEndsWith_suffix)
    return endsWith(lmText(lmStringEndsWith_source), lmText(lmStringEndsWith_suffix))
end
function lmStringReplace(lmStringReplace_source, lmStringReplace_old, lmStringReplace_new)
    return replace(lmText(lmStringReplace_source), lmText(lmStringReplace_old), lmText(lmStringReplace_new))
end
function lmStringReplaceAll(lmStringReplaceAll_source, lmStringReplaceAll_old, lmStringReplaceAll_new)
    return lmStringReplace(lmStringReplaceAll_source, lmStringReplaceAll_old, lmStringReplaceAll_new)
end
function lmStringSlice(lmStringSlice_source, lmStringSlice_start, lmStringSlice_end)
    lmStringSlice_text = lmText(lmStringSlice_source)
    lmStringSlice_len = len(lmStringSlice_text)
    if lmStringSlice_start == null
        lmStringSlice_start = 0
    end
    if lmStringSlice_end == null
        lmStringSlice_end = lmStringSlice_len
    end
    assert(type(lmStringSlice_start) == "number" and type(lmStringSlice_end) == "number", "string.slice expects numeric bounds")
    lmStringSlice_from = lmClampIndex(lmStringSlice_len, lmStringSlice_start)
    lmStringSlice_to = lmClampIndex(lmStringSlice_len, lmStringSlice_end)
    return lmSliceChars(lmStringSlice_text, lmStringSlice_from, lmStringSlice_to)
end
function lmStringSubstring(lmStringSubstring_source, lmStringSubstring_start, lmStringSubstring_end)
    lmStringSubstring_text = lmText(lmStringSubstring_source)
    lmStringSubstring_len = len(lmStringSubstring_text)
    assert(lmIndex(lmStringSubstring_start), "string.substring expects a non-negative whole start")
    if lmStringSubstring_end == null
        lmStringSubstring_end = lmStringSubstring_len
    end
    assert(lmIndex(lmStringSubstring_end), "string.substring expects a non-negative whole end")
    assert(lmStringSubstring_start <= lmStringSubstring_end and lmStringSubstring_end <= lmStringSubstring_len, "string.substring expects 0 <= start <= end <= length")
    return lmSliceChars(lmStringSubstring_text, lmStringSubstring_start, lmStringSubstring_end)
end
function lmStringIndexOf(lmStringIndexOf_source, lmStringIndexOf_needle)
    lmStringIndexOf_text = lmText(lmStringIndexOf_source)
    lmStringIndexOf_find = lmText(lmStringIndexOf_needle)
    if lmStringIndexOf_find == ""
        return 0
    end
    lmStringIndexOf_chars = lmChars(lmStringIndexOf_find)
    lmStringIndexOf_needleLen = len(lmStringIndexOf_chars)
    lmStringIndexOf_last = len(lmStringIndexOf_text) - lmStringIndexOf_needleLen
    lmStringIndexOf_i = 0
    while lmStringIndexOf_i <= lmStringIndexOf_last
    if lmSliceChars(lmStringIndexOf_text, lmStringIndexOf_i, lmStringIndexOf_i + lmStringIndexOf_needleLen) == lmStringIndexOf_find
        return lmStringIndexOf_i
    end
    lmStringIndexOf_i += 1
end
return -1
end
function lmStringLastIndexOf(lmStringLastIndexOf_source, lmStringLastIndexOf_needle)
    lmStringLastIndexOf_text = lmText(lmStringLastIndexOf_source)
    lmStringLastIndexOf_find = lmText(lmStringLastIndexOf_needle)
    if lmStringLastIndexOf_find == ""
        return len(lmStringLastIndexOf_text)
    end
    lmStringLastIndexOf_chars = lmChars(lmStringLastIndexOf_find)
    lmStringLastIndexOf_needleLen = len(lmStringLastIndexOf_chars)
    lmStringLastIndexOf_last = len(lmStringLastIndexOf_text) - lmStringLastIndexOf_needleLen
    lmStringLastIndexOf_found = -1
    lmStringLastIndexOf_i = 0
    while lmStringLastIndexOf_i <= lmStringLastIndexOf_last
    if lmSliceChars(lmStringLastIndexOf_text, lmStringLastIndexOf_i, lmStringLastIndexOf_i + lmStringLastIndexOf_needleLen) == lmStringLastIndexOf_find
        lmStringLastIndexOf_found = lmStringLastIndexOf_i
    end
    lmStringLastIndexOf_i += 1
end
return lmStringLastIndexOf_found
end
function lmStringCharAt(lmStringCharAt_source, lmStringCharAt_index)
    lmStringCharAt_text = lmText(lmStringCharAt_source)
    assert(lmIndex(lmStringCharAt_index), "string.charAt expects a non-negative whole index")
    lmStringCharAt_chars = lmChars(lmStringCharAt_text)
    assert(lmStringCharAt_index < len(lmStringCharAt_chars), "string.charAt index is out of range")
    return lmStringCharAt_chars[lmStringCharAt_index]
end
function lmStringToNumber(lmStringToNumber_source)
    lmStringToNumber_text = trim(lmText(lmStringToNumber_source))
    if not lmNumericText(lmStringToNumber_text)
        return null
    end
    lmStringToNumber_value = parseFloat(lmStringToNumber_text)
    if not lmFinite(lmStringToNumber_value)
        return null
    end
    return lmStringToNumber_value
end
function lmStringCapitalize(lmStringCapitalize_source)
    lmStringCapitalize_text = lmText(lmStringCapitalize_source)
    if lmStringCapitalize_text == ""
        return ""
    end
    lmStringCapitalize_chars = lmChars(lmStringCapitalize_text)
    return upper(lmStringCapitalize_chars[0]) + lmSliceChars(lmStringCapitalize_text, 1, len(lmStringCapitalize_chars))
end
function lmStringTitleCase(lmStringTitleCase_source)
    lmStringTitleCase_text = lmText(lmStringTitleCase_source)
    lmStringTitleCase_chars = lmChars(lmStringTitleCase_text)
    lmStringTitleCase_out = ""
    lmStringTitleCase_start = true
    lmStringTitleCase_i = 0
    while lmStringTitleCase_i < len(lmStringTitleCase_chars)
    lmStringTitleCase_char = lmStringTitleCase_chars[lmStringTitleCase_i]
    if lmStringTitleCase_char.isBlank()
        lmStringTitleCase_out += lmStringTitleCase_char
        lmStringTitleCase_start = true
    else if lmStringTitleCase_start
        lmStringTitleCase_out += upper(lmStringTitleCase_char)
        lmStringTitleCase_start = false
    else
        lmStringTitleCase_out += lower(lmStringTitleCase_char)
    end
    lmStringTitleCase_i += 1
end
return lmStringTitleCase_out
end
function lmStringReverse(lmStringReverse_source)
    lmStringReverse_text = lmText(lmStringReverse_source)
    lmStringReverse_chars = lmChars(lmStringReverse_text)
    lmStringReverse_out = ""
    lmStringReverse_i = len(lmStringReverse_chars) - 1
    while lmStringReverse_i >= 0
    lmStringReverse_out += lmStringReverse_chars[lmStringReverse_i]
    lmStringReverse_i -= 1
end
return lmStringReverse_out
end
function lmStringRepeat(lmStringRepeat_source, lmStringRepeat_count)
    lmStringRepeat_text = lmText(lmStringRepeat_source)
    assert(lmIndex(lmStringRepeat_count), "string.repeat expects a non-negative whole count")
    assert(lmByteLength(lmStringRepeat_text) * lmStringRepeat_count <= 10000000, "string.repeat would produce a string that is too long")
    return lmRepeatText(lmStringRepeat_text, lmStringRepeat_count)
end
function lmStringPad(lmStringPad_source, lmStringPad_width, lmStringPad_fill, lmStringPad_align)
    lmStringPad_text = lmText(lmStringPad_source)
    assert(lmIndex(lmStringPad_width), "string.pad expects a non-negative whole width")
    lmStringPad_fillText = " "
    if lmStringPad_fill != null
        lmStringPad_fillText = lmText(lmStringPad_fill)
    end
    lmStringPad_unit = " "
    if lmStringPad_fillText != ""
        lmStringPad_unit = lmChars(lmStringPad_fillText)[0]
    end
    lmStringPad_alignment = "left"
    if lmStringPad_align != null
        lmStringPad_alignment = lmText(lmStringPad_align)
    end
    lmStringPad_current = len(lmStringPad_text)
    if lmStringPad_current >= lmStringPad_width
        return lmStringPad_text
    end
    lmStringPad_missing = lmStringPad_width - lmStringPad_current
    if lmStringPad_alignment == "left"
        return lmStringPad_text + lmRepeatChar(lmStringPad_unit, lmStringPad_missing)
    end
    if lmStringPad_alignment == "right"
        return lmRepeatChar(lmStringPad_unit, lmStringPad_missing) + lmStringPad_text
    end
    if lmStringPad_alignment != "both" and lmStringPad_alignment != "center"
        assert(false, "string.pad alignment must be 'left', 'right' or 'center'")
    end
    lmStringPad_left = floor(lmStringPad_missing / 2)
    if lmStringPad_missing % 2 == 1
        lmStringPad_left += 1
    end
    lmStringPad_right = lmStringPad_missing - lmStringPad_left
    return lmRepeatChar(lmStringPad_unit, lmStringPad_left) + lmStringPad_text + lmRepeatChar(lmStringPad_unit, lmStringPad_right)
end
function lmStringPadLeft(lmStringPadLeft_source, lmStringPadLeft_width, lmStringPadLeft_fill)
    lmStringPadLeft_text = lmText(lmStringPadLeft_source)
    assert(lmIndex(lmStringPadLeft_width), "padLeft expects a non-negative whole width")
    lmStringPadLeft_target = lmStringPadLeft_width
    if lmStringPadLeft_target > 100000
        lmStringPadLeft_target = 100000
    end
    lmStringPadLeft_missing = lmStringPadLeft_target - len(lmStringPadLeft_text)
    if lmStringPadLeft_missing <= 0
        return lmStringPadLeft_text
    end
    lmStringPadLeft_unit = " "
    if lmStringPadLeft_fill != null
        lmStringPadLeft_unit = lmText(lmStringPadLeft_fill)
    end
    if lmStringPadLeft_unit == ""
        lmStringPadLeft_unit = " "
    end
    lmStringPadLeft_padding = ""
    while len(lmStringPadLeft_padding) < lmStringPadLeft_missing
    lmStringPadLeft_padding += lmStringPadLeft_unit
end
return lmSliceChars(lmStringPadLeft_padding, 0, lmStringPadLeft_missing) + lmStringPadLeft_text
end
function lmStringPadRight(lmStringPadRight_source, lmStringPadRight_width, lmStringPadRight_fill)
    lmStringPadRight_text = lmText(lmStringPadRight_source)
    assert(lmIndex(lmStringPadRight_width), "padRight expects a non-negative whole width")
    lmStringPadRight_target = lmStringPadRight_width
    if lmStringPadRight_target > 100000
        lmStringPadRight_target = 100000
    end
    lmStringPadRight_missing = lmStringPadRight_target - len(lmStringPadRight_text)
    if lmStringPadRight_missing <= 0
        return lmStringPadRight_text
    end
    lmStringPadRight_unit = " "
    if lmStringPadRight_fill != null
        lmStringPadRight_unit = lmText(lmStringPadRight_fill)
    end
    if lmStringPadRight_unit == ""
        lmStringPadRight_unit = " "
    end
    lmStringPadRight_padding = ""
    while len(lmStringPadRight_padding) < lmStringPadRight_missing
    lmStringPadRight_padding += lmStringPadRight_unit
end
return lmStringPadRight_text + lmSliceChars(lmStringPadRight_padding, 0, lmStringPadRight_missing)
end
function lmStringIsDigit(lmStringIsDigit_source)
    lmStringIsDigit_chars = lmChars(lmText(lmStringIsDigit_source))
    if len(lmStringIsDigit_chars) == 0
        return false
    end
    lmStringIsDigit_i = 0
    while lmStringIsDigit_i < len(lmStringIsDigit_chars)
    if not lmAsciiDigit(lmStringIsDigit_chars[lmStringIsDigit_i])
        return false
    end
    lmStringIsDigit_i += 1
end
return true
end
function lmStringIsAlpha(lmStringIsAlpha_source)
    lmStringIsAlpha_chars = lmChars(lmText(lmStringIsAlpha_source))
    if len(lmStringIsAlpha_chars) == 0
        return false
    end
    lmStringIsAlpha_i = 0
    while lmStringIsAlpha_i < len(lmStringIsAlpha_chars)
    if not lmStringIsAlpha_chars[lmStringIsAlpha_i].isAlpha()
        return false
    end
    lmStringIsAlpha_i += 1
end
return true
end
function lmStringIsAlphanumeric(lmStringIsAlphanumeric_source)
    lmStringIsAlphanumeric_chars = lmChars(lmText(lmStringIsAlphanumeric_source))
    if len(lmStringIsAlphanumeric_chars) == 0
        return false
    end
    lmStringIsAlphanumeric_i = 0
    while lmStringIsAlphanumeric_i < len(lmStringIsAlphanumeric_chars)
    lmStringIsAlphanumeric_char = lmStringIsAlphanumeric_chars[lmStringIsAlphanumeric_i]
    if not lmStringIsAlphanumeric_char.isAlpha() and not lmAsciiDigit(lmStringIsAlphanumeric_char)
        return false
    end
    lmStringIsAlphanumeric_i += 1
end
return true
end
function lmStringIsWhitespace(lmStringIsWhitespace_source)
    lmStringIsWhitespace_chars = lmChars(lmText(lmStringIsWhitespace_source))
    if len(lmStringIsWhitespace_chars) == 0
        return false
    end
    lmStringIsWhitespace_i = 0
    while lmStringIsWhitespace_i < len(lmStringIsWhitespace_chars)
    if not lmStringIsWhitespace_chars[lmStringIsWhitespace_i].isBlank()
        return false
    end
    lmStringIsWhitespace_i += 1
end
return true
end
function lmStringIsEmpty(lmStringIsEmpty_source)
    return len(lmText(lmStringIsEmpty_source)) == 0
end
function lmStringIsBlank(lmStringIsBlank_source)
    lmStringIsBlank_chars = lmChars(lmText(lmStringIsBlank_source))
    lmStringIsBlank_i = 0
    while lmStringIsBlank_i < len(lmStringIsBlank_chars)
    if not lmStringIsBlank_chars[lmStringIsBlank_i].isBlank()
        return false
    end
    lmStringIsBlank_i += 1
end
return true
end
function lmStringLines(lmStringLines_source)
    lmStringLines_text = lmText(lmStringLines_source)
    if lmStringLines_text == ""
        return []
    end
    lmStringLines_raw = split(lmStringLines_text, "\n")
    lmStringLines_count = len(lmStringLines_raw)
    lmStringLines_dropLast = lmStringLines_count > 0 and lmStringLines_raw[lmStringLines_count - 1] == "" and lmStringLines_text.endsWith("\n")
    lmStringLines_out = []
    lmStringLines_i = 0
    while lmStringLines_i < lmStringLines_count
    lmStringLines_part = lmStringLines_raw[lmStringLines_i]
    if lmStringLines_i < lmStringLines_count - 1 and lmStringLines_part.endsWith("")
        lmStringLines_part = lmSliceChars(lmStringLines_part, 0, len(lmStringLines_part) - 1)
    end
    if not (lmStringLines_dropLast and lmStringLines_i == lmStringLines_count - 1)
        lmStringLines_out.add(lmStringLines_part)
    end
    lmStringLines_i += 1
end
return lmStringLines_out
end
function lmStringChars(lmStringChars_source)
    return lmChars(lmText(lmStringChars_source))
end
function lmStringSwapCase(lmStringSwapCase_source)
    lmStringSwapCase_chars = lmChars(lmText(lmStringSwapCase_source))
    lmStringSwapCase_out = ""
    lmStringSwapCase_i = 0
    while lmStringSwapCase_i < len(lmStringSwapCase_chars)
    lmStringSwapCase_char = lmStringSwapCase_chars[lmStringSwapCase_i]
    if lmIsUpperChar(lmStringSwapCase_char)
        lmStringSwapCase_out += lower(lmStringSwapCase_char)
    else if lmIsLowerChar(lmStringSwapCase_char)
        lmStringSwapCase_out += upper(lmStringSwapCase_char)
    else
        lmStringSwapCase_out += lmStringSwapCase_char
    end
    lmStringSwapCase_i += 1
end
return lmStringSwapCase_out
end
function lmStringTruncate(lmStringTruncate_source, lmStringTruncate_width, lmStringTruncate_suffix)
    lmStringTruncate_text = lmText(lmStringTruncate_source)
    assert(lmIndex(lmStringTruncate_width), "truncate expects a non-negative whole width")
    lmStringTruncate_target = lmStringTruncate_width
    if lmStringTruncate_target > 100000
        lmStringTruncate_target = 100000
    end
    if len(lmStringTruncate_text) <= lmStringTruncate_target
        return lmStringTruncate_text
    end
    lmStringTruncate_tail = "..."
    if lmStringTruncate_suffix != null
        lmStringTruncate_tail = lmText(lmStringTruncate_suffix)
    end
    lmStringTruncate_chars = lmChars(lmStringTruncate_text)
    lmStringTruncate_tailChars = lmChars(lmStringTruncate_tail)
    lmStringTruncate_kept = lmStringTruncate_target - len(lmStringTruncate_tailChars)
    if lmStringTruncate_kept < 0
        lmStringTruncate_kept = 0
    end
    lmStringTruncate_out = lmSliceChars(lmStringTruncate_text, 0, lmStringTruncate_kept)
    lmStringTruncate_left = lmStringTruncate_target - lmStringTruncate_kept
    lmStringTruncate_tailI = 0
    while lmStringTruncate_tailI < lmStringTruncate_left and lmStringTruncate_tailI < len(lmStringTruncate_tailChars)
    lmStringTruncate_out += lmStringTruncate_tailChars[lmStringTruncate_tailI]
    lmStringTruncate_tailI += 1
end
return lmStringTruncate_out
end
function lmStringModule()
    return {length: lmStringLength, upper: lmStringUpper, lower: lmStringLower, trim: lmStringTrim, split: lmStringSplit, join: lmStringJoin, contains: lmStringContains, startsWith: lmStringStartsWith, endsWith: lmStringEndsWith, replace: lmStringReplace, replaceAll: lmStringReplaceAll, slice: lmStringSlice, substring: lmStringSubstring, indexOf: lmStringIndexOf, lastIndexOf: lmStringLastIndexOf, charAt: lmStringCharAt, toNumber: lmStringToNumber, capitalize: lmStringCapitalize, titleCase: lmStringTitleCase, reverse: lmStringReverse, repeat: lmStringRepeat, pad: lmStringPad, padLeft: lmStringPadLeft, padRight: lmStringPadRight, isDigit: lmStringIsDigit, isAlpha: lmStringIsAlpha, isAlphanumeric: lmStringIsAlphanumeric, isWhitespace: lmStringIsWhitespace, isEmpty: lmStringIsEmpty, isBlank: lmStringIsBlank, lines: lmStringLines, chars: lmStringChars, swapCase: lmStringSwapCase, truncate: lmStringTruncate}
end
$- ---------------------------------------------------------------------------
   JSON encoding
   --------------------------------------------------------------------------- -$
function lmJsonHexDigit(lmJsonHexDigit_n)
    lmJsonHexDigit_digits = "0123456789abcdef"
    if lmJsonHexDigit_n < 0 or lmJsonHexDigit_n > 15
        return -1
    end
    return lmJsonHexDigit_digits[lmJsonHexDigit_n]
end
function lmJsonHex4(lmJsonHex4_n)
    lmJsonHex4_out = ""
    lmJsonHex4_i = 3
    while lmJsonHex4_i >= 0
    lmJsonHex4_out = lmJsonHexDigit(floor(lmJsonHex4_n / pow(16, lmJsonHex4_i)) % 16) + lmJsonHex4_out
    lmJsonHex4_i -= 1
end
return lmJsonHex4_out
end
function lmJsonQuote(lmJsonQuote_source)
    lmJsonQuote_chars = lmChars(lmText(lmJsonQuote_source))
    lmJsonQuote_out = "\""
    lmJsonQuote_i = 0
    while lmJsonQuote_i < len(lmJsonQuote_chars)
    lmJsonQuote_char = lmJsonQuote_chars[lmJsonQuote_i]
    if lmJsonQuote_char == "\""
        lmJsonQuote_out += "\\\""
    else if lmJsonQuote_char == "\\"
        lmJsonQuote_out += "\\\\"
    else if lmJsonQuote_char == "\n"
        lmJsonQuote_out += "\\n"
    else if lmJsonQuote_char == ""
        lmJsonQuote_out += "\\r"
    else if lmJsonQuote_char == "\t"
        lmJsonQuote_out += "\\t"
    else if lmJsonQuote_char == ""
        lmJsonQuote_out += "\\b"
    else if lmJsonQuote_char == ""
        lmJsonQuote_out += "\\f"
    else if charCode(lmJsonQuote_char) < 32
        lmJsonQuote_out += "\\u00" + lmJsonHex4(charCode(lmJsonQuote_char))
    else
        lmJsonQuote_out += lmJsonQuote_char
    end
    lmJsonQuote_i += 1
end
return lmJsonQuote_out + "\""
end
function lmJsonEncodeInner(lmJsonEncodeInner_value, lmJsonEncodeInner_depth)
    if lmJsonEncodeInner_depth > 100
        assert(false, "JSON value is nested too deeply")
    end
    lmJsonEncodeInner_type = type(lmJsonEncodeInner_value)
    if lmJsonEncodeInner_type == "null"
        return "null"
    end
    if lmJsonEncodeInner_type == "boolean"
        if lmJsonEncodeInner_value
            return "true"
        end
        return "false"
    end
    if lmJsonEncodeInner_type == "number"
        assert(lmFinite(lmJsonEncodeInner_value), "Cannot encode a non-finite number as JSON")
        return toString(lmJsonEncodeInner_value)
    end
    if lmJsonEncodeInner_type == "string"
        return lmJsonQuote(lmJsonEncodeInner_value)
    end
    if lmJsonEncodeInner_type == "array"
        lmJsonEncodeInner_out = "["
        lmJsonEncodeInner_i = 0
        while lmJsonEncodeInner_i < len(lmJsonEncodeInner_value)
        if lmJsonEncodeInner_i > 0
            lmJsonEncodeInner_out += ","
        end
        lmJsonEncodeInner_out += lmJsonEncodeInner(lmJsonEncodeInner_value[lmJsonEncodeInner_i], lmJsonEncodeInner_depth + 1)
        lmJsonEncodeInner_i += 1
    end
    return lmJsonEncodeInner_out + "]"
end
if lmJsonEncodeInner_type == "object"
    lmJsonEncodeInner_out = "\{"
    lmJsonEncodeInner_keys = keys(lmJsonEncodeInner_value)
    lmJsonEncodeInner_i = 0
    while lmJsonEncodeInner_i < len(lmJsonEncodeInner_keys)
    if lmJsonEncodeInner_i > 0
        lmJsonEncodeInner_out += ","
    end
    lmJsonEncodeInner_key = lmJsonEncodeInner_keys[lmJsonEncodeInner_i]
    lmJsonEncodeInner_out += lmJsonQuote(lmJsonEncodeInner_key) + ":"
    lmJsonEncodeInner_out += lmJsonEncodeInner(lmJsonEncodeInner_value.get(lmJsonEncodeInner_key), lmJsonEncodeInner_depth + 1)
    lmJsonEncodeInner_i += 1
end
return lmJsonEncodeInner_out + "\}"
end
assert(false, "Cannot encode a " + lmJsonEncodeInner_type + " as JSON")
end
function lmJsonEncode(lmJsonEncode_value)
    return lmJsonEncodeInner(lmJsonEncode_value, 0)
end
$- ---------------------------------------------------------------------------
   JSON decoding
   --------------------------------------------------------------------------- -$
function lmJsonState(lmJsonState_text, lmJsonState_strict)
    return {chars: split(lmJsonState_text, ""), pos: 0, strict: lmJsonState_strict, error: ""}
end
function lmJsonFail(lmJsonFail_state, lmJsonFail_message)
    lmJsonFail_state.error = lmJsonFail_message
    if lmJsonFail_state.strict
        assert(false, lmJsonFail_message)
    end
    return null
end
function lmJsonSkipWs(lmJsonSkipWs_state)
    while lmJsonSkipWs_state.pos < len(lmJsonSkipWs_state.chars)
    lmJsonSkipWs_char = lmJsonSkipWs_state.chars[lmJsonSkipWs_state.pos]
    if lmJsonSkipWs_char != " " and lmJsonSkipWs_char != "\t" and lmJsonSkipWs_char != "\n" and lmJsonSkipWs_char != ""
        break
    end
    lmJsonSkipWs_state.pos += 1
end
end
function lmJsonTail(lmJsonTail_state)
    lmJsonTail_out = ""
    lmJsonTail_i = lmJsonTail_state.pos
    while lmJsonTail_i < len(lmJsonTail_state.chars)
    lmJsonTail_out += lmJsonTail_state.chars[lmJsonTail_i]
    lmJsonTail_i += 1
end
return lmJsonTail_out
end
function lmJsonConsumeLiteral(lmJsonConsumeLiteral_state, lmJsonConsumeLiteral_literal)
    if startsWith(lmJsonTail(lmJsonConsumeLiteral_state), lmJsonConsumeLiteral_literal)
        lmJsonConsumeLiteral_state.pos += len(lmJsonConsumeLiteral_literal)
        return true
    end
    return false
end
function lmJsonHexValue(lmJsonHexValue_char)
    lmJsonHexValue_digits = "0123456789abcdefABCDEF"
    lmJsonHexValue_i = 0
    while lmJsonHexValue_i < len(lmJsonHexValue_digits)
    if lmJsonHexValue_digits[lmJsonHexValue_i] == lmJsonHexValue_char
        if lmJsonHexValue_i < 16
            return lmJsonHexValue_i
        end
        return lmJsonHexValue_i - 6
    end
    lmJsonHexValue_i += 1
end
return -1
end
function lmJsonParseHex4(lmJsonParseHex4_state)
    if lmJsonParseHex4_state.pos + 4 > len(lmJsonParseHex4_state.chars)
        return lmJsonFail(lmJsonParseHex4_state, "Incomplete Unicode escape in JSON string")
    end
    lmJsonParseHex4_value = 0
    lmJsonParseHex4_i = 0
    while lmJsonParseHex4_i < 4
    lmJsonParseHex4_digit = lmJsonHexValue(lmJsonParseHex4_state.chars[lmJsonParseHex4_state.pos])
    if lmJsonParseHex4_digit < 0
        return lmJsonFail(lmJsonParseHex4_state, "Invalid Unicode escape in JSON string")
    end
    lmJsonParseHex4_value = lmJsonParseHex4_value * 16 + lmJsonParseHex4_digit
    lmJsonParseHex4_state.pos += 1
    lmJsonParseHex4_i += 1
end
return lmJsonParseHex4_value
end
function lmJsonParseString(lmJsonParseString_state)
    lmJsonParseString_state.pos += 1
    lmJsonParseString_out = ""
    while true
    if lmJsonParseString_state.pos >= len(lmJsonParseString_state.chars)
        return lmJsonFail(lmJsonParseString_state, "Unterminated JSON string")
    end
    lmJsonParseString_char = lmJsonParseString_state.chars[lmJsonParseString_state.pos]
    lmJsonParseString_state.pos += 1
    if lmJsonParseString_char == "\""
        return lmJsonParseString_out
    end
    if lmJsonParseString_char == "\\"
        if lmJsonParseString_state.pos >= len(lmJsonParseString_state.chars)
            return lmJsonFail(lmJsonParseString_state, "Unterminated JSON escape sequence")
        end
        lmJsonParseString_escape = lmJsonParseString_state.chars[lmJsonParseString_state.pos]
        lmJsonParseString_state.pos += 1
        if lmJsonParseString_escape == "\""
            lmJsonParseString_out += "\""
        else if lmJsonParseString_escape == "\\"
            lmJsonParseString_out += "\\"
        else if lmJsonParseString_escape == "/"
            lmJsonParseString_out += "/"
        else if lmJsonParseString_escape == "b"
            lmJsonParseString_out += ""
        else if lmJsonParseString_escape == "f"
            lmJsonParseString_out += ""
        else if lmJsonParseString_escape == "n"
            lmJsonParseString_out += "\n"
        else if lmJsonParseString_escape == "r"
            lmJsonParseString_out += ""
        else if lmJsonParseString_escape == "t"
            lmJsonParseString_out += "\t"
        else if lmJsonParseString_escape == "u"
            lmJsonParseString_code = lmJsonParseHex4(lmJsonParseString_state)
            if lmJsonParseString_state.error != ""
                return null
            end
            if lmJsonParseString_code >= 55296 and lmJsonParseString_code <= 57343
                if lmJsonParseString_code > 56319
                    return lmJsonFail(lmJsonParseString_state, "Expected a high surrogate in JSON string")
                end
                if lmJsonParseString_state.pos + 1 >= len(lmJsonParseString_state.chars) or lmJsonParseString_state.chars[lmJsonParseString_state.pos] != "\\" or lmJsonParseString_state.chars[lmJsonParseString_state.pos + 1] != "u"
                    return lmJsonFail(lmJsonParseString_state, "Expected a low surrogate in JSON string")
                end
                lmJsonParseString_state.pos += 2
                lmJsonParseString_low = lmJsonParseHex4(lmJsonParseString_state)
                if lmJsonParseString_state.error != ""
                    return null
                end
                if lmJsonParseString_low < 56320 or lmJsonParseString_low > 57343
                    return lmJsonFail(lmJsonParseString_state, "Invalid low surrogate in JSON string")
                end
                lmJsonParseString_code = 65536 + (lmJsonParseString_code - 55296) * 1024 + (lmJsonParseString_low - 56320)
            end
            if lmJsonParseString_code >= 55296 and lmJsonParseString_code <= 57343
                return lmJsonFail(lmJsonParseString_state, "Invalid Unicode escape in JSON string")
            end
            lmJsonParseString_out += fromCharCode(lmJsonParseString_code)
        else
            return lmJsonFail(lmJsonParseString_state, "Invalid JSON escape sequence")
        end
    else if charCode(lmJsonParseString_char) < 32
        return lmJsonFail(lmJsonParseString_state, "Control character in JSON string")
    else
        lmJsonParseString_out += lmJsonParseString_char
    end
end
end
function lmJsonValidNumber(lmJsonValidNumber_text)
    lmJsonValidNumber_chars = lmChars(lmJsonValidNumber_text)
    lmJsonValidNumber_size = len(lmJsonValidNumber_chars)
    lmJsonValidNumber_pos = 0
    if lmJsonValidNumber_size == 0
        return false
    end
    if lmJsonValidNumber_chars[0] == "-"
        lmJsonValidNumber_pos = 1
    end
    if lmJsonValidNumber_pos >= lmJsonValidNumber_size
        return false
    end
    if lmJsonValidNumber_chars[lmJsonValidNumber_pos] == "0"
        lmJsonValidNumber_pos += 1
        if lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
            return false
        end
    else if lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        while lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        lmJsonValidNumber_pos += 1
    end
else
    return false
end
if lmJsonValidNumber_pos < lmJsonValidNumber_size and lmJsonValidNumber_chars[lmJsonValidNumber_pos] == "."
    lmJsonValidNumber_pos += 1
    if lmJsonValidNumber_pos >= lmJsonValidNumber_size or not lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        return false
    end
    while lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
    lmJsonValidNumber_pos += 1
end
end
if lmJsonValidNumber_pos < lmJsonValidNumber_size
    lmJsonValidNumber_exp = lmJsonValidNumber_chars[lmJsonValidNumber_pos]
    if lmJsonValidNumber_exp == "e" or lmJsonValidNumber_exp == "E"
        lmJsonValidNumber_pos += 1
        if lmJsonValidNumber_pos < lmJsonValidNumber_size
            lmJsonValidNumber_sign = lmJsonValidNumber_chars[lmJsonValidNumber_pos]
            if lmJsonValidNumber_sign == "+" or lmJsonValidNumber_sign == "-"
                lmJsonValidNumber_pos += 1
            end
        end
        if lmJsonValidNumber_pos >= lmJsonValidNumber_size or not lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
            return false
        end
        while lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        lmJsonValidNumber_pos += 1
    end
end
end
return lmJsonValidNumber_pos == lmJsonValidNumber_size
end
function lmJsonParseNumber(lmJsonParseNumber_state)
    lmJsonParseNumber_start = lmJsonParseNumber_state.pos
    while lmJsonParseNumber_state.pos < len(lmJsonParseNumber_state.chars)
    lmJsonParseNumber_char = lmJsonParseNumber_state.chars[lmJsonParseNumber_state.pos]
    if lmAsciiDigit(lmJsonParseNumber_char) or lmJsonParseNumber_char == "-" or lmJsonParseNumber_char == "+" or lmJsonParseNumber_char == "." or lmJsonParseNumber_char == "e" or lmJsonParseNumber_char == "E"
        lmJsonParseNumber_state.pos += 1
        continue
    end
    break
end
lmJsonParseNumber_text = lmJsonTailSlice(lmJsonParseNumber_state, lmJsonParseNumber_start, lmJsonParseNumber_state.pos)
if not lmJsonValidNumber(lmJsonParseNumber_text)
    return lmJsonFail(lmJsonParseNumber_state, "Invalid JSON number '" + lmJsonParseNumber_text + "'")
end
return parseFloat(lmJsonParseNumber_text)
end
function lmJsonTailSlice(lmJsonTailSlice_state, lmJsonTailSlice_from, lmJsonTailSlice_to)
    return join(slice(lmJsonTailSlice_state.chars, lmJsonTailSlice_from, lmJsonTailSlice_to), "")
end
function lmJsonParseArray(lmJsonParseArray_state)
    lmJsonParseArray_state.pos += 1
    lmJsonParseArray_items = []
    lmJsonSkipWs(lmJsonParseArray_state)
    if lmJsonParseArray_state.pos < len(lmJsonParseArray_state.chars) and lmJsonParseArray_state.chars[lmJsonParseArray_state.pos] == "]"
        lmJsonParseArray_state.pos += 1
        return lmJsonParseArray_items
    end
    while true
    lmJsonSkipWs(lmJsonParseArray_state)
    lmJsonParseArray_value = lmJsonParseValue(lmJsonParseArray_state)
    if lmJsonParseArray_state.error != ""
        return null
    end
    lmJsonParseArray_items.add(lmJsonParseArray_value)
    lmJsonSkipWs(lmJsonParseArray_state)
    if lmJsonParseArray_state.pos >= len(lmJsonParseArray_state.chars)
        return lmJsonFail(lmJsonParseArray_state, "Expected ',' or ']' at position " + toString(lmJsonParseArray_state.pos))
    end
    lmJsonParseArray_char = lmJsonParseArray_state.chars[lmJsonParseArray_state.pos]
    lmJsonParseArray_state.pos += 1
    if lmJsonParseArray_char == "]"
        return lmJsonParseArray_items
    end
    if lmJsonParseArray_char != ","
        return lmJsonFail(lmJsonParseArray_state, "Expected ',' or ']' at position " + toString(lmJsonParseArray_state.pos - 1))
    end
end
end
function lmJsonParseObject(lmJsonParseObject_state)
    lmJsonParseObject_state.pos += 1
    lmJsonParseObject_fields = {}
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos < len(lmJsonParseObject_state.chars) and lmJsonParseObject_state.chars[lmJsonParseObject_state.pos] == "\}"
        lmJsonParseObject_state.pos += 1
        return lmJsonParseObject_fields
    end
    while true
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos >= len(lmJsonParseObject_state.chars) or lmJsonParseObject_state.chars[lmJsonParseObject_state.pos] != "\""
        return lmJsonFail(lmJsonParseObject_state, "Expected a string key at position " + toString(lmJsonParseObject_state.pos))
    end
    lmJsonParseObject_key = lmJsonParseString(lmJsonParseObject_state)
    if lmJsonParseObject_state.error != ""
        return null
    end
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos >= len(lmJsonParseObject_state.chars) or lmJsonParseObject_state.chars[lmJsonParseObject_state.pos] != ":"
        return lmJsonFail(lmJsonParseObject_state, "Expected ':' at position " + toString(lmJsonParseObject_state.pos))
    end
    lmJsonParseObject_state.pos += 1
    lmJsonSkipWs(lmJsonParseObject_state)
    lmJsonParseObject_value = lmJsonParseValue(lmJsonParseObject_state)
    if lmJsonParseObject_state.error != ""
        return null
    end
    lmJsonParseObject_fields.set(lmJsonParseObject_key, lmJsonParseObject_value)
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos >= len(lmJsonParseObject_state.chars)
        return lmJsonFail(lmJsonParseObject_state, "Expected ',' or '\}' at position " + toString(lmJsonParseObject_state.pos))
    end
    lmJsonParseObject_char = lmJsonParseObject_state.chars[lmJsonParseObject_state.pos]
    lmJsonParseObject_state.pos += 1
    if lmJsonParseObject_char == "\}"
        return lmJsonParseObject_fields
    end
    if lmJsonParseObject_char != ","
        return lmJsonFail(lmJsonParseObject_state, "Expected ',' or '\}' at position " + toString(lmJsonParseObject_state.pos - 1))
    end
end
end
function lmJsonParseValue(lmJsonParseValue_state)
    if lmJsonParseValue_state.error != ""
        return null
    end
    lmJsonSkipWs(lmJsonParseValue_state)
    if lmJsonParseValue_state.pos >= len(lmJsonParseValue_state.chars)
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    lmJsonParseValue_char = lmJsonParseValue_state.chars[lmJsonParseValue_state.pos]
    if lmJsonParseValue_char == "\""
        return lmJsonParseString(lmJsonParseValue_state)
    end
    if lmJsonParseValue_char == "\{"
        return lmJsonParseObject(lmJsonParseValue_state)
    end
    if lmJsonParseValue_char == "["
        return lmJsonParseArray(lmJsonParseValue_state)
    end
    if lmJsonParseValue_char == "t"
        if lmJsonConsumeLiteral(lmJsonParseValue_state, "true")
            return true
        end
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    if lmJsonParseValue_char == "f"
        if lmJsonConsumeLiteral(lmJsonParseValue_state, "false")
            return false
        end
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    if lmJsonParseValue_char == "n"
        if lmJsonConsumeLiteral(lmJsonParseValue_state, "null")
            return null
        end
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    if lmJsonParseValue_char == "-" or lmAsciiDigit(lmJsonParseValue_char)
        return lmJsonParseNumber(lmJsonParseValue_state)
    end
    return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
end
function lmJsonDecode(lmJsonDecode_text)
    assert(type(lmJsonDecode_text) == "string", "json.decode expects a string")
    lmJsonDecode_state = lmJsonState(lmJsonDecode_text, true)
    lmJsonDecode_value = lmJsonParseValue(lmJsonDecode_state)
    lmJsonSkipWs(lmJsonDecode_state)
    assert(lmJsonDecode_state.pos == len(lmJsonDecode_state.chars), "Unexpected trailing JSON characters at position " + toString(lmJsonDecode_state.pos))
    return lmJsonDecode_value
end
function lmJsonIsValid(lmJsonIsValid_text)
    if type(lmJsonIsValid_text) != "string"
        return false
    end
    lmJsonIsValid_state = lmJsonState(lmJsonIsValid_text, false)
    lmJsonParseValue(lmJsonIsValid_state)
    if lmJsonIsValid_state.error != ""
        return false
    end
    lmJsonSkipWs(lmJsonIsValid_state)
    return lmJsonIsValid_state.pos == len(lmJsonIsValid_state.chars)
end
$- ---------------------------------------------------------------------------
   JSON paths and pretty printing
   --------------------------------------------------------------------------- -$
function lmJsonIndent(lmJsonIndent_level)
    return lmRepeatText("  ", lmJsonIndent_level)
end
function lmJsonPrettyInner(lmJsonPrettyInner_value, lmJsonPrettyInner_level)
    if lmJsonPrettyInner_level > 100
        assert(false, "JSON value is nested too deeply")
    end
    lmJsonPrettyInner_type = type(lmJsonPrettyInner_value)
    if lmJsonPrettyInner_type == "array"
        if len(lmJsonPrettyInner_value) == 0
            return "[]"
        end
        lmJsonPrettyInner_out = "[\n"
        lmJsonPrettyInner_i = 0
        while lmJsonPrettyInner_i < len(lmJsonPrettyInner_value)
        lmJsonPrettyInner_out += lmJsonIndent(lmJsonPrettyInner_level + 1)
        lmJsonPrettyInner_out += lmJsonPrettyInner(lmJsonPrettyInner_value[lmJsonPrettyInner_i], lmJsonPrettyInner_level + 1)
        if lmJsonPrettyInner_i + 1 < len(lmJsonPrettyInner_value)
            lmJsonPrettyInner_out += ","
        end
        lmJsonPrettyInner_out += "\n"
        lmJsonPrettyInner_i += 1
    end
    return lmJsonPrettyInner_out + lmJsonIndent(lmJsonPrettyInner_level) + "]"
end
if lmJsonPrettyInner_type == "object"
    lmJsonPrettyInner_keys = keys(lmJsonPrettyInner_value)
    if len(lmJsonPrettyInner_keys) == 0
        return "\{\}"
    end
    lmJsonPrettyInner_out = "\{\n"
    lmJsonPrettyInner_i = 0
    while lmJsonPrettyInner_i < len(lmJsonPrettyInner_keys)
    lmJsonPrettyInner_out += lmJsonIndent(lmJsonPrettyInner_level + 1)
    lmJsonPrettyInner_key = lmJsonPrettyInner_keys[lmJsonPrettyInner_i]
    lmJsonPrettyInner_out += lmJsonQuote(lmJsonPrettyInner_key) + ": "
    lmJsonPrettyInner_out += lmJsonPrettyInner(lmJsonPrettyInner_value.get(lmJsonPrettyInner_key), lmJsonPrettyInner_level + 1)
    if lmJsonPrettyInner_i + 1 < len(lmJsonPrettyInner_keys)
        lmJsonPrettyInner_out += ","
    end
    lmJsonPrettyInner_out += "\n"
    lmJsonPrettyInner_i += 1
end
return lmJsonPrettyInner_out + lmJsonIndent(lmJsonPrettyInner_level) + "\}"
end
return lmJsonEncodeInner(lmJsonPrettyInner_value, lmJsonPrettyInner_level)
end
function lmJsonPretty(lmJsonPretty_value)
    return lmJsonPrettyInner(lmJsonPretty_value, 0)
end
function lmJsonArrayIndex(lmJsonArrayIndex_segment)
    if not lmNumericText(lmJsonArrayIndex_segment)
        return -1
    end
    lmJsonArrayIndex_number = parseFloat(lmJsonArrayIndex_segment)
    if not lmIndex(lmJsonArrayIndex_number)
        return -1
    end
    return lmJsonArrayIndex_number
end
function lmJsonGet(lmJsonGet_root, lmJsonGet_path)
    assert(type(lmJsonGet_path) == "string", "json.get expects a path string")
    if lmJsonGet_path == ""
        return lmJsonGet_root
    end
    lmJsonGet_segments = split(lmJsonGet_path, ".")
    lmJsonGet_current = lmJsonGet_root
    lmJsonGet_i = 0
    while lmJsonGet_i < len(lmJsonGet_segments)
    lmJsonGet_segment = lmJsonGet_segments[lmJsonGet_i]
    if type(lmJsonGet_current) == "object"
        lmJsonGet_current = lmJsonGet_current.get(lmJsonGet_segment, null)
    else if type(lmJsonGet_current) == "array"
        lmJsonGet_index = lmJsonArrayIndex(lmJsonGet_segment)
        if lmJsonGet_index < 0 or lmJsonGet_index >= len(lmJsonGet_current)
            lmJsonGet_current = null
        else
            lmJsonGet_current = lmJsonGet_current[lmJsonGet_index]
        end
    else
        lmJsonGet_current = null
    end
    lmJsonGet_i += 1
end
return lmJsonGet_current
end
function lmJsonSetAt(lmJsonSetAt_container, lmJsonSetAt_segments, lmJsonSetAt_pos, lmJsonSetAt_value)
    lmJsonSetAt_segment = lmJsonSetAt_segments[lmJsonSetAt_pos]
    lmJsonSetAt_last = lmJsonSetAt_pos == len(lmJsonSetAt_segments) - 1
    if type(lmJsonSetAt_container) == "object"
        if lmJsonSetAt_last
            lmJsonSetAt_container.set(lmJsonSetAt_segment, lmJsonSetAt_value)
            return
        end
        lmJsonSetAt_child = lmJsonSetAt_container.get(lmJsonSetAt_segment, null)
        if type(lmJsonSetAt_child) == "object" or type(lmJsonSetAt_child) == "array"
            lmJsonSetAt(lmJsonSetAt_child, lmJsonSetAt_segments, lmJsonSetAt_pos + 1, lmJsonSetAt_value)
            return
        end
        if type(lmJsonSetAt_child) != "null"
            assert(false, "Cannot descend into a " + type(lmJsonSetAt_child) + " at '" + lmJsonSetAt_segment + "' for json.set")
        end
        lmJsonSetAt_child = {}
        lmJsonSetAt_container.set(lmJsonSetAt_segment, lmJsonSetAt_child)
        lmJsonSetAt(lmJsonSetAt_child, lmJsonSetAt_segments, lmJsonSetAt_pos + 1, lmJsonSetAt_value)
        return
    end
    if type(lmJsonSetAt_container) == "array"
        lmJsonSetAt_index = lmJsonArrayIndex(lmJsonSetAt_segment)
        assert(lmJsonSetAt_index >= 0, "Expected an array index in path, found '" + lmJsonSetAt_segment + "'")
        if lmJsonSetAt_last
            if lmJsonSetAt_index < len(lmJsonSetAt_container)
                lmJsonSetAt_container[lmJsonSetAt_index] = lmJsonSetAt_value
            else if lmJsonSetAt_index == len(lmJsonSetAt_container)
                lmJsonSetAt_container.add(lmJsonSetAt_value)
            else
                assert(false, "json.set array index is past the end of the array")
            end
            return
        end
        assert(lmJsonSetAt_index < len(lmJsonSetAt_container), "json.set array index is past the end of the array")
        lmJsonSetAt_child = lmJsonSetAt_container[lmJsonSetAt_index]
        if type(lmJsonSetAt_child) != "object" and type(lmJsonSetAt_child) != "array"
            assert(false, "Cannot descend into a non-container for json.set")
        end
        lmJsonSetAt(lmJsonSetAt_child, lmJsonSetAt_segments, lmJsonSetAt_pos + 1, lmJsonSetAt_value)
        return
    end
    assert(false, "json.set cannot descend into a " + type(lmJsonSetAt_container) + " at '" + lmJsonSetAt_segment + "'")
end
function lmJsonSet(lmJsonSet_root, lmJsonSet_path, lmJsonSet_value)
    assert(type(lmJsonSet_path) == "string", "json.set expects a path string")
    if lmJsonSet_path == ""
        return lmJsonSet_value
    end
    lmJsonSet_result = lmJsonSet_root
    if lmJsonSet_result == null
        lmJsonSet_result = {}
    end
    assert(type(lmJsonSet_result) == "object" or type(lmJsonSet_result) == "array", "json.set expects an object, array or null root")
    lmJsonSet_segments = split(lmJsonSet_path, ".")
    lmJsonSetAt(lmJsonSet_result, lmJsonSet_segments, 0, lmJsonSet_value)
    return lmJsonSet_result
end
function lmJsonModule()
    return {encode: lmJsonEncode, decode: lmJsonDecode, pretty: lmJsonPretty, isValid: lmJsonIsValid, get: lmJsonGet, set: lmJsonSet}
end
function lmAllModules()
    return {string: lmStringModule(), json: lmJsonModule()}
end
$- ---------------------------------------------------------------------------
   Self-tests: native modules are oracles only below this point.
   --------------------------------------------------------------------------- -$
if os.env("EM_SELFTEST", "") == "1"
    import string
    import json
    function lmSelfEqual(lmSelfEqual_left, lmSelfEqual_right, lmSelfEqual_label)
        assert(lmSelfEqual_left == lmSelfEqual_right, "self-test failed: " + lmSelfEqual_label)
    end
    function lmSelfSameArray(lmSelfSameArray_left, lmSelfSameArray_right, lmSelfSameArray_label)
        if type(lmSelfSameArray_left) != "array" or type(lmSelfSameArray_right) != "array"
            assert(false, "self-test failed: " + lmSelfSameArray_label + " is not an array")
        end
        assert(len(lmSelfSameArray_left) == len(lmSelfSameArray_right), "self-test failed: " + lmSelfSameArray_label + " length")
        lmSelfSameArray_i = 0
        while lmSelfSameArray_i < len(lmSelfSameArray_left)
        lmSelfEqual(lmSelfSameArray_left[lmSelfSameArray_i], lmSelfSameArray_right[lmSelfSameArray_i], lmSelfSameArray_label + "[" + toString(lmSelfSameArray_i) + "]")
        lmSelfSameArray_i += 1
    end
end
lmSelfString = lmStringModule()
lmSelfJson = lmJsonModule()
lmSelfAll = lmAllModules()
lmSelfSameArray(keys(lmSelfAll), ["json", "string"], "lmAllModules keys")
assert(keys(lmSelfString).length() == 34, "self-test failed: string module key count")
assert(keys(lmSelfJson).length() == 6, "self-test failed: json module key count")
lmSelfTexts = ["", "hello", "  padded  ", "a-b-a", "héllo ☃", "日本語", "🙂🙃", "a\nb\tc", "a\nb\nc", "quote \" and \\ slash", "abababa", "ßİıǅ", "0123456789", "abcXYZ"]
lmSelfUnary = ["length", "upper", "lower", "trim", "reverse", "isDigit", "isAlpha", "isAlphanumeric", "isWhitespace", "isEmpty", "lines"]
for lmSelfText in lmSelfTexts
    for lmSelfName in lmSelfUnary
        lmSelfExpected = string.get(lmSelfName)(lmSelfText)
        lmSelfActual = lmSelfString.get(lmSelfName)(lmSelfText)
        if type(lmSelfExpected) == "array"
            lmSelfSameArray(lmSelfActual, lmSelfExpected, lmSelfName + " " + lmSelfText)
        else
            lmSelfEqual(lmSelfActual, lmSelfExpected, lmSelfName + " " + lmSelfText)
        end
    end
    lmSelfEqual(lmSelfString.replace(lmSelfText, "a", "Z"), string.replace(lmSelfText, "a", "Z"), "replace " + lmSelfText)
    lmSelfEqual(lmSelfString.replaceAll(lmSelfText, "a", "Z"), lmSelfText.replaceAll("a", "Z"), "replaceAll " + lmSelfText)
    lmSelfEqual(lmSelfString.capitalize(lmSelfText), lmSelfText.capitalize(), "capitalize " + lmSelfText)
    lmSelfEqual(lmSelfString.titleCase(lmSelfText), lmSelfText.titleCase(), "titleCase " + lmSelfText)
    lmSelfEqual(lmSelfString.swapCase(lmSelfText), lmSelfText.swapCase(), "swapCase " + lmSelfText)
    lmSelfEqual(lmSelfString.isBlank(lmSelfText), lmSelfText.isBlank(), "isBlank " + lmSelfText)
    lmSelfSameArray(lmSelfString.chars(lmSelfText), lmSelfText.chars(), "chars " + lmSelfText)
    for lmSelfNeedle in ["", "a", "é", "☃", "🙂", "aba", "zzz", lmSelfText]
        lmSelfEqual(lmSelfString.contains(lmSelfText, lmSelfNeedle), string.contains(lmSelfText, lmSelfNeedle), "contains " + lmSelfText)
        lmSelfEqual(lmSelfString.startsWith(lmSelfText, lmSelfNeedle), string.startsWith(lmSelfText, lmSelfNeedle), "startsWith " + lmSelfText)
        lmSelfEqual(lmSelfString.endsWith(lmSelfText, lmSelfNeedle), string.endsWith(lmSelfText, lmSelfNeedle), "endsWith " + lmSelfText)
        lmSelfEqual(lmSelfString.indexOf(lmSelfText, lmSelfNeedle), string.indexOf(lmSelfText, lmSelfNeedle), "indexOf " + lmSelfText)
        lmSelfEqual(lmSelfString.lastIndexOf(lmSelfText, lmSelfNeedle), string.lastIndexOf(lmSelfText, lmSelfNeedle), "lastIndexOf " + lmSelfText)
        lmSelfEqual(lmSelfString.slice(lmSelfText, 1, null), lmSelfText.slice(1), "slice open " + lmSelfText)
        lmSelfEqual(lmSelfString.slice(lmSelfText, -2, 3), lmSelfText.slice(-2, 3), "slice negative " + lmSelfText)
        lmSelfEqual(lmSelfString.slice(lmSelfText, 99, -99), lmSelfText.slice(99, -99), "slice clamped " + lmSelfText)
    end
    lmSelfEqual(lmSelfString.truncate(lmSelfText, 4, ".."), lmSelfText.truncate(4, ".."), "truncate " + lmSelfText)
    lmSelfEqual(lmSelfString.truncate(lmSelfText, 6, null), lmSelfText.truncate(6), "truncate default " + lmSelfText)
    lmSelfEqual(lmSelfString.padLeft(lmSelfText, 12, "ab"), lmSelfText.padLeft(12, "ab"), "padLeft " + lmSelfText)
    lmSelfEqual(lmSelfString.padRight(lmSelfText, 12, "ab"), lmSelfText.padRight(12, "ab"), "padRight " + lmSelfText)
    lmSelfEqual(lmSelfString.pad(lmSelfText, 10, "*x", "left"), string.pad(lmSelfText, 10, "*x", "left"), "pad left " + lmSelfText)
    lmSelfEqual(lmSelfString.pad(lmSelfText, 10, "*x", "right"), string.pad(lmSelfText, 10, "*x", "right"), "pad right " + lmSelfText)
    lmSelfEqual(lmSelfString.pad(lmSelfText, 11, "*x", "center"), string.pad(lmSelfText, 11, "*x", "center"), "pad center " + lmSelfText)
    lmSelfEqual(lmSelfString.pad(lmSelfText, 11, "*x", "both"), string.pad(lmSelfText, 11, "*x", "both"), "pad both " + lmSelfText)
    lmSelfEqual(lmSelfString.repeat(lmSelfText, 3), string.repeat(lmSelfText, 3), "repeat " + lmSelfText)
    lmSelfSameArray(lmSelfString.split(lmSelfText, "a"), string.split(lmSelfText, "a"), "split " + lmSelfText)
    lmSelfSameArray(lmSelfString.split(lmSelfText, null), string.split(lmSelfText), "split default " + lmSelfText)
    lmSelfEqual(lmSelfString.substring(lmSelfText, 0, len(lmSelfText)), string.substring(lmSelfText, 0), "substring full " + lmSelfText)
    if len(lmSelfText) > 1
        lmSelfEqual(lmSelfString.substring(lmSelfText, 0, 1), string.substring(lmSelfText, 0, 1), "substring short " + lmSelfText)
    end
    if len(lmSelfText) > 0
        lmSelfEqual(lmSelfString.charAt(lmSelfText, 0), string.charAt(lmSelfText, 0), "charAt " + lmSelfText)
    end
end
lmSelfJoined = ["a", "b", 3, true, null]
lmSelfEqual(lmSelfString.join(lmSelfJoined, "-"), string.join(lmSelfJoined, "-"), "join")
lmSelfEqual(lmSelfString.join(lmSelfJoined, null), string.join(lmSelfJoined), "join default")
lmSelfNumbers = ["", " 42 ", "-3.5", "+7", ".5", "1.", "1e3", "2.5E-2", "NaN", "inf", "abc", "\t12\n", "1e400", "0x10"]
for lmSelfNumberText in lmSelfNumbers
    lmSelfEqual(lmSelfString.toNumber(lmSelfNumberText), lmSelfNumberText.toNumber(), "toNumber " + lmSelfNumberText)
end
lmSelfJsonValues = [null, true, false, 0, -1, 2.5, 0.0000001, 12345678901234, "", "plain", "quote \" slash \\ newline \n tab \t back  form  snowman ☃ emoji 🙂", [], [1, "two", false, null], [[1, 2], {b: 2, a: [true, null]}], {z: 1, a: {y: "yes", x: [3, 4]}, m: null}]
for lmSelfJsonValue in lmSelfJsonValues
    lmSelfEqual(lmSelfJson.encode(lmSelfJsonValue), json.encode(lmSelfJsonValue), "json.encode " + toString(lmSelfJsonValue))
    lmSelfEqual(lmSelfJson.pretty(lmSelfJsonValue), json.pretty(lmSelfJsonValue), "json.pretty " + toString(lmSelfJsonValue))
    lmSelfEqual(lmSelfJson.encode(lmSelfJson.decode(json.encode(lmSelfJsonValue))), json.encode(lmSelfJsonValue), "json round trip " + toString(lmSelfJsonValue))
end
lmSelfJsonTexts = ["null", "true", "false", "0", "-12.5e2", "\"\"", "\"a\\\"b\\\\c\\n\\r\\t\\b\\f\\/d\"", "\"\\u2603 \\uD83D\\uDE00\"", "[]", "\{\}", "[1, 2, \{\"a\": [3, null]\}]", " \{ \"a\" : 1 , \"b\" : [true, false] \} ", "\{\"a\":1,\"a\":2\}"]
for lmSelfJsonText in lmSelfJsonTexts
    lmSelfEqual(lmSelfJson.encode(lmSelfJson.decode(lmSelfJsonText)), json.encode(json.decode(lmSelfJsonText)), "json.decode " + lmSelfJsonText)
    lmSelfEqual(lmSelfJson.isValid(lmSelfJsonText), json.isValid(lmSelfJsonText), "json.isValid " + lmSelfJsonText)
end
lmSelfEqual(lmSelfJson.decode("1e400"), json.decode("1e400"), "json.decode huge number")
lmSelfBadJson = ["", "\{", "[1,]", "\{\"a\" 1\}", "01", "tru", "[1] extra", "'x'", "\"\\uD800\"", "\"\\u00ZZ\"", "\"ab\"", "1.", "+1", "[1 2]"]
for lmSelfBadText in lmSelfBadJson
    lmSelfEqual(lmSelfJson.isValid(lmSelfBadText), json.isValid(lmSelfBadText), "json.isValid bad " + lmSelfBadText)
end
lmSelfPathValue = json.decode("\{\"user\":\{\"name\":\"Ada\",\"age\":36\},\"items\":[10,20],\"flag\":true,\"nil\":null\}")
lmSelfPurePathValue = lmSelfJson.decode("\{\"user\":\{\"name\":\"Ada\",\"age\":36\},\"items\":[10,20],\"flag\":true,\"nil\":null\}")
for lmSelfPath in ["", "user", "user.name", "user.age", "items.0", "items.1", "flag", "nil", "missing.path", "items.9", "name.first"]
    lmSelfEqual(lmSelfJson.encode(lmSelfJson.get(lmSelfPurePathValue, lmSelfPath)), json.encode(json.get(lmSelfPathValue, lmSelfPath)), "json.get " + lmSelfPath)
end
lmSelfSetCases = [[{user: {name: "Ada"}}, "user.age", 36], [null, "a.b", true], [[1, 2], "1", 9], [[1, 2], "2", 3], [{}, "a.0.b", "deep"]]
for lmSelfCase in lmSelfSetCases
    lmSelfPureRoot = lmSelfCase[0]
    lmSelfNativeRoot = json.decode(json.encode(lmSelfCase[0]))
    lmSelfPureSet = lmSelfJson.set(lmSelfPureRoot, lmSelfCase[1], lmSelfCase[2])
    lmSelfNativeSet = json.set(lmSelfNativeRoot, lmSelfCase[1], lmSelfCase[2])
    lmSelfEqual(lmSelfJson.encode(lmSelfPureSet), json.encode(lmSelfNativeSet), "json.set " + lmSelfCase[1])
end
say("ok")
end
