$- Pure Englishmen implementation of the native `bytes` module.

   A buffer is an ordinary array of whole numbers from 0 to 255. Every
   conversion packs into a fresh array; `btSet` is the one mutating helper
   and returns the same buffer it was given. All helpers are prefixed with
   `bt` so this file can be concatenated with the other self-hosted pieces.

   The native `bytes` module is imported only inside the self-test guard at
   the bottom, where it acts as a reference oracle. It is not used by any
   function above that guard; the guard itself uses the `env` builtin instead
   of importing `os`.

   Englishmen functions have fixed arity, so the two variadic native helpers
   have array-shaped equivalents here:
     - btOf(values) accepts a single number or an array of numbers.
     - btConcat(buffers) accepts an array of buffers.
   btSlice(buffer, start, end) uses `null` for `end` to mean "to the end",
   matching a native call that omits the third argument.
-$
$- ---------------------------------------------------------------------------
   Argument validation
   --------------------------------------------------------------------------- -$
function btIsNumber(btValue_arg)
    return type(btValue_arg) == "number"
end
function btIsFiniteNumber(btValue_arg)
    if not btIsNumber(btValue_arg)
        return false
    end
    if isNaN(btValue_arg)
        return false
    end
    return btValue_arg <=  and btValue_arg >= -
end
function btIsWhole(btValue_arg)
    if not btIsFiniteNumber(btValue_arg)
        return false
    end
    return btValue_arg == floor(btValue_arg)
end
function btAssertWhole(btValue_arg, btContext_arg)
    assert(btIsWhole(btValue_arg), "Expected a whole number " + btContext_arg)
end
function btByte(btValue_arg, btContext_arg)
    btAssertWhole(btValue_arg, btContext_arg)
    assert(btValue_arg >= 0 and btValue_arg <= 255, "Expected a byte from 0 to 255 " + btContext_arg)
    return btValue_arg
end
function btBuffer(btBuffer_arg, btContext_arg)
    assert(type(btBuffer_arg) == "array", "Expected a byte buffer " + btContext_arg)
    btBuffer_i = 0
    while btBuffer_i < len(btBuffer_arg)
    btByte(btBuffer_arg[btBuffer_i], "at index " + toString(btBuffer_i) + " " + btContext_arg)
    btBuffer_i += 1
end
return btBuffer_arg
end
function btExactIndex(btLength_arg, btIndex_arg, btContext_arg)
    btAssertWhole(btIndex_arg, btContext_arg)
    btResolved = btIndex_arg
    if btIndex_arg < 0
        btResolved = btLength_arg + btIndex_arg
    end
    assert(btResolved >= 0 and btResolved < btLength_arg, "Index " + toString(btIndex_arg) + " is outside a buffer of " + toString(btLength_arg) + " bytes")
    return btResolved
end
function btSliceIndex(btLength_arg, btIndex_arg, btContext_arg)
    btAssertWhole(btIndex_arg, btContext_arg)
    if btIndex_arg < 0
        btResolved = btLength_arg + btIndex_arg
        if btResolved < 0
            return 0
        end
        return btResolved
    end
    if btIndex_arg > btLength_arg
        return btLength_arg
    end
    return btIndex_arg
end
$- ---------------------------------------------------------------------------
   Text conversion
   --------------------------------------------------------------------------- -$
function btFromString(btText_arg)
    assert(type(btText_arg) == "string", "btFromString expects a string")
    btOut = []
    btIndex = 0
    while btIndex < len(btText_arg)
    btCode = charCode(btText_arg[btIndex])
    if btCode <= 127
        btOut.add(btCode)
    else if btCode <= 2047
        btOut.add(192 | ((btCode >> 6) & 31))
        btOut.add(128 | (btCode & 63))
    else if btCode <= 65535
        btOut.add(224 | ((btCode >> 12) & 15))
        btOut.add(128 | ((btCode >> 6) & 63))
        btOut.add(128 | (btCode & 63))
    else
        btOut.add(240 | ((btCode >> 18) & 7))
        btOut.add(128 | ((btCode >> 12) & 63))
        btOut.add(128 | ((btCode >> 6) & 63))
        btOut.add(128 | (btCode & 63))
    end
    btIndex += 1
end
return btOut
end
function btUtf8Continuation(btByte_arg)
    return btByte_arg >= 128 and btByte_arg <= 191
end
function btToString(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btToString")
    btOut = ""
    btSize = len(btBuffer_arg)
    btIndex = 0
    while btIndex < btSize
    btLead = btBuffer_arg[btIndex]
    if btLead < 128
        btOut += fromCharCode(btLead)
    else if btLead >= 194 and btLead <= 223
        assert(btIndex + 1 < btSize, "Truncated UTF-8 sequence for btToString")
        btNext = btBuffer_arg[btIndex + 1]
        assert(btUtf8Continuation(btNext), "Invalid UTF-8 continuation byte for btToString")
        btCode = ((btLead & 31) << 6) | (btNext & 63)
        assert(btCode >= 128, "Overlong UTF-8 sequence for btToString")
        btOut += fromCharCode(btCode)
        btIndex += 1
    else if btLead >= 224 and btLead <= 239
        assert(btIndex + 2 < btSize, "Truncated UTF-8 sequence for btToString")
        btNext = btBuffer_arg[btIndex + 1]
        btLast = btBuffer_arg[btIndex + 2]
        assert(btUtf8Continuation(btNext) and btUtf8Continuation(btLast), "Invalid UTF-8 continuation byte for btToString")
        if btLead == 224
            assert(btNext >= 160, "Overlong UTF-8 sequence for btToString")
        end
        if btLead == 237
            assert(btNext <= 159, "UTF-8 surrogate is not a scalar value for btToString")
        end
        btCode = ((btLead & 15) << 12) | ((btNext & 63) << 6) | (btLast & 63)
        assert(btCode >= 2048 and not (btCode >= 55296 and btCode <= 57343), "Invalid UTF-8 code point for btToString")
        btOut += fromCharCode(btCode)
        btIndex += 2
    else if btLead >= 240 and btLead <= 244
        assert(btIndex + 3 < btSize, "Truncated UTF-8 sequence for btToString")
        btNext = btBuffer_arg[btIndex + 1]
        btSecond = btBuffer_arg[btIndex + 2]
        btLast = btBuffer_arg[btIndex + 3]
        assert(btUtf8Continuation(btNext) and btUtf8Continuation(btSecond) and btUtf8Continuation(btLast), "Invalid UTF-8 continuation byte for btToString")
        if btLead == 240
            assert(btNext >= 144, "Overlong UTF-8 sequence for btToString")
        end
        if btLead == 244
            assert(btNext <= 143, "UTF-8 code point above U+10FFFF for btToString")
        end
        btCode = ((btLead & 7) << 18) | ((btNext & 63) << 12) | ((btSecond & 63) << 6) | (btLast & 63)
        assert(btCode >= 65536 and btCode <= 1114111, "Invalid UTF-8 code point for btToString")
        btOut += fromCharCode(btCode)
        btIndex += 3
    else
        assert(false, "Invalid UTF-8 lead byte for btToString")
    end
    btIndex += 1
end
return btOut
end
$- ---------------------------------------------------------------------------
   Buffers, indexing and slicing
   --------------------------------------------------------------------------- -$
function btOf(btValues_arg)
    if type(btValues_arg) == "number"
        return [btByte(btValues_arg, "as a byte for btOf")]
    end
    assert(type(btValues_arg) == "array", "btOf expects a number or an array of numbers")
    btOut = []
    btIndex = 0
    while btIndex < len(btValues_arg)
    btOut.add(btByte(btValues_arg[btIndex], "as byte " + toString(btIndex + 1) + " for btOf"))
    btIndex += 1
end
return btOut
end
function btLength(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btLength")
    return len(btBuffer_arg)
end
function btGet(btBuffer_arg, btIndex_arg)
    btBuffer(btBuffer_arg, "for btGet")
    btResolved = btExactIndex(len(btBuffer_arg), btIndex_arg, "as the index for btGet")
    return btBuffer_arg[btResolved]
end
function btSet(btBuffer_arg, btIndex_arg, btValue_arg)
$- Validate the whole buffer before changing any of it, like the native module. -$
    btBuffer(btBuffer_arg, "for btSet")
    btResolved = btExactIndex(len(btBuffer_arg), btIndex_arg, "as the index for btSet")
    btByte(btValue_arg, "as the byte for btSet")
    btBuffer_arg[btResolved] = btValue_arg
    return btBuffer_arg
end
function btConcat(btBuffers_arg)
    assert(type(btBuffers_arg) == "array", "btConcat expects an array of buffers")
    btOut = []
    btIndex = 0
    while btIndex < len(btBuffers_arg)
    btPart = btBuffer(btBuffers_arg[btIndex], "as buffer " + toString(btIndex + 1) + " for btConcat")
    btInner = 0
    while btInner < len(btPart)
    btOut.add(btPart[btInner])
    btInner += 1
end
btIndex += 1
end
return btOut
end
function btSlice(btBuffer_arg, btStart_arg, btEnd_arg)
    btBuffer(btBuffer_arg, "for btSlice")
    if btEnd_arg == null
        btStop = len(btBuffer_arg)
    else
        btStop = btEnd_arg
    end
    btFrom = btSliceIndex(len(btBuffer_arg), btStart_arg, "as the start index for btSlice")
    btTo = btSliceIndex(len(btBuffer_arg), btStop, "as the end index for btSlice")
    btOut = []
    btIndex = btFrom
    while btIndex < btTo
    btOut.add(btBuffer_arg[btIndex])
    btIndex += 1
end
return btOut
end
function btCopy(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btCopy")
    btOut = []
    btIndex = 0
    while btIndex < len(btBuffer_arg)
    btOut.add(btBuffer_arg[btIndex])
    btIndex += 1
end
return btOut
end
$- ---------------------------------------------------------------------------
   Hex conversion
   --------------------------------------------------------------------------- -$
function btHexDigit(btChar_arg)
    btCode = charCode(btChar_arg)
    if btCode >= 48 and btCode <= 57
        return btCode - 48
    end
    if btCode >= 97 and btCode <= 102
        return btCode - 87
    end
    if btCode >= 65 and btCode <= 70
        return btCode - 55
    end
    return -1
end
function btIsAsciiWhitespace(btCode_arg)
    return btCode_arg == 9 or btCode_arg == 10 or btCode_arg == 11 or btCode_arg == 12 or btCode_arg == 13 or btCode_arg == 32
end
function btFromHex(btText_arg)
    assert(type(btText_arg) == "string", "btFromHex expects hex text")
    btCompact = ""
    btIndex = 0
    while btIndex < len(btText_arg)
    btChar = btText_arg[btIndex]
    if not btIsAsciiWhitespace(charCode(btChar))
        btCompact += btChar
    end
    btIndex += 1
end
assert(len(btCompact) % 2 == 0, "btFromHex expects an even number of hex digits")
btOut = []
btIndex = 0
while btIndex < len(btCompact)
btHigh = btHexDigit(btCompact[btIndex])
btLow = btHexDigit(btCompact[btIndex + 1])
assert(btHigh >= 0 and btLow >= 0, "Invalid hex byte for btFromHex")
btOut.add(btHigh * 16 + btLow)
btIndex += 2
end
return btOut
end
function btHexPair(btByte_arg)
    btDigits = "0123456789abcdef"
    return btDigits[floor(btByte_arg / 16)] + btDigits[btByte_arg % 16]
end
function btToHex(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btToHex")
    btParts = []
    btIndex = 0
    while btIndex < len(btBuffer_arg)
    btParts.add(btHexPair(btBuffer_arg[btIndex]))
    btIndex += 1
end
return join(btParts, " ")
end
$- ---------------------------------------------------------------------------
   Little-endian integer packing
   --------------------------------------------------------------------------- -$
function btLeBytes(btValue_arg, btCount_arg)
    btOut = []
    btIndex = 0
    while btIndex < btCount_arg
    btOut.add(btValue_arg % 256)
    btValue_arg = floor(btValue_arg / 256)
    btIndex += 1
end
return btOut
end
function btUnsignedArg(btValue_arg, btUpper_arg, btName_arg, btMaxLabel_arg)
    btAssertWhole(btValue_arg, "as the number for " + btName_arg)
    assert(btValue_arg >= 0 and btValue_arg < btUpper_arg, btName_arg + " expects a whole number from 0 to " + btMaxLabel_arg)
    return btValue_arg
end
function btSignedLeBytes(btValue_arg, btCount_arg)
    btOut = []
    btIndex = 0
    while btIndex < btCount_arg
    btOut.add(btValue_arg & 255)
    btValue_arg = btValue_arg >> 8
    btIndex += 1
end
return btOut
end
function btSignedArg(btValue_arg, btLower_arg, btUpper_arg, btName_arg, btMinLabel_arg, btMaxLabel_arg)
    btAssertWhole(btValue_arg, "as the number for " + btName_arg)
    assert(btValue_arg >= btLower_arg and btValue_arg < btUpper_arg, btName_arg + " expects a whole number from " + btMinLabel_arg + " to " + btMaxLabel_arg)
    return btValue_arg
end
function btU8(btValue_arg)
    return btLeBytes(btUnsignedArg(btValue_arg, 256, "btU8", "255"), 1)
end
function btU16(btValue_arg)
    return btLeBytes(btUnsignedArg(btValue_arg, 65536, "btU16", "65535"), 2)
end
function btU32(btValue_arg)
    return btLeBytes(btUnsignedArg(btValue_arg, 4294967296, "btU32", "4294967295"), 4)
end
function btU64(btValue_arg)
$- 2^64 is exactly representable as an f64 and keeps an out-of-range input from becoming u64::MAX. -$
    return btLeBytes(btUnsignedArg(btValue_arg, pow(2, 64), "btU64", "18446744073709551615"), 8)
end
function btI16(btValue_arg)
    return btSignedLeBytes(btSignedArg(btValue_arg, -32768, 32768, "btI16", "-32768", "32767"), 2)
end
function btI32(btValue_arg)
    return btSignedLeBytes(btSignedArg(btValue_arg, -2147483648, 2147483648, "btI32", "-2147483648", "2147483647"), 4)
end
function btI64(btValue_arg)
    return btSignedLeBytes(btSignedArg(btValue_arg, -9223372036854776000, 9223372036854776000, "btI64", "-9223372036854775808", "9223372036854775807"), 8)
end
$- ---------------------------------------------------------------------------
   IEEE-754 binary64 packing and unpacking
   --------------------------------------------------------------------------- -$
function btSetBit(btBytes_arg, btIndex_arg, btBit_arg)
    btByteIndex = floor(btIndex_arg / 8)
    btBitIndex = btIndex_arg % 8
    btBytes_arg[btByteIndex] = btBytes_arg[btByteIndex] + (btBit_arg << btBitIndex)
end
function btPutBits(btBytes_arg, btValue_arg, btStart_arg, btCount_arg)
    btIndex = 0
    while btIndex < btCount_arg
    btBit = floor(btValue_arg / pow(2, btIndex)) % 2
    btSetBit(btBytes_arg, btStart_arg + btIndex, btBit)
    btIndex += 1
end
end
function btBitAt(btBytes_arg, btIndex_arg)
    btByteIndex = floor(btIndex_arg / 8)
    btBitIndex = btIndex_arg % 8
    return floor(btBytes_arg[btByteIndex] / pow(2, btBitIndex)) % 2
end
function btF64Bits(btValue_arg)
    btNegative = btValue_arg < 0
    if btValue_arg == 0 and pow(btValue_arg, -1) < 0
        btNegative = true
    end
    btBytes = [0, 0, 0, 0, 0, 0, 0, 0]
    if isNaN(btValue_arg)
$- Englishmen arithmetic produces a negative quiet NaN; keep its sign bit. -$
        btNegative = true
        btExponent = 2047
        btMantissa = pow(2, 51)
    else if btValue_arg >  or btValue_arg < -
        btExponent = 2047
        btMantissa = 0
    else if btValue_arg == 0
        btExponent = 0
        btMantissa = 0
    else
        btMagnitude = abs(btValue_arg)
        btScale = btMagnitude
        btExponentCount = 0
        while btScale >= 2
        btScale = btScale / 2
        btExponentCount += 1
    end
    while btScale < 1
    btScale = btScale * 2
    btExponentCount -= 1
end
if btExponentCount >= -1022
    btExponent = btExponentCount + 1023
    btMantissa = floor((btScale - 1) * pow(2, 52))
else
$- Subnormals have no implicit leading 1: divide by the smallest double. -$
    btExponent = 0
    btMantissa = floor(btMagnitude / pow(2, -1074))
end
end
if btNegative
    btSetBit(btBytes, 63, 1)
end
btPutBits(btBytes, btExponent, 52, 11)
btPutBits(btBytes, btMantissa, 0, 52)
return btBytes
end
function btF64(btValue_arg)
    assert(btIsNumber(btValue_arg), "btF64 expects a number")
    return btF64Bits(btValue_arg)
end
function btReadU16(btBuffer_arg, btOffset_arg)
    btBuffer(btBuffer_arg, "for btReadU16")
    btAssertWhole(btOffset_arg, "as the offset for btReadU16")
    assert(btOffset_arg >= 0 and btOffset_arg + 2 <= len(btBuffer_arg), "btReadU16 needs two bytes inside the buffer")
    return btBuffer_arg[btOffset_arg] + btBuffer_arg[btOffset_arg + 1] * 256
end
function btReadU32(btBuffer_arg, btOffset_arg)
    btBuffer(btBuffer_arg, "for btReadU32")
    btAssertWhole(btOffset_arg, "as the offset for btReadU32")
    assert(btOffset_arg >= 0 and btOffset_arg + 4 <= len(btBuffer_arg), "btReadU32 needs four bytes inside the buffer")
    return btBuffer_arg[btOffset_arg] + btBuffer_arg[btOffset_arg + 1] * 256 + btBuffer_arg[btOffset_arg + 2] * 65536 + btBuffer_arg[btOffset_arg + 3] * 16777216
end
function btReadF64(btBuffer_arg, btOffset_arg)
    btBuffer(btBuffer_arg, "for btReadF64")
    btAssertWhole(btOffset_arg, "as the offset for btReadF64")
    assert(btOffset_arg >= 0 and btOffset_arg + 8 <= len(btBuffer_arg), "btReadF64 needs eight bytes inside the buffer")
    btExponent = 0
    btBit = 0
    while btBit < 11
    btExponent += btBitAt(btBuffer_arg, btOffset_arg * 8 + 52 + btBit) * pow(2, btBit)
    btBit += 1
end
btMantissa = 0
btBit = 0
while btBit < 52
btMantissa += btBitAt(btBuffer_arg, btOffset_arg * 8 + btBit) * pow(2, btBit)
btBit += 1
end
if btExponent == 2047
    if btMantissa == 0
        btValue = pow(2, 1024)
    else
        btValue = pow(-1, 0.5)
    end
else if btExponent == 0
    btValue = btMantissa * pow(2, -1074)
else
    btValue = pow(2, btExponent - 1023) * (1 + btMantissa / pow(2, 52))
end
if btBitAt(btBuffer_arg, btOffset_arg * 8 + 63) == 1
    btValue = -btValue
end
return btValue
end
$- ---------------------------------------------------------------------------
   Self-tests: the native bytes module is an oracle only inside this guard.
   --------------------------------------------------------------------------- -$
if env("EM_SELFTEST") == "1"
    import bytes
    function btSameBuffer(btLeft_arg, btRight_arg)
        if type(btLeft_arg) != "array" or type(btRight_arg) != "array"
            return false
        end
        if len(btLeft_arg) != len(btRight_arg)
            return false
        end
        btIndex = 0
        while btIndex < len(btLeft_arg)
        if btLeft_arg[btIndex] != btRight_arg[btIndex]
            return false
        end
        btIndex += 1
    end
    return true
end
function btCheck(btActual_arg, btExpected_arg, btLabel_arg)
    assert(btSameBuffer(btActual_arg, btExpected_arg), "self-test failed: " + btLabel_arg)
end
btTexts = ["", "hi", "héllo ☃", "日本語", "🙂", "a\nb\tc", "ÿ", "aé🙂z"]
for btText in btTexts
    btCheck(btFromString(btText), bytes.fromString(btText), "btFromString " + btText)
    assert(btToString(btFromString(btText)) == btText, "btToString round-trip " + btText)
    assert(btToString(bytes.fromString(btText)) == btText, "btToString oracle " + btText)
end
btCheck(btOf([]), bytes.of(), "btOf empty")
btCheck(btOf(7), bytes.of(7), "btOf single")
btCheck(btOf([0, 1, 127, 128, 255]), bytes.of(0, 1, 127, 128, 255), "btOf many")
btSample = bytes.of(1, 2, 3, 4, 5, 255, 0)
assert(btLength(btSample) == bytes.length(btSample), "btLength")
assert(btLength([]) == bytes.length([]), "btLength empty")
for btIndex in [-7, -6, -3, -1, 0, 1, 3, 6]
    assert(btGet(btSample, btIndex) == bytes.get(btSample, btIndex), "btGet " + toString(btIndex))
end
btMutable = bytes.copy(btSample)
btReturned = btSet(btMutable, -2, 99)
assert(btReturned == btMutable, "btSet returns the same buffer")
assert(btSameBuffer(btMutable, bytes.set(bytes.copy(btSample), -2, 99)), "btSet contents")
btCheck(btConcat([]), bytes.concat(), "btConcat empty")
btCheck(btConcat([btSample]), bytes.concat(btSample), "btConcat one")
btCheck(btConcat([bytes.of(1, 2), bytes.of(3), bytes.of(4, 5)]), bytes.concat(bytes.of(1, 2), bytes.of(3), bytes.of(4, 5)), "btConcat many")
btBounds = [[0, null], [1, null], [-2, null], [99, null], [-99, null], [0, 0], [1, 3], [0, -1], [-2, -1], [3, 1], [-99, 4], [0, 99], [-99, 99]]
for btBound in btBounds
    btStart = btBound[0]
    btStop = btBound[1]
    if btStop == null
        btCheck(btSlice(btSample, btStart, null), bytes.slice(btSample, btStart), "btSlice open " + toString(btStart))
    else
        btCheck(btSlice(btSample, btStart, btStop), bytes.slice(btSample, btStart, btStop), "btSlice closed")
    end
end
btClone = btCopy(btSample)
btCheck(btClone, bytes.copy(btSample), "btCopy contents")
btSet(btClone, 0, 42)
assert(btGet(btClone, 0) == 42 and btGet(btSample, 0) == 1, "btCopy independence")
btHexTexts = ["", "aabbcc", "aa bb cc", "AA\tBB\nCC", "a ab bcc", "0a0b0c", "00 ff 7f 80", "de ad be ef", "1 2 3 4"]
for btHexText in btHexTexts
    btCheck(btFromHex(btHexText), bytes.fromHex(btHexText), "btFromHex " + btHexText)
end
btHexBuffers = [[], [0], [0, 15, 255], bytes.fromHex("00 0a 7f 80 fe ff")]
for btHexBuffer in btHexBuffers
    assert(btToHex(btHexBuffer) == bytes.toHex(btHexBuffer), "btToHex")
end
for btValue in [0, 1, 127, 255]
    btCheck(btU8(btValue), bytes.u8(btValue), "btU8")
end
for btValue in [0, 1, 255, 4660, 65535]
    btCheck(btU16(btValue), bytes.u16(btValue), "btU16")
end
for btValue in [0, 1, 65535, 305419896, 4294967295]
    btCheck(btU32(btValue), bytes.u32(btValue), "btU32")
end
for btValue in [0, 1, 255, 4294967295, 9223372036854776000, pow(2, 64) - 2048]
    btCheck(btU64(btValue), bytes.u64(btValue), "btU64")
end
for btValue in [-32768, -258, -2, -1, 0, 1, 32767]
    btCheck(btI16(btValue), bytes.i16(btValue), "btI16")
end
for btValue in [-2147483648, -65537, -2, 0, 2147483647]
    btCheck(btI32(btValue), bytes.i32(btValue), "btI32")
end
for btValue in [-9223372036854776000, -4294967297, -2, 0, 9223372036854775000]
    btCheck(btI64(btValue), bytes.i64(btValue), "btI64")
end
btFloats = [0, 1, -1, 0.5, -2.5, 1.5, 3.141592653589793, 0., , 0., 0., pow(2, 1024), -pow(2, 1024)]
btZero = 0
btNegativeZero = btZero * -1
btFloats.add(btNegativeZero)
for btValue in btFloats
    btCheck(btF64(btValue), bytes.f64(btValue), "btF64 " + toString(btValue))
end
btQuietNaN = pow(-1, 0.5)
btCheck(btF64(btQuietNaN), bytes.f64(btQuietNaN), "btF64 NaN")
for btValue in [0, 1, 255, 4660, 65535]
    assert(btReadU16(bytes.u16(btValue), 0) == btValue, "btReadU16")
end
for btValue in [0, 1, 65535, 305419896, 4294967295]
    assert(btReadU32(bytes.u32(btValue), 0) == btValue, "btReadU32")
end
for btValue in btFloats
    btPacked = bytes.f64(btValue)
    assert(btSameBuffer(btF64(btReadF64(btPacked, 0)), btPacked), "btReadF64 " + toString(btValue))
end
btWithPrefix = bytes.concat(bytes.of(9, 8, 7), bytes.u16(4660), bytes.u32(305419896), bytes.f64(-2.5))
assert(btReadU16(btWithPrefix, 3) == 4660, "btReadU16 offset")
assert(btReadU32(btWithPrefix, 5) == 305419896, "btReadU32 offset")
assert(btReadF64(btWithPrefix, 9) == -2.5, "btReadF64 offset")
say("ok")
end
