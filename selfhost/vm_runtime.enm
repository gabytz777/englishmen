$-!
    selfhost/vm_runtime.enm

    A self-hosted Englishmen VM runtime. It executes the EMB IR object shape
    described in docs/selfhost/EMB_AND_MANIFEST.md and collects `Say` output in
    an array instead of printing it, so a caller can compare the result with the
    native VM. Englishmen has no local .enm imports, so all helpers are global
    and prefixed with `rt` to make this file safe to inline into full.enm.

    CLI:  em run selfhost/vm_runtime.enm <ir.json>
          prints jsonEncode(outputArray)
    Test: EM_SELFTEST=1 em run selfhost/vm_runtime.enm   prints ok
!-$
import fs
import os
$- One VM at a time; every helper reaches the mutable state through rtVm. -$
rtVm = null
function rtError(message)
    assert(false, "ENM VM: " + message)
end
function rtArg(args, index, fallback)
    if index >= 0 and index < len(args)
        return args[index]
    end
    return fallback
end
function rtTypeName(value)
    if isObject(value)
        kind = value.get("rtKind", "")
        if kind == "closure" or kind == "native"
            return "function"
        end
    end
    return type(value)
end
function rtDebugDisplay(value)
    if isString(value)
        return "\"" + value + "\""
    end
    return rtDisplay(value)
end
function rtDisplay(value)
    if isNull(value)
        return "null"
    end
    if isBool(value)
        if value
            return "true"
        end
        return "false"
    end
    if isNumber(value)
        return toString(value)
    end
    if isString(value)
        return value
    end
    if isObject(value)
        kind = value.get("rtKind", "")
        if kind == "closure"
            return "<function " + value.get("rtProto", {}).get("name", "?") + ">"
        end
        if kind == "native"
            return "<native function " + value.get("rtName", "?") + ">"
        end
        parts = []
        for key in keys(value)
            parts.add(key + ": " + rtDebugDisplay(value.get(key, null)))
        end
        return "\{" + join(parts, ", ") + "\}"
    end
    if isArray(value)
        parts = []
        for item in value
            parts.add(rtDebugDisplay(item))
        end
        return "[" + join(parts, ", ") + "]"
    end
    return "<function ?>"
end
function rtTruthy(value)
    if isBool(value)
        return value
    end
    if isNull(value)
        return false
    end
    if isNumber(value)
        return value != 0
    end
    if isString(value)
        return value != ""
    end
    if isArray(value)
        return len(value) > 0
    end
    return true
end
function rtEquals(left, right)
    return left == right
end
function rtExpectNumber(value, context)
    if not isNumber(value)
        rtError("Type mismatch: expected a number " + context + ", found " + rtTypeName(value))
    end
    return value
end
function rtExpectString(value, context)
    if not isString(value)
        rtError("Type mismatch: expected a string " + context + ", found " + rtTypeName(value))
    end
    return value
end
function rtTrunc(value)
    n = rtExpectNumber(value, "as a whole number")
    if n >= 0
        return floor(n)
    end
    return ceil(n)
end
function rtClampIndex(length, raw)
    n = rtExpectNumber(raw, "as an index")
    if isNaN(n)
        if n < 0
            return 0
        end
        return length
    end
    if n < 0
        index = length + n
        if index < 0
            return 0
        end
        return index
    end
    if n > length
        return length
    end
    return n
end
function rtExactIndex(length, raw)
    n = rtExpectNumber(raw, "as an index")
    if isNaN(n) or n % 1 != 0
        return -1
    end
    if n < 0
        index = length + n
        if index < 0
            return -1
        end
        return index
    end
    if n >= length
        return -1
    end
    return n
end
function rtSliceRange(length, start, finish)
    from = rtClampIndex(length, start)
    to = rtClampIndex(length, finish)
    if to < from
        return [from, from]
    end
    return [from, to]
end
function rtArrayCopy(array)
    out = []
    for item in array
        out.add(item)
    end
    return out
end
function rtArrayReplace(array, items)
    while len(array) > 0
    array.pop()
end
for item in items
    array.add(item)
end
return array
end
function rtArrayInsert(array, index, value)
    out = []
    at = rtClampIndex(len(array), index)
    i = 0
    while i < at
    out.add(array[i])
    i += 1
end
out.add(value)
while i < len(array)
out.add(array[i])
i += 1
end
return rtArrayReplace(array, out)
end
function rtArrayRemoveAt(array, index)
    at = rtTrunc(index)
    if at < 0 or at >= len(array)
        return false
    end
    out = []
    i = 0
    while i < len(array)
    if i != at
        out.add(array[i])
    end
    i += 1
end
rtArrayReplace(array, out)
return true
end
function rtArraySlice(array, from, to)
    out = []
    i = from
    while i < to and i < len(array)
    out.add(array[i])
    i += 1
end
return out
end
function rtCompareValues(left, right, numeric)
    if numeric and isNumber(left) and isNumber(right)
        if left < right
            return -1
        end
        if left > right
            return 1
        end
        return 0
    end
    leftText = rtDisplay(left)
    rightText = rtDisplay(right)
    if leftText < rightText
        return -1
    end
    if leftText > rightText
        return 1
    end
    return 0
end
function rtArraySort(array)
    numeric = true
    for item in array
        if not isNumber(item)
            numeric = false
        end
    end
    items = rtArrayCopy(array)
    i = 1
    while i < len(items)
    key = items[i]
    j = i - 1
    while j >= 0 and rtCompareValues(items[j], key, numeric) > 0
    items[j + 1] = items[j]
    j -= 1
end
items[j + 1] = key
i += 1
end
return rtArrayReplace(array, items)
end
function rtObjectKeys(object)
    if not isObject(object)
        rtError("expected an object, found " + rtTypeName(object))
    end
    return keys(object)
end
function rtObjectValues(object)
    out = []
    for key in rtObjectKeys(object)
        out.add(object.get(key, null))
    end
    return out
end
function rtObjectHas(object, key)
    found = keys(object).indexOf(key)
    return found >= 0
end
function rtObjectGet(object, key, fallback)
    if rtObjectHas(object, key)
        return object.get(key, fallback)
    end
    return fallback
end
function rtObjectSet(object, key, value)
    object.set(key, value)
    return null
end
function rtObjectDelete(object, key)
    return object.delete(key)
end
function rtLen(value)
    if isString(value)
        return len(value)
    end
    if isArray(value)
        return len(value)
    end
    if isObject(value)
        return len(rtObjectKeys(value))
    end
    rtError("len expects a string, array, or object, found " + rtTypeName(value))
end
$- Collect Say lines instead of writing them; this is the C1 output convention. -$
function rtSay(args)
    parts = []
    for value in args
        parts.add(rtDisplay(value))
    end
    line = join(parts, " ")
    if rtVm != null
        rtVm.output.add(line)
    end
    return null
end
$- Environments are objects with a parent chain, matching Environment. -$
function rtEnvNew(parent)
    return {rtVars: {}, rtParent: parent}
end
function rtEnvHas(env, name)
    cursor = env
    while cursor != null
    if rtObjectHas(cursor.rtVars, name)
        return true
    end
    cursor = cursor.rtParent
end
return false
end
function rtEnvGet(env, name)
    cursor = env
    while cursor != null
    if rtObjectHas(cursor.rtVars, name)
        return cursor.rtVars.get(name, null)
    end
    cursor = cursor.rtParent
end
rtError("Unknown variable '" + name + "'")
end
function rtEnvDefine(env, name, value)
    env.rtVars.set(name, value)
    return null
end
function rtEnvAssign(env, name, value)
    cursor = env
    while cursor != null
    if rtObjectHas(cursor.rtVars, name)
        cursor.rtVars.set(name, value)
        return null
    end
    cursor = cursor.rtParent
end
return rtEnvDefine(env, name, value)
end
$- Native builtins are represented as tagged objects so IR Call can find them. -$
function rtNative(name)
    return {rtKind: "native", rtName: name}
end
function rtGlobalEnv()
    env = rtEnvNew(null)
    names = ["say", "print", "len", "type", "toString", "toNumber", "toBool", "isNumber", "isString", "isArray", "isObject", "isBool", "isNull", "isFunction", "isNaN", "parseInt", "parseFloat", "range", "sum", "average", "min", "max", "abs", "clamp", "sorted", "reversed", "zip", "take", "drop", "keys", "values", "entries", "fromEntries", "first", "last", "indexOf", "contains", "slice", "pow", "sqrt", "floor", "ceil", "round", "sign", "trim", "upper", "lower", "split", "join", "replace", "startsWith", "endsWith", "repeat", "padStart", "padEnd", "charCode", "fromCharCode", "random", "randomInt", "seed", "format"]
    for name in names
        rtEnvDefine(env, name, rtNative(name))
    end
    return env
end
$- The import table maps module names to module objects. A2 builds those objects
   from pure Englishmen functions, so they are ordinary function values here. -$
function rtImportNormalizeTable(rtImportNormalizeTable_value)
    if isNull(rtImportNormalizeTable_value)
        return {}
    end
    if not isObject(rtImportNormalizeTable_value)
        rtError("import table must be an object mapping module names to module objects")
        return {}
    end
    return rtImportNormalizeTable_value
end
function rtImportMissingMessage(rtImportMissingMessage_name, rtImportMissingMessage_table)
    rtImportAvailableNames = sorted(keys(rtImportMissingMessage_table))
    if len(rtImportAvailableNames) == 0
        return "module '" + rtImportMissingMessage_name + "' is not available; no imports were provided"
    end
    return "module '" + rtImportMissingMessage_name + "' is not available; available modules: " + join(rtImportAvailableNames, ", ")
end
$- The IR view of a chunk: constants, functions and code are ordinary values. -$
function rtChunkCode(chunk)
    code = chunk.get("code", null)
    if isArray(code)
        return code
    end
    return []
end
function rtChunkConstants(chunk)
    constants = chunk.get("constants", null)
    if isArray(constants)
        return constants
    end
    return []
end
function rtChunkFunctions(chunk)
    functions = chunk.get("functions", null)
    if isArray(functions)
        return functions
    end
    return []
end
function rtConstValue(chunk, index)
    constants = rtChunkConstants(chunk)
    if index < 0 or index >= len(constants)
        rtError("constant index " + toString(index) + " is out of range")
    end
    constant = constants[index]
    tag = constant.get("tag", "")
    if tag == "number"
        return rtExpectNumber(constant.get("value", 0), "as a constant")
    end
    if tag == "string"
        return rtExpectString(constant.get("value", ""), "as a constant")
    end
    if tag == "bool"
        return constant.get("value", false) == true
    end
    if tag == "null"
        return null
    end
    rtError("unknown constant tag '" + tag + "'")
end
function rtName(chunk, index)
    constants = rtChunkConstants(chunk)
    if index < 0 or index >= len(constants)
        rtError("name index " + toString(index) + " is out of range")
    end
    value = constants[index].get("value", null)
    return rtExpectString(value, "as a name")
end
function rtStackPush(value)
    rtVm.stack.add(value)
    return null
end
function rtStackPop()
    if len(rtVm.stack) == 0
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    return rtVm.stack.pop()
end
function rtStackPeek()
    if len(rtVm.stack) == 0
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    return rtVm.stack[len(rtVm.stack) - 1]
end
function rtStackDrain(count)
    if count < 0 or count > len(rtVm.stack)
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    rtDrainReversed = []
    i = 0
    while i < count
    rtDrainReversed.add(rtStackPop())
    i += 1
end
out = []
i = len(rtDrainReversed) - 1
while i >= 0
out.add(rtDrainReversed[i])
i -= 1
end
return out
end
$- Frames hold a unit, an instruction pointer, an environment and a stack base. -$
function rtFrameNew(unit, ip, env, stackBase)
    return {rtUnit: unit, rtIp: ip, rtEnv: env, rtBase: stackBase}
end
function rtPopFrame(result)
    frame = rtVm.frames[len(rtVm.frames) - 1]
    while len(rtVm.stack) > frame.rtBase
    rtStackPop()
end
rtVm.frames.pop()
if len(rtVm.frames) == 0
    return true
end
rtStackPush(result)
return false
end
function rtIsCallable(value)
    if isObject(value)
        kind = value.get("rtKind", "")
        return kind == "closure" or kind == "native"
    end
    return isFunction(value)
end
$- rtInvoke returns a tagged result; a frame push means no value is pushed here. -$
function rtInvoke(callee, args, hint)
    if not rtIsCallable(callee)
        rtError("'" + hint + "' is not callable (found " + rtTypeName(callee) + ")")
    end
    if isFunction(callee)
$- Imported module objects hold pure Englishmen functions. Englishmen has
           no function-apply primitive, so dispatch by argument count. -$
        rtInvokeArgCount = len(args)
        if rtInvokeArgCount == 0
            return {rtPushed: false, rtValue: callee()}
        end
        if rtInvokeArgCount == 1
            return {rtPushed: false, rtValue: callee(args[0])}
        end
        if rtInvokeArgCount == 2
            return {rtPushed: false, rtValue: callee(args[0], args[1])}
        end
        if rtInvokeArgCount == 3
            return {rtPushed: false, rtValue: callee(args[0], args[1], args[2])}
        end
        if rtInvokeArgCount == 4
            return {rtPushed: false, rtValue: callee(args[0], args[1], args[2], args[3])}
        end
        rtError("host function '" + hint + "' with " + toString(rtInvokeArgCount) + " arguments cannot be called by the self-hosted VM")
    end
    kind = callee.get("rtKind", "")
    if kind == "native"
        value = rtNativeCall(callee.get("rtName", ""), args)
        return {rtPushed: false, rtValue: value}
    end
    proto = callee.get("rtProto", {})
    params = proto.get("params", [])
    if len(args) != len(params)
        rtError("Function '" + proto.get("name", "?") + "' expects " + len(params) + " argument(s) but got " + len(args))
    end
    env = rtEnvNew(callee.get("rtEnv", null))
    i = 0
    while i < len(params)
    rtEnvDefine(env, params[i], args[i])
    i += 1
end
unit = {rtKind: "function", rtChunk: proto.get("chunk", {})}
rtVm.frames.add(rtFrameNew(unit, 0, env, len(rtVm.stack)))
return {rtPushed: true, rtValue: null}
end
$- ---------------------------------------------------------------------------
   Numeric, string, array and object methods. Every global helper is `rt...`.
   --------------------------------------------------------------------------- -$
function rtNumberMethod(value, method, args)
    n = rtExpectNumber(value, "as a number method receiver")
    if method == "isEven"
        return n % 1 == 0 and n % 2 == 0
    end
    if method == "isOdd"
        return n % 1 == 0 and n % 2 != 0
    end
    if method == "isInteger"
        return n % 1 == 0
    end
    if method == "isFinite"
        return n.isFinite()
    end
    if method == "toFixed"
        digits = rtTrunc(rtArg(args, 0, 0))
        if digits < 0 or digits > 10
            rtError("toFixed() expects between 0 and 10 digits")
        end
        scale = 10 ** digits
        rounded = round(n * scale)
        negative = rounded < 0
        rounded = abs(rounded)
        whole = floor(rounded / scale)
        fraction = rounded - whole * scale
        text = toString(whole)
        if digits > 0
            fractionText = toString(fraction)
            while len(fractionText) < digits
            fractionText = "0" + fractionText
        end
        text += "." + fractionText
    end
    if negative
        return "-" + text
    end
    return text
end
if method == "clamp"
    rtClampLower = rtExpectNumber(rtArg(args, 0, null), "as a minimum")
    rtClampUpper = rtExpectNumber(rtArg(args, 1, null), "as a maximum")
    if rtClampLower > rtClampUpper
        rtError("clamp() expects minimum <= maximum")
    end
    if n < rtClampLower
        return rtClampLower
    end
    if n > rtClampUpper
        return rtClampUpper
    end
    return n
end
if method == "toHex" or method == "toBinary" or method == "toOctal"
    if isNaN(n) or n >= 9223372036854776000 or n <= -9223372036854776000
        rtError("toHex/toBinary/toOctal need a finite integer within range")
    end
    negative = n < 0
    magnitude = abs(rtTrunc(n))
    base = 16
    digits = "0123456789abcdef"
    if method == "toBinary"
        base = 2
    else if method == "toOctal"
        base = 8
    end
    text = ""
    if magnitude == 0
        text = "0"
    else
        while magnitude > 0
        digit = magnitude % base
        text = digits.charAt(digit) + text
        magnitude = floor(magnitude / base)
    end
end
if negative and text != "0"
    return "-" + text
end
return text
end
if method == "sign"
    if n > 0
        return 1
    end
    if n < 0
        return -1
    end
    return 0
end
if method == "abs"
    return abs(n)
end
if method == "floor"
    return floor(n)
end
if method == "ceil"
    return ceil(n)
end
if method == "round"
    return round(n)
end
if method == "sqrt"
    if n < 0
        rtError("sqrt() expects a non-negative number")
    end
    return sqrt(n)
end
if method == "toDegrees"
    return n * 180 / 3.141592653589793
end
if method == "reciprocal"
    if n == 0
        rtError("reciprocal() is undefined for zero")
    end
    return 1 / n
end
rtError("Number has no method '" + method + "'")
end
function rtStringChars(text)
    out = []
    for ch in text.chars()
        out.add(ch)
    end
    return out
end
function rtStringSlice(text, start, finish)
    chars = rtStringChars(text)
    rtSliceBounds = rtSliceRange(len(chars), start, finish)
    out = ""
    i = rtSliceBounds[0]
    while i < rtSliceBounds[1]
    out += chars[i]
    i += 1
end
return out
end
function rtStringIndexOf(text, needle)
    return indexOf(text, needle)
end
function rtStringLastIndexOf(text, needle)
    return text.lastIndexOf(needle)
end
function rtStringRepeat(text, count)
    n = rtExpectNumber(count, "as a repeat count")
    if n < 0
        return ""
    end
    if n % 1 != 0
        rtError("repeat() expects a whole number of repetitions")
    end
    if n > 1000000
        rtError("repeat() result would be too large")
    end
    out = ""
    i = 0
    while i < n
    out += text
    i += 1
end
return out
end
function rtStringPad(text, width, padding, atStart)
    w = rtTrunc(width)
    if w < 0 or w > 100000
        rtError("padLeft/padRight expects a non-negative whole width")
    end
    unit = rtExpectString(padding, "as padding")
    if unit == ""
        unit = " "
    end
    missing = w - len(text)
    if missing <= 0
        return text
    end
    pad = ""
    while len(pad) < missing
    pad += unit
end
pad = slice(pad, 0, missing)
if atStart
    return pad + text
end
return text + pad
end
function rtStringNumeric(text)
    if text == ""
        return false
    end
    chars = rtStringChars(text)
    i = 0
    if chars[0] == "+" or chars[0] == "-"
        i += 1
    end
    digits = 0
    while i < len(chars) and chars[i] >= "0" and chars[i] <= "9"
    digits += 1
    i += 1
end
if i < len(chars) and chars[i] == "."
    i += 1
    while i < len(chars) and chars[i] >= "0" and chars[i] <= "9"
    digits += 1
    i += 1
end
end
if digits == 0
    return false
end
if i < len(chars) and (chars[i] == "e" or chars[i] == "E")
    i += 1
    if i < len(chars) and (chars[i] == "+" or chars[i] == "-")
        i += 1
    end
    exponentDigits = 0
    while i < len(chars) and chars[i] >= "0" and chars[i] <= "9"
    exponentDigits += 1
    i += 1
end
if exponentDigits == 0
    return false
end
end
return i == len(chars)
end
function rtStringReplace(text, old, replacement, all)
    if old == ""
        if all
            out = replacement
            for ch in text.chars()
                out += ch + replacement
            end
            return out
        end
        return replacement + text
    end
    out = ""
    rest = text
    while true
    at = rtStringIndexOf(rest, old)
    if at < 0
        out += rest
        break
    end
    out += rtStringSlice(rest, 0, at)
    out += replacement
    rest = rtStringSlice(rest, at + len(old), len(rest))
    if not all
        out += rest
        break
    end
end
return out
end
function rtStringMethod(text, method, args)
    if method == "length"
        return len(text)
    end
    if method == "upper"
        return upper(text)
    end
    if method == "lower"
        return lower(text)
    end
    if method == "trim"
        return trim(text)
    end
    if method == "split"
        separator = rtExpectString(rtArg(args, 0, ""), "as a separator")
        if separator == ""
            return rtStringChars(text)
        end
        return text.split(separator)
    end
    if method == "contains"
        return rtStringIndexOf(text, rtExpectString(rtArg(args, 0, ""), "to search for")) >= 0
    end
    if method == "startsWith"
        return startsWith(text, rtExpectString(rtArg(args, 0, null), "as a prefix"))
    end
    if method == "endsWith"
        return endsWith(text, rtExpectString(rtArg(args, 0, null), "as a suffix"))
    end
    if method == "replace"
        return rtStringReplace(text, rtExpectString(rtArg(args, 0, null), "to replace"), rtExpectString(rtArg(args, 1, null), "as a replacement"), false)
    end
    if method == "replaceAll"
        return rtStringReplace(text, rtExpectString(rtArg(args, 0, null), "to replace"), rtExpectString(rtArg(args, 1, null), "as a replacement"), true)
    end
    if method == "slice"
        return rtStringSlice(text, rtArg(args, 0, 0), rtArg(args, 1, len(text)))
    end
    if method == "substring"
        chars = rtStringChars(text)
        from = rtClampIndex(len(chars), rtArg(args, 0, 0))
        to = rtClampIndex(len(chars), rtArg(args, 1, len(chars)))
        if to < from
            swap = from
            from = to
            to = swap
        end
        out = ""
        i = from
        while i < to
        out += chars[i]
        i += 1
    end
    return out
end
if method == "indexOf"
    return rtStringIndexOf(text, rtExpectString(rtArg(args, 0, null), "to search for"))
end
if method == "lastIndexOf"
    return rtStringLastIndexOf(text, rtExpectString(rtArg(args, 0, null), "to search for"))
end
if method == "charAt"
    chars = rtStringChars(text)
    at = rtExactIndex(len(chars), rtArg(args, 0, null))
    if at < 0
        return ""
    end
    return chars[at]
end
if method == "toNumber"
    trimmed = trim(text)
    if not rtStringNumeric(trimmed)
        return null
    end
    return toNumber(trimmed)
end
if method == "capitalize"
    if text == ""
        return ""
    end
    return upper(slice(text, 0, 1)) + slice(text, 1, len(text))
end
if method == "titleCase"
    out = ""
    start = true
    for ch in text.chars()
        if trim(ch) == ""
            out += ch
            start = true
        else if start
            out += upper(ch)
            start = false
        else
