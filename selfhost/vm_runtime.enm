function rtFlattenInto(values, out, seen)
    for value in values
        if isArray(value)
            known = false
            for previous in seen
                if rtEquals(previous, value)
                    known = true
                end
            end
            if not known
                seen.add(value)
                rtFlattenInto(value, out, seen)
                seen.pop()
            end
        else
            out.add(value)
        end
    end
    return null
end
function rtObjectMethod(object, method, args)
    if method == "keys"
        return rtObjectKeys(object)
    end
    if method == "values"
        return rtObjectValues(object)
    end
    if method == "has"
        return rtObjectHas(object, rtExpectString(rtArg(args, 0, null), "as a key"))
    end
    if method == "get"
        key = rtExpectString(rtArg(args, 0, null), "as a key")
        return rtObjectGet(object, key, rtArg(args, 1, null))
    end
    if method == "set"
        key = rtExpectString(rtArg(args, 0, null), "as a key")
        return rtObjectSet(object, key, rtArg(args, 1, null))
    end
    if method == "delete"
        return rtObjectDelete(object, rtExpectString(rtArg(args, 0, null), "as a key"))
    end
    if method == "length"
        return len(rtObjectKeys(object))
    end
    if method == "merge"
        other = rtArg(args, 0, null)
        if not isObject(other)
            rtError("merge() expects an object to merge")
        end
        for key in rtObjectKeys(other)
            rtObjectSet(object, key, other.get(key, null))
        end
        return object
    end
    if method == "copy"
        out = {}
        for key in rtObjectKeys(object)
            rtObjectSet(out, key, object.get(key, null))
        end
        return out
    end
    if method == "isEmpty"
        return len(rtObjectKeys(object)) == 0
    end
    if method == "pick"
        out = {}
        for key in args
            name = rtExpectString(key, "as a key")
            if rtObjectHas(object, name)
                rtObjectSet(out, name, object.get(name, null))
            end
        end
        return out
    end
    if method == "omit"
        out = {}
        for key in rtObjectKeys(object)
            if keys(args).indexOf(key) < 0
                rtObjectSet(out, key, object.get(key, null))
            end
        end
        return out
    end
    if method == "entries"
        out = []
        for key in rtObjectKeys(object)
            out.add([key, object.get(key, null)])
        end
        return out
    end
