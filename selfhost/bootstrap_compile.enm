end
pad = slice(pad, 0, missing)
if atStart
    return pad + text
end
return text + pad
end
function rtStringNumeric(text)
    if text == ""
        return false
    end
    chars = rtStringChars(text)
    i = 0
    if chars[0] == "+" or chars[0] == "-"
        i += 1
    end
    digits = 0
    while i < len(chars) and chars[i] >= "0" and chars[i] <= "9"
    digits += 1
    i += 1
end
if i < len(chars) and chars[i] == "."
    i += 1
    while i < len(chars) and chars[i] >= "0" and chars[i] <= "9"
    digits += 1
    i += 1
end
end
if digits == 0
    return false
end
if i < len(chars) and (chars[i] == "e" or chars[i] == "E")
    i += 1
    if i < len(chars) and (chars[i] == "+" or chars[i] == "-")
        i += 1
    end
    exponentDigits = 0
    while i < len(chars) and chars[i] >= "0" and chars[i] <= "9"
    exponentDigits += 1
    i += 1
end
if exponentDigits == 0
    return false
end
end
return i == len(chars)
