            return
        end
        vmExec_flat = vmDrain(vmExec_a * 2, vmExec_instr)
        if vmError != null
            return
        end
        vmExec_object = {}
        vmExec_i = 0
        while vmExec_i < len(vmExec_flat)
        vmExec_object.set(toString(vmExec_flat[vmExec_i]), vmExec_flat[vmExec_i + 1])
        vmExec_i += 2
    end
    vmPush(vmExec_object)
    return
end
if vmExec_op == "MakeClosure"
    vmExec_functions = vmExec_chunk.get("functions", [])
    if vmExec_a < 0 or vmExec_a >= len(vmExec_functions)
        vmRaiseAt("runtime", "function index " + toString(vmExec_a) + " out of range", vmExec_instr)
        return
    end
    vmPush({__vmClosure: true, proto: vmExec_functions[vmExec_a], scope: vmExec_frame.scope})
    return
end
if vmExec_op == "Call"
    vmExec_name = vmName(vmExec_chunk, vmExec_b, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_args = vmDrain(vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_callee = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmExec_result = vmCallValue(vmExec_callee, vmExec_args, vmExec_name, vmExec_instr)
    if vmError != null or vmCallPushedFrame
        return
    end
    vmPush(vmExec_result)
    return
end
if vmExec_op == "MethodCall"
    vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_args = vmDrain(vmExec_b, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_receiver = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmExec_result = vmMethodCall(vmExec_receiver, vmExec_name, vmExec_args, vmExec_instr)
    if vmError != null or vmCallPushedFrame
        return
    end
    vmPush(vmExec_result)
    return
end
if vmExec_op == "Say"
    vmExec_values = vmDrain(vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_i = 0
    while vmExec_i < len(vmExec_values)
    vmOutput.add(vmExec_values[vmExec_i])
    vmExec_i += 1
end
vmPush(null)
return
end
if vmExec_op == "Add" or vmExec_op == "Sub" or vmExec_op == "Mul" or vmExec_op == "Div" or vmExec_op == "Mod" or vmExec_op == "FloorDiv" or vmExec_op == "Pow" or vmExec_op == "BitAnd" or vmExec_op == "BitOr" or vmExec_op == "BitXor" or vmExec_op == "Shl" or vmExec_op == "Shr" or vmExec_op == "Eq" or vmExec_op == "NotEq" or vmExec_op == "Gt" or vmExec_op == "Lt" or vmExec_op == "GtEq" or vmExec_op == "LtEq"
    vmExec_right = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmExec_left = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmPush(vmBinary(vmExec_op, vmExec_left, vmExec_right, vmExec_instr))
    return
end
if vmExec_op == "Neg" or vmExec_op == "Not" or vmExec_op == "BitNot" or vmExec_op == "ToBool"
    vmExec_value = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmPush(vmUnary(vmExec_op, vmExec_value, vmExec_instr))
    return
end
if vmExec_op == "Dup"
    vmPush(vmPeek(vmExec_instr))
    return
end
if vmExec_op == "Rotate"
    vmExec_count = vmExec_a + 1
    if vmExec_count > len(vmStack)
        vmRaiseAt("runtime", "value stack underflow", vmExec_instr)
        return
    end
    vmExec_split = len(vmStack) - vmExec_count
    vmExec_top = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmStack.insert(vmExec_split, vmExec_top)
    return
end
if vmExec_op == "GetPropKeep"
    vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_value = vmGetProperty(vmPeek(vmExec_instr), vmExec_name, vmExec_instr)
    if vmError != null
        return
    end
    vmPush(vmExec_value)
    return
end
if vmExec_op == "Jump"
    vmJump(vmExec_a, vmExec_instr)
    return
end
if vmExec_op == "JumpIfFalse"
    vmExec_value = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    if not toBool(vmExec_value)
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "JumpIfFalsePeek"
    if not toBool(vmPeek(vmExec_instr))
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "JumpIfTruePeek"
    if toBool(vmPeek(vmExec_instr))
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "JumpIfNullPeek"
    if isNull(vmPeek(vmExec_instr))
        vmJump(vmExec_a, vmExec_instr)
    end
    return
end
if vmExec_op == "RepeatSetup"
    vmExec_value = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmExec_n = vmRequireNumber(vmExec_value, "as a repeat count", vmExec_instr)
    if vmError != null
        return
    end
    if vmExec_n < 0 or isNaN(vmExec_n)
        vmRaiseAt("runtime", "repeat count must not be negative", vmExec_instr)
        return
    end
    vmPush(floor(vmExec_n))
    return
end
if vmExec_op == "RepeatNext"
    vmExec_remaining = vmPeek(vmExec_instr)
    if vmError != null
        return
    end
    if not isNumber(vmExec_remaining)
        vmRaiseAt("runtime", "corrupt repeat counter", vmExec_instr)
        return
    end
    if vmExec_remaining <= 0
        vmStack.pop()
        vmJump(vmExec_a, vmExec_instr)
    else
        vmStack[len(vmStack) - 1] = vmExec_remaining - 1
    end
    return
end
if vmExec_op == "IterSetup"
    vmExec_iterable = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    if not isArray(vmExec_iterable)
        vmRaiseAt("runtime", "cannot iterate over a " + type(vmExec_iterable) + "; 'for ... in' expects an array", vmExec_instr)
        return
    end
    vmPush(vmExec_iterable.copy())
    vmPush(0)
    return
end
if vmExec_op == "IterNext"
    vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    if len(vmStack) < 2
        vmRaiseAt("runtime", "value stack underflow", vmExec_instr)
        return
    end
    vmExec_cursor = vmStack[len(vmStack) - 1]
    vmExec_items = vmStack[len(vmStack) - 2]
    if not isNumber(vmExec_cursor) or not isArray(vmExec_items)
        vmRaiseAt("runtime", "corrupt iterator state", vmExec_instr)
        return
    end
    if vmExec_cursor < len(vmExec_items)
        vmScopeDefine(vmExec_frame.scope, vmExec_name, vmExec_items[vmExec_cursor])
        vmStack[len(vmStack) - 1] = vmExec_cursor + 1
    else
        vmStack.pop()
        vmStack.pop()
        vmJump(vmExec_b, vmExec_instr)
    end
    return
end
if vmExec_op == "Return"
    vmExec_value = vmPop(vmExec_instr)
    if vmError != null
        return
    end
    vmPopFrame(vmExec_value)
    return
end
if vmExec_op == "ReturnNull"
    vmPopFrame(null)
    return
end
if vmExec_op == "Import"
    vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
    if vmError != null
        return
    end
    vmExec_value = vmImport(vmExec_name, vmExec_instr)
    if vmError != null
        return
    end
    vmScopeDefine(vmExec_frame.scope, vmExec_name, vmExec_value)
    return
end
vmRaiseAt("runtime", "unsupported opcode '" + vmExec_op + "'", vmExec_instr)
end
function vmStep()
    vmStep_frame = vmFrame()
    if vmStep_frame == null
        return
    end
    vmStep_code = vmStep_frame.chunk.get("code", [])
    if vmStep_frame.ip >= len(vmStep_code)
        vmPopFrame(null)
        return
    end
    vmStep_ip = vmStep_frame.ip
    vmStep_instr = vmStep_code[vmStep_ip]
    vmStep_frame.ip = vmStep_ip + 1
    vmExec(vmStep_instr)
end
$- === inlined selfhost/vm_runtime.enm === -$
$-!
    selfhost/vm_runtime.enm

    A self-hosted Englishmen VM runtime. It executes the EMB IR object shape
    described in docs/selfhost/EMB_AND_MANIFEST.md and collects `Say` output in
    an array instead of printing it, so a caller can compare the result with the
    native VM. Englishmen has no local .enm imports, so all helpers are global
    and prefixed with `rt` to make this file safe to inline into full.enm.

    CLI:  em run selfhost/vm_runtime.enm <ir.json>
          prints jsonEncode(outputArray)
    Test: EM_SELFTEST=1 em run selfhost/vm_runtime.enm   prints ok

    No native modules are imported. The CLI uses the global `args` and
    `readFile` builtins, and selftests use the `env` builtin; the regenerator
    can swap in the pure `pfo`/`pjs` helpers without changing the VM core.
    Native modules appear only inside guarded self-test oracles; when
    regenerating for the C host, strip those blocks or provide a global `env`.
!-$
$- One VM at a time; every helper reaches the mutable state through rtVm. -$
rtVm = null
function rtError(message)
    assert(false, "ENM VM: " + message)
end
function rtArg(args, index, fallback)
    if index >= 0 and index < len(args)
        return args[index]
    end
    return fallback
end
function rtTypeName(value)
    if isObject(value)
        kind = rtObjectGet(value, "rtKind", "")
        if kind == "closure" or kind == "native"
            return "function"
        end
    end
    return type(value)
end
function rtDebugDisplay(value)
    if isString(value)
        return "\"" + value + "\""
    end
    return rtDisplay(value)
end
function rtDisplay(value)
    if isNull(value)
        return "null"
    end
    if isBool(value)
        if value
            return "true"
        end
        return "false"
    end
    if isNumber(value)
        return toString(value)
    end
    if isString(value)
        return value
    end
    if isObject(value)
        kind = rtObjectGet(value, "rtKind", "")
        if kind == "closure"
            return "<function " + rtObjectGet(rtObjectGet(value, "rtProto", {}), "name", "?") + ">"
        end
        if kind == "native"
            return "<native function " + rtObjectGet(value, "rtName", "?") + ">"
        end
        parts = []
        for key in keys(value)
            parts.add(key + ": " + rtDebugDisplay(rtObjectGet(value, key, null)))
        end
        return "\{" + join(parts, ", ") + "\}"
    end
    if isArray(value)
        parts = []
        for item in value
            parts.add(rtDebugDisplay(item))
        end
        return "[" + join(parts, ", ") + "]"
    end
    return "<function ?>"
end
function rtTruthy(value)
    if isBool(value)
        return value
    end
    if isNull(value)
        return false
    end
    if isNumber(value)
        return value != 0
    end
    if isString(value)
        return value != ""
    end
    if isArray(value)
        return len(value) > 0
    end
    return true
end
function rtEquals(left, right)
    return left == right
end
function rtExpectNumber(value, context)
    if not isNumber(value)
        rtError("Type mismatch: expected a number " + context + ", found " + rtTypeName(value))
    end
    return value
end
function rtExpectString(value, context)
    if not isString(value)
        rtError("Type mismatch: expected a string " + context + ", found " + rtTypeName(value))
    end
    return value
end
function rtTrunc(value)
    n = rtExpectNumber(value, "as a whole number")
    if n >= 0
        return floor(n)
    end
    return ceil(n)
end
function rtClampIndex(length, raw)
    n = rtExpectNumber(raw, "as an index")
    if isNaN(n)
        if n < 0
            return 0
        end
        return length
    end
    if n < 0
        index = length + n
        if index < 0
            return 0
        end
        return index
    end
    if n > length
        return length
    end
    return n
end
function rtExactIndex(length, raw)
    n = rtExpectNumber(raw, "as an index")
    if isNaN(n) or n % 1 != 0
        return -1
    end
    if n < 0
        index = length + n
        if index < 0
            return -1
        end
        return index
    end
    if n >= length
        return -1
    end
    return n
end
function rtSliceRange(length, start, finish)
    from = rtClampIndex(length, start)
    to = rtClampIndex(length, finish)
    if to < from
        return [from, from]
    end
    return [from, to]
end
function rtArrayCopy(array)
    out = []
    for item in array
        out.add(item)
    end
    return out
end
function rtArrayReplace(array, items)
    while len(array) > 0
    array.pop()
end
for item in items
    array.add(item)
end
return array
end
function rtArrayInsert(array, index, value)
    out = []
    at = rtClampIndex(len(array), index)
    i = 0
    while i < at
    out.add(array[i])
    i += 1
end
out.add(value)
while i < len(array)
out.add(array[i])
i += 1
end
return rtArrayReplace(array, out)
end
function rtArrayRemoveAt(array, index)
    at = rtTrunc(index)
    if at < 0 or at >= len(array)
        return false
    end
    out = []
    i = 0
    while i < len(array)
    if i != at
        out.add(array[i])
    end
    i += 1
end
rtArrayReplace(array, out)
return true
end
function rtArraySlice(array, from, to)
    out = []
    i = from
    while i < to and i < len(array)
    out.add(array[i])
    i += 1
end
return out
end
function rtCompareValues(left, right, numeric)
    if numeric and isNumber(left) and isNumber(right)
        if left < right
            return -1
        end
        if left > right
            return 1
        end
        return 0
    end
    leftText = rtDisplay(left)
    rightText = rtDisplay(right)
    if leftText < rightText
        return -1
    end
    if leftText > rightText
        return 1
    end
    return 0
end
function rtArraySort(array)
    numeric = true
    for item in array
        if not isNumber(item)
            numeric = false
        end
    end
    items = rtArrayCopy(array)
    i = 1
    while i < len(items)
    key = items[i]
    j = i - 1
    while j >= 0 and rtCompareValues(items[j], key, numeric) > 0
    items[j + 1] = items[j]
    j -= 1
end
items[j + 1] = key
i += 1
end
return rtArrayReplace(array, items)
end
function rtObjectKeys(object)
    if not isObject(object)
        rtError("expected an object, found " + rtTypeName(object))
    end
    return keys(object)
end
function rtObjectValues(object)
    out = []
    for key in rtObjectKeys(object)
        out.add(rtObjectGet(object, key, null))
    end
    return out
end
function rtObjectHas(object, key)
    found = keys(object).indexOf(key)
    return found >= 0
end
$- Module objects can define a `get` key, which shadows the native object.get
   method. Read properties through entries() so runtime metadata lookups never
   accidentally call a module function. -$
function rtObjectGet(object, key, fallback)
    if not isObject(object)
        return fallback
    end
    rtObjectGet_pairs = entries(object)
    rtObjectGet_i = 0
    while rtObjectGet_i < len(rtObjectGet_pairs)
    if rtDisplay(rtObjectGet_pairs[rtObjectGet_i][0]) == key
        return rtObjectGet_pairs[rtObjectGet_i][1]
    end
    rtObjectGet_i += 1
end
return fallback
end
function rtObjectSet(object, key, value)
    object.set(key, value)
    return null
end
function rtObjectDelete(object, key)
    return object.delete(key)
end
function rtLen(value)
    if isString(value)
        return len(value)
    end
    if isArray(value)
        return len(value)
    end
    if isObject(value)
        return len(rtObjectKeys(value))
    end
    rtError("len expects a string, array, or object, found " + rtTypeName(value))
end
$- Collect Say lines instead of writing them; this is the C1 output convention. -$
function rtSay(args)
    parts = []
    for value in args
        parts.add(rtDisplay(value))
    end
    line = join(parts, " ")
    if rtVm != null
        rtVm.output.add(line)
    end
    return null
end
$- Environments are objects with a parent chain, matching Environment. -$
function rtEnvNew(parent)
    return {rtVars: {}, rtParent: parent}
end
function rtEnvHas(env, name)
    cursor = env
    while cursor != null
    if rtObjectHas(cursor.rtVars, name)
        return true
    end
    cursor = cursor.rtParent
end
return false
end
function rtEnvGet(env, name)
    cursor = env
    while cursor != null
    if rtObjectHas(cursor.rtVars, name)
        return rtObjectGet(cursor.rtVars, name, null)
    end
    cursor = cursor.rtParent
end
rtError("Unknown variable '" + name + "'")
end
function rtEnvDefine(env, name, value)
    env.rtVars.set(name, value)
    return null
end
function rtEnvAssign(env, name, value)
    cursor = env
    while cursor != null
    if rtObjectHas(cursor.rtVars, name)
        cursor.rtVars.set(name, value)
        return null
    end
    cursor = cursor.rtParent
end
return rtEnvDefine(env, name, value)
end
$- Native builtins are represented as tagged objects so IR Call can find them. -$
function rtNative(name)
    return {rtKind: "native", rtName: name}
end
function rtGlobalEnv()
    env = rtEnvNew(null)
    names = ["say", "print", "len", "type", "toString", "toNumber", "toBool", "isNumber", "isString", "isArray", "isObject", "isBool", "isNull", "isFunction", "isNaN", "parseInt", "parseFloat", "range", "sum", "average", "min", "max", "abs", "clamp", "sorted", "reversed", "zip", "take", "drop", "keys", "values", "entries", "fromEntries", "first", "last", "indexOf", "contains", "slice", "pow", "sqrt", "floor", "ceil", "round", "sign", "trim", "upper", "lower", "split", "join", "replace", "startsWith", "endsWith", "repeat", "padStart", "padEnd", "charCode", "fromCharCode", "random", "randomInt", "seed", "format", "assert", "jsonEncode", "jsonDecode", "args"]
    for name in names
        rtEnvDefine(env, name, rtNative(name))
    end
    return env
end
$- The import table maps module names to module objects. A2 builds those objects
   from pure Englishmen functions, so they are ordinary function values here. -$
function rtImportNormalizeTable(rtImportNormalizeTable_value)
    if isNull(rtImportNormalizeTable_value)
        return {}
    end
    if not isObject(rtImportNormalizeTable_value)
        rtError("import table must be an object mapping module names to module objects")
        return {}
    end
    return rtImportNormalizeTable_value
end
function rtImportMissingMessage(rtImportMissingMessage_name, rtImportMissingMessage_table)
    rtImportAllNames = sorted(keys(rtImportMissingMessage_table))
    rtImportAvailableNames = []
    for rtImportCandidate in rtImportAllNames
        if rtImportCandidate != "__arities"
            rtImportAvailableNames.add(rtImportCandidate)
        end
    end
    if len(rtImportAvailableNames) == 0
        return "module '" + rtImportMissingMessage_name + "' is not available; no imports were provided"
    end
    return "module '" + rtImportMissingMessage_name + "' is not available; available modules: " + join(rtImportAvailableNames, ", ")
end
$- The IR view of a chunk: constants, functions and code are ordinary values. -$
function rtChunkCode(chunk)
    code = rtObjectGet(chunk, "code", null)
    if isArray(code)
        return code
    end
    return []
end
function rtChunkConstants(chunk)
    constants = rtObjectGet(chunk, "constants", null)
    if isArray(constants)
        return constants
    end
    return []
end
function rtChunkFunctions(chunk)
    functions = rtObjectGet(chunk, "functions", null)
    if isArray(functions)
        return functions
    end
    return []
end
function rtConstValue(chunk, index)
    constants = rtChunkConstants(chunk)
    if index < 0 or index >= len(constants)
        rtError("constant index " + toString(index) + " is out of range")
    end
    constant = constants[index]
    tag = rtObjectGet(constant, "tag", "")
    if tag == "number"
        return rtExpectNumber(rtObjectGet(constant, "value", 0), "as a constant")
    end
    if tag == "string"
        return rtExpectString(rtObjectGet(constant, "value", ""), "as a constant")
    end
    if tag == "bool"
        return rtObjectGet(constant, "value", false) == true
    end
    if tag == "null"
        return null
    end
    rtError("unknown constant tag '" + tag + "'")
end
function rtName(chunk, index)
    constants = rtChunkConstants(chunk)
    if index < 0 or index >= len(constants)
        rtError("name index " + toString(index) + " is out of range")
    end
    value = rtObjectGet(constants[index], "value", null)
    return rtExpectString(value, "as a name")
end
function rtStackPush(value)
    rtVm.stack.add(value)
    return null
end
function rtStackPop()
    if len(rtVm.stack) == 0
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    return rtVm.stack.pop()
end
function rtStackPeek()
    if len(rtVm.stack) == 0
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    return rtVm.stack[len(rtVm.stack) - 1]
end
function rtStackDrain(count)
    if count < 0 or count > len(rtVm.stack)
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    rtDrainReversed = []
    i = 0
    while i < count
    rtDrainReversed.add(rtStackPop())
    i += 1
end
out = []
i = len(rtDrainReversed) - 1
while i >= 0
out.add(rtDrainReversed[i])
i -= 1
end
return out
end
$- Frames hold a unit, an instruction pointer, an environment and a stack base. -$
function rtFrameNew(unit, ip, env, stackBase)
    return {rtUnit: unit, rtIp: ip, rtEnv: env, rtBase: stackBase}
end
function rtPopFrame(result)
    frame = rtVm.frames[len(rtVm.frames) - 1]
    while len(rtVm.stack) > frame.rtBase
    rtStackPop()
end
rtVm.frames.pop()
if len(rtVm.frames) == 0
    return true
end
rtStackPush(result)
return false
end
function rtIsCallable(value)
    if isObject(value)
        kind = rtObjectGet(value, "rtKind", "")
        return kind == "closure" or kind == "native"
    end
    return isFunction(value)
end
$- rtInvoke returns a tagged result; a frame push means no value is pushed here. -$
function rtInvoke(callee, args, hint)
    if not rtIsCallable(callee)
        rtError("'" + hint + "' is not callable (found " + rtTypeName(callee) + ")")
    end
    if isFunction(callee)
$- Imported module objects hold pure Englishmen functions. Englishmen has
           no function-apply primitive, so dispatch by argument count. An
           optional __arities table in the import table pads variadic adapters
           such as bytes.of and bytes.slice up to their fixed Englishmen arity. -$
        if rtVm != null
            rtInvokeImports = rtObjectGet(rtVm, "imports", {})
            rtInvokeArities = rtObjectGet(rtInvokeImports, "__arities", {})
            if isObject(rtInvokeArities) and rtObjectHas(rtInvokeArities, hint)
                rtInvokeTargetArity = rtObjectGet(rtInvokeArities, hint, 0)
                while len(args) < rtInvokeTargetArity
                args.add(null)
            end
        end
    end
    rtInvokeArgCount = len(args)
    if rtInvokeArgCount == 0
        return {rtPushed: false, rtValue: callee()}
    end
    if rtInvokeArgCount == 1
        return {rtPushed: false, rtValue: callee(args[0])}
    end
    if rtInvokeArgCount == 2
        return {rtPushed: false, rtValue: callee(args[0], args[1])}
