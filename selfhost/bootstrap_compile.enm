end
if vmValidateChunk_op == "Rotate" and vmValidateChunk_instr.get("a", 0) > 16
    vmRaiseAt("validation", vmValidateChunk_path_i + ": rotate count out of range", vmValidateChunk_instr)
    return false
end
vmValidateChunk_i += 1
end
vmValidateChunk_i = 0
while vmValidateChunk_i < len(vmValidateChunk_functions)
vmValidateChunk_function = vmValidateChunk_functions[vmValidateChunk_i]
vmValidateChunk_functionPath = vmValidateChunk_path + ".functions[" + toString(vmValidateChunk_i) + "]"
if not isObject(vmValidateChunk_function)
    vmRaise("validation", vmValidateChunk_functionPath + " must be an object", "", 1, 1)
    return false
end
if not isString(vmValidateChunk_function.get("name", ""))
    vmRaise("validation", vmValidateChunk_functionPath + ".name must be a string", "", 1, 1)
    return false
end
vmValidateChunk_params = vmValidateChunk_function.get("params", null)
if not isArray(vmValidateChunk_params)
    vmRaise("validation", vmValidateChunk_functionPath + ".params must be an array", "", 1, 1)
    return false
end
vmValidateChunk_j = 0
while vmValidateChunk_j < len(vmValidateChunk_params)
if not isString(vmValidateChunk_params[vmValidateChunk_j])
    vmRaise("validation", vmValidateChunk_functionPath + ".params[" + toString(vmValidateChunk_j) + "] must be a string", "", 1, 1)
    return false
end
vmValidateChunk_j += 1
end
if not vmValidateChunk(vmValidateChunk_function.get("chunk", null), vmValidateChunk_depth + 1, false, vmValidateChunk_functionPath + ".chunk")
    return false
end
vmValidateChunk_i += 1
end
return true
end
function vmValidate(vmValidate_ir)
    return vmValidateChunk(vmValidate_ir, 0, true, "ir")
end
function vmFrame()
