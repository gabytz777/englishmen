    if name == "min"
        return min(rtArg(args, 0, []))
    end
    if name == "max"
        return max(rtArg(args, 0, []))
    end
    if name == "abs"
        return abs(rtArg(args, 0, 0))
    end
    if name == "clamp"
        return clamp(rtArg(args, 0, 0), rtArg(args, 1, 0), rtArg(args, 2, 0))
