        if not vmScopeHas(vmExec_frame.scope, vmExec_name)
            vmScopeDefine(vmExec_frame.scope, vmExec_name, {})
        end
        vmPush(vmScopeGet(vmExec_frame.scope, vmExec_name))
        return
    end
    if vmExec_op == "GetPropOrObject"
        vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
        if vmError != null
            return
        end
        vmExec_base = vmPop(vmExec_instr)
        if vmError != null
            return
        end
        if isObject(vmExec_base) and not vmExec_base.has(vmExec_name)
            vmExec_base.set(vmExec_name, {})
        end
        vmExec_value = vmGetProperty(vmExec_base, vmExec_name, vmExec_instr)
        if vmError != null
            return
