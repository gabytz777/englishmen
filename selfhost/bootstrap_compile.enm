$- === inlined selfhost/compiler.enm === -$
$- Self-contained bootstrap compiler for Englishmen.
   Englishmen cannot import local .enm files yet, so the lexer, parser and
   emitter are inlined here. The emitter builds Value objects/arrays and lets
   json.encode handle key ordering, escaping and number formatting, which makes
   the output byte-identical to `em build <file> --emit ast-json`.

   Native module imports are replaced by global builtins, so this source runs
   both standalone and inside the regenerated compiler image.
-$
$- ---------------------------------------------------------------------------
   Lexer state and helpers. Token objects mirror src/lexer.rs:
   {type: RustTokenVariant, value: ..., line: n, col: n} with an extra `op`
   field on compound assignments.
   --------------------------------------------------------------------------- -$
lxSrc = ""
lxChars = []
lxPos = 0
lxLine = 1
lxCol = 1
lxTokens = []
lxTokLine = 1
lxTokCol = 1
function lxPeek()
    if lxPos >= len(lxChars)
        return null
    end
    return lxChars[lxPos]
end
function lxPeekAt(lxPeekAt_offset)
    lxPeekAt_i = lxPos + lxPeekAt_offset
    if lxPeekAt_i >= len(lxChars)
        return null
    end
    return lxChars[lxPeekAt_i]
end
function lxAdvance()
    lxAdvance_c = lxChars[lxPos]
    lxPos += 1
    if charCode(lxAdvance_c) == 10
        lxLine += 1
        lxCol = 1
    else
        lxCol += 1
    end
    return lxAdvance_c
end
function lxMake(lxMake_type, lxMake_value)
    lxMake_tok = {type: lxMake_type, value: lxMake_value, line: lxTokLine, col: lxTokCol}
    return lxMake_tok
end
function lxMakeCompound(lxMakeCompound_op)
    lxMakeCompound_tok = {type: "CompoundAssign", value: lxMakeCompound_op, op: lxMakeCompound_op, line: lxTokLine, col: lxTokCol}
    return lxMakeCompound_tok
end
function lxIsDigit(lxIsDigit_c)
    if lxIsDigit_c == null
        return false
    end
    lxIsDigit_n = charCode(lxIsDigit_c)
    return lxIsDigit_n >= 48 and lxIsDigit_n <= 57
end
function lxIsLetter(lxIsLetter_c)
    if lxIsLetter_c == null
        return false
    end
    return lxIsLetter_c.isAlpha()
end
function lxDigitValue(lxDigitValue_c)
    if lxDigitValue_c == null
        return -1
    end
    lxDigitValue_n = charCode(lxDigitValue_c)
    if lxDigitValue_n >= 48 and lxDigitValue_n <= 57
        return lxDigitValue_n - 48
    end
    lxDigitValue_n = charCode(lxDigitValue_c.lower())
    if lxDigitValue_n >= 97 and lxDigitValue_n <= 102
        return lxDigitValue_n - 87
    end
    return -1
end
function lxEndsExpression(lxEndsExpression_type)
    lxEndsExpression_ends = ["Number", "String", "Interpolated", "Identifier", "True", "False", "Null", "RParen", "RBracket", "RBrace", "PlusPlus", "MinusMinus"]
    return lxEndsExpression_ends.indexOf(lxEndsExpression_type) >= 0
end
function lxSkipToEndOfLine()
    while lxPos < len(lxChars) and lxChars[lxPos] != "\n"
    lxAdvance()
end
end
function lxSkipWhitespaceAndComments()
    while lxPos < len(lxChars)
    lxSkipWhitespaceAndComments_c = lxChars[lxPos]
    lxSkipWhitespaceAndComments_n = charCode(lxSkipWhitespaceAndComments_c)
    if lxSkipWhitespaceAndComments_n == 32 or lxSkipWhitespaceAndComments_n == 9 or lxSkipWhitespaceAndComments_n == 13
        lxAdvance()
    else if lxSkipWhitespaceAndComments_c == "$" and lxPeekAt(1) == "-"
        lxAdvance()
        lxAdvance()
        lxSkipWhitespaceAndComments_closed = false
        while lxPos < len(lxChars)
        if lxChars[lxPos] == "-" and lxPeekAt(1) == "$"
            lxAdvance()
            lxAdvance()
            lxSkipWhitespaceAndComments_closed = true
            break
        end
        lxAdvance()
    end
    assert(lxSkipWhitespaceAndComments_closed, "Unterminated comment")
else
    break
end
end
end
function lxReadNumber()
    lxReadNumber_c = lxChars[lxPos]
    lxReadNumber_nextChar = lxPeekAt(1)
    if lxReadNumber_nextChar == null
        lxReadNumber_nextChar = ""
    end
    if lxReadNumber_c == "0" and "xXbBoO".indexOf(lxReadNumber_nextChar) >= 0
        lxReadNumber_p = lxChars[lxPos + 1]
        if lxReadNumber_p == "x" or lxReadNumber_p == "X"
            lxReadNumber_radix = 16
        else if lxReadNumber_p == "b" or lxReadNumber_p == "B"
            lxReadNumber_radix = 2
        else
            lxReadNumber_radix = 8
        end
        lxAdvance()
        lxAdvance()
        lxReadNumber_digits = ""
        while lxPos < len(lxChars)
        lxReadNumber_d = lxChars[lxPos]
        if lxReadNumber_d == "_"
            lxAdvance()
        else if lxDigitValue(lxReadNumber_d) >= 0 and lxDigitValue(lxReadNumber_d) < lxReadNumber_radix
            lxReadNumber_digits += lxReadNumber_d
            lxAdvance()
        else
            break
        end
    end
    assert(len(lxReadNumber_digits) > 0, "Invalid numeric literal")
    return lxMake("Number", parseInt(lxReadNumber_digits, lxReadNumber_radix))
end
lxReadNumber_s = ""
lxReadNumber_lastWasDigit = false
while lxPos < len(lxChars)
lxReadNumber_d = lxChars[lxPos]
if lxIsDigit(lxReadNumber_d)
    lxReadNumber_s += lxReadNumber_d
    lxAdvance()
    lxReadNumber_lastWasDigit = true
else if lxReadNumber_d == "_" and lxReadNumber_lastWasDigit and lxIsDigit(lxPeekAt(1))
    lxAdvance()
    lxReadNumber_lastWasDigit = false
else
    break
end
end
if lxPeek() == "." and lxIsDigit(lxPeekAt(1))
    lxReadNumber_s += "."
    lxAdvance()
    while lxPos < len(lxChars)
    lxReadNumber_d = lxChars[lxPos]
    if lxIsDigit(lxReadNumber_d)
        lxReadNumber_s += lxReadNumber_d
        lxAdvance()
    else if lxReadNumber_d == "_" and lxReadNumber_s[len(lxReadNumber_s) - 1] != "" and lxIsDigit(lxReadNumber_s[len(lxReadNumber_s) - 1]) and lxIsDigit(lxPeekAt(1))
        lxAdvance()
    else
        break
    end
end
end
lxReadNumber_d = lxPeek()
if lxReadNumber_d == "e" or lxReadNumber_d == "E"
    lxReadNumber_exponent = ""
    lxAdvance()
    lxReadNumber_d = lxPeek()
    if lxReadNumber_d == "+" or lxReadNumber_d == "-"
        lxReadNumber_exponent += lxAdvance()
    end
    lxReadNumber_sawDigit = false
    while lxPos < len(lxChars)
    lxReadNumber_d = lxChars[lxPos]
    if lxIsDigit(lxReadNumber_d)
        lxReadNumber_exponent += lxReadNumber_d
        lxAdvance()
        lxReadNumber_sawDigit = true
    else if lxReadNumber_d == "_" and lxReadNumber_sawDigit and lxIsDigit(lxPeekAt(1))
        lxAdvance()
    else
        break
    end
end
assert(lxReadNumber_sawDigit, "Invalid exponent in numeric literal")
lxReadNumber_s += "e" + lxReadNumber_exponent
end
return lxMake("Number", toNumber(lxReadNumber_s))
end
function lxReadInterpolation(lxReadInterpolation_exprLine, lxReadInterpolation_exprCol)
    lxReadInterpolation_raw = ""
    lxReadInterpolation_depth = 0
    while true
    assert(lxPos < len(lxChars), "Unclosed interpolation")
    lxReadInterpolation_c = lxPeek()
    if lxReadInterpolation_c == "\\"
        lxReadInterpolation_raw += lxReadInterpolation_c
        lxAdvance()
        if lxPos < len(lxChars)
            lxReadInterpolation_raw += lxChars[lxPos]
            lxAdvance()
        end
    else if lxReadInterpolation_c == "\""
        lxReadInterpolation_raw += "\""
        lxAdvance()
        while true
        assert(lxPos < len(lxChars), "Unterminated string literal")
        lxReadInterpolation_d = lxAdvance()
        lxReadInterpolation_raw += lxReadInterpolation_d
        if lxReadInterpolation_d == "\""
            break
        end
        if lxReadInterpolation_d == "\\" and lxPos < len(lxChars)
            lxReadInterpolation_raw += lxChars[lxPos]
            lxAdvance()
        end
    end
else if lxReadInterpolation_c == "$" and lxPeekAt(1) == "-"
    lxReadInterpolation_raw += "$"
    lxReadInterpolation_raw += "-"
    lxAdvance()
    lxAdvance()
    while lxPos < len(lxChars)
    lxReadInterpolation_d = lxAdvance()
    lxReadInterpolation_raw += lxReadInterpolation_d
    if lxReadInterpolation_d == "-" and lxPeek() == "$"
        lxReadInterpolation_raw += "$"
        lxAdvance()
        break
    end
end
else if lxReadInterpolation_c == "\{"
lxReadInterpolation_depth += 1
lxReadInterpolation_raw += "\{"
lxAdvance()
else if lxReadInterpolation_c == "\}"
lxAdvance()
if lxReadInterpolation_depth == 0
    break
end
lxReadInterpolation_depth -= 1
lxReadInterpolation_raw += "\}"
else
    lxReadInterpolation_raw += lxReadInterpolation_c
    lxAdvance()
end
end
lxReadInterpolation_savedSrc = lxSrc
lxReadInterpolation_savedChars = lxChars
lxReadInterpolation_savedPos = lxPos
lxReadInterpolation_savedLine = lxLine
lxReadInterpolation_savedCol = lxCol
lxReadInterpolation_savedTokens = lxTokens
lxReadInterpolation_savedTokLine = lxTokLine
lxReadInterpolation_savedTokCol = lxTokCol
lxReadInterpolation_inner = lex(lxReadInterpolation_raw)
for lxReadInterpolation_i in range(len(lxReadInterpolation_inner))
    lxReadInterpolation_tok = lxReadInterpolation_inner[lxReadInterpolation_i]
    if lxReadInterpolation_tok.line == 1
        lxReadInterpolation_tok.col = lxReadInterpolation_exprCol + lxReadInterpolation_tok.col - 1
    end
    lxReadInterpolation_tok.line = lxReadInterpolation_exprLine + lxReadInterpolation_tok.line - 1
end
lxSrc = lxReadInterpolation_savedSrc
lxChars = lxReadInterpolation_savedChars
lxPos = lxReadInterpolation_savedPos
lxLine = lxReadInterpolation_savedLine
lxCol = lxReadInterpolation_savedCol
lxTokens = lxReadInterpolation_savedTokens
lxTokLine = lxReadInterpolation_savedTokLine
lxTokCol = lxReadInterpolation_savedTokCol
return lxReadInterpolation_inner
end
function lxReadString()
    lxAdvance()
    lxReadString_literal = ""
    lxReadString_parts = []
    while true
    assert(lxPos < len(lxChars), "Unterminated string literal")
    lxReadString_c = lxAdvance()
    if lxReadString_c == "\""
        break
    else if lxReadString_c == "\\"
        assert(lxPos < len(lxChars), "Unterminated string literal")
        lxReadString_e = lxAdvance()
        if lxReadString_e == "n"
            lxReadString_literal += fromCharCode(10)
        else if lxReadString_e == "t"
            lxReadString_literal += fromCharCode(9)
        else if lxReadString_e == "r"
            lxReadString_literal += fromCharCode(13)
        else if lxReadString_e == "0"
            lxReadString_literal += fromCharCode(0)
        else if lxReadString_e == "u"
            assert(lxPeek() == "\{", "Invalid unicode escape")
            lxAdvance()
            lxReadString_hex = ""
            lxReadString_closed = false
            while lxPos < len(lxChars)
            lxReadString_h = lxAdvance()
            if lxReadString_h == "\}"
                lxReadString_closed = true
                break
            end
            lxReadString_hex += lxReadString_h
        end
        assert(lxReadString_closed, "Invalid unicode escape")
        lxReadString_literal += fromCharCode(parseInt(lxReadString_hex, 16))
    else
        lxReadString_literal += lxReadString_e
    end
else if lxReadString_c == "\{"
    if lxPeek() == "\{"
        lxAdvance()
        lxReadString_literal += "\{"
    else
        if lxReadString_literal != ""
        lxReadString_parts.add({type: "Literal", value: lxReadString_literal})
        lxReadString_literal = ""
    end
    lxReadString_exprLine = lxLine
    lxReadString_exprCol = lxCol
    lxReadString_exprTokens = lxReadInterpolation(lxReadString_exprLine, lxReadString_exprCol)
    assert(len(lxReadString_exprTokens) > 0 and lxReadString_exprTokens[0].type != "Eof", "Empty interpolation")
    lxReadString_parts.add({type: "Expr", value: lxReadString_exprTokens})
end
else if lxReadString_c == "\}"
if lxPeek() == "\}"
    lxAdvance()
end
lxReadString_literal += "\}"
else
    lxReadString_literal += lxReadString_c
end
end
if len(lxReadString_parts) == 0
    return lxMake("String", lxReadString_literal)
end
if lxReadString_literal != ""
    lxReadString_parts.add({type: "Literal", value: lxReadString_literal})
end
return lxMake("Interpolated", lxReadString_parts)
end
function lxReadIdentifier()
    lxReadIdentifier_s = ""
    while lxPos < len(lxChars)
    lxReadIdentifier_c = lxChars[lxPos]
    if lxIsLetter(lxReadIdentifier_c) or lxIsDigit(lxReadIdentifier_c) or lxReadIdentifier_c == "_"
        lxReadIdentifier_s += lxReadIdentifier_c
        lxAdvance()
    else
        break
    end
end
lxReadIdentifier_keywords = {if: "If", else: "Else", end: "End", function: "Function", return: "Return", repeat: "Repeat", while: "While", for: "For", in: "In", import: "Import", and: "And", or: "Or", not: "Not", break: "Break", continue: "Continue", div: "Div", true: "True", false: "False", null: "Null"}
lxReadIdentifier_kw = lxReadIdentifier_keywords.get(lxReadIdentifier_s)
if lxReadIdentifier_kw != null
    return lxMake(lxReadIdentifier_kw, lxReadIdentifier_s)
end
return lxMake("Identifier", lxReadIdentifier_s)
end
function lxReadSymbol()
    lxReadSymbol_c = lxAdvance()
    if lxReadSymbol_c == "+"
        if lxPeek() == "+"
            lxAdvance()
            return lxMake("PlusPlus", null)
        end
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("+")
        end
        return lxMake("Plus", null)
    end
    if lxReadSymbol_c == "-"
        if lxPeek() == "-"
            lxAdvance()
            return lxMake("MinusMinus", null)
        end
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("-")
        end
        return lxMake("Minus", null)
    end
    if lxReadSymbol_c == "*"
        if lxPeek() == "*" and lxPeekAt(1) == "="
            lxAdvance()
            lxAdvance()
            return lxMakeCompound("**")
        end
        if lxPeek() == "*"
            lxAdvance()
            return lxMake("Pow", null)
        end
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("*")
        end
        return lxMake("Star", null)
    end
    if lxReadSymbol_c == "/"
        if lxPeek() == "/" and lxPeekAt(1) == "="
            lxAdvance()
            lxAdvance()
            return lxMakeCompound("//")
        end
        if lxPeek() == "/"
            lxAdvance()
            return lxMake("FloorDiv", null)
        end
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("/")
        end
        return lxMake("Slash", null)
    end
    if lxReadSymbol_c == "%"
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("%")
        end
        return lxMake("Percent", null)
    end
    if lxReadSymbol_c == "("
        return lxMake("LParen", null)
    end
    if lxReadSymbol_c == ")"
        return lxMake("RParen", null)
    end
    if lxReadSymbol_c == "["
        return lxMake("LBracket", null)
    end
    if lxReadSymbol_c == "]"
        return lxMake("RBracket", null)
    end
    if lxReadSymbol_c == "\{"
        return lxMake("LBrace", null)
    end
    if lxReadSymbol_c == "\}"
        return lxMake("RBrace", null)
    end
    if lxReadSymbol_c == "."
        return lxMake("Dot", null)
    end
    if lxReadSymbol_c == ","
        return lxMake("Comma", null)
    end
    if lxReadSymbol_c == ":"
        return lxMake("Colon", null)
    end
    if lxReadSymbol_c == "&"
        if lxPeek() == "&"
            lxAdvance()
            return lxMake("AndAlso", null)
        end
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("&")
        end
        return lxMake("BitAnd", null)
    end
    if lxReadSymbol_c == "|"
        if lxPeek() == "|"
            lxAdvance()
            return lxMake("OrElse", null)
        end
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("|")
        end
        return lxMake("BitOr", null)
    end
    if lxReadSymbol_c == "^"
        if lxPeek() == "="
            lxAdvance()
            return lxMakeCompound("^")
        end
        return lxMake("BitXor", null)
    end
    if lxReadSymbol_c == "~"
        return lxMake("BitNot", null)
    end
    if lxReadSymbol_c == "?"
        if lxPeek() == "?"
            lxAdvance()
            return lxMake("NullCoalesce", null)
        end
        return lxMake("Question", null)
    end
    if lxReadSymbol_c == "="
        if lxPeek() == "="
            lxAdvance()
            return lxMake("Eq", null)
        end
        return lxMake("Assign", null)
    end
    if lxReadSymbol_c == "!"
        if lxPeek() == "="
            lxAdvance()
            return lxMake("NotEq", null)
        end
        return lxMake("Bang", null)
    end
    if lxReadSymbol_c == ">"
        if lxPeek() == "="
            lxAdvance()
            return lxMake("GtEq", null)
        end
        if lxPeek() == ">" and lxPeekAt(1) == "="
            lxAdvance()
            lxAdvance()
            return lxMakeCompound(">>")
        end
        if lxPeek() == ">"
            lxAdvance()
            return lxMake("Shr", null)
        end
        return lxMake("Gt", null)
    end
    if lxReadSymbol_c == "<"
        if lxPeek() == "="
            lxAdvance()
            return lxMake("LtEq", null)
        end
        if lxPeek() == "<" and lxPeekAt(1) == "="
            lxAdvance()
            lxAdvance()
            return lxMakeCompound("<<")
        end
        if lxPeek() == "<"
            lxAdvance()
            return lxMake("Shl", null)
        end
        return lxMake("Lt", null)
    end
    assert(false, "Unexpected character '" + lxReadSymbol_c + "'")
end
function lex(source)
    lxSrc = source
$- Indexing a string re-decodes it on every access in the native VM. Cache
       one char array so lexing a large compiler source stays linear. -$
    lxChars = lxSrc.chars()
    if len(lxChars) > 0 and charCode(lxChars[0]) == 65279
        lxChars = lxChars.slice(1)
        lxSrc = lxSrc.slice(1, len(lxSrc))
    end
    lxPos = 0
    lxLine = 1
    lxCol = 1
    lxTokens = []
    while true
    lxSkipWhitespaceAndComments()
    if lxPos >= len(lxChars)
        lxTokLine = lxLine
        lxTokCol = lxCol
        lxTokens.add(lxMake("Eof", null))
        break
    end
    lex_c = lxChars[lxPos]
    if lex_c == "\n"
        lxTokLine = lxLine
        lxTokCol = lxCol
        lxAdvance()
        lxTokens.add(lxMake("Newline", null))
        continue
    end
    if lex_c == "#"
        lxSkipToEndOfLine()
        continue
    end
    if lex_c == "/" and lxPeekAt(1) == "/" and lxPeekAt(2) != "="
        lex_previousEnds = false
        if len(lxTokens) > 0
            lex_previousEnds = lxEndsExpression(lxTokens[len(lxTokens) - 1].type) and lxTokens[len(lxTokens) - 1].line == lxLine
        end
        if not lex_previousEnds
            lxSkipToEndOfLine()
            continue
        end
    end
    lxTokLine = lxLine
    lxTokCol = lxCol
    if lxIsDigit(lex_c)
        lxTokens.add(lxReadNumber())
    else if lex_c == "\""
        lxTokens.add(lxReadString())
    else if lxIsLetter(lex_c) or lex_c == "_"
        lxTokens.add(lxReadIdentifier())
    else
        lxTokens.add(lxReadSymbol())
    end
end
return lxTokens
end
$- ---------------------------------------------------------------------------
   Parser state. The parser mirrors src/parser.rs and produces the AST JSON
   object shape from docs/selfhost/CONTRACT.md section 6.
   --------------------------------------------------------------------------- -$
paTokens = []
paPos = 0
paLoopDepth = 0
function paPeek()
    return paTokens[paPos]
end
function paType()
    return paTokens[paPos].type
end
function paSpan()
    paSpan_tok = paPeek()
    return {line: paSpan_tok.line, col: paSpan_tok.col}
end
function paSpanAt(paSpanAt_line, paSpanAt_col)
    return {line: paSpanAt_line, col: paSpanAt_col}
end
function paAdvance()
    paAdvance_tok = paPeek()
    if paAdvance_tok.type != "Eof"
        paPos += 1
    end
    return paAdvance_tok
end
function paCheck(paCheck_type)
    return paType() == paCheck_type
end
function paMatches(paMatches_type)
    if paCheck(paMatches_type)
        paAdvance()
        return true
    end
    return false
end
function paExpect(paExpect_type, paExpect_context)
    assert(paCheck(paExpect_type), "Expected " + paExpect_type + " " + paExpect_context + ", found " + paType())
    return paAdvance()
end
function paSkipNewlines()
    while paCheck("Newline")
    paAdvance()
end
end
function paEndOfStatement()
    paEndOfStatement_t = paType()
    assert(paEndOfStatement_t == "Newline" or paEndOfStatement_t == "Eof", "Expected end of line, found " + paEndOfStatement_t)
    paSkipNewlines()
end
function paAtEnd()
    return paCheck("Eof")
end
function paKeywordName(paKeywordName_type)
    paKeywordName_names = {True: "true", False: "false", Null: "null", If: "if", Else: "else", End: "end", Function: "function", Return: "return", Repeat: "repeat", While: "while", For: "for", In: "in", Import: "import", And: "and", Or: "or", Not: "not", Break: "break", Continue: "continue", Div: "div"}
    return paKeywordName_names.get(paKeywordName_type)
end
function paExpectIdentifier(paExpectIdentifier_context)
    assert(paCheck("Identifier"), "Expected identifier " + paExpectIdentifier_context + ", found " + paType())
    return paAdvance().value
end
function paExpectMemberName(paExpectMemberName_context)
    paExpectMemberName_t = paType()
    paExpectMemberName_name = paPeek().value
    if paExpectMemberName_t != "Identifier"
        paExpectMemberName_name = paKeywordName(paExpectMemberName_t)
    end
    assert(paExpectMemberName_name != null, "Expected member name " + paExpectMemberName_context + ", found " + paExpectMemberName_t)
    paAdvance()
    return paExpectMemberName_name
end
function paRequireInLoop(paRequireInLoop_word)
    assert(paLoopDepth > 0, "'" + paRequireInLoop_word + "' can only be used inside a loop")
end
function paRepeatIsCall()
    if paType() != "Repeat"
        return false
    end
    if paPos + 1 >= len(paTokens) or paTokens[paPos + 1].type != "LParen"
        return false
    end
    paRepeatIsCall_depth = 0
    paRepeatIsCall_i = paPos + 1
    while paRepeatIsCall_i < len(paTokens)
    paRepeatIsCall_t = paTokens[paRepeatIsCall_i].type
    if paRepeatIsCall_t == "LParen"
        paRepeatIsCall_depth += 1
    else if paRepeatIsCall_t == "RParen"
        paRepeatIsCall_depth -= 1
        if paRepeatIsCall_depth == 0
            return false
        end
    else if paRepeatIsCall_t == "Comma" and paRepeatIsCall_depth == 1
