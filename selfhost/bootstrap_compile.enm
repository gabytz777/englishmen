end
function vmScopeGet(vmScopeGet_scope, vmScopeGet_name)
    vmScopeGet_cursor = vmScopeGet_scope
    while vmScopeGet_cursor != null
    if vmScopeGet_cursor.vars.has(vmScopeGet_name)
        return vmScopeGet_cursor.vars.get(vmScopeGet_name, null)
    end
    vmScopeGet_cursor = vmScopeGet_cursor.parent
