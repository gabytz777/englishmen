    end
    if ch == "ﬁ"
        return "fi"
    end
    if ch == "ﬂ"
        return "fl"
    end
    if ch == "ﬃ"
        return "ffi"
    end
    if ch == "ﬄ"
        return "ffl"
    end
    if ch == "ﬅ" or ch == "ﬆ"
        return "st"
    end
    if ch == "ς"
        return "σ"
    end
    return lower(ch)
end
function pmtCapitalizeWord(word)
    if word == ""
        return ""
    end
    pmtCapitalizeWord_chars = pmtChars(word)
    return upper(pmtCapitalizeWord_chars[0]) + lower(slice(word, 1, len(pmtCapitalizeWord_chars)))
end
function pmtWords(text)
    pmtWords_chars = pmtChars(text)
    pmtWords_out = []
    pmtWords_current = ""
    pmtWords_i = 0
    while pmtWords_i < len(pmtWords_chars)
    pmtWords_ch = pmtWords_chars[pmtWords_i]
    if pmtWords_ch.isBlank()
        if pmtWords_current != ""
            pmtWords_out.add(pmtWords_current)
            pmtWords_current = ""
        end
    else
        pmtWords_current += pmtWords_ch
    end
    pmtWords_i += 1
end
if pmtWords_current != ""
    pmtWords_out.add(pmtWords_current)
end
return pmtWords_out
end
function pmtIdentifierWords(text)
    pmtIdentifierWords_chars = pmtChars(text)
    pmtIdentifierWords_out = []
    pmtIdentifierWords_current = ""
    pmtIdentifierWords_i = 0
    while pmtIdentifierWords_i < len(pmtIdentifierWords_chars)
    pmtIdentifierWords_ch = pmtIdentifierWords_chars[pmtIdentifierWords_i]
    if not pmtIsAlphaNum(pmtIdentifierWords_ch)
        if pmtIdentifierWords_current != ""
            pmtIdentifierWords_out.add(lower(pmtIdentifierWords_current))
            pmtIdentifierWords_current = ""
        end
        pmtIdentifierWords_i += 1
        continue
    end
    if pmtIsUpperChar(pmtIdentifierWords_ch) and pmtIdentifierWords_current != ""
        pmtIdentifierWords_previous = pmtIdentifierWords_chars[pmtIdentifierWords_i - 1]
        pmtIdentifierWords_nextLower = false
        if pmtIdentifierWords_i + 1 < len(pmtIdentifierWords_chars)
            pmtIdentifierWords_nextLower = pmtIsLowerChar(pmtIdentifierWords_chars[pmtIdentifierWords_i + 1])
        end
        pmtIdentifierWords_boundary = pmtIsLowerChar(pmtIdentifierWords_previous) or pmtIdentifierWords_previous.isDigit() or (pmtIsUpperChar(pmtIdentifierWords_previous) and pmtIdentifierWords_nextLower)
        if pmtIdentifierWords_boundary
            pmtIdentifierWords_out.add(lower(pmtIdentifierWords_current))
            pmtIdentifierWords_current = ""
        end
    end
    pmtIdentifierWords_current += pmtIdentifierWords_ch
    pmtIdentifierWords_i += 1
end
if pmtIdentifierWords_current != ""
    pmtIdentifierWords_out.add(lower(pmtIdentifierWords_current))
end
return pmtIdentifierWords_out
end
function pmtTrimDashes(text)
    pmtTrimDashes_out = text
    while pmtTrimDashes_out.startsWith("-")
    pmtTrimDashes_out = slice(pmtTrimDashes_out, 1, len(pmtTrimDashes_out))
end
while pmtTrimDashes_out.endsWith("-")
pmtTrimDashes_out = slice(pmtTrimDashes_out, 0, len(pmtTrimDashes_out) - 1)
end
return pmtTrimDashes_out
end
function pmtSplitInclusive(text)
    pmtSplitInclusive_chars = pmtChars(text)
    pmtSplitInclusive_out = []
    pmtSplitInclusive_start = 0
    pmtSplitInclusive_i = 0
    while pmtSplitInclusive_i < len(pmtSplitInclusive_chars)
    if pmtSplitInclusive_chars[pmtSplitInclusive_i] == "\n"
        pmtSplitInclusive_out.add(slice(text, pmtSplitInclusive_start, pmtSplitInclusive_i + 1))
        pmtSplitInclusive_start = pmtSplitInclusive_i + 1
    end
    pmtSplitInclusive_i += 1
end
if pmtSplitInclusive_start < len(pmtSplitInclusive_chars)
    pmtSplitInclusive_out.add(slice(text, pmtSplitInclusive_start, len(pmtSplitInclusive_chars)))
end
return pmtSplitInclusive_out
end
function pmtSplitLineEnding(segment)
    if not segment.endsWith("\n")
        return [segment, ""]
    end
    pmtSplitLineEnding_body = slice(segment, 0, len(segment) - 1)
    if pmtSplitLineEnding_body.endsWith("\n")
        return [slice(pmtSplitLineEnding_body, 0, len(pmtSplitLineEnding_body) - 1), "\n\n"]
    end
    return [pmtSplitLineEnding_body, "\n"]
end
function pmtLeadingIndent(body)
    pmtLeadingIndent_chars = pmtChars(body)
    pmtLeadingIndent_i = 0
    while pmtLeadingIndent_i < len(pmtLeadingIndent_chars)
    if pmtLeadingIndent_chars[pmtLeadingIndent_i] != " " and pmtLeadingIndent_chars[pmtLeadingIndent_i] != "\t"
        break
    end
    pmtLeadingIndent_i += 1
end
return pmtLeadingIndent_i
end
function pmtSubstringCount(text, needle)
    pmtSubstringCount_chars = pmtChars(text)
    pmtSubstringCount_needle = pmtChars(needle)
    pmtSubstringCount_needleLen = len(pmtSubstringCount_needle)
    pmtSubstringCount_count = 0
    pmtSubstringCount_i = 0
    while pmtSubstringCount_i + pmtSubstringCount_needleLen <= len(pmtSubstringCount_chars)
    pmtSubstringCount_matches = true
    pmtSubstringCount_j = 0
    while pmtSubstringCount_j < pmtSubstringCount_needleLen
    if pmtSubstringCount_chars[pmtSubstringCount_i + pmtSubstringCount_j] != pmtSubstringCount_needle[pmtSubstringCount_j]
        pmtSubstringCount_matches = false
        break
    end
    pmtSubstringCount_j += 1
end
if pmtSubstringCount_matches
    pmtSubstringCount_count += 1
    pmtSubstringCount_i += pmtSubstringCount_needleLen
else
    pmtSubstringCount_i += 1
end
end
return pmtSubstringCount_count
end
$- ---------------------------------------------------------------------------
   Text module functions
   --------------------------------------------------------------------------- -$
function pmtTextWords(text)
    return pmtWords(pmtStringArg(text, "for text.words"))
end
function pmtTextTitle(text)
    pmtTextTitle_words = pmtWords(pmtStringArg(text, "for text.title"))
    pmtTextTitle_out = []
    pmtTextTitle_i = 0
    while pmtTextTitle_i < len(pmtTextTitle_words)
    pmtTextTitle_out.add(pmtCapitalizeWord(pmtTextTitle_words[pmtTextTitle_i]))
    pmtTextTitle_i += 1
end
return join(pmtTextTitle_out, " ")
end
function pmtTextCapitalize(text)
    return pmtCapitalizeWord(pmtStringArg(text, "for text.capitalize"))
end
function pmtTextSwapCase(text)
    pmtTextSwapCase_chars = pmtChars(pmtStringArg(text, "for text.swapCase"))
    pmtTextSwapCase_out = ""
    pmtTextSwapCase_i = 0
    while pmtTextSwapCase_i < len(pmtTextSwapCase_chars)
    pmtTextSwapCase_ch = pmtTextSwapCase_chars[pmtTextSwapCase_i]
    if pmtIsUpperChar(pmtTextSwapCase_ch)
        pmtTextSwapCase_out += lower(pmtTextSwapCase_ch)
    else
        pmtTextSwapCase_out += upper(pmtTextSwapCase_ch)
    end
    pmtTextSwapCase_i += 1
end
return pmtTextSwapCase_out
end
function pmtTextSnake(text)
    return join(pmtIdentifierWords(pmtStringArg(text, "for text.snake")), "_")
end
function pmtTextKebab(text)
    return join(pmtIdentifierWords(pmtStringArg(text, "for text.kebab")), "-")
end
function pmtTextCamel(text)
    pmtTextCamel_words = pmtIdentifierWords(pmtStringArg(text, "for text.camel"))
    pmtTextCamel_out = ""
    pmtTextCamel_i = 0
    while pmtTextCamel_i < len(pmtTextCamel_words)
    if pmtTextCamel_i == 0
        pmtTextCamel_out += pmtTextCamel_words[pmtTextCamel_i]
    else
        pmtTextCamel_out += pmtCapitalizeWord(pmtTextCamel_words[pmtTextCamel_i])
    end
    pmtTextCamel_i += 1
end
return pmtTextCamel_out
end
function pmtTextPascal(text)
    pmtTextPascal_words = pmtIdentifierWords(pmtStringArg(text, "for text.pascal"))
    pmtTextPascal_out = ""
    pmtTextPascal_i = 0
    while pmtTextPascal_i < len(pmtTextPascal_words)
    pmtTextPascal_out += pmtCapitalizeWord(pmtTextPascal_words[pmtTextPascal_i])
    pmtTextPascal_i += 1
end
return pmtTextPascal_out
end
function pmtTextSlug(text)
    pmtTextSlug_chars = pmtChars(pmtStringArg(text, "for text.slug"))
    pmtTextSlug_out = ""
    pmtTextSlug_i = 0
    while pmtTextSlug_i < len(pmtTextSlug_chars)
    pmtTextSlug_ch = pmtTextSlug_chars[pmtTextSlug_i]
    if pmtIsAlphaNum(pmtTextSlug_ch)
        pmtTextSlug_out += lower(pmtTextSlug_ch)
    else if not pmtTextSlug_out.endsWith("-")
        pmtTextSlug_out += "-"
    end
    pmtTextSlug_i += 1
end
return pmtTrimDashes(pmtTextSlug_out)
end
function pmtTextCollapseWhitespace(text)
    return join(pmtWords(pmtStringArg(text, "for text.collapseWhitespace")), " ")
end
function pmtTextCount(text, needle)
    pmtTextCount_text = pmtStringArg(text, "for text.count")
    pmtTextCount_needle = pmtStringArg(needle, "as the substring for text.count")
    if pmtTextCount_needle == ""
        assert(false, "text.count needs a non-empty substring")
    end
    return pmtSubstringCount(pmtTextCount_text, pmtTextCount_needle)
end
function pmtTextTruncate(text, width, suffix)
    pmtTextTruncate_text = pmtStringArg(text, "for text.truncate")
    pmtTextTruncate_width = pmtWidthArg(width, "as the width for text.truncate")
    pmtTextTruncate_suffix = "..."
    if suffix != null
        pmtTextTruncate_suffix = pmtStringArg(suffix, "as the suffix for text.truncate")
    end
    pmtTextTruncate_chars = len(pmtTextTruncate_text)
    if pmtTextTruncate_chars <= pmtTextTruncate_width
        return pmtTextTruncate_text
    end
    pmtTextTruncate_suffixLen = len(pmtTextTruncate_suffix)
    if pmtTextTruncate_suffixLen >= pmtTextTruncate_width
        return slice(pmtTextTruncate_text, 0, pmtTextTruncate_width)
    end
    return slice(pmtTextTruncate_text, 0, pmtTextTruncate_width - pmtTextTruncate_suffixLen) + pmtTextTruncate_suffix
end
function pmtTextWrap(text, width)
    pmtTextWrap_width = pmtWidthArg(width, "as the width for text.wrap")
    if pmtTextWrap_width == 0
        assert(false, "text.wrap width must be greater than zero")
    end
    pmtTextWrap_words = pmtWords(pmtStringArg(text, "for text.wrap"))
    pmtTextWrap_lines = []
    pmtTextWrap_current = ""
    pmtTextWrap_i = 0
    while pmtTextWrap_i < len(pmtTextWrap_words)
    pmtTextWrap_word = pmtTextWrap_words[pmtTextWrap_i]
    if pmtTextWrap_current == ""
        pmtTextWrap_current = pmtTextWrap_word
    else if len(pmtTextWrap_current) + 1 + len(pmtTextWrap_word) <= pmtTextWrap_width
        pmtTextWrap_current += " " + pmtTextWrap_word
    else
        pmtTextWrap_lines.add(pmtTextWrap_current)
        pmtTextWrap_current = pmtTextWrap_word
    end
    pmtTextWrap_i += 1
end
if pmtTextWrap_current != ""
    pmtTextWrap_lines.add(pmtTextWrap_current)
end
return pmtTextWrap_lines
end
function pmtTextIndent(text, prefix)
    pmtTextIndent_segments = pmtSplitInclusive(pmtStringArg(text, "for text.indent"))
    pmtTextIndent_prefixText = pmtStringArg(prefix, "as the prefix for text.indent")
    pmtTextIndent_out = ""
    pmtTextIndent_i = 0
    while pmtTextIndent_i < len(pmtTextIndent_segments)
    pmtTextIndent_out += pmtTextIndent_prefixText + pmtTextIndent_segments[pmtTextIndent_i]
    pmtTextIndent_i += 1
end
return pmtTextIndent_out
end
function pmtTextDedent(text)
    pmtTextDedent_segments = pmtSplitInclusive(pmtStringArg(text, "for text.dedent"))
    pmtTextDedent_common = null
    pmtTextDedent_i = 0
    while pmtTextDedent_i < len(pmtTextDedent_segments)
    pmtTextDedent_parts = pmtSplitLineEnding(pmtTextDedent_segments[pmtTextDedent_i])
    pmtTextDedent_body = pmtTextDedent_parts[0]
    if trim(pmtTextDedent_body) != ""
        pmtTextDedent_indent = pmtLeadingIndent(pmtTextDedent_body)
        if pmtTextDedent_common == null or pmtTextDedent_indent < pmtTextDedent_common
            pmtTextDedent_common = pmtTextDedent_indent
        end
    end
    pmtTextDedent_i += 1
end
if pmtTextDedent_common == null
    pmtTextDedent_common = 0
end
pmtTextDedent_out = ""
pmtTextDedent_i = 0
while pmtTextDedent_i < len(pmtTextDedent_segments)
pmtTextDedent_parts = pmtSplitLineEnding(pmtTextDedent_segments[pmtTextDedent_i])
pmtTextDedent_body = pmtTextDedent_parts[0]
pmtTextDedent_out += slice(pmtTextDedent_body, pmtTextDedent_common, len(pmtTextDedent_body)) + pmtTextDedent_parts[1]
pmtTextDedent_i += 1
end
return pmtTextDedent_out
end
function pmtTextReverseWords(text)
    return join(reversed(pmtWords(pmtStringArg(text, "for text.reverseWords"))), " ")
end
function pmtTextInitials(text)
    pmtTextInitials_words = pmtWords(pmtStringArg(text, "for text.initials"))
    pmtTextInitials_out = ""
    pmtTextInitials_i = 0
    while pmtTextInitials_i < len(pmtTextInitials_words)
    pmtTextInitials_out += upper(first(pmtTextInitials_words[pmtTextInitials_i]))
    pmtTextInitials_i += 1
end
return pmtTextInitials_out
end
function pmtTextIsPalindrome(text)
    pmtTextIsPalindrome_chars = pmtChars(pmtStringArg(text, "for text.isPalindrome"))
    pmtTextIsPalindrome_folded = ""
    pmtTextIsPalindrome_i = 0
    while pmtTextIsPalindrome_i < len(pmtTextIsPalindrome_chars)
    pmtTextIsPalindrome_ch = pmtTextIsPalindrome_chars[pmtTextIsPalindrome_i]
    if pmtIsAlphaNum(pmtTextIsPalindrome_ch)
        pmtTextIsPalindrome_folded += pmtCasefoldChar(pmtTextIsPalindrome_ch)
    end
    pmtTextIsPalindrome_i += 1
end
pmtTextIsPalindrome_normalized = pmtChars(pmtTextIsPalindrome_folded)
pmtTextIsPalindrome_left = 0
pmtTextIsPalindrome_right = len(pmtTextIsPalindrome_normalized) - 1
while pmtTextIsPalindrome_left < pmtTextIsPalindrome_right
if pmtTextIsPalindrome_normalized[pmtTextIsPalindrome_left] != pmtTextIsPalindrome_normalized[pmtTextIsPalindrome_right]
    return false
end
pmtTextIsPalindrome_left += 1
pmtTextIsPalindrome_right -= 1
end
return true
end
function pmtTextLevenshtein(left, right)
    pmtTextLevenshtein_a = pmtChars(pmtStringArg(left, "for text.levenshtein"))
    pmtTextLevenshtein_b = pmtChars(pmtStringArg(right, "as the second string for text.levenshtein"))
    pmtTextLevenshtein_aLen = len(pmtTextLevenshtein_a)
    pmtTextLevenshtein_bLen = len(pmtTextLevenshtein_b)
    if pmtTextLevenshtein_aLen == 0
        return pmtTextLevenshtein_bLen
    end
    if pmtTextLevenshtein_bLen == 0
        return pmtTextLevenshtein_aLen
    end
    if pmtTextLevenshtein_aLen * pmtTextLevenshtein_bLen > 1000000
        assert(false, "text.levenshtein inputs are too long")
    end
    pmtTextLevenshtein_previous = []
    pmtTextLevenshtein_j = 0
    while pmtTextLevenshtein_j <= pmtTextLevenshtein_bLen
    pmtTextLevenshtein_previous.add(pmtTextLevenshtein_j)
    pmtTextLevenshtein_j += 1
end
pmtTextLevenshtein_i = 0
while pmtTextLevenshtein_i < pmtTextLevenshtein_aLen
pmtTextLevenshtein_current = []
pmtTextLevenshtein_j = 0
while pmtTextLevenshtein_j <= pmtTextLevenshtein_bLen
pmtTextLevenshtein_current.add(0)
pmtTextLevenshtein_j += 1
end
pmtTextLevenshtein_current[0] = pmtTextLevenshtein_i + 1
pmtTextLevenshtein_j = 0
while pmtTextLevenshtein_j < pmtTextLevenshtein_bLen
pmtTextLevenshtein_cost = 0
if pmtTextLevenshtein_a[pmtTextLevenshtein_i] != pmtTextLevenshtein_b[pmtTextLevenshtein_j]
    pmtTextLevenshtein_cost = 1
end
pmtTextLevenshtein_delete = pmtTextLevenshtein_previous[pmtTextLevenshtein_j + 1] + 1
pmtTextLevenshtein_insert = pmtTextLevenshtein_current[pmtTextLevenshtein_j] + 1
pmtTextLevenshtein_replace = pmtTextLevenshtein_previous[pmtTextLevenshtein_j] + pmtTextLevenshtein_cost
pmtTextLevenshtein_current[pmtTextLevenshtein_j + 1] = min(pmtTextLevenshtein_delete, pmtTextLevenshtein_insert, pmtTextLevenshtein_replace)
pmtTextLevenshtein_j += 1
end
pmtTextLevenshtein_previous = pmtTextLevenshtein_current
pmtTextLevenshtein_i += 1
end
return pmtTextLevenshtein_previous[pmtTextLevenshtein_bLen]
end
function pmtTextModule()
    return {camel: pmtTextCamel, capitalize: pmtTextCapitalize, collapseWhitespace: pmtTextCollapseWhitespace, count: pmtTextCount, dedent: pmtTextDedent, indent: pmtTextIndent, initials: pmtTextInitials, isPalindrome: pmtTextIsPalindrome, kebab: pmtTextKebab, levenshtein: pmtTextLevenshtein, pascal: pmtTextPascal, reverseWords: pmtTextReverseWords, slug: pmtTextSlug, snake: pmtTextSnake, swapCase: pmtTextSwapCase, title: pmtTextTitle, truncate: pmtTextTruncate, words: pmtTextWords, wrap: pmtTextWrap}
end
function pmtAllModules()
    return {math: pmtMathModule(), text: pmtTextModule()}
end
$- ---------------------------------------------------------------------------
   Self-tests: native modules are oracles only below this point.
   --------------------------------------------------------------------------- -$
$- === inlined selfhost/pure_project_cowsay.enm === -$
$- Pure Englishmen replacements for the native `project` and `cowsay` modules.
   Self-contained by design: Englishmen has no local `.enm` imports, so every
   global helper is prefixed with `ppc` to survive concatenation into
   `selfhost/full.enm`. The only import is `os`, used solely for the
   `EM_SELFTEST` guard. Native `project` and `cowsay` are imported only inside
   that guard, where they act as reference oracles.

   File I/O goes through the `host` module (`host.readFile`, `host.writeFile`,
   `host.cwd`, `host.tempDir`, `host.pid`), which the C bootstrap VM exposes to
   every pure module. When the Rust CLI runs the guarded self-test, the guard
   installs a small `host` object backed by the equivalent global builtins.

   Module objects:

       ppcProjectModule() -> {default, parse, load, get, section, name,
                              version, main, write}
       ppcCowModule()     -> {render, say}

   Englishmen functions have fixed arity, so optional native arguments are
   passed as `null` (for example `project.load(null)` means the default path). -$
$- Return the value of one hexadecimal digit, or -1 for anything else. -$
function ppcHexDigit(ppcHexDigit_c)
    ppcHexDigit_n = charCode(ppcHexDigit_c)
    if ppcHexDigit_n >= 48 and ppcHexDigit_n <= 57
        return ppcHexDigit_n - 48
    end
    if ppcHexDigit_n >= 97 and ppcHexDigit_n <= 102
        return ppcHexDigit_n - 87
    end
    if ppcHexDigit_n >= 65 and ppcHexDigit_n <= 70
        return ppcHexDigit_n - 55
    end
    return -1
end
$- Reverse `u32::from_str_radix(digits, 16)` for the 1-4 digits after `\u`. -$
function ppcHexValue(ppcHexValue_digits)
    if ppcHexValue_digits.length() == 0
        return -1
    end
    ppcHexValue_start = 0
    if ppcHexValue_digits[0] == "+"
        ppcHexValue_start = 1
    else if ppcHexValue_digits[0] == "-"
        return -1
    end
    if ppcHexValue_start >= ppcHexValue_digits.length()
        return -1
    end
    ppcHexValue_value = 0
    ppcHexValue_i = ppcHexValue_start
    while ppcHexValue_i < ppcHexValue_digits.length()
    ppcHexValue_digit = ppcHexDigit(ppcHexValue_digits[ppcHexValue_i])
    if ppcHexValue_digit < 0
        return -1
    end
    ppcHexValue_value = ppcHexValue_value * 16 + ppcHexValue_digit
    ppcHexValue_i += 1
end
return ppcHexValue_value
end
$- Four lowercase hex digits, matching Rust's `\u{:04x}` writer. -$
function ppcHex4(ppcHex4_n)
    ppcHex4_digits = "0123456789abcdef"
    ppcHex4_out = ""
    ppcHex4_i = 3
    while ppcHex4_i >= 0
    ppcHex4_out = ppcHex4_digits[ppcHex4_n % 16] + ppcHex4_out
    ppcHex4_n = floor(ppcHex4_n / 16)
    ppcHex4_i -= 1
end
return ppcHex4_out
end
$- `char::from_u32` accepts scalars only: no surrogates and nothing above U+10FFFF. -$
function ppcIsScalar(ppcIsScalar_n)
    if ppcIsScalar_n < 0 or ppcIsScalar_n > 1114111
        return false
    end
    if ppcIsScalar_n >= 55296 and ppcIsScalar_n <= 57343
        return false
    end
    return true
end
$- Reverse `write_quoted` escape by escape. Unknown escapes and malformed
   `\uXXXX` sequences are kept literally, exactly as native `project.parse`
   does. -$
function ppcUnescape(ppcUnescape_text)
    ppcUnescape_chars = ppcUnescape_text.chars()
    ppcUnescape_out = ""
    ppcUnescape_i = 0
    while ppcUnescape_i < ppcUnescape_chars.length()
    ppcUnescape_c = ppcUnescape_chars[ppcUnescape_i]
    if ppcUnescape_c != "\\"
        ppcUnescape_out += ppcUnescape_c
        ppcUnescape_i += 1
        continue
    end
    if ppcUnescape_i + 1 >= ppcUnescape_chars.length()
        ppcUnescape_out += "\\"
        ppcUnescape_i += 1
        continue
    end
    ppcUnescape_next = ppcUnescape_chars[ppcUnescape_i + 1]
    if ppcUnescape_next == "\""
        ppcUnescape_out += "\""
        ppcUnescape_i += 2
    else if ppcUnescape_next == "\\"
        ppcUnescape_out += "\\"
        ppcUnescape_i += 2
    else if ppcUnescape_next == "n"
        ppcUnescape_out += "\n"
        ppcUnescape_i += 2
    else if ppcUnescape_next == "r"
        ppcUnescape_out += fromCharCode(13)
        ppcUnescape_i += 2
    else if ppcUnescape_next == "t"
        ppcUnescape_out += "\t"
        ppcUnescape_i += 2
    else if ppcUnescape_next == "u"
        ppcUnescape_digits = ""
        ppcUnescape_j = ppcUnescape_i + 2
        while ppcUnescape_j < ppcUnescape_chars.length() and ppcUnescape_j < ppcUnescape_i + 6
        ppcUnescape_digits += ppcUnescape_chars[ppcUnescape_j]
        ppcUnescape_j += 1
    end
    ppcUnescape_code = ppcHexValue(ppcUnescape_digits)
    if ppcUnescape_code >= 0 and ppcIsScalar(ppcUnescape_code)
        ppcUnescape_out += fromCharCode(ppcUnescape_code)
    else
        ppcUnescape_out += "\\u"
        ppcUnescape_out += ppcUnescape_digits
    end
    ppcUnescape_i = ppcUnescape_j
else
    ppcUnescape_out += "\\"
    ppcUnescape_out += ppcUnescape_next
    ppcUnescape_i += 2
end
end
return ppcUnescape_out
end
$- Trim, strip one pair of surrounding double quotes, then unescape. -$
function ppcParseValue(ppcParseValue_raw)
    ppcParseValue_trimmed = ppcParseValue_raw.trim()
    if ppcParseValue_trimmed.length() >= 2 and ppcParseValue_trimmed.startsWith("\"") and ppcParseValue_trimmed.endsWith("\"")
        return ppcUnescape(ppcParseValue_trimmed.slice(1, ppcParseValue_trimmed.length() - 1))
    end
    return ppcParseValue_trimmed
end
$- Parse `.emc` text into `{root: object, sections: object}`. Values are read
   as strings; bare numbers, booleans and null keep their textual form. -$
function ppcParse(ppcParse_text)
    if isString(ppcParse_text) == false
        assert(false, "Type mismatch: expected a string as the manifest text for project.parse, found " + type(ppcParse_text))
    end
    ppcParse_root = {}
    ppcParse_sections = {}
    ppcParse_current = null
    ppcParse_lines = ppcParse_text.lines()
    ppcParse_i = 0
    while ppcParse_i < ppcParse_lines.length()
    ppcParse_line = ppcParse_lines[ppcParse_i].trim()
    if ppcParse_line == "" or ppcParse_line.startsWith("#")
        ppcParse_i += 1
        continue
    end
    if ppcParse_line.startsWith("[") and ppcParse_line.endsWith("]")
        ppcParse_name = ppcParse_line.slice(1, ppcParse_line.length() - 1).trim()
        if ppcParse_sections.has(ppcParse_name) == false
            ppcParse_sections.set(ppcParse_name, {})
        end
        ppcParse_current = ppcParse_name
        ppcParse_i += 1
        continue
    end
    ppcParse_equals = ppcParse_line.indexOf("=")
    if ppcParse_equals >= 0
        ppcParse_key = ppcParse_line.slice(0, ppcParse_equals).trim()
        ppcParse_value = ppcParseValue(ppcParse_line.slice(ppcParse_equals + 1))
        if ppcParse_current == null
            ppcParse_root.set(ppcParse_key, ppcParse_value)
        else
            ppcParse_sections.get(ppcParse_current).set(ppcParse_key, ppcParse_value)
        end
    end
    ppcParse_i += 1
end
return {root: ppcParse_root, sections: ppcParse_sections}
end
$- Snapshot and validate the two objects of a parsed config. `op` is the native
   function name used in error messages (name, version, main, get, section,
   write or load). -$
function ppcConfig(ppcConfig_manifest, ppcConfig_op)
    if isObject(ppcConfig_manifest) == false
        assert(false, "Type mismatch: expected a project config object for project." + ppcConfig_op + ", found " + type(ppcConfig_manifest))
    end
    ppcConfig_root = ppcConfig_manifest.get("root")
    if isObject(ppcConfig_root) == false
        if ppcConfig_manifest.has("root")
            assert(false, "project." + ppcConfig_op + " expects 'root' to be an object, found " + type(ppcConfig_root))
        end
        assert(false, "project." + ppcConfig_op + " expects a config with a 'root' object")
    end
    ppcConfig_sections = ppcConfig_manifest.get("sections")
    if isObject(ppcConfig_sections) == false
        if ppcConfig_manifest.has("sections")
            assert(false, "project." + ppcConfig_op + " expects 'sections' to be an object, found " + type(ppcConfig_sections))
        end
        assert(false, "project." + ppcConfig_op + " expects a config with a 'sections' object")
    end
    for ppcConfig_name in ppcConfig_sections.keys()
        ppcConfig_section = ppcConfig_sections.get(ppcConfig_name)
        if isObject(ppcConfig_section) == false
            assert(false, "project." + ppcConfig_op + " expects section '" + ppcConfig_name + "' to be an object, found " + type(ppcConfig_section))
        end
    end
    return {root: ppcConfig_root, sections: ppcConfig_sections}
end
function ppcRootValue(ppcRootValue_manifest, ppcRootValue_op, ppcRootValue_key)
    ppcRootValue_parts = ppcConfig(ppcRootValue_manifest, ppcRootValue_op)
    return ppcRootValue_parts.get("root").get(ppcRootValue_key)
end
function ppcName(ppcName_manifest)
    return ppcRootValue(ppcName_manifest, "name", "name")
end
function ppcVersion(ppcVersion_manifest)
    return ppcRootValue(ppcVersion_manifest, "version", "version")
end
function ppcMain(ppcMain_manifest)
    return ppcRootValue(ppcMain_manifest, "main", "main")
end
function ppcGet(ppcGet_manifest, ppcGet_key)
    if isString(ppcGet_key) == false
        assert(false, "Type mismatch: expected a string as the key for project.get, found " + type(ppcGet_key))
    end
    ppcGet_parts = ppcConfig(ppcGet_manifest, "get")
    return ppcGet_parts.get("root").get(ppcGet_key)
end
function ppcSection(ppcSection_manifest, ppcSection_name)
    if isString(ppcSection_name) == false
        assert(false, "Type mismatch: expected a string as the section name for project.section, found " + type(ppcSection_name))
    end
    ppcSection_parts = ppcConfig(ppcSection_manifest, "section")
    ppcSection_sections = ppcSection_parts.get("sections")
    if ppcSection_sections.has(ppcSection_name) == false
        return {}
    end
    return ppcSection_sections.get(ppcSection_name)
end
$- The native template writes the project name verbatim between quotes. -$
function ppcDefault(ppcDefault_name)
    if isString(ppcDefault_name) == false
        assert(false, "Type mismatch: expected a string as the project name for project.default, found " + type(ppcDefault_name))
    end
    return "name = \"" + ppcDefault_name + "\"\nversion = \"1.0.0\"\nmain = \"main.enm\"\n"
end
$- Read through the host module. The C VM's `host.readFile` returns an error
   object with `__hostError` instead of raising; normalise both forms. -$
function ppcHostRead(ppcHostRead_path)
    ppcHostRead_result = host.readFile(ppcHostRead_path)
    if isObject(ppcHostRead_result) and ppcHostRead_result.has("__hostError")
        assert(false, "Could not read '" + ppcHostRead_path + "': " + toString(ppcHostRead_result.get("__hostError")))
    end
    return ppcHostRead_result
end
function ppcHostWrite(ppcHostWrite_path, ppcHostWrite_text)
    ppcHostWrite_result = host.writeFile(ppcHostWrite_path, ppcHostWrite_text)
    if isObject(ppcHostWrite_result) and ppcHostWrite_result.has("__hostError")
        assert(false, "Could not write '" + ppcHostWrite_path + "': " + toString(ppcHostWrite_result.get("__hostError")))
    end
    return ppcHostWrite_result
end
$- Load a manifest from `path`, or from `englishmen.emc` in the working
   directory when `path` is null. -$
function ppcLoad(ppcLoad_path)
    ppcLoad_real = ppcLoad_path
    if ppcLoad_real == null
        ppcLoad_real = host.cwd() + "/englishmen.emc"
    end
    if isString(ppcLoad_real) == false
        assert(false, "Type mismatch: expected a string as the path for project.load, found " + type(ppcLoad_real))
    end
    return ppcParse(ppcHostRead(ppcLoad_real))
end
$- Rust `char::is_whitespace` (Unicode White_Space). -$
function ppcIsWhitespaceCode(ppcIsWhitespaceCode_n)
    if ppcIsWhitespaceCode_n >= 9 and ppcIsWhitespaceCode_n <= 13
        return true
    end
    if ppcIsWhitespaceCode_n == 32 or ppcIsWhitespaceCode_n == 133 or ppcIsWhitespaceCode_n == 160 or ppcIsWhitespaceCode_n == 5760
        return true
    end
    if ppcIsWhitespaceCode_n >= 8192 and ppcIsWhitespaceCode_n <= 8202
        return true
    end
    if ppcIsWhitespaceCode_n == 8232 or ppcIsWhitespaceCode_n == 8233 or ppcIsWhitespaceCode_n == 8239 or ppcIsWhitespaceCode_n == 8287 or ppcIsWhitespaceCode_n == 12288
        return true
    end
    return false
end
$- Keys and section names must survive the parser unchanged. -$
function ppcValidateName(ppcValidateName_name, ppcValidateName_what)
    ppcValidateName_message = "Invalid " + ppcValidateName_what + " '" + ppcValidateName_name + "' for project.write"
    if ppcValidateName_name == "" or ppcValidateName_name.startsWith("#")
        assert(false, ppcValidateName_message)
    end
    ppcValidateName_chars = ppcValidateName_name.chars()
    for ppcValidateName_c in ppcValidateName_chars
        if ppcIsWhitespaceCode(charCode(ppcValidateName_c)) or ppcValidateName_c == "[" or ppcValidateName_c == "]" or ppcValidateName_c == "="
            assert(false, ppcValidateName_message)
        end
    end
end
$- Quote a string value, escaping exactly the characters native writes. -$
function ppcQuoted(ppcQuoted_text)
    ppcQuoted_out = "\""
    for ppcQuoted_c in ppcQuoted_text.chars()
        if ppcQuoted_c == "\""
            ppcQuoted_out += "\\\""
        else if ppcQuoted_c == "\\"
            ppcQuoted_out += "\\\\"
        else if ppcQuoted_c == "\n"
            ppcQuoted_out += "\\n"
        else if ppcQuoted_c == fromCharCode(13)
            ppcQuoted_out += "\\r"
        else if ppcQuoted_c == "\t"
            ppcQuoted_out += "\\t"
        else if charCode(ppcQuoted_c) < 32
            ppcQuoted_out += "\\u" + ppcHex4(charCode(ppcQuoted_c))
        else
            ppcQuoted_out += ppcQuoted_c
        end
    end
    return ppcQuoted_out + "\""
end
$- One `key = value` line, including its trailing newline. -$
function ppcWritePair(ppcWritePair_key, ppcWritePair_value)
    ppcValidateName(ppcWritePair_key, "manifest key")
    ppcWritePair_kind = type(ppcWritePair_value)
    if ppcWritePair_kind == "string"
        return ppcWritePair_key + " = " + ppcQuoted(ppcWritePair_value) + "\n"
    end
    if ppcWritePair_kind == "number"
        if isNaN(ppcWritePair_value) or ppcWritePair_value > pow(10, 308) or ppcWritePair_value < -pow(10, 308)
            assert(false, "Cannot write a non-finite number for key '" + ppcWritePair_key + "'")
        end
        return ppcWritePair_key + " = " + toString(ppcWritePair_value) + "\n"
    end
    if ppcWritePair_kind == "boolean" or ppcWritePair_kind == "null"
        return ppcWritePair_key + " = " + toString(ppcWritePair_value) + "\n"
    end
    assert(false, "Cannot write a " + ppcWritePair_kind + " for key '" + ppcWritePair_key + "' in a manifest")
end
$- Serialize with BTreeMap ordering: root keys first, then `[section]` headers
   with their keys. -$
function ppcSerialize(ppcSerialize_manifest)
    ppcSerialize_parts = ppcConfig(ppcSerialize_manifest, "write")
    ppcSerialize_root = ppcSerialize_parts.get("root")
    ppcSerialize_sections = ppcSerialize_parts.get("sections")
    ppcSerialize_out = ""
    for ppcSerialize_key in ppcSerialize_root.keys()
        ppcSerialize_out += ppcWritePair(ppcSerialize_key, ppcSerialize_root.get(ppcSerialize_key))
    end
    for ppcSerialize_name in ppcSerialize_sections.keys()
        ppcValidateName(ppcSerialize_name, "section name")
        ppcSerialize_out += "[" + ppcSerialize_name + "]\n"
        ppcSerialize_fields = ppcSerialize_sections.get(ppcSerialize_name)
        for ppcSerialize_key in ppcSerialize_fields.keys()
            ppcSerialize_out += ppcWritePair(ppcSerialize_key, ppcSerialize_fields.get(ppcSerialize_key))
        end
    end
    return ppcSerialize_out
end
$- The module-level writer mirrors native `project.write(path, config)`. -$
function ppcProjectWrite(ppcProjectWrite_path, ppcProjectWrite_manifest)
    if isString(ppcProjectWrite_path) == false
        assert(false, "Type mismatch: expected a string as the path for project.write, found " + type(ppcProjectWrite_path))
    end
    ppcProjectWrite_text = ppcSerialize(ppcProjectWrite_manifest)
    ppcHostWrite(ppcProjectWrite_path, ppcProjectWrite_text)
    return true
end
$- Module object with the native `project` API plus the same helper set. -$
function ppcProjectModule()
    return {default: ppcDefault, parse: ppcParse, load: ppcLoad, get: ppcGet, section: ppcSection, name: ppcName, version: ppcVersion, main: ppcMain, write: ppcProjectWrite}
end
$- Native `str::split_whitespace`: collapse runs of Unicode whitespace. -$
function ppcCowWords(ppcCowWords_text)
    ppcCowWords_chars = ppcCowWords_text.chars()
    ppcCowWords_words = []
    ppcCowWords_current = ""
    for ppcCowWords_c in ppcCowWords_chars
        if ppcIsWhitespaceCode(charCode(ppcCowWords_c))
            if ppcCowWords_current != ""
                ppcCowWords_words.add(ppcCowWords_current)
                ppcCowWords_current = ""
            end
        else
            ppcCowWords_current += ppcCowWords_c
        end
    end
    if ppcCowWords_current != ""
        ppcCowWords_words.add(ppcCowWords_current)
    end
    return ppcCowWords_words
end
$- UTF-8 byte length, matching Rust's `str::len()` used by the native wrapper. -$
function ppcUtf8Len(ppcUtf8Len_text)
    ppcUtf8Len_chars = ppcUtf8Len_text.chars()
    ppcUtf8Len_n = 0
    for ppcUtf8Len_c in ppcUtf8Len_chars
        ppcUtf8Len_code = charCode(ppcUtf8Len_c)
        if ppcUtf8Len_code <= 127
            ppcUtf8Len_n += 1
        else if ppcUtf8Len_code <= 2047
            ppcUtf8Len_n += 2
        else if ppcUtf8Len_code <= 65535
            ppcUtf8Len_n += 3
        else
            ppcUtf8Len_n += 4
        end
    end
    return ppcUtf8Len_n
end
$- Cowsay speech bubble plus cow art, byte-for-byte identical to
   `src/modules/cowsay.rs::render`. -$
function ppcCowRender(ppcCowRender_message)
    if isString(ppcCowRender_message) == false
        assert(false, "Type mismatch: expected a string for cowsay.render, found " + type(ppcCowRender_message))
    end
    ppcCowRender_words = ppcCowWords(ppcCowRender_message)
    ppcCowRender_lines = []
    ppcCowRender_current = ""
    for ppcCowRender_word in ppcCowRender_words
        if ppcCowRender_current == ""
            ppcCowRender_current = ppcCowRender_word
        else if ppcUtf8Len(ppcCowRender_current) + 1 + ppcUtf8Len(ppcCowRender_word) <= 40
            ppcCowRender_current += " " + ppcCowRender_word
        else
            ppcCowRender_lines.add(ppcCowRender_current)
            ppcCowRender_current = ppcCowRender_word
        end
    end
    if ppcCowRender_current != "" or ppcCowRender_lines.length() == 0
        ppcCowRender_lines.add(ppcCowRender_current)
    end
    ppcCowRender_max = 0
    for ppcCowRender_line in ppcCowRender_lines
        ppcCowRender_len = ppcUtf8Len(ppcCowRender_line)
        if ppcCowRender_len > ppcCowRender_max
            ppcCowRender_max = ppcCowRender_len
        end
    end
    ppcCowRender_border = ppcCowRender_max + 2
    ppcCowRender_out = " " + "_".repeat(ppcCowRender_border) + "\n"
    ppcCowRender_count = ppcCowRender_lines.length()
    ppcCowRender_i = 0
    while ppcCowRender_i < ppcCowRender_count
    ppcCowRender_line = ppcCowRender_lines[ppcCowRender_i]
    ppcCowRender_pad = ppcCowRender_max - ppcCowRender_line.chars().length()
    if ppcCowRender_pad < 0
        ppcCowRender_pad = 0
    end
    ppcCowRender_padded = ppcCowRender_line + " ".repeat(ppcCowRender_pad)
    if ppcCowRender_count == 1
        ppcCowRender_left = "<"
        ppcCowRender_right = ">"
    else if ppcCowRender_i == 0
        ppcCowRender_left = "/"
        ppcCowRender_right = "\\"
    else if ppcCowRender_i == ppcCowRender_count - 1
        ppcCowRender_left = "\\"
        ppcCowRender_right = "/"
    else
        ppcCowRender_left = "|"
        ppcCowRender_right = "|"
    end
    ppcCowRender_out += ppcCowRender_left + " " + ppcCowRender_padded + " " + ppcCowRender_right + "\n"
    ppcCowRender_i += 1
end
ppcCowRender_out += " " + "-".repeat(ppcCowRender_border) + "\n"
ppcCowRender_out += "        \\   ^__^\n         \\  (oo)\\_______\n            (__)\\       )\\/\\\n                ||----w |\n                ||     ||\n"
return ppcCowRender_out
end
$- `say` matches the native module: `println!("{}", render(text))`. -$
function ppcCowSay(ppcCowSay_text)
    say(ppcCowRender(ppcCowSay_text))
    return null
end
$- Module object with native `cowsay.say` and the pure `render` extension. -$
function ppcCowModule()
    return {render: ppcCowRender, say: ppcCowSay}
end
$- Inline parity self-test. Native modules are loaded only here. -$
function ppcSelfTest()
    ppcSelfTest_project = ppcProjectModule()
    ppcSelfTest_cow = ppcCowModule()
    ppcSelfTest_samples = ["", "name = \"Demo\"\nversion = \"1.0.0\"\nmain = \"main.enm\"\n", "# leading comment\n\n  name = \"  spaced  \"  \nbare = plain\nsingle = 'quoted'\n\n[installer]\ninstall_dir = \"C:/em\"\nprojects_enabled = \"true\"\n", "name = \"Demo\"" + fromCharCode(13) + "\n\tversion = \"2.1\"" + fromCharCode(13) + "\n# comment" + fromCharCode(13) + "\n[notes]" + fromCharCode(13) + "\nbody = \"hello\"" + fromCharCode(13) + "\n", "a = \"quote \\\" slash \\\\ newline \\n return \\r tab \\t control \\u001f\"\n", "a = \"short \\u41 plus \\u+42 bad \\uZZZZ surrogate \\ud800 high \\u\{1f600\}\"\n", "[a]\nx = \"first\"\n[a]\nx = \"last\"\ny = \"a=b\"\n[ü]\nключ = \"значение\"\n", "dup = \"first\"\ndup = \"second\"\n[sec]\nq = \"# not a comment\"\n", "name = \"\\u00e9\\u263a\"\nx = \"" + fromCharCode(1) + "☺\"\n"]
    ppcSelfTest_a = host.tempDir() + "/pure_project_cowsay_a_" + toString(host.pid()) + ".emc"
    ppcSelfTest_b = host.tempDir() + "/pure_project_cowsay_b_" + toString(host.pid()) + ".emc"
    ppcSelfTest_i = 0
    while ppcSelfTest_i < ppcSelfTest_samples.length()
    ppcSelfTest_text = ppcSelfTest_samples[ppcSelfTest_i]
    ppcSelfTest_pure = ppcSelfTest_project.parse(ppcSelfTest_text)
    ppcSelfTest_native = project.parse(ppcSelfTest_text)
    assert(jsonEncode(ppcSelfTest_pure) == jsonEncode(ppcSelfTest_native), "ppcParse mismatch for sample")
    assert(jsonEncode(ppcSelfTest_project.name(ppcSelfTest_pure)) == jsonEncode(project.name(ppcSelfTest_native)), "ppcName mismatch for sample")
    assert(jsonEncode(ppcSelfTest_project.version(ppcSelfTest_pure)) == jsonEncode(project.version(ppcSelfTest_native)), "ppcVersion mismatch for sample")
    assert(jsonEncode(ppcSelfTest_project.main(ppcSelfTest_pure)) == jsonEncode(project.main(ppcSelfTest_native)), "ppcMain mismatch for sample")
    assert(ppcSelfTest_project.write(ppcSelfTest_a, ppcSelfTest_pure), "pure write failed for sample")
    assert(project.write(ppcSelfTest_b, ppcSelfTest_native), "native write failed for sample")
    assert(host.readFile(ppcSelfTest_a) == host.readFile(ppcSelfTest_b), "write mismatch for sample")
    assert(jsonEncode(ppcSelfTest_project.load(ppcSelfTest_a)) == jsonEncode(project.load(ppcSelfTest_b)), "load mismatch for sample")
    ppcSelfTest_i += 1
end
assert(ppcSelfTest_project.default("Demo") == project.default("Demo"), "ppcDefault mismatch")
ppcSelfTest_manifest = {root: {z: 3, name: "Demo", enabled: true, nothing: null, big: 100000000000000000000, small: 0.00001, tricky: "quote \" slash \\ newline \n return " + fromCharCode(13) + " tab \t control " + fromCharCode(31) + " unicode ☺", unicode: "é☺"}, sections: {alpha: {b: "two", a: 1}, empty: {}}}
assert(ppcSelfTest_project.write(ppcSelfTest_a, ppcSelfTest_manifest), "pure write failed for mixed manifest")
assert(project.write(ppcSelfTest_b, ppcSelfTest_manifest), "native write failed for mixed manifest")
assert(host.readFile(ppcSelfTest_a) == host.readFile(ppcSelfTest_b), "write mismatch for mixed manifest")
assert(jsonEncode(ppcSelfTest_project.load(ppcSelfTest_a)) == jsonEncode(project.load(ppcSelfTest_b)), "load mismatch for mixed manifest")
deleteFile(ppcSelfTest_a)
deleteFile(ppcSelfTest_b)
ppcSelfTest_art = "        \\   ^__^\n         \\  (oo)\\_______\n            (__)\\       )\\/\\\n                ||----w |\n                ||     ||\n"
ppcSelfTest_messages = ["", "Hello", "one two", "this is a fairly long message that should wrap across more than one line of the bubble", "  spaced   out\twords\nand  more  ", "éé éé éé éé éé éé éé éé éé éé éé éé éé éé éé éé éé éé éé éé"]
ppcSelfTest_expected = [" __\n<  >\n --\n" + ppcSelfTest_art, " _______\n< Hello >\n -------\n" + ppcSelfTest_art, " _________\n< one two >\n ---------\n" + ppcSelfTest_art, " __________________________________________\n/ this is a fairly long message that       \\\n| should wrap across more than one line of |\n\\ the bubble                               /\n ------------------------------------------\n" + ppcSelfTest_art, " ___________________________\n< spaced out words and more >\n ---------------------------\n" + ppcSelfTest_art, " _________________________________________\n/ éé éé éé éé éé éé éé éé                 \\\n| éé éé éé éé éé éé éé éé                 |\n\\ éé éé éé éé                             /\n -----------------------------------------\n" + ppcSelfTest_art]
ppcSelfTest_i = 0
while ppcSelfTest_i < ppcSelfTest_messages.length()
ppcSelfTest_actual = ppcSelfTest_cow.render(ppcSelfTest_messages[ppcSelfTest_i])
assert(ppcSelfTest_actual == ppcSelfTest_expected[ppcSelfTest_i], "render mismatch for cow sample " + toString(ppcSelfTest_i) + ": " + jsonEncode(ppcSelfTest_actual) + " != " + jsonEncode(ppcSelfTest_expected[ppcSelfTest_i]))
ppcSelfTest_i += 1
end
end
$- === inlined selfhost/pure_string.enm === -$
$- Pure Englishmen implementation of the native `string` module and the string
   methods used by the self-hosted compiler.

   This file is self-contained: it imports only `os` for the self-test guard
   and imports the native `string` oracle inside that guard at the bottom.
   Every globally visible helper is prefixed with `pst`. `pstStringModule()`
   returns an ordinary object whose keys are the native `string` member names
   used by `selfhost/*.enm`.

   Optional native arguments are passed as `null` because Englishmen functions
   have fixed arity. For example `pst.slice(text, 1, null)` means the same thing
   as native `text.slice(1)`, and `pst.pad(text, 5, null, null)` uses the default
   fill and alignment.
-$
$- ---------------------------------------------------------------------------
   Shared argument and indexing helpers
   --------------------------------------------------------------------------- -$
function pstExpectString(pstExpectString_value, pstExpectString_context)
    if type(pstExpectString_value) != "string"
        assert(false, "Type mismatch: expected a string " + pstExpectString_context + ", found " + type(pstExpectString_value))
    end
    return pstExpectString_value
end
function pstFinite(pstFinite_value)
    if type(pstFinite_value) != "number"
        return false
    end
    if isNaN(pstFinite_value)
        return false
    end
    return pstFinite_value <=  and pstFinite_value >= -
end
function pstWhole(pstWhole_value)
    if not pstFinite(pstWhole_value)
        return false
    end
    return floor(pstWhole_value) == pstWhole_value
end
function pstIndex(pstIndex_value)
    if not pstWhole(pstIndex_value) or pstIndex_value < 0
        return false
    end
    return true
end
function pstExpectIndex(pstExpectIndex_value, pstExpectIndex_context)
    if type(pstExpectIndex_value) != "number"
        assert(false, "Type mismatch: expected a number " + pstExpectIndex_context + ", found " + type(pstExpectIndex_value))
    end
    if not pstWhole(pstExpectIndex_value) or pstExpectIndex_value < 0 or pstExpectIndex_value > 9007199254740992
        assert(false, "Expected a non-negative whole number " + pstExpectIndex_context + ", found " + toString(pstExpectIndex_value))
    end
    return pstExpectIndex_value
end
function pstChars(pstChars_source)
    return split(pstChars_source, "")
end
function pstByteLength(pstByteLength_source)
    pstByteLength_chars = pstChars(pstByteLength_source)
    pstByteLength_total = 0
    pstByteLength_i = 0
    while pstByteLength_i < len(pstByteLength_chars)
    pstByteLength_code = charCode(pstByteLength_chars[pstByteLength_i])
    if pstByteLength_code <= 127
        pstByteLength_total += 1
    else if pstByteLength_code <= 2047
        pstByteLength_total += 2
    else if pstByteLength_code <= 65535
        pstByteLength_total += 3
    else
        pstByteLength_total += 4
    end
    pstByteLength_i += 1
end
return pstByteLength_total
end
function pstClampIndex(pstClampIndex_length, pstClampIndex_value)
    if not pstFinite(pstClampIndex_value)
        if pstClampIndex_value < 0
            return 0
        end
        return pstClampIndex_length
    end
    if pstClampIndex_value < 0
        pstClampIndex_resolved = pstClampIndex_length - floor(-pstClampIndex_value)
        if pstClampIndex_resolved < 0
            return 0
        end
        return pstClampIndex_resolved
    end
    pstClampIndex_resolved = floor(pstClampIndex_value)
    if pstClampIndex_resolved > pstClampIndex_length
        return pstClampIndex_length
    end
    return pstClampIndex_resolved
end
function pstJoinSlice(pstJoinSlice_chars, pstJoinSlice_from, pstJoinSlice_to)
    return join(slice(pstJoinSlice_chars, pstJoinSlice_from, pstJoinSlice_to), "")
end
function pstSliceChars(pstSliceChars_source, pstSliceChars_from, pstSliceChars_to)
    if pstSliceChars_to < pstSliceChars_from
        pstSliceChars_to = pstSliceChars_from
    end
    return pstJoinSlice(pstChars(pstSliceChars_source), pstSliceChars_from, pstSliceChars_to)
end
function pstFind(pstFind_text, pstFind_needle, pstFind_backwards)
    pstFind_chars = pstChars(pstFind_text)
    pstFind_needleChars = pstChars(pstFind_needle)
    pstFind_needleLen = len(pstFind_needleChars)
    if pstFind_needleLen == 0
        if pstFind_backwards
            return len(pstFind_chars)
        end
        return 0
    end
    pstFind_last = len(pstFind_chars) - pstFind_needleLen
    pstFind_found = -1
    pstFind_i = 0
    while pstFind_i <= pstFind_last
    if pstJoinSlice(pstFind_chars, pstFind_i, pstFind_i + pstFind_needleLen) == pstFind_needle
        if not pstFind_backwards
            return pstFind_i
        end
        pstFind_found = pstFind_i
    end
    pstFind_i += 1
end
return pstFind_found
end
function pstAsciiDigit(pstAsciiDigit_char)
    pstAsciiDigit_code = charCode(pstAsciiDigit_char)
    return pstAsciiDigit_code >= 48 and pstAsciiDigit_code <= 57
end
function pstNumericText(pstNumericText_source)
    pstNumericText_chars = pstChars(pstNumericText_source)
    pstNumericText_size = len(pstNumericText_chars)
    pstNumericText_pos = 0
    if pstNumericText_size == 0
        return false
    end
    if pstNumericText_chars[0] == "+" or pstNumericText_chars[0] == "-"
        pstNumericText_pos = 1
    end
    pstNumericText_before = 0
    pstNumericText_after = 0
    pstNumericText_dot = false
    while pstNumericText_pos < pstNumericText_size
    pstNumericText_char = pstNumericText_chars[pstNumericText_pos]
    if pstAsciiDigit(pstNumericText_char)
        if pstNumericText_dot
            pstNumericText_after += 1
        else
            pstNumericText_before += 1
        end
        pstNumericText_pos += 1
        continue
    end
    if pstNumericText_char == "." and not pstNumericText_dot
        pstNumericText_dot = true
        pstNumericText_pos += 1
        continue
    end
    if pstNumericText_char == "e" or pstNumericText_char == "E"
        pstNumericText_pos += 1
        if pstNumericText_pos < pstNumericText_size
            if pstNumericText_chars[pstNumericText_pos] == "+" or pstNumericText_chars[pstNumericText_pos] == "-"
                pstNumericText_pos += 1
            end
        end
        pstNumericText_exp = 0
        while pstNumericText_pos < pstNumericText_size
        if not pstAsciiDigit(pstNumericText_chars[pstNumericText_pos])
            return false
        end
        pstNumericText_exp += 1
        pstNumericText_pos += 1
    end
    if pstNumericText_exp == 0
        return false
    end
    break
end
return false
end
if pstNumericText_before + pstNumericText_after == 0
    return false
end
return pstNumericText_pos == pstNumericText_size
end
function pstRepeatText(pstRepeatText_source, pstRepeatText_count)
    pstRepeatText_out = ""
    pstRepeatText_i = 0
    while pstRepeatText_i < pstRepeatText_count
    pstRepeatText_out += pstRepeatText_source
    pstRepeatText_i += 1
end
return pstRepeatText_out
end
function pstRepeatChar(pstRepeatChar_char, pstRepeatChar_count)
    return pstRepeatText(pstRepeatChar_char, pstRepeatChar_count)
end
function pstIsUpperChar(pstIsUpperChar_char)
    return pstIsUpperChar_char == upper(pstIsUpperChar_char) and lower(pstIsUpperChar_char) != pstIsUpperChar_char
end
function pstIsLowerChar(pstIsLowerChar_char)
    return pstIsLowerChar_char == lower(pstIsLowerChar_char) and upper(pstIsLowerChar_char) != pstIsLowerChar_char
end
$- ---------------------------------------------------------------------------
   String module functions
   --------------------------------------------------------------------------- -$
function pstStringLength(pstStringLength_source)
    return len(pstExpectString(pstStringLength_source, "for string.length"))
end
function pstStringUpper(pstStringUpper_source)
    return upper(pstExpectString(pstStringUpper_source, "for string.upper"))
end
function pstStringLower(pstStringLower_source)
    return lower(pstExpectString(pstStringLower_source, "for string.lower"))
end
function pstStringTrim(pstStringTrim_source)
    return trim(pstExpectString(pstStringTrim_source, "for string.trim"))
end
function pstStringSplit(pstStringSplit_source, pstStringSplit_separator)
    pstStringSplit_text = pstExpectString(pstStringSplit_source, "for string.split")
    if pstStringSplit_separator == null
        return pstChars(pstStringSplit_text)
    end
    pstStringSplit_sep = pstExpectString(pstStringSplit_separator, "as the separator for string.split")
    if pstStringSplit_sep == ""
        return pstChars(pstStringSplit_text)
    end
    return split(pstStringSplit_text, pstStringSplit_sep)
end
function pstStringJoin(pstStringJoin_items, pstStringJoin_separator)
    if type(pstStringJoin_items) != "array"
        assert(false, "Type mismatch: expected an array as the array for string.join, found " + type(pstStringJoin_items))
    end
    if pstStringJoin_separator == null
        return join(pstStringJoin_items, "")
    end
    return join(pstStringJoin_items, pstExpectString(pstStringJoin_separator, "as the separator for string.join"))
end
function pstStringContains(pstStringContains_source, pstStringContains_needle)
    pstStringContains_text = pstExpectString(pstStringContains_source, "for string.contains")
    return contains(pstStringContains_text, pstExpectString(pstStringContains_needle, "to search for with string.contains"))
end
function pstStringStartsWith(pstStringStartsWith_source, pstStringStartsWith_prefix)
    pstStringStartsWith_text = pstExpectString(pstStringStartsWith_source, "for string.startsWith")
    return startsWith(pstStringStartsWith_text, pstExpectString(pstStringStartsWith_prefix, "as the prefix for string.startsWith"))
end
function pstStringEndsWith(pstStringEndsWith_source, pstStringEndsWith_suffix)
    pstStringEndsWith_text = pstExpectString(pstStringEndsWith_source, "for string.endsWith")
    return endsWith(pstStringEndsWith_text, pstExpectString(pstStringEndsWith_suffix, "as the suffix for string.endsWith"))
end
function pstStringReplace(pstStringReplace_source, pstStringReplace_old, pstStringReplace_new)
    pstStringReplace_text = pstExpectString(pstStringReplace_source, "for string.replace")
    pstStringReplace_from = pstExpectString(pstStringReplace_old, "as the text to replace for string.replace")
    pstStringReplace_to = pstExpectString(pstStringReplace_new, "as the replacement for string.replace")
    return replace(pstStringReplace_text, pstStringReplace_from, pstStringReplace_to)
end
function pstStringReplaceAll(pstStringReplaceAll_source, pstStringReplaceAll_old, pstStringReplaceAll_new)
    return pstStringReplace(pstStringReplaceAll_source, pstStringReplaceAll_old, pstStringReplaceAll_new)
end
function pstStringSlice(pstStringSlice_source, pstStringSlice_start, pstStringSlice_end)
    pstStringSlice_text = pstExpectString(pstStringSlice_source, "for string.slice")
    pstStringSlice_len = len(pstStringSlice_text)
    if pstStringSlice_start == null
        pstStringSlice_start = 0
    end
    if pstStringSlice_end == null
        pstStringSlice_end = pstStringSlice_len
    end
    assert(type(pstStringSlice_start) == "number" and type(pstStringSlice_end) == "number", "string.slice expects numeric bounds")
    pstStringSlice_from = pstClampIndex(pstStringSlice_len, pstStringSlice_start)
    pstStringSlice_to = pstClampIndex(pstStringSlice_len, pstStringSlice_end)
    return pstSliceChars(pstStringSlice_text, pstStringSlice_from, pstStringSlice_to)
end
function pstStringSubstring(pstStringSubstring_source, pstStringSubstring_start, pstStringSubstring_end)
    pstStringSubstring_text = pstExpectString(pstStringSubstring_source, "for string.substring")
    pstStringSubstring_len = len(pstStringSubstring_text)
    pstExpectIndex(pstStringSubstring_start, "as the start for string.substring")
    if pstStringSubstring_end == null
        pstStringSubstring_end = pstStringSubstring_len
    end
    pstExpectIndex(pstStringSubstring_end, "as the end for string.substring")
    assert(pstStringSubstring_start <= pstStringSubstring_end and pstStringSubstring_end <= pstStringSubstring_len, "string.substring expects 0 <= start <= end <= length")
    return pstSliceChars(pstStringSubstring_text, pstStringSubstring_start, pstStringSubstring_end)
end
function pstStringIndexOf(pstStringIndexOf_source, pstStringIndexOf_needle)
    pstStringIndexOf_text = pstExpectString(pstStringIndexOf_source, "for string.indexOf")
    pstStringIndexOf_find = pstExpectString(pstStringIndexOf_needle, "as the text to find for string.indexOf")
    return pstFind(pstStringIndexOf_text, pstStringIndexOf_find, false)
end
function pstStringLastIndexOf(pstStringLastIndexOf_source, pstStringLastIndexOf_needle)
    pstStringLastIndexOf_text = pstExpectString(pstStringLastIndexOf_source, "for string.lastIndexOf")
    pstStringLastIndexOf_find = pstExpectString(pstStringLastIndexOf_needle, "as the text to find for string.lastIndexOf")
    return pstFind(pstStringLastIndexOf_text, pstStringLastIndexOf_find, true)
end
function pstStringCharAt(pstStringCharAt_source, pstStringCharAt_index)
    pstStringCharAt_text = pstExpectString(pstStringCharAt_source, "for string.charAt")
    pstExpectIndex(pstStringCharAt_index, "as the index for string.charAt")
    pstStringCharAt_chars = pstChars(pstStringCharAt_text)
    assert(pstStringCharAt_index < len(pstStringCharAt_chars), "string.charAt index " + toString(pstStringCharAt_index) + " is out of range for a " + toString(len(pstStringCharAt_chars)) + "-character string")
    return pstStringCharAt_chars[pstStringCharAt_index]
end
function pstStringToNumber(pstStringToNumber_source)
    pstStringToNumber_text = trim(pstExpectString(pstStringToNumber_source, "for string.toNumber"))
    if not pstNumericText(pstStringToNumber_text)
        return null
    end
    pstStringToNumber_value = parseFloat(pstStringToNumber_text)
    if not pstFinite(pstStringToNumber_value)
        return null
    end
    return pstStringToNumber_value
end
function pstStringCapitalize(pstStringCapitalize_source)
    pstStringCapitalize_text = pstExpectString(pstStringCapitalize_source, "for string.capitalize")
    if pstStringCapitalize_text == ""
        return ""
    end
    pstStringCapitalize_chars = pstChars(pstStringCapitalize_text)
    return upper(pstStringCapitalize_chars[0]) + pstSliceChars(pstStringCapitalize_text, 1, len(pstStringCapitalize_chars))
end
function pstStringTitleCase(pstStringTitleCase_source)
    pstStringTitleCase_text = pstExpectString(pstStringTitleCase_source, "for string.titleCase")
    pstStringTitleCase_chars = pstChars(pstStringTitleCase_text)
    pstStringTitleCase_out = ""
    pstStringTitleCase_start = true
    pstStringTitleCase_i = 0
    while pstStringTitleCase_i < len(pstStringTitleCase_chars)
    pstStringTitleCase_char = pstStringTitleCase_chars[pstStringTitleCase_i]
    if pstStringTitleCase_char.isBlank()
        pstStringTitleCase_out += pstStringTitleCase_char
        pstStringTitleCase_start = true
    else if pstStringTitleCase_start
        pstStringTitleCase_out += upper(pstStringTitleCase_char)
        pstStringTitleCase_start = false
    else
        pstStringTitleCase_out += lower(pstStringTitleCase_char)
    end
    pstStringTitleCase_i += 1
end
return pstStringTitleCase_out
end
function pstStringReverse(pstStringReverse_source)
    pstStringReverse_text = pstExpectString(pstStringReverse_source, "for string.reverse")
    pstStringReverse_chars = pstChars(pstStringReverse_text)
    pstStringReverse_out = ""
    pstStringReverse_i = len(pstStringReverse_chars) - 1
    while pstStringReverse_i >= 0
    pstStringReverse_out += pstStringReverse_chars[pstStringReverse_i]
    pstStringReverse_i -= 1
end
return pstStringReverse_out
end
function pstStringRepeat(pstStringRepeat_source, pstStringRepeat_count)
    pstStringRepeat_text = pstExpectString(pstStringRepeat_source, "for string.repeat")
    pstExpectIndex(pstStringRepeat_count, "as the repeat count for string.repeat")
    assert(pstByteLength(pstStringRepeat_text) * pstStringRepeat_count <= 10000000, "string.repeat would produce a string that is too long")
    return pstRepeatText(pstStringRepeat_text, pstStringRepeat_count)
end
function pstStringPad(pstStringPad_source, pstStringPad_width, pstStringPad_fill, pstStringPad_align)
    pstStringPad_text = pstExpectString(pstStringPad_source, "for string.pad")
    pstExpectIndex(pstStringPad_width, "as the width for string.pad")
    pstStringPad_fillText = " "
    if pstStringPad_fill != null
        pstStringPad_fillText = pstExpectString(pstStringPad_fill, "as the fill text for string.pad")
    end
    pstStringPad_unit = " "
    if pstStringPad_fillText != ""
        pstStringPad_unit = pstChars(pstStringPad_fillText)[0]
    end
    pstStringPad_alignment = "left"
    if pstStringPad_align != null
        pstStringPad_alignment = pstExpectString(pstStringPad_align, "as the alignment for string.pad")
    end
    pstStringPad_current = len(pstStringPad_text)
    if pstStringPad_current >= pstStringPad_width
        return pstStringPad_text
    end
    pstStringPad_missing = pstStringPad_width - pstStringPad_current
    if pstStringPad_alignment == "left"
        return pstStringPad_text + pstRepeatChar(pstStringPad_unit, pstStringPad_missing)
    end
    if pstStringPad_alignment == "right"
        return pstRepeatChar(pstStringPad_unit, pstStringPad_missing) + pstStringPad_text
    end
    if pstStringPad_alignment != "both" and pstStringPad_alignment != "center"
        assert(false, "string.pad alignment must be 'left', 'right' or 'center'")
    end
    pstStringPad_left = floor(pstStringPad_missing / 2)
    if pstStringPad_missing % 2 == 1
        pstStringPad_left += 1
    end
    pstStringPad_right = pstStringPad_missing - pstStringPad_left
    return pstRepeatChar(pstStringPad_unit, pstStringPad_left) + pstStringPad_text + pstRepeatChar(pstStringPad_unit, pstStringPad_right)
end
function pstStringPadLeft(pstStringPadLeft_source, pstStringPadLeft_width, pstStringPadLeft_fill)
    pstStringPadLeft_text = pstExpectString(pstStringPadLeft_source, "for string.padLeft")
    pstExpectIndex(pstStringPadLeft_width, "as the width for string.padLeft")
    pstStringPadLeft_target = pstStringPadLeft_width
    if pstStringPadLeft_target > 100000
        pstStringPadLeft_target = 100000
    end
    pstStringPadLeft_missing = pstStringPadLeft_target - len(pstStringPadLeft_text)
    if pstStringPadLeft_missing <= 0
        return pstStringPadLeft_text
    end
    pstStringPadLeft_unit = " "
    if pstStringPadLeft_fill != null
        pstStringPadLeft_unit = pstExpectString(pstStringPadLeft_fill, "as the fill for string.padLeft")
    end
    if pstStringPadLeft_unit == ""
        pstStringPadLeft_unit = " "
    end
    pstStringPadLeft_padding = ""
    while len(pstStringPadLeft_padding) < pstStringPadLeft_missing
    pstStringPadLeft_padding += pstStringPadLeft_unit
end
return pstSliceChars(pstStringPadLeft_padding, 0, pstStringPadLeft_missing) + pstStringPadLeft_text
end
function pstStringPadRight(pstStringPadRight_source, pstStringPadRight_width, pstStringPadRight_fill)
    pstStringPadRight_text = pstExpectString(pstStringPadRight_source, "for string.padRight")
    pstExpectIndex(pstStringPadRight_width, "as the width for string.padRight")
    pstStringPadRight_target = pstStringPadRight_width
    if pstStringPadRight_target > 100000
        pstStringPadRight_target = 100000
    end
    pstStringPadRight_missing = pstStringPadRight_target - len(pstStringPadRight_text)
    if pstStringPadRight_missing <= 0
        return pstStringPadRight_text
    end
    pstStringPadRight_unit = " "
    if pstStringPadRight_fill != null
        pstStringPadRight_unit = pstExpectString(pstStringPadRight_fill, "as the fill for string.padRight")
    end
    if pstStringPadRight_unit == ""
        pstStringPadRight_unit = " "
    end
    pstStringPadRight_padding = ""
    while len(pstStringPadRight_padding) < pstStringPadRight_missing
    pstStringPadRight_padding += pstStringPadRight_unit
end
return pstStringPadRight_text + pstSliceChars(pstStringPadRight_padding, 0, pstStringPadRight_missing)
end
function pstStringIsDigit(pstStringIsDigit_source)
    pstStringIsDigit_chars = pstChars(pstExpectString(pstStringIsDigit_source, "for string.isDigit"))
    if len(pstStringIsDigit_chars) == 0
        return false
    end
    pstStringIsDigit_i = 0
    while pstStringIsDigit_i < len(pstStringIsDigit_chars)
    if not pstAsciiDigit(pstStringIsDigit_chars[pstStringIsDigit_i])
        return false
    end
    pstStringIsDigit_i += 1
end
return true
end
function pstStringIsAlpha(pstStringIsAlpha_source)
    pstStringIsAlpha_chars = pstChars(pstExpectString(pstStringIsAlpha_source, "for string.isAlpha"))
    if len(pstStringIsAlpha_chars) == 0
        return false
    end
    pstStringIsAlpha_i = 0
    while pstStringIsAlpha_i < len(pstStringIsAlpha_chars)
    if not pstStringIsAlpha_chars[pstStringIsAlpha_i].isAlpha()
        return false
    end
    pstStringIsAlpha_i += 1
end
return true
end
function pstStringIsAlphanumeric(pstStringIsAlphanumeric_source)
    pstStringIsAlphanumeric_chars = pstChars(pstExpectString(pstStringIsAlphanumeric_source, "for string.isAlphanumeric"))
    if len(pstStringIsAlphanumeric_chars) == 0
        return false
    end
    pstStringIsAlphanumeric_i = 0
    while pstStringIsAlphanumeric_i < len(pstStringIsAlphanumeric_chars)
    pstStringIsAlphanumeric_char = pstStringIsAlphanumeric_chars[pstStringIsAlphanumeric_i]
    if not pstStringIsAlphanumeric_char.isAlpha() and not pstAsciiDigit(pstStringIsAlphanumeric_char)
        return false
    end
    pstStringIsAlphanumeric_i += 1
end
return true
end
function pstStringIsWhitespace(pstStringIsWhitespace_source)
    pstStringIsWhitespace_chars = pstChars(pstExpectString(pstStringIsWhitespace_source, "for string.isWhitespace"))
    if len(pstStringIsWhitespace_chars) == 0
        return false
    end
    pstStringIsWhitespace_i = 0
    while pstStringIsWhitespace_i < len(pstStringIsWhitespace_chars)
    if not pstStringIsWhitespace_chars[pstStringIsWhitespace_i].isBlank()
        return false
    end
    pstStringIsWhitespace_i += 1
end
return true
end
function pstStringIsEmpty(pstStringIsEmpty_source)
    return len(pstExpectString(pstStringIsEmpty_source, "for string.isEmpty")) == 0
end
function pstStringIsBlank(pstStringIsBlank_source)
    pstStringIsBlank_chars = pstChars(pstExpectString(pstStringIsBlank_source, "for string.isBlank"))
    pstStringIsBlank_i = 0
    while pstStringIsBlank_i < len(pstStringIsBlank_chars)
    if not pstStringIsBlank_chars[pstStringIsBlank_i].isBlank()
        return false
    end
    pstStringIsBlank_i += 1
end
return true
end
function pstStringLines(pstStringLines_source)
    pstStringLines_text = pstExpectString(pstStringLines_source, "for string.lines")
    if pstStringLines_text == ""
        return []
    end
    pstStringLines_raw = split(pstStringLines_text, "\n")
    pstStringLines_count = len(pstStringLines_raw)
    pstStringLines_dropLast = pstStringLines_count > 0 and pstStringLines_raw[pstStringLines_count - 1] == "" and endsWith(pstStringLines_text, "\n")
    pstStringLines_out = []
    pstStringLines_i = 0
    while pstStringLines_i < pstStringLines_count
    pstStringLines_part = pstStringLines_raw[pstStringLines_i]
    if pstStringLines_i < pstStringLines_count - 1 and endsWith(pstStringLines_part, "\n")
        pstStringLines_part = pstSliceChars(pstStringLines_part, 0, len(pstStringLines_part) - 1)
    end
    if not (pstStringLines_dropLast and pstStringLines_i == pstStringLines_count - 1)
        pstStringLines_out.add(pstStringLines_part)
    end
    pstStringLines_i += 1
end
return pstStringLines_out
end
function pstStringChars(pstStringChars_source)
    return pstChars(pstExpectString(pstStringChars_source, "for string.chars"))
end
function pstStringSwapCase(pstStringSwapCase_source)
    pstStringSwapCase_chars = pstChars(pstExpectString(pstStringSwapCase_source, "for string.swapCase"))
    pstStringSwapCase_out = ""
    pstStringSwapCase_i = 0
    while pstStringSwapCase_i < len(pstStringSwapCase_chars)
    pstStringSwapCase_char = pstStringSwapCase_chars[pstStringSwapCase_i]
    if pstIsUpperChar(pstStringSwapCase_char)
        pstStringSwapCase_out += lower(pstStringSwapCase_char)
    else if pstIsLowerChar(pstStringSwapCase_char)
        pstStringSwapCase_out += upper(pstStringSwapCase_char)
    else
        pstStringSwapCase_out += pstStringSwapCase_char
    end
    pstStringSwapCase_i += 1
end
return pstStringSwapCase_out
end
function pstStringTruncate(pstStringTruncate_source, pstStringTruncate_width, pstStringTruncate_suffix)
    pstStringTruncate_text = pstExpectString(pstStringTruncate_source, "for string.truncate")
    pstExpectIndex(pstStringTruncate_width, "as the width for string.truncate")
    pstStringTruncate_target = pstStringTruncate_width
    if pstStringTruncate_target > 100000
        pstStringTruncate_target = 100000
    end
    if len(pstStringTruncate_text) <= pstStringTruncate_target
        return pstStringTruncate_text
    end
    pstStringTruncate_tail = "..."
    if pstStringTruncate_suffix != null
        pstStringTruncate_tail = pstExpectString(pstStringTruncate_suffix, "as the suffix for string.truncate")
    end
    pstStringTruncate_tailChars = pstChars(pstStringTruncate_tail)
    pstStringTruncate_kept = pstStringTruncate_target - len(pstStringTruncate_tailChars)
    if pstStringTruncate_kept < 0
        pstStringTruncate_kept = 0
    end
    pstStringTruncate_out = pstSliceChars(pstStringTruncate_text, 0, pstStringTruncate_kept)
    pstStringTruncate_left = pstStringTruncate_target - pstStringTruncate_kept
    pstStringTruncate_tailI = 0
    while pstStringTruncate_tailI < pstStringTruncate_left and pstStringTruncate_tailI < len(pstStringTruncate_tailChars)
    pstStringTruncate_out += pstStringTruncate_tailChars[pstStringTruncate_tailI]
    pstStringTruncate_tailI += 1
end
return pstStringTruncate_out
end
function pstStringModule()
    return {length: pstStringLength, upper: pstStringUpper, lower: pstStringLower, trim: pstStringTrim, split: pstStringSplit, join: pstStringJoin, contains: pstStringContains, startsWith: pstStringStartsWith, endsWith: pstStringEndsWith, replace: pstStringReplace, replaceAll: pstStringReplaceAll, slice: pstStringSlice, substring: pstStringSubstring, indexOf: pstStringIndexOf, lastIndexOf: pstStringLastIndexOf, charAt: pstStringCharAt, toNumber: pstStringToNumber, capitalize: pstStringCapitalize, titleCase: pstStringTitleCase, reverse: pstStringReverse, repeat: pstStringRepeat, pad: pstStringPad, padLeft: pstStringPadLeft, padRight: pstStringPadRight, isDigit: pstStringIsDigit, isAlpha: pstStringIsAlpha, isAlphanumeric: pstStringIsAlphanumeric, isWhitespace: pstStringIsWhitespace, isEmpty: pstStringIsEmpty, isBlank: pstStringIsBlank, lines: pstStringLines, chars: pstStringChars, swapCase: pstStringSwapCase, truncate: pstStringTruncate}
end
$- ---------------------------------------------------------------------------
   Self-tests: the native string module and methods are oracles only below
   this point.
   --------------------------------------------------------------------------- -$
$- === compile-only bootstrap driver ===
   Reads one .enm source path, runs the pure Englishmen lexer, parser, AST ->
   IR code generator and encoder, then prints exactly one JSON summary line.
   This script never invokes the self-hosted VM, so compiling and executing its
   IR cannot recurse.
-$
if env("EM_SELFTEST") == "1"
    say("ok")
else
    argvCompile = args()
    scriptIndexCompile = -1
    for iCompile in range(len(argvCompile))
        if argvCompile[iCompile].endsWith("bootstrap_compile.enm")
            scriptIndexCompile = iCompile
            break
        end
    end
    sourcePathCompile = argvCompile[len(argvCompile) - 1]
    if scriptIndexCompile >= 0
        for jCompile in range(scriptIndexCompile + 1, len(argvCompile))
            candidateCompile = argvCompile[jCompile]
            if not candidateCompile.startsWith("-") and candidateCompile != ""
                sourcePathCompile = candidateCompile
                break
            end
        end
    end
    sourceCompile = fs.read(sourcePathCompile)
    astCompile = parse(lex(sourceCompile))
    irCompile = cgCodegen(astCompile)
    encodedCompile = ieEncode(irCompile)
    say(jsonEncode({astStatements: len(astCompile.get("statements", [])), irInstructions: len(irCompile.get("code", [])), encodedBytes: len(encodedCompile), output: []}))
end
