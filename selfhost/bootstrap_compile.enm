    if rtInvokeArgCount == 6
        return {rtPushed: false, rtValue: callee(args[0], args[1], args[2], args[3], args[4], args[5])}
    end
    if rtInvokeArgCount == 7
        return {rtPushed: false, rtValue: callee(args[0], args[1], args[2], args[3], args[4], args[5], args[6])}
    end
    if rtInvokeArgCount == 8
        return {rtPushed: false, rtValue: callee(args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7])}
    end
