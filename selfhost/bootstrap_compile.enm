        if len(args) == 2
            return range(rtArg(args, 0, 0), rtArg(args, 1, 0))
        end
        return range(rtArg(args, 0, 0), rtArg(args, 1, 0), rtArg(args, 2, 1))
    end
    if name == "sum"
        return sum(rtArg(args, 0, []))
    end
    if name == "average"
        return average(rtArg(args, 0, []))
