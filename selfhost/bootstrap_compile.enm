        for key in rtObjectKeys(other)
            rtObjectSet(object, key, rtObjectGet(other, key, null))
        end
        return object
    end
    if method == "copy"
        out = {}
        for key in rtObjectKeys(object)
            rtObjectSet(out, key, rtObjectGet(object, key, null))
        end
        return out
