end
$- ---------------------------------------------------------------------------
   Math module functions
   --------------------------------------------------------------------------- -$
function pmtMathSqrt(n)
    pmtNumberArg(n, "for math.sqrt")
    if n < 0
        assert(false, "Cannot take the square root of a negative number")
    end
    return sqrt(n)
end
function pmtMathAbs(n)
    return abs(pmtNumberArg(n, "for math.abs"))
end
function pmtMathFloor(n)
    return floor(pmtNumberArg(n, "for math.floor"))
end
function pmtMathCeil(n)
    return ceil(pmtNumberArg(n, "for math.ceil"))
end
function pmtMathRound(n)
    return round(pmtNumberArg(n, "for math.round"))
end
function pmtMathPow(base, exponent)
    pmtNumberArg(base, "as the base for math.pow")
