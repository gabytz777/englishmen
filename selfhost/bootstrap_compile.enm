end
function vmGetIndex(vmGetIndex_base, vmGetIndex_index, vmGetIndex_instr)
    if isArray(vmGetIndex_base)
        vmGetIndex_i = vmRequireIndex(vmGetIndex_index, "array index", vmGetIndex_instr)
        if vmError != null
            return null
