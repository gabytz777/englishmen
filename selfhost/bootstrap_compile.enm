        if vmGetIndex_i >= len(vmGetIndex_base)
            return vmRaiseAt("runtime", "array index " + toString(vmGetIndex_i) + " out of bounds (length " + toString(len(vmGetIndex_base)) + ")", vmGetIndex_instr)
        end
        return vmGetIndex_base[vmGetIndex_i]
    end
    if isString(vmGetIndex_base)
        vmGetIndex_i = vmRequireIndex(vmGetIndex_index, "string index", vmGetIndex_instr)
        if vmError != null
            return null
        end
        if vmGetIndex_i >= len(vmGetIndex_base)
            return vmRaiseAt("runtime", "string index " + toString(vmGetIndex_i) + " out of bounds (length " + toString(len(vmGetIndex_base)) + ")", vmGetIndex_instr)
        end
        return vmGetIndex_base[vmGetIndex_i]
    end
    return vmRaiseAt("runtime", "cannot index into a " + type(vmGetIndex_base), vmGetIndex_instr)
end
function vmSetIndex(vmSetIndex_base, vmSetIndex_index, vmSetIndex_value, vmSetIndex_instr)
    if not isArray(vmSetIndex_base)
        return vmRaiseAt("runtime", "cannot index into a " + type(vmSetIndex_base), vmSetIndex_instr)
    end
    vmSetIndex_i = vmRequireIndex(vmSetIndex_index, "array index", vmSetIndex_instr)
    if vmError != null
        return null
    end
    if vmSetIndex_i >= len(vmSetIndex_base)
        return vmRaiseAt("runtime", "array index " + toString(vmSetIndex_i) + " out of bounds (length " + toString(len(vmSetIndex_base)) + ")", vmSetIndex_instr)
    end
    vmSetIndex_base[vmSetIndex_i] = vmSetIndex_value
    return null
end
function vmBinary(vmBinary_op, vmBinary_left, vmBinary_right, vmBinary_instr)
    if vmBinary_op == "Eq"
        return vmBinary_left == vmBinary_right
    end
    if vmBinary_op == "NotEq"
        return vmBinary_left != vmBinary_right
    end
    if vmBinary_op == "Add"
        if isString(vmBinary_left) or isString(vmBinary_right)
            return toString(vmBinary_left) + toString(vmBinary_right)
        end
        if isNumber(vmBinary_left) and isNumber(vmBinary_right)
            return vmBinary_left + vmBinary_right
        end
        return vmRaiseAt("runtime", "cannot add " + type(vmBinary_left) + " and " + type(vmBinary_right), vmBinary_instr)
    end
    if vmBinary_op == "Mul" and (isString(vmBinary_left) or isString(vmBinary_right))
        vmBinary_text = ""
        vmBinary_count = 0
        if isString(vmBinary_left)
            vmBinary_text = vmBinary_left
            vmBinary_count = vmRequireNumber(vmBinary_right, "as a string repetition count", vmBinary_instr)
        else
            vmBinary_text = vmBinary_right
            vmBinary_count = vmRequireNumber(vmBinary_left, "as a string repetition count", vmBinary_instr)
        end
        if vmError != null
            return null
        end
        if vmBinary_count <= 0 or isNaN(vmBinary_count)
            return ""
        end
        vmBinary_times = floor(vmBinary_count)
        if vmBinary_times > 1000000
            vmBinary_times = 1000000
        end
        if len(vmBinary_text) > 0 and vmBinary_times > floor(1000000 / len(vmBinary_text))
            vmBinary_times = floor(1000000 / len(vmBinary_text))
        end
        return repeat(vmBinary_text, vmBinary_times)
    end
    vmBinary_context = "on the left of the operator"
    if vmBinary_op == "Gt" or vmBinary_op == "Lt" or vmBinary_op == "GtEq" or vmBinary_op == "LtEq"
        vmBinary_context = "on the left of the comparison"
    end
    vmBinary_a = vmRequireNumber(vmBinary_left, vmBinary_context, vmBinary_instr)
    if vmError != null
        return null
    end
    if vmBinary_op == "Gt" or vmBinary_op == "Lt" or vmBinary_op == "GtEq" or vmBinary_op == "LtEq"
        vmBinary_context = "on the right of the comparison"
    else
        vmBinary_context = "on the right of the operator"
    end
    vmBinary_b = vmRequireNumber(vmBinary_right, vmBinary_context, vmBinary_instr)
    if vmError != null
        return null
    end
    if vmBinary_op == "Sub"
        return vmBinary_a - vmBinary_b
    end
    if vmBinary_op == "Mul"
        return vmBinary_a * vmBinary_b
    end
    if vmBinary_op == "Div"
        if vmBinary_b == 0
            return vmRaiseAt("runtime", "division by zero", vmBinary_instr)
        end
        return vmBinary_a / vmBinary_b
    end
    if vmBinary_op == "Mod"
        if vmBinary_b == 0
            return vmRaiseAt("runtime", "division by zero", vmBinary_instr)
        end
        return vmBinary_a % vmBinary_b
    end
    if vmBinary_op == "FloorDiv"
        if vmBinary_b == 0
            return vmRaiseAt("runtime", "division by zero", vmBinary_instr)
        end
        return floor(vmBinary_a / vmBinary_b)
    end
    if vmBinary_op == "Pow"
        return pow(vmBinary_a, vmBinary_b)
    end
    if vmBinary_op == "BitAnd"
        return vmBinary_a & vmBinary_b
    end
    if vmBinary_op == "BitOr"
        return vmBinary_a | vmBinary_b
    end
    if vmBinary_op == "BitXor"
        return vmBinary_a ^ vmBinary_b
    end
    if vmBinary_op == "Shl"
        return vmBinary_a << vmBinary_b
    end
    if vmBinary_op == "Shr"
        return vmBinary_a >> vmBinary_b
    end
    if vmBinary_op == "Gt"
        return vmBinary_a > vmBinary_b
    end
    if vmBinary_op == "Lt"
        return vmBinary_a < vmBinary_b
    end
    if vmBinary_op == "GtEq"
        return vmBinary_a >= vmBinary_b
    end
    if vmBinary_op == "LtEq"
        return vmBinary_a <= vmBinary_b
    end
    return vmRaiseAt("runtime", "unsupported binary opcode '" + vmBinary_op + "'", vmBinary_instr)
end
function vmUnary(vmUnary_op, vmUnary_value, vmUnary_instr)
