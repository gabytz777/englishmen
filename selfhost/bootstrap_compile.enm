$- The compile-only bootstrap uses these host-provided helpers. The driver
   defines emProgramArgs and the emJson*Value functions before running its IR. -$
    if name == "assert"
        if not rtTruthy(rtArg(args, 0, false))
            rtError(rtDisplay(rtArg(args, 1, "assertion failed")))
        end
        return null
    end
    if name == "jsonEncode"
        return emJsonEncodeValue(rtArg(args, 0, null))
    end
    if name == "jsonDecode"
        return emJsonDecodeValue(rtArg(args, 0, ""))
    end
    if name == "args"
        return emProgramArgs
    end
    rtError("native builtin '" + name + "' is not available in the self-hosted VM")
end
function rtBinary(op, left, right)
    if op == "Eq"
        return rtEquals(left, right)
    end
    if op == "NotEq"
        return not rtEquals(left, right)
    end
    if op == "Add"
        if isNumber(left) and isNumber(right)
            return left + right
        end
        if isString(left)
            return left + rtDisplay(right)
        end
        if isString(right)
            return rtDisplay(left) + right
        end
        rtError("Cannot add " + rtTypeName(left) + " and " + rtTypeName(right))
    end
    if op == "Mul"
        if isString(left) and isNumber(right)
            return rtStringRepeat(left, right)
        end
        if isNumber(left) and isString(right)
            return rtStringRepeat(right, left)
        end
    end
    context = "on the left of the operator"
    if op == "Gt" or op == "Lt" or op == "GtEq" or op == "LtEq"
        context = "on the left of the comparison"
    end
    a = rtExpectNumber(left, context)
    rightContext = "on the right of the operator"
    if op == "Gt" or op == "Lt" or op == "GtEq" or op == "LtEq"
        rightContext = "on the right of the comparison"
    end
    b = rtExpectNumber(right, rightContext)
    if op == "Sub"
        return a - b
    end
    if op == "Mul"
        return a * b
    end
    if op == "Div"
        if b == 0
            rtError("Division by zero")
        end
        return a / b
    end
    if op == "Mod"
        if b == 0
            rtError("Division by zero")
        end
        return a % b
    end
    if op == "FloorDiv"
        if b == 0
            rtError("Division by zero")
        end
        return floor(a / b)
    end
    if op == "Pow"
        return a ** b
    end
    if op == "BitAnd"
        return a & b
    end
    if op == "BitOr"
        return a | b
    end
    if op == "BitXor"
        return a ^ b
    end
    if op == "Shl"
        return a << b
    end
    if op == "Shr"
        return a >> b
    end
    if op == "Gt"
        return a > b
    end
    if op == "Lt"
        return a < b
    end
    if op == "GtEq"
        return a >= b
    end
    if op == "LtEq"
        return a <= b
    end
    rtError("unknown binary operator '" + op + "'")
end
$- ---------------------------------------------------------------------------
   Instruction execution. The `a` and `b` operands follow the Rust Op order.
   --------------------------------------------------------------------------- -$
function rtGetProperty(base, name)
    if not isObject(base)
        rtError("Cannot access property '" + name + "' on a " + rtTypeName(base))
    end
    if rtObjectHas(base, name)
        return rtObjectGet(base, name, null)
    end
    rtError("Unknown property '" + name + "'")
end
function rtGetIndex(base, index)
    if isArray(base)
        at = rtTrunc(index)
        if at < 0 or at >= len(base)
            rtError("Array index " + toString(at) + " is out of bounds (length " + len(base) + ")")
        end
        return base[at]
    end
    if isString(base)
        chars = rtStringChars(base)
        at = rtTrunc(index)
        if at < 0 or at >= len(chars)
            rtError("String index " + toString(at) + " is out of bounds (length " + len(chars) + ")")
        end
        return chars[at]
    end
    rtError("Cannot index into a " + rtTypeName(base))
end
function rtSetIndex(base, index, value)
    if not isArray(base)
        rtError("Cannot index into a " + rtTypeName(base))
    end
    at = rtTrunc(index)
    if at < 0 or at >= len(base)
        rtError("Array index " + toString(at) + " is out of bounds (length " + len(base) + ")")
    end
    base[at] = value
    return null
end
function rtStep(op, chunk, frame)
    name = rtObjectGet(op, "op", "")
    a = rtObjectGet(op, "a", 0)
    b = rtObjectGet(op, "b", 0)
    if name == "LoadConst"
        rtStackPush(rtConstValue(chunk, a))
        return null
    end
    if name == "Pop"
        rtStackPop()
        return null
    end
    if name == "GetVar"
        rtStackPush(rtEnvGet(frame.rtEnv, rtName(chunk, a)))
        return null
    end
    if name == "SetVar"
        rtEnvAssign(frame.rtEnv, rtName(chunk, a), rtStackPop())
        return null
    end
    if name == "DefineVar"
        rtEnvDefine(frame.rtEnv, rtName(chunk, a), rtStackPop())
        return null
    end
    if name == "GetProp"
        base = rtStackPop()
        rtStackPush(rtGetProperty(base, rtName(chunk, a)))
        return null
    end
    if name == "SetProp"
        base = rtStackPop()
        value = rtStackPop()
        if not isObject(base)
            rtError("Cannot set property '" + rtName(chunk, a) + "' on a " + rtTypeName(base))
        end
        rtObjectSet(base, rtName(chunk, a), value)
        return null
    end
    if name == "GetVarOrObject"
        variable = rtName(chunk, a)
        if not rtEnvHas(frame.rtEnv, variable)
            rtEnvDefine(frame.rtEnv, variable, {})
        end
        rtStackPush(rtEnvGet(frame.rtEnv, variable))
        return null
    end
    if name == "GetPropOrObject"
        base = rtStackPop()
        property = rtName(chunk, a)
        if isObject(base)
            if not rtObjectHas(base, property)
                rtObjectSet(base, property, {})
            end
            rtStackPush(rtObjectGet(base, property, null))
        else
            rtStackPush(rtGetProperty(base, property))
        end
        return null
    end
    if name == "GetPropKeep"
        rtStackPush(rtGetProperty(rtStackPeek(), rtName(chunk, a)))
        return null
    end
    if name == "GetIndex"
        index = rtStackPop()
        base = rtStackPop()
        rtStackPush(rtGetIndex(base, index))
        return null
    end
    if name == "GetIndexKeep"
        index = rtStackPeek()
        base = rtVm.stack[len(rtVm.stack) - 2]
        rtStackPush(rtGetIndex(base, index))
        return null
    end
    if name == "SetIndex"
        index = rtStackPop()
        base = rtStackPop()
        value = rtStackPop()
        rtSetIndex(base, index, value)
        return null
    end
    if name == "MakeArray"
        rtStackPush(rtStackDrain(a))
        return null
    end
    if name == "MakeObject"
        flat = rtStackDrain(a * 2)
        object = {}
        i = 0
        while i < len(flat)
        rtObjectSet(object, rtDisplay(flat[i]), flat[i + 1])
        i += 2
    end
    rtStackPush(object)
    return null
end
if name == "MakeClosure"
    functions = rtChunkFunctions(chunk)
    if a < 0 or a >= len(functions)
        rtError("function index " + toString(a) + " is out of range")
    end
    rtStackPush({rtKind: "closure", rtProto: functions[a], rtEnv: frame.rtEnv})
    return null
end
if name == "Call"
    args = rtStackDrain(a)
    callee = rtStackPop()
    result = rtInvoke(callee, args, rtName(chunk, b))
    if not result.rtPushed
        rtStackPush(result.rtValue)
    end
    return null
end
if name == "MethodCall"
    args = rtStackDrain(b)
    receiver = rtStackPop()
    result = rtMethodCall(receiver, rtName(chunk, a), args)
    if not result.rtPushed
        rtStackPush(result.rtValue)
    end
    return null
end
if name == "Say"
    rtSay(rtStackDrain(a))
    rtStackPush(null)
    return null
end
binaryOps = ["Add", "Sub", "Mul", "Div", "Mod", "FloorDiv", "Pow", "BitAnd", "BitOr", "BitXor", "Shl", "Shr", "Eq", "NotEq", "Gt", "Lt", "GtEq", "LtEq"]
if binaryOps.indexOf(name) >= 0
    right = rtStackPop()
    left = rtStackPop()
    rtStackPush(rtBinary(name, left, right))
    return null
end
if name == "Neg"
    rtStackPush(-rtExpectNumber(rtStackPop(), "for unary '-'"))
    return null
end
if name == "Not"
    rtStackPush(not rtTruthy(rtStackPop()))
    return null
end
if name == "BitNot"
    rtStackPush(~rtExpectNumber(rtStackPop(), "for bitwise '~'"))
    return null
end
if name == "ToBool"
    rtStackPush(rtTruthy(rtStackPop()))
    return null
end
if name == "Dup"
    rtStackPush(rtStackPeek())
    return null
end
if name == "Rotate"
    count = a + 1
    if len(rtVm.stack) < count
        rtError("Corrupt bytecode: the value stack ran empty")
    end
    rtSplitAt = len(rtVm.stack) - count
    top = rtStackPop()
    rtArrayInsert(rtVm.stack, rtSplitAt, top)
    return null
end
if name == "Jump"
    frame.rtIp = a
    return null
end
if name == "JumpIfFalse"
    if not rtTruthy(rtStackPop())
        frame.rtIp = a
    end
    return null
end
if name == "JumpIfFalsePeek"
    if not rtTruthy(rtStackPeek())
        frame.rtIp = a
    end
    return null
end
if name == "JumpIfTruePeek"
    if rtTruthy(rtStackPeek())
        frame.rtIp = a
    end
    return null
end
if name == "JumpIfNullPeek"
    if isNull(rtStackPeek())
        frame.rtIp = a
    end
    return null
end
if name == "RepeatSetup"
    count = rtExpectNumber(rtStackPop(), "as a repeat count")
    if count < 0
        rtError("repeat count must not be negative")
    end
    rtStackPush(rtTrunc(count))
    return null
end
if name == "RepeatNext"
    remaining = rtStackPeek()
    if not isNumber(remaining)
        rtError("Corrupt bytecode: unexpected value on the stack")
    end
    if remaining <= 0
        rtStackPop()
        frame.rtIp = a
    else
        rtVm.stack[len(rtVm.stack) - 1] = remaining - 1
    end
    return null
end
if name == "IterSetup"
    iterable = rtStackPop()
    if not isArray(iterable)
        rtError("Cannot iterate over a " + rtTypeName(iterable))
    end
    rtStackPush(rtArrayCopy(iterable))
    rtStackPush(0)
    return null
end
if name == "IterNext"
    cursor = rtStackPeek()
    if not isNumber(cursor)
        rtError("Corrupt bytecode: unexpected value on the stack")
    end
    source = rtVm.stack[len(rtVm.stack) - 2]
    if cursor < len(source)
        rtEnvDefine(frame.rtEnv, rtName(chunk, a), source[cursor])
        rtVm.stack[len(rtVm.stack) - 1] = cursor + 1
    else
        rtStackPop()
        rtStackPop()
        frame.rtIp = b
    end
    return null
end
if name == "Return"
    rtPopFrame(rtStackPop())
    return null
end
if name == "ReturnNull"
    rtPopFrame(null)
    return null
end
if name == "Import"
    rtImportNameValue = rtName(chunk, a)
    if not rtObjectHas(rtVm.imports, rtImportNameValue)
        rtError(rtImportMissingMessage(rtImportNameValue, rtVm.imports))
        return null
    end
    rtImportModuleValue = rtObjectGet(rtVm.imports, rtImportNameValue, null)
    rtEnvDefine(rtVm.globals, rtImportNameValue, rtImportModuleValue)
    return null
end
rtError("unknown instruction '" + name + "'")
end
function rtExecute()
    while len(rtVm.frames) > 0
    frame = rtVm.frames[len(rtVm.frames) - 1]
    code = rtChunkCode(frame.rtUnit.rtChunk)
    if frame.rtIp >= len(code)
        done = rtPopFrame(null)
        if done
            return null
        end
    else
        op = code[frame.rtIp]
        frame.rtIp = frame.rtIp + 1
        rtStep(op, frame.rtUnit.rtChunk, frame)
    end
end
return null
end
$- === inlined selfhost/pure_bytes.enm === -$
$- Pure Englishmen module object builder for the native `bytes` module.

   A buffer is an ordinary array of whole numbers from 0 to 255. Every
   conversion packs into a fresh array; `pbySet` is the one mutating helper
   and returns the same buffer it was given. Every global helper is prefixed
   with `pby` so this file can be concatenated with the other self-hosted
   pieces without collisions. `pbyBytesModule()` returns an object whose keys
   match the native module, ready to be installed as an import table entry.

   Only global builtins are used for computation. The `host` module is read
   from the ambient VM environment and used solely by `pbyWrite`, which calls
   `host.writeBytes`; the Rust CLI has no `host` module, so that function is
   not exercised by the native oracle self-test below.

   The native `bytes` module is imported only inside the self-test guard at
   the bottom, where it acts as a reference oracle. `os` is imported here only
   so that guard can read EM_SELFTEST; no other native import exists.

   Englishmen functions have fixed arity, so the module adapts native
   variadics to eight padded parameters:
     - pbyOf collects non-null arguments into one buffer.
     - pbyConcat collects non-null buffers into one buffer.
     - pbySlice takes three arguments, with a null end meaning "to the end".
   The returned object includes `__arities` for the self-hosted VM's adapter
   padding, matching the convention in `selfhost/full.enm`. When installing
   this object under the `bytes` key of an import table, lift `__arities` to
   that import table's root. `read` is deliberately absent: the C bootstrap
   host supplies `readFile`, and only file writing is wrapped here.
-$
$- ---------------------------------------------------------------------------
   Argument validation
   --------------------------------------------------------------------------- -$
function pbyIsNumber(pbyValue_arg)
    return type(pbyValue_arg) == "number"
end
function pbyIsFiniteNumber(pbyValue_arg)
    if not pbyIsNumber(pbyValue_arg)
        return false
    end
    if isNaN(pbyValue_arg)
        return false
    end
    return pbyValue_arg <=  and pbyValue_arg >= -
end
function pbyIsWhole(pbyValue_arg)
    if not pbyIsFiniteNumber(pbyValue_arg)
        return false
    end
    return pbyValue_arg == floor(pbyValue_arg)
end
function pbyAssertWhole(pbyValue_arg, pbyContext_arg)
    assert(pbyIsWhole(pbyValue_arg), "Expected a whole number " + pbyContext_arg)
end
function pbyByte(pbyValue_arg, pbyContext_arg)
    pbyAssertWhole(pbyValue_arg, pbyContext_arg)
    assert(pbyValue_arg >= 0 and pbyValue_arg <= 255, "Expected a byte from 0 to 255 " + pbyContext_arg)
    return pbyValue_arg
end
function pbyBuffer(pbyBuffer_arg, pbyContext_arg)
    assert(type(pbyBuffer_arg) == "array", "Expected a byte buffer " + pbyContext_arg)
    pbyBuffer_i = 0
    while pbyBuffer_i < len(pbyBuffer_arg)
    pbyByte(pbyBuffer_arg[pbyBuffer_i], "at index " + toString(pbyBuffer_i) + " " + pbyContext_arg)
    pbyBuffer_i += 1
end
return pbyBuffer_arg
end
function pbyExactIndex(pbyLength_arg, pbyIndex_arg, pbyContext_arg)
    pbyAssertWhole(pbyIndex_arg, pbyContext_arg)
    pbyResolved = pbyIndex_arg
    if pbyIndex_arg < 0
        pbyResolved = pbyLength_arg + pbyIndex_arg
    end
    assert(pbyResolved >= 0 and pbyResolved < pbyLength_arg, "Index " + toString(pbyIndex_arg) + " is outside a buffer of " + toString(pbyLength_arg) + " bytes")
    return pbyResolved
end
function pbySliceIndex(pbyLength_arg, pbyIndex_arg, pbyContext_arg)
    pbyAssertWhole(pbyIndex_arg, pbyContext_arg)
    if pbyIndex_arg < 0
        pbyResolved = pbyLength_arg + pbyIndex_arg
        if pbyResolved < 0
            return 0
        end
        return pbyResolved
    end
    if pbyIndex_arg > pbyLength_arg
        return pbyLength_arg
    end
    return pbyIndex_arg
end
$- ---------------------------------------------------------------------------
   Text conversion
   --------------------------------------------------------------------------- -$
function pbyFromString(pbyText_arg)
    assert(type(pbyText_arg) == "string", "pbyFromString expects a string")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyText_arg)
    pbyCode = charCode(pbyText_arg[pbyIndex])
    if pbyCode <= 127
        pbyOut.add(pbyCode)
    else if pbyCode <= 2047
        pbyOut.add(192 | ((pbyCode >> 6) & 31))
        pbyOut.add(128 | (pbyCode & 63))
    else if pbyCode <= 65535
        pbyOut.add(224 | ((pbyCode >> 12) & 15))
        pbyOut.add(128 | ((pbyCode >> 6) & 63))
        pbyOut.add(128 | (pbyCode & 63))
    else
        pbyOut.add(240 | ((pbyCode >> 18) & 7))
        pbyOut.add(128 | ((pbyCode >> 12) & 63))
        pbyOut.add(128 | ((pbyCode >> 6) & 63))
        pbyOut.add(128 | (pbyCode & 63))
    end
    pbyIndex += 1
end
return pbyOut
end
function pbyUtf8Continuation(pbyByte_arg)
    return pbyByte_arg >= 128 and pbyByte_arg <= 191
end
function pbyToString(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyToString")
    pbyOut = ""
    pbySize = len(pbyBuffer_arg)
    pbyIndex = 0
    while pbyIndex < pbySize
    pbyLead = pbyBuffer_arg[pbyIndex]
    if pbyLead < 128
        pbyOut += fromCharCode(pbyLead)
    else if pbyLead >= 194 and pbyLead <= 223
        assert(pbyIndex + 1 < pbySize, "Truncated UTF-8 sequence for pbyToString")
        pbyNext = pbyBuffer_arg[pbyIndex + 1]
        assert(pbyUtf8Continuation(pbyNext), "Invalid UTF-8 continuation byte for pbyToString")
        pbyCode = ((pbyLead & 31) << 6) | (pbyNext & 63)
        assert(pbyCode >= 128, "Overlong UTF-8 sequence for pbyToString")
        pbyOut += fromCharCode(pbyCode)
        pbyIndex += 1
    else if pbyLead >= 224 and pbyLead <= 239
        assert(pbyIndex + 2 < pbySize, "Truncated UTF-8 sequence for pbyToString")
        pbyNext = pbyBuffer_arg[pbyIndex + 1]
        pbyLast = pbyBuffer_arg[pbyIndex + 2]
        assert(pbyUtf8Continuation(pbyNext) and pbyUtf8Continuation(pbyLast), "Invalid UTF-8 continuation byte for pbyToString")
        if pbyLead == 224
            assert(pbyNext >= 160, "Overlong UTF-8 sequence for pbyToString")
        end
        if pbyLead == 237
            assert(pbyNext <= 159, "UTF-8 surrogate is not a scalar value for pbyToString")
        end
        pbyCode = ((pbyLead & 15) << 12) | ((pbyNext & 63) << 6) | (pbyLast & 63)
        assert(pbyCode >= 2048 and not (pbyCode >= 55296 and pbyCode <= 57343), "Invalid UTF-8 code point for pbyToString")
        pbyOut += fromCharCode(pbyCode)
        pbyIndex += 2
    else if pbyLead >= 240 and pbyLead <= 244
        assert(pbyIndex + 3 < pbySize, "Truncated UTF-8 sequence for pbyToString")
        pbyNext = pbyBuffer_arg[pbyIndex + 1]
        pbySecond = pbyBuffer_arg[pbyIndex + 2]
        pbyLast = pbyBuffer_arg[pbyIndex + 3]
        assert(pbyUtf8Continuation(pbyNext) and pbyUtf8Continuation(pbySecond) and pbyUtf8Continuation(pbyLast), "Invalid UTF-8 continuation byte for pbyToString")
        if pbyLead == 240
            assert(pbyNext >= 144, "Overlong UTF-8 sequence for pbyToString")
        end
        if pbyLead == 244
            assert(pbyNext <= 143, "UTF-8 code point above U+10FFFF for pbyToString")
        end
        pbyCode = ((pbyLead & 7) << 18) | ((pbyNext & 63) << 12) | ((pbySecond & 63) << 6) | (pbyLast & 63)
        assert(pbyCode >= 65536 and pbyCode <= 1114111, "Invalid UTF-8 code point for pbyToString")
        pbyOut += fromCharCode(pbyCode)
        pbyIndex += 3
    else
        assert(false, "Invalid UTF-8 lead byte for pbyToString")
    end
    pbyIndex += 1
end
return pbyOut
end
$- ---------------------------------------------------------------------------
   Buffers, indexing and slicing
   --------------------------------------------------------------------------- -$
function pbyOfValues(pbyValues_arg)
    if type(pbyValues_arg) == "number"
        return [pbyByte(pbyValues_arg, "as a byte for bytes.of")]
    end
    assert(type(pbyValues_arg) == "array", "bytes.of expects a number or an array of numbers")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyValues_arg)
    pbyOut.add(pbyByte(pbyValues_arg[pbyIndex], "as byte " + toString(pbyIndex + 1) + " for bytes.of"))
    pbyIndex += 1
end
return pbyOut
end
$- The self-hosted VM pads this adapter with nulls up to eight arguments. -$
function pbyOf(pbyA_arg, pbyB_arg, pbyC_arg, pbyD_arg, pbyE_arg, pbyF_arg, pbyG_arg, pbyH_arg)
    pbyValues = []
    if not isNull(pbyA_arg)
        pbyValues.add(pbyA_arg)
    end
    if not isNull(pbyB_arg)
        pbyValues.add(pbyB_arg)
    end
    if not isNull(pbyC_arg)
        pbyValues.add(pbyC_arg)
    end
    if not isNull(pbyD_arg)
        pbyValues.add(pbyD_arg)
    end
    if not isNull(pbyE_arg)
        pbyValues.add(pbyE_arg)
    end
    if not isNull(pbyF_arg)
        pbyValues.add(pbyF_arg)
    end
    if not isNull(pbyG_arg)
        pbyValues.add(pbyG_arg)
    end
    if not isNull(pbyH_arg)
        pbyValues.add(pbyH_arg)
    end
    return pbyOfValues(pbyValues)
end
function pbyLength(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyLength")
    return len(pbyBuffer_arg)
end
function pbyGet(pbyBuffer_arg, pbyIndex_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyGet")
    pbyResolved = pbyExactIndex(len(pbyBuffer_arg), pbyIndex_arg, "as the index for pbyGet")
    return pbyBuffer_arg[pbyResolved]
end
function pbySet(pbyBuffer_arg, pbyIndex_arg, pbyValue_arg)
$- Validate the whole buffer before changing any of it, like the native module. -$
    pbyBuffer(pbyBuffer_arg, "for pbySet")
    pbyResolved = pbyExactIndex(len(pbyBuffer_arg), pbyIndex_arg, "as the index for pbySet")
    pbyByte(pbyValue_arg, "as the byte for pbySet")
    pbyBuffer_arg[pbyResolved] = pbyValue_arg
    return pbyBuffer_arg
end
function pbyConcatBuffers(pbyBuffers_arg)
    assert(type(pbyBuffers_arg) == "array", "bytes.concat expects an array of buffers")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyBuffers_arg)
    pbyPart = pbyBuffer(pbyBuffers_arg[pbyIndex], "as buffer " + toString(pbyIndex + 1) + " for bytes.concat")
    pbyInner = 0
    while pbyInner < len(pbyPart)
    pbyOut.add(pbyPart[pbyInner])
    pbyInner += 1
end
pbyIndex += 1
end
return pbyOut
end
$- The self-hosted VM pads this adapter with nulls up to eight arguments. -$
function pbyConcat(pbyA_arg, pbyB_arg, pbyC_arg, pbyD_arg, pbyE_arg, pbyF_arg, pbyG_arg, pbyH_arg)
    pbyBuffers = []
    if not isNull(pbyA_arg)
        pbyBuffers.add(pbyA_arg)
    end
    if not isNull(pbyB_arg)
        pbyBuffers.add(pbyB_arg)
    end
    if not isNull(pbyC_arg)
        pbyBuffers.add(pbyC_arg)
    end
    if not isNull(pbyD_arg)
        pbyBuffers.add(pbyD_arg)
    end
    if not isNull(pbyE_arg)
        pbyBuffers.add(pbyE_arg)
    end
    if not isNull(pbyF_arg)
        pbyBuffers.add(pbyF_arg)
    end
    if not isNull(pbyG_arg)
        pbyBuffers.add(pbyG_arg)
    end
    if not isNull(pbyH_arg)
        pbyBuffers.add(pbyH_arg)
    end
    return pbyConcatBuffers(pbyBuffers)
end
function pbySlice(pbyBuffer_arg, pbyStart_arg, pbyEnd_arg)
    pbyBuffer(pbyBuffer_arg, "for pbySlice")
    if pbyEnd_arg == null
        pbyStop = len(pbyBuffer_arg)
    else
        pbyStop = pbyEnd_arg
    end
    pbyFrom = pbySliceIndex(len(pbyBuffer_arg), pbyStart_arg, "as the start index for pbySlice")
    pbyTo = pbySliceIndex(len(pbyBuffer_arg), pbyStop, "as the end index for pbySlice")
    pbyOut = []
    pbyIndex = pbyFrom
    while pbyIndex < pbyTo
    pbyOut.add(pbyBuffer_arg[pbyIndex])
    pbyIndex += 1
end
return pbyOut
end
function pbyCopy(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyCopy")
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < len(pbyBuffer_arg)
    pbyOut.add(pbyBuffer_arg[pbyIndex])
    pbyIndex += 1
end
return pbyOut
end
$- ---------------------------------------------------------------------------
   Hex conversion
   --------------------------------------------------------------------------- -$
function pbyHexDigit(pbyChar_arg)
    pbyCode = charCode(pbyChar_arg)
    if pbyCode >= 48 and pbyCode <= 57
        return pbyCode - 48
    end
    if pbyCode >= 97 and pbyCode <= 102
        return pbyCode - 87
    end
    if pbyCode >= 65 and pbyCode <= 70
        return pbyCode - 55
    end
    return -1
end
function pbyIsAsciiWhitespace(pbyCode_arg)
    return pbyCode_arg == 9 or pbyCode_arg == 10 or pbyCode_arg == 11 or pbyCode_arg == 12 or pbyCode_arg == 13 or pbyCode_arg == 32
end
function pbyFromHex(pbyText_arg)
    assert(type(pbyText_arg) == "string", "pbyFromHex expects hex text")
    pbyCompact = ""
    pbyIndex = 0
    while pbyIndex < len(pbyText_arg)
    pbyChar = pbyText_arg[pbyIndex]
    if not pbyIsAsciiWhitespace(charCode(pbyChar))
        pbyCompact += pbyChar
    end
    pbyIndex += 1
end
assert(len(pbyCompact) % 2 == 0, "pbyFromHex expects an even number of hex digits")
pbyOut = []
pbyIndex = 0
while pbyIndex < len(pbyCompact)
pbyHigh = pbyHexDigit(pbyCompact[pbyIndex])
pbyLow = pbyHexDigit(pbyCompact[pbyIndex + 1])
assert(pbyHigh >= 0 and pbyLow >= 0, "Invalid hex byte for pbyFromHex")
pbyOut.add(pbyHigh * 16 + pbyLow)
pbyIndex += 2
end
return pbyOut
end
function pbyHexPair(pbyByte_arg)
    pbyDigits = "0123456789abcdef"
    return pbyDigits[floor(pbyByte_arg / 16)] + pbyDigits[pbyByte_arg % 16]
end
function pbyToHex(pbyBuffer_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyToHex")
    pbyParts = []
    pbyIndex = 0
    while pbyIndex < len(pbyBuffer_arg)
    pbyParts.add(pbyHexPair(pbyBuffer_arg[pbyIndex]))
    pbyIndex += 1
end
return join(pbyParts, " ")
end
$- ---------------------------------------------------------------------------
   Little-endian integer packing
   --------------------------------------------------------------------------- -$
function pbyLeBytes(pbyValue_arg, pbyCount_arg)
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < pbyCount_arg
    pbyOut.add(pbyValue_arg % 256)
    pbyValue_arg = floor(pbyValue_arg / 256)
    pbyIndex += 1
end
return pbyOut
end
function pbyUnsignedArg(pbyValue_arg, pbyUpper_arg, pbyName_arg, pbyMaxLabel_arg)
    pbyAssertWhole(pbyValue_arg, "as the number for " + pbyName_arg)
    assert(pbyValue_arg >= 0 and pbyValue_arg < pbyUpper_arg, pbyName_arg + " expects a whole number from 0 to " + pbyMaxLabel_arg)
    return pbyValue_arg
end
function pbySignedLeBytes(pbyValue_arg, pbyCount_arg)
    pbyOut = []
    pbyIndex = 0
    while pbyIndex < pbyCount_arg
    pbyOut.add(pbyValue_arg & 255)
    pbyValue_arg = pbyValue_arg >> 8
    pbyIndex += 1
end
return pbyOut
end
function pbySignedArg(pbyValue_arg, pbyLower_arg, pbyUpper_arg, pbyName_arg, pbyMinLabel_arg, pbyMaxLabel_arg)
    pbyAssertWhole(pbyValue_arg, "as the number for " + pbyName_arg)
    assert(pbyValue_arg >= pbyLower_arg and pbyValue_arg < pbyUpper_arg, pbyName_arg + " expects a whole number from " + pbyMinLabel_arg + " to " + pbyMaxLabel_arg)
    return pbyValue_arg
end
function pbyU8(pbyValue_arg)
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, 256, "bytes.u8", "255"), 1)
end
function pbyU16(pbyValue_arg)
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, 65536, "bytes.u16", "65535"), 2)
end
function pbyU32(pbyValue_arg)
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, 4294967296, "bytes.u32", "4294967295"), 4)
end
function pbyU64(pbyValue_arg)
$- 2^64 is exactly representable as an f64 and keeps an out-of-range input from becoming u64::MAX. -$
    return pbyLeBytes(pbyUnsignedArg(pbyValue_arg, pow(2, 64), "bytes.u64", "18446744073709551615"), 8)
end
$- bytes.i8 is not present in the native module, but the round-4 surface list
   asks for it. It follows the same two's-complement little-endian rule. -$
function pbyI8(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -128, 128, "bytes.i8", "-128", "127"), 1)
end
function pbyI16(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -32768, 32768, "bytes.i16", "-32768", "32767"), 2)
end
function pbyI32(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -2147483648, 2147483648, "bytes.i32", "-2147483648", "2147483647"), 4)
end
function pbyI64(pbyValue_arg)
    return pbySignedLeBytes(pbySignedArg(pbyValue_arg, -9223372036854776000, 9223372036854776000, "bytes.i64", "-9223372036854775808", "9223372036854775807"), 8)
end
$- ---------------------------------------------------------------------------
   IEEE-754 binary64 packing and unpacking
   --------------------------------------------------------------------------- -$
function pbySetBit(pbyBytes_arg, pbyIndex_arg, pbyBit_arg)
    pbyByteIndex = floor(pbyIndex_arg / 8)
    pbyBitIndex = pbyIndex_arg % 8
    pbyBytes_arg[pbyByteIndex] = pbyBytes_arg[pbyByteIndex] + (pbyBit_arg << pbyBitIndex)
end
function pbyPutBits(pbyBytes_arg, pbyValue_arg, pbyStart_arg, pbyCount_arg)
    pbyIndex = 0
    while pbyIndex < pbyCount_arg
    pbyBit = floor(pbyValue_arg / pow(2, pbyIndex)) % 2
    pbySetBit(pbyBytes_arg, pbyStart_arg + pbyIndex, pbyBit)
    pbyIndex += 1
end
end
function pbyBitAt(pbyBytes_arg, pbyIndex_arg)
    pbyByteIndex = floor(pbyIndex_arg / 8)
    pbyBitIndex = pbyIndex_arg % 8
    return floor(pbyBytes_arg[pbyByteIndex] / pow(2, pbyBitIndex)) % 2
end
function pbyF64Bits(pbyValue_arg)
    pbyNegative = pbyValue_arg < 0
    if pbyValue_arg == 0 and pow(pbyValue_arg, -1) < 0
        pbyNegative = true
    end
    pbyBytes = [0, 0, 0, 0, 0, 0, 0, 0]
    if isNaN(pbyValue_arg)
$- Englishmen arithmetic produces a negative quiet NaN; keep its sign bit. -$
        pbyNegative = true
        pbyExponent = 2047
        pbyMantissa = pow(2, 51)
    else if pbyValue_arg >  or pbyValue_arg < -
        pbyExponent = 2047
        pbyMantissa = 0
    else if pbyValue_arg == 0
        pbyExponent = 0
        pbyMantissa = 0
    else
        pbyMagnitude = abs(pbyValue_arg)
        pbyScale = pbyMagnitude
        pbyExponentCount = 0
        while pbyScale >= 2
        pbyScale = pbyScale / 2
        pbyExponentCount += 1
    end
    while pbyScale < 1
    pbyScale = pbyScale * 2
    pbyExponentCount -= 1
end
if pbyExponentCount >= -1022
    pbyExponent = pbyExponentCount + 1023
    pbyMantissa = floor((pbyScale - 1) * pow(2, 52))
else
$- Subnormals have no implicit leading 1: divide by the smallest double. -$
    pbyExponent = 0
    pbyMantissa = floor(pbyMagnitude / pow(2, -1074))
end
end
if pbyNegative
    pbySetBit(pbyBytes, 63, 1)
end
pbyPutBits(pbyBytes, pbyExponent, 52, 11)
pbyPutBits(pbyBytes, pbyMantissa, 0, 52)
return pbyBytes
end
function pbyF64(pbyValue_arg)
    assert(pbyIsNumber(pbyValue_arg), "pbyF64 expects a number")
    return pbyF64Bits(pbyValue_arg)
end
function pbyReadU16(pbyBuffer_arg, pbyOffset_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyReadU16")
    pbyAssertWhole(pbyOffset_arg, "as the offset for pbyReadU16")
    assert(pbyOffset_arg >= 0 and pbyOffset_arg + 2 <= len(pbyBuffer_arg), "pbyReadU16 needs two bytes inside the buffer")
    return pbyBuffer_arg[pbyOffset_arg] + pbyBuffer_arg[pbyOffset_arg + 1] * 256
end
function pbyReadU32(pbyBuffer_arg, pbyOffset_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyReadU32")
    pbyAssertWhole(pbyOffset_arg, "as the offset for pbyReadU32")
    assert(pbyOffset_arg >= 0 and pbyOffset_arg + 4 <= len(pbyBuffer_arg), "pbyReadU32 needs four bytes inside the buffer")
    return pbyBuffer_arg[pbyOffset_arg] + pbyBuffer_arg[pbyOffset_arg + 1] * 256 + pbyBuffer_arg[pbyOffset_arg + 2] * 65536 + pbyBuffer_arg[pbyOffset_arg + 3] * 16777216
end
function pbyReadF64(pbyBuffer_arg, pbyOffset_arg)
    pbyBuffer(pbyBuffer_arg, "for pbyReadF64")
    pbyAssertWhole(pbyOffset_arg, "as the offset for pbyReadF64")
    assert(pbyOffset_arg >= 0 and pbyOffset_arg + 8 <= len(pbyBuffer_arg), "pbyReadF64 needs eight bytes inside the buffer")
    pbyExponent = 0
    pbyBit = 0
    while pbyBit < 11
    pbyExponent += pbyBitAt(pbyBuffer_arg, pbyOffset_arg * 8 + 52 + pbyBit) * pow(2, pbyBit)
    pbyBit += 1
end
pbyMantissa = 0
pbyBit = 0
while pbyBit < 52
pbyMantissa += pbyBitAt(pbyBuffer_arg, pbyOffset_arg * 8 + pbyBit) * pow(2, pbyBit)
pbyBit += 1
end
if pbyExponent == 2047
    if pbyMantissa == 0
        pbyValue = pow(2, 1024)
    else
        pbyValue = pow(-1, 0.5)
    end
else if pbyExponent == 0
    pbyValue = pbyMantissa * pow(2, -1074)
else
    pbyValue = pow(2, pbyExponent - 1023) * (1 + pbyMantissa / pow(2, 52))
end
if pbyBitAt(pbyBuffer_arg, pbyOffset_arg * 8 + 63) == 1
    pbyValue = -pbyValue
end
return pbyValue
end
$- ---------------------------------------------------------------------------
   Module object and host file writing
   --------------------------------------------------------------------------- -$
$- `host` is supplied by the C bootstrap VM. The Rust CLI has no such module,
   so referencing it here is harmless until pbyWrite is actually called. -$
function pbyWrite(pbyPath_arg, pbyBuffer_arg)
    assert(type(pbyPath_arg) == "string", "bytes.write expects a path string")
    pbyBuffer(pbyBuffer_arg, "for bytes.write")
    pbyWriteResult = host.writeBytes(pbyPath_arg, pbyBuffer_arg)
    if isObject(pbyWriteResult) and contains(keys(pbyWriteResult), "__hostError")
        assert(false, "Could not write '" + pbyPath_arg + "'")
    end
    return pbyWriteResult
end
function pbyBytesModule()
    return {__arities: {of: 8, concat: 8, slice: 3}, of: pbyOf, fromString: pbyFromString, toString: pbyToString, concat: pbyConcat, slice: pbySlice, copy: pbyCopy, length: pbyLength, get: pbyGet, set: pbySet, u8: pbyU8, u16: pbyU16, u32: pbyU32, u64: pbyU64, i8: pbyI8, i16: pbyI16, i32: pbyI32, i64: pbyI64, f64: pbyF64, fromHex: pbyFromHex, toHex: pbyToHex, write: pbyWrite}
end
$- ---------------------------------------------------------------------------
   Self-tests: the native bytes module is an oracle only inside this guard.
   --------------------------------------------------------------------------- -$
$- === inlined selfhost/pure_emb_file.enm === -$
$-!
    selfhost/pure_emb_file.enm

    Pure-Englishmen `emb` module object for the C bootstrap VM.  The module
    value returned by `pefEmbModule()` mirrors the native `emb` module:

        magic, version, encodeOp, encode, write, writeBytes

    `pefEncode` is the pure IR encoder contract from `selfhost/ir_encode.enm`;
    its helpers are duplicated here with a `pef` prefix because self-hosted
    files cannot import one another.  `pefWrite`/`pefWriteBytes` persist bytes
    only through the `host` module supplied by the bootstrap VM.  No native
    module other than `os` (used solely for the EM_SELFTEST guard) is imported
    outside the guarded oracle self-test at the bottom of this file.
!-$
$- Name -> [tag, operand shape], copied from src/modules/emb.rs and mirrored by
   bytecode::encode_op.  Shape 0 zeroes both operands, shape 1 keeps `a`,
   shape 2 keeps `a` and `b`. -$
pefOps = {LoadConst: [0, 1], Pop: [1, 0], GetVar: [2, 1], SetVar: [3, 1], DefineVar: [4, 1], GetProp: [5, 1], SetProp: [6, 1], GetVarOrObject: [7, 1], GetPropOrObject: [8, 1], GetIndex: [9, 0], SetIndex: [10, 0], MakeArray: [11, 1], MakeObject: [12, 1], MakeClosure: [13, 1], Call: [14, 2], MethodCall: [15, 2], Say: [16, 1], Add: [17, 0], Sub: [18, 0], Mul: [19, 0], Div: [20, 0], Mod: [21, 0], FloorDiv: [42, 0], Pow: [43, 0], BitAnd: [44, 0], BitOr: [45, 0], BitXor: [46, 0], Shl: [47, 0], Shr: [48, 0], Eq: [22, 0], NotEq: [23, 0], Gt: [24, 0], Lt: [25, 0], GtEq: [26, 0], LtEq: [27, 0], Neg: [28, 0], Not: [29, 0], BitNot: [49, 0], ToBool: [30, 0], Jump: [31, 1], JumpIfFalse: [32, 1], JumpIfFalsePeek: [33, 1], JumpIfTruePeek: [34, 1], RepeatSetup: [35, 0], RepeatNext: [36, 1], IterSetup: [37, 0], IterNext: [38, 2], Return: [39, 0], ReturnNull: [40, 0], Import: [41, 1], Dup: [50, 0], Rotate: [51, 1], GetPropKeep: [52, 1], GetIndexKeep: [53, 0], JumpIfNullPeek: [54, 1]}
$- Append the low `count` bytes of a non-negative whole number, little-endian. -$
function pefAppendUint(pefAppendUint_out, pefAppendUint_value, pefAppendUint_count)
    assert(isNumber(pefAppendUint_value), "pefEncode: expected a whole number")
    assert(pefAppendUint_value >= 0, "pefEncode: expected a non-negative whole number")
    for pefAppendUint_i in range(pefAppendUint_count)
        pefAppendUint_out.add(pefAppendUint_value % 256)
        pefAppendUint_value = floor(pefAppendUint_value / 256)
    end
end
$- Append a u32 exactly as bytecode::write_u32 does. -$
function pefAppendU32(pefAppendU32_out, pefAppendU32_value)
    assert(isNumber(pefAppendU32_value) and pefAppendU32_value <= 4294967295, "pefEncode: u32 out of range")
    pefAppendUint(pefAppendU32_out, pefAppendU32_value, 4)
end
$- UTF-8 bytes for one string, matching Rust's String::as_bytes. -$
function pefTextBytes(pefTextBytes_text)
    pefTextBytes_out = []
    for pefTextBytes_i in range(len(pefTextBytes_text))
        pefTextBytes_code = charCode(pefTextBytes_text[pefTextBytes_i])
        if pefTextBytes_code <= 127
            pefTextBytes_out.add(pefTextBytes_code)
        else if pefTextBytes_code <= 2047
            pefTextBytes_out.add(192 | (pefTextBytes_code >> 6))
            pefTextBytes_out.add(128 | (pefTextBytes_code & 63))
        else if pefTextBytes_code <= 65535
            pefTextBytes_out.add(224 | (pefTextBytes_code >> 12))
            pefTextBytes_out.add(128 | ((pefTextBytes_code >> 6) & 63))
            pefTextBytes_out.add(128 | (pefTextBytes_code & 63))
        else
            pefTextBytes_out.add(240 | (pefTextBytes_code >> 18))
            pefTextBytes_out.add(128 | ((pefTextBytes_code >> 12) & 63))
            pefTextBytes_out.add(128 | ((pefTextBytes_code >> 6) & 63))
            pefTextBytes_out.add(128 | (pefTextBytes_code & 63))
        end
    end
    return pefTextBytes_out
end
$- A length-prefixed UTF-8 string (write_str in bytecode.rs). -$
function pefAppendStr(pefAppendStr_out, pefAppendStr_text)
    assert(isString(pefAppendStr_text), "pefEncode: expected a string")
    pefAppendStr_bytes = pefTextBytes(pefAppendStr_text)
    pefAppendU32(pefAppendStr_out, len(pefAppendStr_bytes))
    for pefAppendStr_byte in pefAppendStr_bytes
        pefAppendStr_out.add(pefAppendStr_byte)
    end
end
$- IEEE-754 binary64, little-endian.  Scaling by powers of two is exact, so
   the recovered 52-bit fraction is bit-identical to f64::to_le_bytes. -$
function pefAppendF64(pefAppendF64_out, pefAppendF64_number)
    assert(isNumber(pefAppendF64_number), "pefEncode: expected a number constant")
    pefAppendF64_sign = 0
    if isNaN(pefAppendF64_number)
        if pefAppendF64_number.toFixed(1).startsWith("-")
            pefAppendF64_sign = 1
        end
    else if pefAppendF64_number == 0
        if pefAppendF64_number.toFixed(1).startsWith("-")
            pefAppendF64_sign = 1
        end
    else if pefAppendF64_number < 0
        pefAppendF64_sign = 1
    end
    pefAppendF64_exponent = 0
    pefAppendF64_fraction = 0
    if isNaN(pefAppendF64_number)
        pefAppendF64_exponent = 2047
        pefAppendF64_fraction = 2251799813685248 $- 2^51, canonical quiet NaN -$
    else if not pefAppendF64_number.isFinite()
        pefAppendF64_exponent = 2047
        pefAppendF64_fraction = 0
    else
        pefAppendF64_magnitude = abs(pefAppendF64_number)
        if pefAppendF64_magnitude > 0
            pefAppendF64_scaled = pefAppendF64_magnitude
            pefAppendF64_unbiased = 0
            for pefAppendF64_i in range(1100)
                if pefAppendF64_scaled >= 2
                    pefAppendF64_scaled = pefAppendF64_scaled / 2
                    pefAppendF64_unbiased += 1
                else
                    break
                end
            end
            for pefAppendF64_i in range(1100)
                if pefAppendF64_scaled < 1 and pefAppendF64_unbiased > -1022
                    pefAppendF64_scaled = pefAppendF64_scaled * 2
                    pefAppendF64_unbiased -= 1
                else
                    break
                end
            end
            if pefAppendF64_unbiased == -1022 and pefAppendF64_scaled < 1
$- Subnormal: `scaled` is already magnitude * 2^1022. -$
                pefAppendF64_exponent = 0
                pefAppendF64_fraction = pefAppendF64_scaled
            else
                pefAppendF64_exponent = pefAppendF64_unbiased + 1023
                pefAppendF64_fraction = pefAppendF64_scaled - 1
            end
            for pefAppendF64_i in range(52)
                pefAppendF64_fraction = pefAppendF64_fraction * 2
            end
            pefAppendF64_fraction = floor(pefAppendF64_fraction)
        end
    end
$- Fraction bytes 0..5; the top four fraction bits share byte 6 with the
           low four exponent bits.  Byte 7 holds the remaining exponent bits and
           the sign bit. -$
    for pefAppendF64_i in range(6)
        pefAppendF64_out.add(pefAppendF64_fraction % 256)
        pefAppendF64_fraction = floor(pefAppendF64_fraction / 256)
    end
    pefAppendF64_out.add((pefAppendF64_fraction % 16) + ((pefAppendF64_exponent % 16) * 16))
    pefAppendF64_out.add(floor(pefAppendF64_exponent / 16) + (pefAppendF64_sign * 128))
end
$- Validate and append a u32 operand; absent fields use the Rust defaults. -$
function pefOperand(pefOperand_instruction, pefOperand_name, pefOperand_fallback)
    if not pefOperand_instruction.has(pefOperand_name)
        return pefOperand_fallback
    end
    pefOperand_value = pefOperand_instruction.get(pefOperand_name)
    assert(isNumber(pefOperand_value) and pefOperand_value.isFinite(), "pefEncode: operand must be a finite number")
    assert(pefOperand_value >= 0 and pefOperand_value <= 4294967295 and pefOperand_value == floor(pefOperand_value), "pefEncode: operand must be a u32")
    return pefOperand_value
end
function pefAppendConstant(pefAppendConstant_out, pefAppendConstant_constant)
    pefAppendConstant_tag = pefAppendConstant_constant.get("tag", null)
    assert(isString(pefAppendConstant_tag), "pefEncode: constant tag must be a string")
    if pefAppendConstant_tag == "number"
        pefAppendConstant_value = pefAppendConstant_constant.get("value")
        assert(isNumber(pefAppendConstant_value), "pefEncode: number constant needs a numeric value")
        pefAppendConstant_out.add(0)
        pefAppendF64(pefAppendConstant_out, pefAppendConstant_value)
    else if pefAppendConstant_tag == "string"
        pefAppendConstant_value = pefAppendConstant_constant.get("value")
        pefAppendConstant_out.add(1)
        pefAppendStr(pefAppendConstant_out, pefAppendConstant_value)
    else if pefAppendConstant_tag == "bool"
        pefAppendConstant_value = pefAppendConstant_constant.get("value")
        assert(isBool(pefAppendConstant_value), "pefEncode: bool constant needs a boolean value")
        pefAppendConstant_out.add(2)
        if pefAppendConstant_value
            pefAppendConstant_out.add(1)
        else
            pefAppendConstant_out.add(0)
        end
    else if pefAppendConstant_tag == "null"
        pefAppendConstant_out.add(3)
    else
        assert(false, "pefEncode: unknown constant tag '" + pefAppendConstant_tag + "'")
    end
end
function pefAppendInstruction(pefAppendInstruction_out, pefAppendInstruction_instruction)
    pefAppendInstruction_name = pefAppendInstruction_instruction.get("op", null)
    assert(isString(pefAppendInstruction_name) and pefOps.has(pefAppendInstruction_name), "pefEncode: unknown op name")
    pefAppendInstruction_info = pefOps.get(pefAppendInstruction_name)
    pefAppendInstruction_a = pefOperand(pefAppendInstruction_instruction, "a", 0)
    pefAppendInstruction_b = pefOperand(pefAppendInstruction_instruction, "b", 0)
    pefAppendInstruction_line = pefOperand(pefAppendInstruction_instruction, "line", 1)
    pefAppendInstruction_col = pefOperand(pefAppendInstruction_instruction, "col", 1)
    if pefAppendInstruction_info[1] == 0
        pefAppendInstruction_a = 0
        pefAppendInstruction_b = 0
    else if pefAppendInstruction_info[1] == 1
        pefAppendInstruction_b = 0
    end
    pefAppendInstruction_out.add(pefAppendInstruction_info[0])
    pefAppendU32(pefAppendInstruction_out, pefAppendInstruction_a)
    pefAppendU32(pefAppendInstruction_out, pefAppendInstruction_b)
    pefAppendU32(pefAppendInstruction_out, pefAppendInstruction_line)
    pefAppendU32(pefAppendInstruction_out, pefAppendInstruction_col)
end
$- Chunks are recursive: constants, functions (with their own chunk), code. -$
function pefAppendChunk(pefAppendChunk_out, pefAppendChunk_chunk, pefAppendChunk_depth)
    assert(pefAppendChunk_depth <= 32, "pefEncode: functions are nested too deeply")
    pefAppendChunk_constants = pefAppendChunk_chunk.get("constants")
    pefAppendChunk_functions = pefAppendChunk_chunk.get("functions")
    pefAppendChunk_code = pefAppendChunk_chunk.get("code")
    assert(isArray(pefAppendChunk_constants), "pefEncode: chunk needs a constants array")
    assert(isArray(pefAppendChunk_functions), "pefEncode: chunk needs a functions array")
    assert(isArray(pefAppendChunk_code), "pefEncode: chunk needs a code array")
    pefAppendU32(pefAppendChunk_out, len(pefAppendChunk_constants))
    for pefAppendChunk_constant in pefAppendChunk_constants
        pefAppendConstant(pefAppendChunk_out, pefAppendChunk_constant)
    end
    pefAppendU32(pefAppendChunk_out, len(pefAppendChunk_functions))
    for pefAppendChunk_prototype in pefAppendChunk_functions
        pefAppendChunk_name = pefAppendChunk_prototype.get("name")
        pefAppendChunk_params = pefAppendChunk_prototype.get("params")
        pefAppendChunk_body = pefAppendChunk_prototype.get("chunk")
        assert(isString(pefAppendChunk_name), "pefEncode: function needs a string name")
        assert(isArray(pefAppendChunk_params), "pefEncode: function needs a params array")
        pefAppendStr(pefAppendChunk_out, pefAppendChunk_name)
        pefAppendU32(pefAppendChunk_out, len(pefAppendChunk_params))
        for pefAppendChunk_param in pefAppendChunk_params
            pefAppendStr(pefAppendChunk_out, pefAppendChunk_param)
        end
        pefAppendChunk(pefAppendChunk_out, pefAppendChunk_body, pefAppendChunk_depth + 1)
    end
    pefAppendU32(pefAppendChunk_out, len(pefAppendChunk_code))
    for pefAppendChunk_instruction in pefAppendChunk_code
        pefAppendInstruction(pefAppendChunk_out, pefAppendChunk_instruction)
    end
end
$- Public encoder entry point: magic, LE u16 version, then the root chunk. -$
function pefEncode(pefEncode_ir)
    assert(pefEncode_ir.get("version") == 2, "pefEncode: version mismatch, expected 2")
    pefEncode_out = []
    pefEncode_out.add(charCode("E"))
    pefEncode_out.add(charCode("M"))
    pefEncode_out.add(charCode("B"))
    pefEncode_out.add(charCode("C"))
    pefEncode_out.add(2)
    pefEncode_out.add(0)
    pefAppendChunk(pefEncode_out, pefEncode_ir, 0)
    return pefEncode_out
end
$- Native-module-compatible members.  Paths are strings and buffers are arrays
   of whole bytes; `host.writeBytes` is the only persistence primitive used. -$
function pefMagic()
    return "EMBC"
end
function pefVersion()
    return 2
end
function pefEncodeOp(pefEncodeOp_name)
    assert(isString(pefEncodeOp_name) and pefOps.has(pefEncodeOp_name), "pefEncodeOp: unknown op name '" + toString(pefEncodeOp_name) + "'")
    return pefOps.get(pefEncodeOp_name)[0]
end
function pefWriteBytes(pefWriteBytes_path, pefWriteBytes_bytes)
    assert(isString(pefWriteBytes_path), "pefWriteBytes: expected a string as the path")
    assert(isArray(pefWriteBytes_bytes), "pefWriteBytes: expected an array for the buffer")
    for pefWriteBytes_i in range(len(pefWriteBytes_bytes))
        pefWriteBytes_byte = pefWriteBytes_bytes[pefWriteBytes_i]
        assert(isNumber(pefWriteBytes_byte) and pefWriteBytes_byte.isFinite() and pefWriteBytes_byte == floor(pefWriteBytes_byte) and pefWriteBytes_byte >= 0 and pefWriteBytes_byte <= 255, "pefWriteBytes: expected a whole number from 0 to 255 at index " + toString(pefWriteBytes_i))
    end
    return host.writeBytes(pefWriteBytes_path, pefWriteBytes_bytes)
end
function pefWrite(pefWrite_path, pefWrite_ir)
    return pefWriteBytes(pefWrite_path, pefEncode(pefWrite_ir))
end
$- The module object has the same member names as native `emb`. -$
function pefEmbModule()
    return {magic: pefMagic, version: pefVersion, encodeOp: pefEncodeOp, encode: pefEncode, write: pefWrite, writeBytes: pefWriteBytes}
end
$- ---------------------------------------------------------------- self-tests -$
function pefCheckFixture(pefCheckFixture_label, pefCheckFixture_ir)
    pefCheckFixture_expected = jsonEncode(emb.encode(pefCheckFixture_ir))
    pefCheckFixture_actual = jsonEncode(pefEncode(pefCheckFixture_ir))
    assert(pefCheckFixture_actual == pefCheckFixture_expected, "pefEncode mismatch in " + pefCheckFixture_label + "\n" + pefCheckFixture_actual + "\n" + pefCheckFixture_expected)
    return true
end
$- === inlined selfhost/pure_fs_os.enm === -$
$- Pure Englishmen replacements for the native `fs` and `os` modules.

   The ABI in bootstrap-c/ABI.md gives exactly one non-builtin dependency: the
   C runtime's `host` module. Every function in this file is written against
   that module, so a tiny C VM can run the self-hosted compiler without the
   Rust standard library modules.

   Required host keys used here:
     args, env, cwd, tempDir, pid, readFile, writeFile, readBytes, writeBytes

   Optional host keys are probed at call time and used when present because
   they give exact native parity:
     stat, listDir, mkdir, removeFile, rename, copyFile, appendFile
   When an optional key is absent, the fallback stores directory markers and
   file states in `pfoRegistry` and uses read/write/byte primitives instead.
   Those fallbacks cover files created through these module objects; they
   cannot enumerate or delete arbitrary files created outside this module.

   Native `.enm` imports live only inside pfoRunSelfTest(), which is entered
   with EM_SELFTEST=1 and the script flag `pfo-selftest`:
     EM_SELFTEST=1 em run selfhost/pure_fs_os.enm -- pfo-selftest
   The native fs/os/bytes modules then act as an oracle.

   Every global is prefixed with `pfo` so this file is safe to concatenate
   into selfhost/full.enm. -$
pfoHostModule = null
pfoRegistry = {}
pfoOracleNativeFs = null
pfoOracleNativeOs = null
$- ---------------------------------------------------------------------------
   Host access and shared helpers
   --------------------------------------------------------------------------- -$
function pfoHost()
    if pfoHostModule == null
        import host
        pfoHostModule = host
    end
    return pfoHostModule
end
function pfoRegistrySet(pfoRegistrySet_path, pfoRegistrySet_kind)
    pfoRegistry.set(pfoRegistrySet_path, pfoRegistrySet_kind)
    return null
end
function pfoRegistryGet(pfoRegistryGet_path)
    return pfoRegistry.get(pfoRegistryGet_path, "")
end
function pfoPath(pfoPath_value, pfoPath_context)
    if not isString(pfoPath_value)
        assert(false, "Type mismatch: expected a string " + pfoPath_context + ", found " + type(pfoPath_value))
    end
    return pfoPath_value
end
function pfoText(pfoText_value, pfoText_context)
    if not isString(pfoText_value)
        assert(false, "Type mismatch: expected a string " + pfoText_context + ", found " + type(pfoText_value))
    end
    return pfoText_value
end
function pfoIsHostError(pfoIsHostError_value)
    if type(pfoIsHostError_value) != "object"
        return false
    end
    return pfoIsHostError_value.get("__hostError", null) != null
end
function pfoErrorText(pfoErrorText_value)
    if type(pfoErrorText_value) == "string"
        return pfoErrorText_value
    end
    if type(pfoErrorText_value) == "object"
        pfoErrorText_hostError = pfoErrorText_value.get("__hostError", null)
        if pfoErrorText_hostError != null
            return toString(pfoErrorText_hostError)
        end
        pfoErrorText_message = pfoErrorText_value.get("message", null)
        if pfoErrorText_message != null
            return toString(pfoErrorText_message)
        end
    end
    return toString(pfoErrorText_value)
end
$- Distinguish EISDIR from ENOENT: both host messages contain "directory",
   but only the former says "is a directory". -$
function pfoIsDirectoryError(pfoIsDirectoryError_text)
    pfoIsDirectoryError_lower = lower(pfoIsDirectoryError_text)
    return contains(pfoIsDirectoryError_lower, "is a directory") or contains(pfoIsDirectoryError_lower, "eisdir") or contains(pfoIsDirectoryError_lower, "os error 21")
end
function pfoTryRead(pfoTryRead_path)
    pfoTryRead_value = pfoHost().readFile(pfoTryRead_path)
    if pfoIsHostError(pfoTryRead_value)
        return {ok: false, value: pfoTryRead_value, error: pfoErrorText(pfoTryRead_value)}
    end
    return {ok: true, value: pfoTryRead_value, error: ""}
end
function pfoTryReadBytes(pfoTryReadBytes_path)
    pfoTryReadBytes_value = pfoHost().readBytes(pfoTryReadBytes_path)
    if pfoIsHostError(pfoTryReadBytes_value)
        return {ok: false, value: pfoTryReadBytes_value, error: pfoErrorText(pfoTryReadBytes_value)}
    end
    return {ok: true, value: pfoTryReadBytes_value, error: ""}
end
$- A logical path is mapped to a flattened file under tempDir when its parent
   was created by pfoMkdir() but has no directory on disk (the required host
   keys cannot create directories). -$
function pfoPhysicalPath(pfoPhysicalPath_path)
    pfoPhysicalPath_host = pfoHost()
    pfoPhysicalPath_dirs = keys(pfoRegistry)
    pfoPhysicalPath_i = 0
    while pfoPhysicalPath_i < len(pfoPhysicalPath_dirs)
    pfoPhysicalPath_dir = pfoPhysicalPath_dirs[pfoPhysicalPath_i]
    if pfoRegistryGet(pfoPhysicalPath_dir) == "dir"
        if startsWith(pfoPhysicalPath_path, pfoPhysicalPath_dir + "/")
            pfoPhysicalPath_real = pfoFsStatResult(pfoPhysicalPath_dir)
            if pfoPhysicalPath_real == null or pfoPhysicalPath_real.get("isDir", false) != true
                pfoPhysicalPath_flat = replace(pfoPhysicalPath_path, "_", "_5f_")
                pfoPhysicalPath_flat = replace(pfoPhysicalPath_flat, "/", "_2f_")
                return pfoPhysicalPath_host.tempDir() + "/pfo_vfs/" + pfoPhysicalPath_flat
            end
        end
    end
    pfoPhysicalPath_i += 1
end
return pfoPhysicalPath_path
end
$- ---------------------------------------------------------------------------
   fs module
   --------------------------------------------------------------------------- -$
function pfoFsStatResult(pfoFsStatResult_path)
    pfoFsStatResult_host = pfoHost()
    if pfoFsStatResult_host.get("stat", null) != null
        pfoFsStatResult_info = pfoFsStatResult_host.stat(pfoFsStatResult_path)
        if type(pfoFsStatResult_info) == "object" and not pfoIsHostError(pfoFsStatResult_info)
            return pfoFsStatResult_info
        end
    end
    return null
end
function pfoFsRead(pfoFsRead_path)
    pfoFsRead_path = pfoPath(pfoFsRead_path, "as the path for fs.read")
    pfoFsRead_result = pfoTryRead(pfoPhysicalPath(pfoFsRead_path))
    if pfoFsRead_result.ok
        return pfoFsRead_result.value
    end
    return pfoFsRead_result.value
end
function pfoFsWrite(pfoFsWrite_path, pfoFsWrite_text)
    pfoFsWrite_path = pfoPath(pfoFsWrite_path, "as the path for fs.write")
    pfoFsWrite_text = pfoText(pfoFsWrite_text, "as the content for fs.write")
    pfoFsWrite_result = pfoHost().writeFile(pfoPhysicalPath(pfoFsWrite_path), pfoFsWrite_text)
    if pfoIsHostError(pfoFsWrite_result)
        return pfoFsWrite_result
    end
    pfoRegistrySet(pfoFsWrite_path, "file")
    return null
end
function pfoFsAppend(pfoFsAppend_path, pfoFsAppend_text)
    pfoFsAppend_path = pfoPath(pfoFsAppend_path, "as the path for fs.append")
    pfoFsAppend_text = pfoText(pfoFsAppend_text, "as the content for fs.append")
    pfoFsAppend_host = pfoHost()
    pfoFsAppend_physical = pfoPhysicalPath(pfoFsAppend_path)
    if pfoFsAppend_host.get("appendFile", null) != null
        pfoFsAppend_result = pfoFsAppend_host.appendFile(pfoFsAppend_physical, pfoFsAppend_text)
        if pfoIsHostError(pfoFsAppend_result)
            return pfoFsAppend_result
        end
        pfoRegistrySet(pfoFsAppend_path, "file")
        return null
    end
    pfoFsAppend_old = pfoTryRead(pfoFsAppend_physical)
    if not pfoFsAppend_old.ok
        if not pfoIsDirectoryError(pfoFsAppend_old.error)
            pfoRegistrySet(pfoFsAppend_path, "file")
            pfoFsAppend_created = pfoHost().writeFile(pfoFsAppend_physical, pfoFsAppend_text)
            if pfoIsHostError(pfoFsAppend_created)
                return pfoFsAppend_created
            end
            return null
        end
        return pfoFsAppend_old.value
    end
    pfoFsAppend_result = pfoHost().writeFile(pfoFsAppend_physical, pfoFsAppend_old.value + pfoFsAppend_text)
    if pfoIsHostError(pfoFsAppend_result)
        return pfoFsAppend_result
    end
    pfoRegistrySet(pfoFsAppend_path, "file")
    return null
end
function pfoFsExists(pfoFsExists_path)
    pfoFsExists_path = pfoPath(pfoFsExists_path, "as the path for fs.exists")
    pfoFsExists_info = pfoFsStatResult(pfoFsExists_path)
    if pfoFsExists_info != null
        if pfoFsExists_info.get("isFile", false) or pfoFsExists_info.get("isDir", false)
            return true
        end
        return false
    end
    pfoFsExists_state = pfoRegistryGet(pfoFsExists_path)
    if pfoFsExists_state == "file" or pfoFsExists_state == "dir"
        return true
    end
    if pfoFsExists_state == "removed"
        return false
    end
    pfoFsExists_read = pfoTryRead(pfoPhysicalPath(pfoFsExists_path))
    if pfoFsExists_read.ok
        return true
    end
    return pfoIsDirectoryError(pfoFsExists_read.error)
end
function pfoFsIsFile(pfoFsIsFile_path)
    pfoFsIsFile_path = pfoPath(pfoFsIsFile_path, "as the path for fs.isFile")
    pfoFsIsFile_info = pfoFsStatResult(pfoFsIsFile_path)
    if pfoFsIsFile_info != null
        return pfoFsIsFile_info.get("isFile", false) == true
    end
    pfoFsIsFile_state = pfoRegistryGet(pfoFsIsFile_path)
    if pfoFsIsFile_state == "file"
        return true
    end
    if pfoFsIsFile_state == "dir" or pfoFsIsFile_state == "removed"
        return false
    end
    return pfoTryRead(pfoPhysicalPath(pfoFsIsFile_path)).ok
end
function pfoFsIsDir(pfoFsIsDir_path)
    pfoFsIsDir_path = pfoPath(pfoFsIsDir_path, "as the path for fs.isDir")
    pfoFsIsDir_info = pfoFsStatResult(pfoFsIsDir_path)
    if pfoFsIsDir_info != null
        return pfoFsIsDir_info.get("isDir", false) == true
    end
    pfoFsIsDir_state = pfoRegistryGet(pfoFsIsDir_path)
    if pfoFsIsDir_state == "dir"
        return true
    end
    if pfoFsIsDir_state == "file" or pfoFsIsDir_state == "removed"
        return false
    end
    if endsWith(pfoFsIsDir_path, "/")
        return true
    end
    pfoFsIsDir_read = pfoTryRead(pfoPhysicalPath(pfoFsIsDir_path))
    return not pfoFsIsDir_read.ok and pfoIsDirectoryError(pfoFsIsDir_read.error)
end
function pfoFsSizeState(pfoFsSizeState_path)
    pfoFsSizeState_info = pfoFsStatResult(pfoFsSizeState_path)
    if pfoFsSizeState_info != null
        return {ok: true, value: pfoFsSizeState_info.get("size", 0), error: ""}
    end
    if pfoFsIsDir(pfoFsSizeState_path)
        return {ok: true, value: 0, error: ""}
    end
    pfoFsSizeState_bytes = pfoTryReadBytes(pfoPhysicalPath(pfoFsSizeState_path))
    if pfoFsSizeState_bytes.ok
        return {ok: true, value: len(pfoFsSizeState_bytes.value), error: ""}
    end
    return {ok: false, value: null, error: pfoFsSizeState_bytes.error}
end
function pfoFsSize(pfoFsSize_path)
    pfoFsSize_path = pfoPath(pfoFsSize_path, "as the path for fs.size")
    pfoFsSize_state = pfoFsSizeState(pfoFsSize_path)
    if pfoFsSize_state.ok
        return pfoFsSize_state.value
    end
    return {__hostError: "Could not stat '" + pfoFsSize_path + "': " + pfoFsSize_state.error}
end
function pfoFsMetadata(pfoFsMetadata_path)
    pfoFsMetadata_path = pfoPath(pfoFsMetadata_path, "as the path for fs.metadata")
    pfoFsMetadata_info = pfoFsStatResult(pfoFsMetadata_path)
    if pfoFsMetadata_info != null
        return pfoFsMetadata_info
    end
    pfoFsMetadata_state = pfoFsSizeState(pfoFsMetadata_path)
    if not pfoFsMetadata_state.ok
        return {__hostError: "Could not stat '" + pfoFsMetadata_path + "': " + pfoFsMetadata_state.error}
    end
    return {size: pfoFsMetadata_state.value, isFile: pfoFsIsFile(pfoFsMetadata_path), isDir: pfoFsIsDir(pfoFsMetadata_path), modified: 0}
end
function pfoFsCopy(pfoFsCopy_from, pfoFsCopy_to)
    pfoFsCopy_from = pfoPath(pfoFsCopy_from, "as the source for fs.copy")
    pfoFsCopy_to = pfoPath(pfoFsCopy_to, "as the destination for fs.copy")
    pfoFsCopy_host = pfoHost()
    pfoFsCopy_physicalFrom = pfoPhysicalPath(pfoFsCopy_from)
    pfoFsCopy_physicalTo = pfoPhysicalPath(pfoFsCopy_to)
    if pfoFsCopy_host.get("copyFile", null) != null
        pfoFsCopy_copied = pfoFsCopy_host.copyFile(pfoFsCopy_physicalFrom, pfoFsCopy_physicalTo)
        if pfoIsHostError(pfoFsCopy_copied)
            return pfoFsCopy_copied
        end
        pfoRegistrySet(pfoFsCopy_to, "file")
        return null
    end
    pfoFsCopy_bytes = pfoTryReadBytes(pfoFsCopy_physicalFrom)
    if not pfoFsCopy_bytes.ok
        return {__hostError: "Could not copy '" + pfoFsCopy_from + "' to '" + pfoFsCopy_to + "': " + pfoFsCopy_bytes.error}
    end
    pfoFsCopy_written = pfoFsCopy_host.writeBytes(pfoFsCopy_physicalTo, pfoFsCopy_bytes.value)
    if pfoIsHostError(pfoFsCopy_written)
        return pfoFsCopy_written
    end
    pfoRegistrySet(pfoFsCopy_to, "file")
    return null
end
$- Remove the source after a byte-level copy when the host has no rename key.
   Truncating is the closest fallback available with writeFile only. -$
function pfoFsForget(pfoFsForget_path)
    pfoFsForget_host = pfoHost()
    pfoFsForget_physical = pfoPhysicalPath(pfoFsForget_path)
    if pfoFsForget_host.get("removeFile", null) != null
        pfoFsForget_host.removeFile(pfoFsForget_physical)
        pfoRegistrySet(pfoFsForget_path, "removed")
        return null
    end
    pfoFsForget_host.writeFile(pfoFsForget_physical, "")
    pfoRegistrySet(pfoFsForget_path, "removed")
    return null
end
function pfoFsMove(pfoFsMove_from, pfoFsMove_to)
    pfoFsMove_from = pfoPath(pfoFsMove_from, "as the source for fs.move")
    pfoFsMove_to = pfoPath(pfoFsMove_to, "as the destination for fs.move")
    pfoFsMove_host = pfoHost()
    if pfoFsMove_host.get("rename", null) != null
        pfoFsMove_moved = pfoFsMove_host.rename(pfoPhysicalPath(pfoFsMove_from), pfoPhysicalPath(pfoFsMove_to))
        if pfoIsHostError(pfoFsMove_moved)
            return pfoFsMove_moved
        end
        if pfoFsMove_host.get("removeFile", null) != null
            pfoFsMove_host.removeFile(pfoFsMove_from)
        end
        pfoRegistrySet(pfoFsMove_from, "removed")
        pfoRegistrySet(pfoFsMove_to, "file")
        return null
    end
    pfoFsMove_copied = pfoFsCopy(pfoFsMove_from, pfoFsMove_to)
    if pfoIsHostError(pfoFsMove_copied)
        return pfoFsMove_copied
    end
    pfoFsForget(pfoFsMove_from)
    return null
end
function pfoFsRemove(pfoFsRemove_path)
    pfoFsRemove_path = pfoPath(pfoFsRemove_path, "as the path for fs.remove")
    pfoFsRemove_host = pfoHost()
    pfoFsRemove_physical = pfoPhysicalPath(pfoFsRemove_path)
    if pfoFsRemove_host.get("removeFile", null) != null
        pfoFsRemove_removed = pfoFsRemove_host.removeFile(pfoFsRemove_physical)
        if pfoIsHostError(pfoFsRemove_removed)
            return pfoFsRemove_removed
        end
        pfoRegistrySet(pfoFsRemove_path, "removed")
        return pfoFsRemove_removed == true
    end
    if not pfoFsExists(pfoFsRemove_path)
        return false
    end
    if pfoFsIsDir(pfoFsRemove_path)
        pfoRegistrySet(pfoFsRemove_path, "removed")
        return true
    end
    pfoFsRemove_result = pfoFsRemove_host.writeFile(pfoFsRemove_physical, "")
    if pfoIsHostError(pfoFsRemove_result)
        return pfoFsRemove_result
    end
    pfoRegistrySet(pfoFsRemove_path, "removed")
    return true
end
function pfoFsList(pfoFsList_path)
    pfoFsList_path = pfoPath(pfoFsList_path, "as the directory for fs.list")
    pfoFsList_host = pfoHost()
    if pfoFsList_host.get("listDir", null) != null
        pfoFsList_names = pfoFsList_host.listDir(pfoPhysicalPath(pfoFsList_path))
        if pfoIsHostError(pfoFsList_names)
            return pfoFsList_names
        end
        return sorted(pfoFsList_names)
    end
    pfoFsList_prefix = pfoFsList_path
    if not endsWith(pfoFsList_prefix, "/")
        pfoFsList_prefix = pfoFsList_prefix + "/"
    end
    pfoFsList_names = []
    pfoFsList_keys = keys(pfoRegistry)
    pfoFsList_i = 0
    while pfoFsList_i < len(pfoFsList_keys)
    pfoFsList_key = pfoFsList_keys[pfoFsList_i]
    if startsWith(pfoFsList_key, pfoFsList_prefix)
        pfoFsList_rest = slice(pfoFsList_key, len(pfoFsList_prefix), len(pfoFsList_key))
        if not contains(pfoFsList_rest, "/")
            if pfoRegistryGet(pfoFsList_key) != "removed"
                pfoFsList_names.add(pfoFsList_rest)
            end
        end
    end
    pfoFsList_i += 1
end
return sorted(pfoFsList_names)
end
function pfoFsMkdir(pfoFsMkdir_path)
    pfoFsMkdir_path = pfoPath(pfoFsMkdir_path, "as the path for fs.mkdir")
    pfoFsMkdir_host = pfoHost()
    if pfoFsMkdir_host.get("mkdir", null) != null
        pfoFsMkdir_created = pfoFsMkdir_host.mkdir(pfoPhysicalPath(pfoFsMkdir_path))
        if pfoIsHostError(pfoFsMkdir_created)
            return pfoFsMkdir_created
        end
        pfoRegistrySet(pfoFsMkdir_path, "dir")
        return pfoFsMkdir_created == true
    end
    pfoFsMkdir_existed = pfoFsExists(pfoFsMkdir_path)
    pfoFsMkdir_parts = split(pfoFsMkdir_path, "/")
    pfoFsMkdir_prefix = ""
    pfoFsMkdir_i = 0
    while pfoFsMkdir_i < len(pfoFsMkdir_parts)
    pfoFsMkdir_part = pfoFsMkdir_parts[pfoFsMkdir_i]
    if pfoFsMkdir_part != ""
        if pfoFsMkdir_prefix == ""
            pfoFsMkdir_prefix = pfoFsMkdir_part
        else
            pfoFsMkdir_prefix = pfoFsMkdir_prefix + "/" + pfoFsMkdir_part
        end
        if pfoRegistryGet(pfoFsMkdir_prefix) == ""
            pfoRegistrySet(pfoFsMkdir_prefix, "dir")
        end
    end
    pfoFsMkdir_i += 1
end
pfoRegistrySet(pfoFsMkdir_path, "dir")
return not pfoFsMkdir_existed
end
function pfoFsCwd()
    return pfoHost().cwd()
end
function pfoFsTempDir()
    return pfoHost().tempDir()
end
function pfoFsModule()
    return {read: pfoFsRead, write: pfoFsWrite, append: pfoFsAppend, exists: pfoFsExists, isFile: pfoFsIsFile, isDir: pfoFsIsDir, size: pfoFsSize, metadata: pfoFsMetadata, copy: pfoFsCopy, move: pfoFsMove, remove: pfoFsRemove, list: pfoFsList, cwd: pfoFsCwd, mkdir: pfoFsMkdir, tempDir: pfoFsTempDir}
end
$- ---------------------------------------------------------------------------
   os module
   --------------------------------------------------------------------------- -$
function pfoOsArgs()
    return pfoHost().args()
end
function pfoOsEnv(pfoOsEnv_key, pfoOsEnv_default)
    pfoOsEnv_key = pfoText(pfoOsEnv_key, "as the variable name for os.env")
    return pfoHost().env(pfoOsEnv_key, pfoOsEnv_default)
end
function pfoOsHome()
    pfoOsHome_host = pfoHost()
    pfoOsHome_value = pfoOsHome_host.env("HOME", null)
    if pfoOsHome_value == null
        pfoOsHome_value = pfoOsHome_host.env("USERPROFILE", null)
    end
    return pfoOsHome_value
end
function pfoOsPid()
    return pfoHost().pid()
end
function pfoOsVersion()
    return pfoHost().env("EM_VERSION", "2.0.0")
end
function pfoOsPlatform()
    pfoOsPlatform_host = pfoHost()
    pfoOsPlatform_value = pfoOsPlatform_host.env("EM_PLATFORM", "")
    if pfoOsPlatform_value == ""
        if pfoOsPlatform_host.env("OS", "") == "Windows_NT"
            pfoOsPlatform_value = "windows"
        else
            pfoOsPlatform_value = "unix"
        end
    end
    return pfoOsPlatform_value
end
function pfoOsArch()
    pfoOsArch_host = pfoHost()
    pfoOsArch_value = pfoOsArch_host.env("EM_ARCH", "")
    if pfoOsArch_value == ""
        pfoOsArch_value = pfoOsArch_host.env("PROCESSOR_ARCHITECTURE", "")
    end
    if pfoOsArch_value == ""
        pfoOsArch_value = pfoOsArch_host.env("HOSTTYPE", "")
    end
    if pfoOsArch_value == ""
        pfoOsArch_value = pfoOsArch_host.env("MACHTYPE", "")
        if pfoOsArch_value != ""
            pfoOsArch_value = split(pfoOsArch_value, "-")[0]
        end
    end
    if pfoOsArch_value == ""
        pfoOsArch_value = "unknown"
    end
    return pfoOsArch_value
end
function pfoOsTempDir()
    return pfoHost().tempDir()
end
function pfoOsCwd()
    return pfoHost().cwd()
end
function pfoOsModule()
    return {args: pfoOsArgs, env: pfoOsEnv, home: pfoOsHome, homeDir: pfoOsHome, pid: pfoOsPid, version: pfoOsVersion, platform: pfoOsPlatform, arch: pfoOsArch, tempDir: pfoOsTempDir, cwd: pfoOsCwd}
end
$- ---------------------------------------------------------------------------
   Guarded oracle self-test. Never imported by the implementation above.
   --------------------------------------------------------------------------- -$
function pfoSelfTestSameJson(pfoSelfTestSameJson_actual, pfoSelfTestSameJson_expected, pfoSelfTestSameJson_label)
    assert(jsonEncode(pfoSelfTestSameJson_actual) == jsonEncode(pfoSelfTestSameJson_expected), pfoSelfTestSameJson_label + ": expected " + toString(pfoSelfTestSameJson_expected) + ", got " + toString(pfoSelfTestSameJson_actual))
    return null
end
function pfoSelfTestFs(pfoSelfTestFs_dir)
    pfoSelfTestFs_fs = pfoFsModule()
    pfoSelfTestFs_pure = pfoSelfTestFs_dir + "/pure.txt"
    pfoSelfTestFs_native = pfoSelfTestFs_dir + "/native.txt"
    pfoSelfTestFs_pureCopy = pfoSelfTestFs_dir + "/pure-copy.txt"
    pfoSelfTestFs_nativeCopy = pfoSelfTestFs_dir + "/native-copy.txt"
    pfoSelfTestFs_pureMoved = pfoSelfTestFs_dir + "/pure-moved.txt"
    pfoSelfTestFs_nativeMoved = pfoSelfTestFs_dir + "/native-moved.txt"
    pfoSelfTestSameJson(pfoSelfTestFs_fs.write(pfoSelfTestFs_pure, "one"), pfoOracleNativeFs.write(pfoSelfTestFs_native, "one"), "fs.write")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.read(pfoSelfTestFs_pure), pfoOracleNativeFs.read(pfoSelfTestFs_native), "fs.read")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.append(pfoSelfTestFs_pure, "two"), pfoOracleNativeFs.append(pfoSelfTestFs_native, "two"), "fs.append")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.read(pfoSelfTestFs_pure), "onetwo", "append content")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.read(pfoSelfTestFs_pure), pfoOracleNativeFs.read(pfoSelfTestFs_native), "appended content parity")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.exists(pfoSelfTestFs_pure), pfoOracleNativeFs.exists(pfoSelfTestFs_native), "fs.exists")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.isFile(pfoSelfTestFs_pure), pfoOracleNativeFs.isFile(pfoSelfTestFs_native), "fs.isFile")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.isDir(pfoSelfTestFs_pure), pfoOracleNativeFs.isDir(pfoSelfTestFs_native), "fs.isDir")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.isDir(pfoSelfTestFs_dir), pfoOracleNativeFs.isDir(pfoSelfTestFs_dir), "fs.isDir directory")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.size(pfoSelfTestFs_pure), pfoOracleNativeFs.size(pfoSelfTestFs_native), "fs.size")
    pfoSelfTestFs_pureMeta = pfoSelfTestFs_fs.metadata(pfoSelfTestFs_pure)
    pfoSelfTestFs_nativeMeta = pfoOracleNativeFs.metadata(pfoSelfTestFs_native)
    pfoSelfTestSameJson(pfoSelfTestFs_pureMeta.size, pfoSelfTestFs_nativeMeta.size, "metadata.size")
    pfoSelfTestSameJson(pfoSelfTestFs_pureMeta.isFile, pfoSelfTestFs_nativeMeta.isFile, "metadata.isFile")
    pfoSelfTestSameJson(pfoSelfTestFs_pureMeta.isDir, pfoSelfTestFs_nativeMeta.isDir, "metadata.isDir")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.copy(pfoSelfTestFs_pure, pfoSelfTestFs_pureCopy), pfoOracleNativeFs.copy(pfoSelfTestFs_native, pfoSelfTestFs_nativeCopy), "fs.copy")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.read(pfoSelfTestFs_pureCopy), pfoOracleNativeFs.read(pfoSelfTestFs_nativeCopy), "copy content")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.move(pfoSelfTestFs_pureCopy, pfoSelfTestFs_pureMoved), pfoOracleNativeFs.move(pfoSelfTestFs_nativeCopy, pfoSelfTestFs_nativeMoved), "fs.move")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.exists(pfoSelfTestFs_pureCopy), pfoOracleNativeFs.exists(pfoSelfTestFs_nativeCopy), "move removed source")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.read(pfoSelfTestFs_pureMoved), pfoOracleNativeFs.read(pfoSelfTestFs_nativeMoved), "move content")
    pfoSelfTestFs_missing = pfoSelfTestFs_dir + "/missing.txt"
    pfoSelfTestFs_error = pfoSelfTestFs_fs.read(pfoSelfTestFs_missing)
    assert(type(pfoSelfTestFs_error) == "object", "read error is an object")
    assert(pfoSelfTestFs_error.get("__hostError", null) != null, "read error keeps __hostError")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.exists(pfoSelfTestFs_missing), pfoOracleNativeFs.exists(pfoSelfTestFs_missing), "missing exists")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.isFile(pfoSelfTestFs_missing), pfoOracleNativeFs.isFile(pfoSelfTestFs_missing), "missing isFile")
    pfoSelfTestFs_pureMade = pfoSelfTestFs_dir + "/pure-made"
    pfoSelfTestFs_nativeMade = pfoSelfTestFs_dir + "/native-made"
    pfoSelfTestSameJson(pfoSelfTestFs_fs.mkdir(pfoSelfTestFs_pureMade), pfoOracleNativeFs.mkdir(pfoSelfTestFs_nativeMade), "fs.mkdir")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.isDir(pfoSelfTestFs_pureMade), pfoOracleNativeFs.isDir(pfoSelfTestFs_nativeMade), "mkdir isDir")
    pfoSelfTestFs_fs.write(pfoSelfTestFs_pureMade + "/child.txt", "child")
    pfoOracleNativeFs.write(pfoSelfTestFs_nativeMade + "/child.txt", "child")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.list(pfoSelfTestFs_pureMade), pfoOracleNativeFs.list(pfoSelfTestFs_nativeMade), "fs.list")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.remove(pfoSelfTestFs_pure), pfoOracleNativeFs.remove(pfoSelfTestFs_native), "fs.remove")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.exists(pfoSelfTestFs_pure), pfoOracleNativeFs.exists(pfoSelfTestFs_native), "removed exists")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.remove(pfoSelfTestFs_pure), pfoOracleNativeFs.remove(pfoSelfTestFs_native), "fs.remove missing")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.cwd(), pfoOracleNativeFs.cwd(), "fs.cwd")
    pfoSelfTestSameJson(pfoSelfTestFs_fs.tempDir(), pfoOracleNativeOs.tempDir(), "fs.tempDir")
    return null
end
function pfoSelfTestOs(pfoSelfTestOs_dir)
    pfoSelfTestOs_os = pfoOsModule()
    pfoSelfTestOs_key = "PFO_SELFTEST_" + toString(pfoOracleNativeOs.pid())
    pfoSelfTestSameJson(pfoSelfTestOs_os.env(pfoSelfTestOs_key, "fallback"), pfoOracleNativeOs.env(pfoSelfTestOs_key, "fallback"), "os.env fallback")
    pfoSelfTestSameJson(pfoSelfTestOs_os.pid(), pfoOracleNativeOs.pid(), "os.pid")
    pfoSelfTestSameJson(pfoSelfTestOs_os.tempDir(), pfoOracleNativeOs.tempDir(), "os.tempDir")
    pfoSelfTestSameJson(pfoSelfTestOs_os.cwd(), pfoOracleNativeOs.cwd(), "os.cwd")
    pfoSelfTestSameJson(pfoSelfTestOs_os.version(), "2.0.0", "os.version")
    pfoSelfTestSameJson(pfoSelfTestOs_os.platform(), pfoOracleNativeOs.platform(), "os.platform")
    assert(type(pfoSelfTestOs_os.args()) == "array", "os.args is an array")
    assert(isString(pfoSelfTestOs_os.arch()), "os.arch is a string")
    if pfoSelfTestOs_os.home() != null
        assert(isString(pfoSelfTestOs_os.home()), "os.home is a string or null")
    end
    return null
end
$- Exercise the ABI-only fallback: the host object below has exactly the keys
   required by bootstrap-c/ABI.md, with no stat/list/mkdir/remove helpers. -$
function pfoSelfTestMinimalHost(pfoSelfTestMinimalHost_oracle)
    pfoSelfTestMinimalHost_host = {args: pfoSelfTestMinimalHost_oracle.args, env: pfoSelfTestMinimalHost_oracle.env, cwd: pfoSelfTestMinimalHost_oracle.cwd, tempDir: pfoSelfTestMinimalHost_oracle.tempDir, pid: pfoSelfTestMinimalHost_oracle.pid, readFile: pfoSelfTestMinimalHost_oracle.readFile, writeFile: pfoSelfTestMinimalHost_oracle.writeFile, readBytes: pfoSelfTestMinimalHost_oracle.readBytes, writeBytes: pfoSelfTestMinimalHost_oracle.writeBytes}
    pfoSelfTestMinimalHost_saved = pfoHostModule
    pfoHostModule = pfoSelfTestMinimalHost_host
    pfoSelfTestMinimalHost_root = pfoOracleNativeOs.tempDir() + "/pfo_vfs"
    pfoOracleNativeFs.mkdir(pfoSelfTestMinimalHost_root)
    pfoSelfTestMinimalHost_dir = pfoOracleNativeOs.tempDir() + "/pfo_minimal_" + toString(pfoOracleNativeOs.pid())
    pfoSelfTestMinimalHost_file = pfoSelfTestMinimalHost_dir + "/hello.txt"
    pfoSelfTestMinimalHost_copy = pfoSelfTestMinimalHost_dir + "/copy.txt"
    pfoSelfTestMinimalHost_moved = pfoSelfTestMinimalHost_dir + "/moved.txt"
    pfoSelfTestMinimalHost_fs = pfoFsModule()
    assert(pfoSelfTestMinimalHost_fs.mkdir(pfoSelfTestMinimalHost_dir) == true, "minimal mkdir")
    assert(pfoSelfTestMinimalHost_fs.isDir(pfoSelfTestMinimalHost_dir) == true, "minimal isDir")
    pfoSelfTestMinimalHost_fs.write(pfoSelfTestMinimalHost_file, "hello")
    assert(pfoSelfTestMinimalHost_fs.read(pfoSelfTestMinimalHost_file) == "hello", "minimal read")
    pfoSelfTestMinimalHost_fs.append(pfoSelfTestMinimalHost_file, " world")
    assert(pfoSelfTestMinimalHost_fs.read(pfoSelfTestMinimalHost_file) == "hello world", "minimal append")
    assert(pfoSelfTestMinimalHost_fs.exists(pfoSelfTestMinimalHost_file) == true, "minimal exists")
    assert(pfoSelfTestMinimalHost_fs.isFile(pfoSelfTestMinimalHost_file) == true, "minimal isFile")
    assert(pfoSelfTestMinimalHost_fs.size(pfoSelfTestMinimalHost_file) == 11, "minimal size")
    assert(contains(pfoSelfTestMinimalHost_fs.list(pfoSelfTestMinimalHost_dir), "hello.txt"), "minimal list")
    pfoSelfTestMinimalHost_fs.copy(pfoSelfTestMinimalHost_file, pfoSelfTestMinimalHost_copy)
    assert(pfoSelfTestMinimalHost_fs.read(pfoSelfTestMinimalHost_copy) == "hello world", "minimal copy")
    pfoSelfTestMinimalHost_fs.move(pfoSelfTestMinimalHost_copy, pfoSelfTestMinimalHost_moved)
    assert(pfoSelfTestMinimalHost_fs.exists(pfoSelfTestMinimalHost_copy) == false, "minimal move source")
    assert(pfoSelfTestMinimalHost_fs.read(pfoSelfTestMinimalHost_moved) == "hello world", "minimal move target")
    assert(pfoSelfTestMinimalHost_fs.remove(pfoSelfTestMinimalHost_file) == true, "minimal remove")
    assert(pfoSelfTestMinimalHost_fs.exists(pfoSelfTestMinimalHost_file) == false, "minimal removed")
    pfoHostModule = pfoSelfTestMinimalHost_saved
    return null
end
function pfoRunSelfTest()
    if env("EM_SELFTEST") != "1"
        return null
    end
    pfoOracleNativeFs = fs
    pfoOracleNativeOs = os
$- The native modules are wrapped as a host module so the implementation
       above needs no changes for the parity run. -$
    function pfoOracleWriteFile(pfoOracleWriteFile_path, pfoOracleWriteFile_text)
        fs.write(pfoOracleWriteFile_path, pfoOracleWriteFile_text)
        return true
    end
    function pfoOracleReadFile(pfoOracleReadFile_path)
        if not fs.exists(pfoOracleReadFile_path)
            return {__hostError: "Could not read '" + pfoOracleReadFile_path + "': not found"}
        end
        if fs.isDir(pfoOracleReadFile_path)
            return {__hostError: "Could not read '" + pfoOracleReadFile_path + "': Is a directory"}
        end
        return fs.read(pfoOracleReadFile_path)
    end
    function pfoOracleReadBytes(pfoOracleReadBytes_path)
        if not fs.exists(pfoOracleReadBytes_path)
            return {__hostError: "Could not read '" + pfoOracleReadBytes_path + "': not found"}
        end
        return bytes.read(pfoOracleReadBytes_path)
    end
    function pfoOracleWriteBytes(pfoOracleWriteBytes_path, pfoOracleWriteBytes_data)
        return bytes.write(pfoOracleWriteBytes_path, pfoOracleWriteBytes_data)
    end
    function pfoOracleStat(pfoOracleStat_path)
        if not fs.exists(pfoOracleStat_path)
            return {__hostError: "Could not stat '" + pfoOracleStat_path + "': not found"}
        end
        return fs.metadata(pfoOracleStat_path)
    end
    function pfoOracleListDir(pfoOracleListDir_path)
        return fs.list(pfoOracleListDir_path)
    end
    function pfoOracleMkdir(pfoOracleMkdir_path)
        return fs.mkdir(pfoOracleMkdir_path)
    end
    function pfoOracleRemoveFile(pfoOracleRemoveFile_path)
        return fs.remove(pfoOracleRemoveFile_path)
    end
    function pfoOracleRename(pfoOracleRename_from, pfoOracleRename_to)
        fs.move(pfoOracleRename_from, pfoOracleRename_to)
        return true
    end
    function pfoOracleCopyFile(pfoOracleCopyFile_from, pfoOracleCopyFile_to)
        fs.copy(pfoOracleCopyFile_from, pfoOracleCopyFile_to)
        return true
    end
    function pfoOracleAppendFile(pfoOracleAppendFile_path, pfoOracleAppendFile_text)
        fs.append(pfoOracleAppendFile_path, pfoOracleAppendFile_text)
        return true
    end
    function pfoOracleEnv(pfoOracleEnv_key, pfoOracleEnv_default)
        return os.env(pfoOracleEnv_key, pfoOracleEnv_default)
    end
    function pfoOracleArgs()
        return os.args()
    end
    function pfoOraclePid()
        return os.pid()
    end
    function pfoOracleCwd()
        return os.cwd()
    end
    function pfoOracleTempDir()
        return os.tempDir()
    end
    function pfoOracleExit(pfoOracleExit_code)
        return null
    end
    function pfoOracleStdout(pfoOracleStdout_text)
        say(pfoOracleStdout_text)
        return true
    end
    pfoSelfTestHost = {readFile: pfoOracleReadFile, writeFile: pfoOracleWriteFile, readBytes: pfoOracleReadBytes, writeBytes: pfoOracleWriteBytes, stat: pfoOracleStat, listDir: pfoOracleListDir, mkdir: pfoOracleMkdir, removeFile: pfoOracleRemoveFile, rename: pfoOracleRename, copyFile: pfoOracleCopyFile, appendFile: pfoOracleAppendFile, env: pfoOracleEnv, args: pfoOracleArgs, cwd: pfoOracleCwd, tempDir: pfoOracleTempDir, pid: pfoOraclePid, version: null, platform: null, arch: null, exit: pfoOracleExit, stdout: pfoOracleStdout, stderr: pfoOracleStdout}
    pfoSelfTestSavedHost = pfoHostModule
    pfoHostModule = pfoSelfTestHost
    pfoSelfTestDir = os.tempDir() + "/pfo_selftest_" + toString(os.pid()) + "_" + toString(floor(random() * 1000000))
    fs.mkdir(pfoSelfTestDir)
    pfoRegistrySet(pfoSelfTestDir, "dir")
    pfoSelfTestFs(pfoSelfTestDir)
    pfoSelfTestOs(pfoSelfTestDir)
    pfoSelfTestMinimalHost(pfoSelfTestHost)
    deleteFile(pfoSelfTestDir)
    pfoHostModule = pfoSelfTestSavedHost
    say("ok")
    return null
end
pfoSelftestRequested = false
for pfoSelftestArg in args()
    if pfoSelftestArg == "pfo-selftest"
        pfoSelftestRequested = true
    end
end
if pfoSelftestRequested
    pfoRunSelfTest()
end
$- === inlined selfhost/pure_imports.enm === -$
$- Pure import table for the C bootstrap VM.
   This file is inlined by the regenerator together with the pure module
   implementations. Every module object below comes from a pure Englishmen
   builder function, so the generated compiler source needs no native imports.
   The C bootstrap VM exposes its `host` module as a global object; the
   regenerator keeps that entry only for images built with that host present.
   All globals defined here are prefixed with `pi`. -$
function piImports()
    return {__arities: {of: 8, concat: 8, slice: 3}, fs: pfoFsModule(), os: pfoOsModule(), emb: pefEmbModule(), json: pjsJsonModule(), string: pstStringModule(), bytes: pbyBytesModule(), math: pmtMathModule(), text: pmtTextModule(), cowsay: ppcCowModule(), project: ppcProjectModule(), host: host}
end
$- === inlined selfhost/pure_json.enm === -$
$- Self-contained pure-Englishmen JSON module builder for the round-4 C bootstrap.

   No local .enm imports exist: every global name in this file is prefixed
   `pjs`. `pjsJsonModule()` returns an ordinary object with the native module
   keys `encode`, `decode`, `pretty`, `isValid`, `get` and `set`; the functions
   reproduce src/modules/json.rs exactly, including sorted object keys, Rust
   number formatting (via toString), escaping, surrogate decoding, and dotted
   path / null semantics.

   The native `json` module is imported only inside the EM_SELFTEST guard at
   the bottom, where it acts as a reference oracle.
-$
$- ---------------------------------------------------------------------------
   Shared helpers
   --------------------------------------------------------------------------- -$
function pjsKeys(pjsKeys_value)
    return sorted(keys(pjsKeys_value))
end
function pjsText(pjsText_value)
    assert(type(pjsText_value) == "string", "Expected a string")
    return pjsText_value
end
function pjsFinite(pjsFinite_value)
    if type(pjsFinite_value) != "number"
        return false
    end
    if isNaN(pjsFinite_value)
        return false
    end
    return pjsFinite_value <=  and pjsFinite_value >= -
end
function pjsWhole(pjsWhole_value)
    if not pjsFinite(pjsWhole_value)
        return false
    end
    return floor(pjsWhole_value) == pjsWhole_value
end
function pjsIndex(pjsIndex_value)
    if not pjsWhole(pjsIndex_value) or pjsIndex_value < 0
        return false
    end
    return true
end
function pjsChars(pjsChars_source)
    return split(pjsChars_source, "")
end
function pjsAsciiDigit(pjsAsciiDigit_char)
    pjsAsciiDigit_code = charCode(pjsAsciiDigit_char)
    return pjsAsciiDigit_code >= 48 and pjsAsciiDigit_code <= 57
end
function pjsNumericText(pjsNumericText_source)
    pjsNumericText_chars = pjsChars(pjsNumericText_source)
    pjsNumericText_size = len(pjsNumericText_chars)
    pjsNumericText_pos = 0
    if pjsNumericText_size == 0
        return false
    end
    if pjsNumericText_chars[0] == "+" or pjsNumericText_chars[0] == "-"
        pjsNumericText_pos = 1
    end
    pjsNumericText_before = 0
    pjsNumericText_after = 0
    pjsNumericText_dot = false
    while pjsNumericText_pos < pjsNumericText_size
    pjsNumericText_char = pjsNumericText_chars[pjsNumericText_pos]
    if pjsAsciiDigit(pjsNumericText_char)
        if pjsNumericText_dot
            pjsNumericText_after += 1
        else
            pjsNumericText_before += 1
        end
        pjsNumericText_pos += 1
        continue
    end
    if pjsNumericText_char == "." and not pjsNumericText_dot
        pjsNumericText_dot = true
        pjsNumericText_pos += 1
        continue
    end
    if pjsNumericText_char == "e" or pjsNumericText_char == "E"
        pjsNumericText_pos += 1
        if pjsNumericText_pos < pjsNumericText_size
            if pjsNumericText_chars[pjsNumericText_pos] == "+" or pjsNumericText_chars[pjsNumericText_pos] == "-"
                pjsNumericText_pos += 1
            end
        end
        pjsNumericText_exp = 0
        while pjsNumericText_pos < pjsNumericText_size
        if not pjsAsciiDigit(pjsNumericText_chars[pjsNumericText_pos])
            return false
        end
        pjsNumericText_exp += 1
        pjsNumericText_pos += 1
    end
    if pjsNumericText_exp == 0
        return false
    end
    break
end
return false
end
if pjsNumericText_before + pjsNumericText_after == 0
    return false
end
return pjsNumericText_pos == pjsNumericText_size
end
function pjsRepeatText(pjsRepeatText_source, pjsRepeatText_count)
    pjsRepeatText_out = ""
    pjsRepeatText_i = 0
    while pjsRepeatText_i < pjsRepeatText_count
    pjsRepeatText_out += pjsRepeatText_source
    pjsRepeatText_i += 1
end
return pjsRepeatText_out
end
$- ---------------------------------------------------------------------------
   JSON encoding
   --------------------------------------------------------------------------- -$
function pjsJsonHexDigit(pjsJsonHexDigit_n)
    pjsJsonHexDigit_digits = "0123456789abcdef"
    if pjsJsonHexDigit_n < 0 or pjsJsonHexDigit_n > 15
        return -1
    end
    return pjsJsonHexDigit_digits[pjsJsonHexDigit_n]
end
function pjsJsonHex4(pjsJsonHex4_n)
    pjsJsonHex4_out = ""
    pjsJsonHex4_i = 3
    while pjsJsonHex4_i >= 0
    pjsJsonHex4_out += pjsJsonHexDigit(floor(pjsJsonHex4_n / pow(16, pjsJsonHex4_i)) % 16)
    pjsJsonHex4_i -= 1
end
return pjsJsonHex4_out
end
function pjsJsonQuote(pjsJsonQuote_source)
    pjsJsonQuote_chars = pjsChars(pjsText(pjsJsonQuote_source))
    pjsJsonQuote_out = "\""
    pjsJsonQuote_i = 0
    while pjsJsonQuote_i < len(pjsJsonQuote_chars)
    pjsJsonQuote_char = pjsJsonQuote_chars[pjsJsonQuote_i]
    if pjsJsonQuote_char == "\""
        pjsJsonQuote_out += "\\\""
    else if pjsJsonQuote_char == "\\"
        pjsJsonQuote_out += "\\\\"
    else if pjsJsonQuote_char == "\n"
        pjsJsonQuote_out += "\\n"
    else if pjsJsonQuote_char == "\n"
        pjsJsonQuote_out += "\\r"
    else if pjsJsonQuote_char == "\t"
        pjsJsonQuote_out += "\\t"
    else if pjsJsonQuote_char == ""
        pjsJsonQuote_out += "\\b"
    else if pjsJsonQuote_char == ""
        pjsJsonQuote_out += "\\f"
    else if charCode(pjsJsonQuote_char) < 32
        pjsJsonQuote_out += "\\u" + pjsJsonHex4(charCode(pjsJsonQuote_char))
    else
        pjsJsonQuote_out += pjsJsonQuote_char
    end
    pjsJsonQuote_i += 1
end
return pjsJsonQuote_out + "\""
end
function pjsJsonEncodeInner(pjsJsonEncodeInner_value, pjsJsonEncodeInner_depth)
    if pjsJsonEncodeInner_depth > 100
        assert(false, "JSON value is nested too deeply")
    end
    pjsJsonEncodeInner_type = type(pjsJsonEncodeInner_value)
    if pjsJsonEncodeInner_type == "null"
        return "null"
    end
    if pjsJsonEncodeInner_type == "boolean"
        if pjsJsonEncodeInner_value
            return "true"
        end
        return "false"
    end
    if pjsJsonEncodeInner_type == "number"
        assert(pjsFinite(pjsJsonEncodeInner_value), "Cannot encode a non-finite number as JSON")
        return toString(pjsJsonEncodeInner_value)
    end
    if pjsJsonEncodeInner_type == "string"
        return pjsJsonQuote(pjsJsonEncodeInner_value)
    end
    if pjsJsonEncodeInner_type == "array"
        pjsJsonEncodeInner_out = "["
        pjsJsonEncodeInner_i = 0
        while pjsJsonEncodeInner_i < len(pjsJsonEncodeInner_value)
        if pjsJsonEncodeInner_i > 0
            pjsJsonEncodeInner_out += ","
        end
        pjsJsonEncodeInner_out += pjsJsonEncodeInner(pjsJsonEncodeInner_value[pjsJsonEncodeInner_i], pjsJsonEncodeInner_depth + 1)
        pjsJsonEncodeInner_i += 1
    end
    return pjsJsonEncodeInner_out + "]"
end
if pjsJsonEncodeInner_type == "object"
    pjsJsonEncodeInner_out = "\{"
    pjsJsonEncodeInner_keys = pjsKeys(pjsJsonEncodeInner_value)
    pjsJsonEncodeInner_i = 0
    while pjsJsonEncodeInner_i < len(pjsJsonEncodeInner_keys)
    if pjsJsonEncodeInner_i > 0
        pjsJsonEncodeInner_out += ","
    end
    pjsJsonEncodeInner_key = pjsJsonEncodeInner_keys[pjsJsonEncodeInner_i]
    pjsJsonEncodeInner_out += pjsJsonQuote(pjsJsonEncodeInner_key) + ":"
    pjsJsonEncodeInner_out += pjsJsonEncodeInner(pjsJsonEncodeInner_value.get(pjsJsonEncodeInner_key), pjsJsonEncodeInner_depth + 1)
    pjsJsonEncodeInner_i += 1
end
return pjsJsonEncodeInner_out + "\}"
end
assert(false, "Cannot encode a " + pjsJsonEncodeInner_type + " as JSON")
end
function pjsJsonEncode(pjsJsonEncode_value)
    return pjsJsonEncodeInner(pjsJsonEncode_value, 0)
end
$- ---------------------------------------------------------------------------
   JSON decoding
   --------------------------------------------------------------------------- -$
function pjsJsonState(pjsJsonState_text, pjsJsonState_strict)
    return {chars: split(pjsJsonState_text, ""), pos: 0, strict: pjsJsonState_strict, error: ""}
end
function pjsJsonFail(pjsJsonFail_state, pjsJsonFail_message)
    pjsJsonFail_state.error = pjsJsonFail_message
    if pjsJsonFail_state.strict
        assert(false, pjsJsonFail_message)
    end
    return null
end
function pjsJsonSkipWs(pjsJsonSkipWs_state)
    while pjsJsonSkipWs_state.pos < len(pjsJsonSkipWs_state.chars)
    pjsJsonSkipWs_char = pjsJsonSkipWs_state.chars[pjsJsonSkipWs_state.pos]
    if pjsJsonSkipWs_char != " " and pjsJsonSkipWs_char != "\t" and pjsJsonSkipWs_char != "\n" and pjsJsonSkipWs_char != "\n"
        break
    end
    pjsJsonSkipWs_state.pos += 1
end
end
function pjsJsonTail(pjsJsonTail_state)
    pjsJsonTail_out = ""
    pjsJsonTail_i = pjsJsonTail_state.pos
    while pjsJsonTail_i < len(pjsJsonTail_state.chars)
    pjsJsonTail_out += pjsJsonTail_state.chars[pjsJsonTail_i]
    pjsJsonTail_i += 1
end
return pjsJsonTail_out
end
function pjsJsonConsumeLiteral(pjsJsonConsumeLiteral_state, pjsJsonConsumeLiteral_literal)
    if startsWith(pjsJsonTail(pjsJsonConsumeLiteral_state), pjsJsonConsumeLiteral_literal)
        pjsJsonConsumeLiteral_state.pos += len(pjsJsonConsumeLiteral_literal)
        return true
    end
    return false
end
function pjsJsonHexValue(pjsJsonHexValue_char)
    pjsJsonHexValue_digits = "0123456789abcdefABCDEF"
    pjsJsonHexValue_i = 0
    while pjsJsonHexValue_i < len(pjsJsonHexValue_digits)
    if pjsJsonHexValue_digits[pjsJsonHexValue_i] == pjsJsonHexValue_char
        if pjsJsonHexValue_i < 16
            return pjsJsonHexValue_i
        end
        return pjsJsonHexValue_i - 6
    end
    pjsJsonHexValue_i += 1
end
return -1
end
function pjsJsonParseHex4(pjsJsonParseHex4_state)
    if pjsJsonParseHex4_state.pos + 4 > len(pjsJsonParseHex4_state.chars)
        return pjsJsonFail(pjsJsonParseHex4_state, "Incomplete Unicode escape in JSON string")
    end
    pjsJsonParseHex4_value = 0
    pjsJsonParseHex4_i = 0
    while pjsJsonParseHex4_i < 4
    pjsJsonParseHex4_digit = pjsJsonHexValue(pjsJsonParseHex4_state.chars[pjsJsonParseHex4_state.pos])
    if pjsJsonParseHex4_digit < 0
        return pjsJsonFail(pjsJsonParseHex4_state, "Invalid Unicode escape in JSON string")
    end
    pjsJsonParseHex4_value = pjsJsonParseHex4_value * 16 + pjsJsonParseHex4_digit
    pjsJsonParseHex4_state.pos += 1
    pjsJsonParseHex4_i += 1
end
return pjsJsonParseHex4_value
end
function pjsJsonParseString(pjsJsonParseString_state)
    pjsJsonParseString_state.pos += 1
    pjsJsonParseString_out = ""
    while true
    if pjsJsonParseString_state.pos >= len(pjsJsonParseString_state.chars)
        return pjsJsonFail(pjsJsonParseString_state, "Unterminated JSON string")
    end
    pjsJsonParseString_char = pjsJsonParseString_state.chars[pjsJsonParseString_state.pos]
    pjsJsonParseString_state.pos += 1
    if pjsJsonParseString_char == "\""
        return pjsJsonParseString_out
    end
    if pjsJsonParseString_char == "\\"
        if pjsJsonParseString_state.pos >= len(pjsJsonParseString_state.chars)
            return pjsJsonFail(pjsJsonParseString_state, "Unterminated JSON escape sequence")
        end
        pjsJsonParseString_escape = pjsJsonParseString_state.chars[pjsJsonParseString_state.pos]
        pjsJsonParseString_state.pos += 1
        if pjsJsonParseString_escape == "\""
            pjsJsonParseString_out += "\""
        else if pjsJsonParseString_escape == "\\"
            pjsJsonParseString_out += "\\"
        else if pjsJsonParseString_escape == "/"
            pjsJsonParseString_out += "/"
        else if pjsJsonParseString_escape == "b"
            pjsJsonParseString_out += ""
        else if pjsJsonParseString_escape == "f"
            pjsJsonParseString_out += ""
        else if pjsJsonParseString_escape == "n"
            pjsJsonParseString_out += "\n"
        else if pjsJsonParseString_escape == "r"
            pjsJsonParseString_out += "\n"
        else if pjsJsonParseString_escape == "t"
            pjsJsonParseString_out += "\t"
        else if pjsJsonParseString_escape == "u"
            pjsJsonParseString_code = pjsJsonParseHex4(pjsJsonParseString_state)
            if pjsJsonParseString_state.error != ""
                return null
            end
            if pjsJsonParseString_code >= 55296 and pjsJsonParseString_code <= 57343
                if pjsJsonParseString_code > 56319
                    return pjsJsonFail(pjsJsonParseString_state, "Expected a high surrogate in JSON string")
                end
                if pjsJsonParseString_state.pos + 1 >= len(pjsJsonParseString_state.chars) or pjsJsonParseString_state.chars[pjsJsonParseString_state.pos] != "\\" or pjsJsonParseString_state.chars[pjsJsonParseString_state.pos + 1] != "u"
                    return pjsJsonFail(pjsJsonParseString_state, "Expected a low surrogate in JSON string")
                end
                pjsJsonParseString_state.pos += 2
                pjsJsonParseString_low = pjsJsonParseHex4(pjsJsonParseString_state)
                if pjsJsonParseString_state.error != ""
                    return null
                end
                if pjsJsonParseString_low < 56320 or pjsJsonParseString_low > 57343
                    return pjsJsonFail(pjsJsonParseString_state, "Invalid low surrogate in JSON string")
                end
                pjsJsonParseString_code = 65536 + (pjsJsonParseString_code - 55296) * 1024 + (pjsJsonParseString_low - 56320)
            end
            if pjsJsonParseString_code >= 55296 and pjsJsonParseString_code <= 57343
                return pjsJsonFail(pjsJsonParseString_state, "Invalid Unicode escape in JSON string")
            end
            pjsJsonParseString_out += fromCharCode(pjsJsonParseString_code)
        else
            return pjsJsonFail(pjsJsonParseString_state, "Invalid JSON escape sequence")
        end
    else if charCode(pjsJsonParseString_char) < 32
        return pjsJsonFail(pjsJsonParseString_state, "Control character in JSON string")
    else
        pjsJsonParseString_out += pjsJsonParseString_char
    end
end
end
function pjsJsonValidNumber(pjsJsonValidNumber_text)
    pjsJsonValidNumber_chars = pjsChars(pjsJsonValidNumber_text)
    pjsJsonValidNumber_size = len(pjsJsonValidNumber_chars)
    pjsJsonValidNumber_pos = 0
    if pjsJsonValidNumber_size == 0
        return false
    end
    if pjsJsonValidNumber_chars[0] == "-"
        pjsJsonValidNumber_pos = 1
    end
    if pjsJsonValidNumber_pos >= pjsJsonValidNumber_size
        return false
    end
    if pjsJsonValidNumber_chars[pjsJsonValidNumber_pos] == "0"
        pjsJsonValidNumber_pos += 1
        if pjsJsonValidNumber_pos < pjsJsonValidNumber_size and pjsAsciiDigit(pjsJsonValidNumber_chars[pjsJsonValidNumber_pos])
            return false
        end
    else if pjsAsciiDigit(pjsJsonValidNumber_chars[pjsJsonValidNumber_pos])
        while pjsJsonValidNumber_pos < pjsJsonValidNumber_size and pjsAsciiDigit(pjsJsonValidNumber_chars[pjsJsonValidNumber_pos])
        pjsJsonValidNumber_pos += 1
    end
else
    return false
end
if pjsJsonValidNumber_pos < pjsJsonValidNumber_size and pjsJsonValidNumber_chars[pjsJsonValidNumber_pos] == "."
    pjsJsonValidNumber_pos += 1
    if pjsJsonValidNumber_pos >= pjsJsonValidNumber_size or not pjsAsciiDigit(pjsJsonValidNumber_chars[pjsJsonValidNumber_pos])
        return false
    end
    while pjsJsonValidNumber_pos < pjsJsonValidNumber_size and pjsAsciiDigit(pjsJsonValidNumber_chars[pjsJsonValidNumber_pos])
    pjsJsonValidNumber_pos += 1
end
end
if pjsJsonValidNumber_pos < pjsJsonValidNumber_size
    pjsJsonValidNumber_exp = pjsJsonValidNumber_chars[pjsJsonValidNumber_pos]
    if pjsJsonValidNumber_exp == "e" or pjsJsonValidNumber_exp == "E"
        pjsJsonValidNumber_pos += 1
        if pjsJsonValidNumber_pos < pjsJsonValidNumber_size
            pjsJsonValidNumber_sign = pjsJsonValidNumber_chars[pjsJsonValidNumber_pos]
            if pjsJsonValidNumber_sign == "+" or pjsJsonValidNumber_sign == "-"
                pjsJsonValidNumber_pos += 1
            end
        end
        if pjsJsonValidNumber_pos >= pjsJsonValidNumber_size or not pjsAsciiDigit(pjsJsonValidNumber_chars[pjsJsonValidNumber_pos])
            return false
        end
        while pjsJsonValidNumber_pos < pjsJsonValidNumber_size and pjsAsciiDigit(pjsJsonValidNumber_chars[pjsJsonValidNumber_pos])
        pjsJsonValidNumber_pos += 1
    end
end
end
return pjsJsonValidNumber_pos == pjsJsonValidNumber_size
end
function pjsJsonParseNumber(pjsJsonParseNumber_state)
    pjsJsonParseNumber_start = pjsJsonParseNumber_state.pos
    while pjsJsonParseNumber_state.pos < len(pjsJsonParseNumber_state.chars)
    pjsJsonParseNumber_char = pjsJsonParseNumber_state.chars[pjsJsonParseNumber_state.pos]
    if pjsAsciiDigit(pjsJsonParseNumber_char) or pjsJsonParseNumber_char == "-" or pjsJsonParseNumber_char == "+" or pjsJsonParseNumber_char == "." or pjsJsonParseNumber_char == "e" or pjsJsonParseNumber_char == "E"
        pjsJsonParseNumber_state.pos += 1
        continue
    end
    break
end
pjsJsonParseNumber_text = pjsJsonTailSlice(pjsJsonParseNumber_state, pjsJsonParseNumber_start, pjsJsonParseNumber_state.pos)
if not pjsJsonValidNumber(pjsJsonParseNumber_text)
    return pjsJsonFail(pjsJsonParseNumber_state, "Invalid JSON number '" + pjsJsonParseNumber_text + "'")
end
return parseFloat(pjsJsonParseNumber_text)
end
function pjsJsonTailSlice(pjsJsonTailSlice_state, pjsJsonTailSlice_from, pjsJsonTailSlice_to)
    return join(slice(pjsJsonTailSlice_state.chars, pjsJsonTailSlice_from, pjsJsonTailSlice_to), "")
end
function pjsJsonParseArray(pjsJsonParseArray_state)
    pjsJsonParseArray_state.pos += 1
    pjsJsonParseArray_items = []
    pjsJsonSkipWs(pjsJsonParseArray_state)
    if pjsJsonParseArray_state.pos < len(pjsJsonParseArray_state.chars) and pjsJsonParseArray_state.chars[pjsJsonParseArray_state.pos] == "]"
        pjsJsonParseArray_state.pos += 1
        return pjsJsonParseArray_items
    end
    while true
    pjsJsonSkipWs(pjsJsonParseArray_state)
    pjsJsonParseArray_value = pjsJsonParseValue(pjsJsonParseArray_state)
    if pjsJsonParseArray_state.error != ""
        return null
    end
    pjsJsonParseArray_items.add(pjsJsonParseArray_value)
    pjsJsonSkipWs(pjsJsonParseArray_state)
    if pjsJsonParseArray_state.pos >= len(pjsJsonParseArray_state.chars)
        return pjsJsonFail(pjsJsonParseArray_state, "Expected ',' or ']' at position " + toString(pjsJsonParseArray_state.pos))
    end
    pjsJsonParseArray_char = pjsJsonParseArray_state.chars[pjsJsonParseArray_state.pos]
    pjsJsonParseArray_state.pos += 1
    if pjsJsonParseArray_char == "]"
        return pjsJsonParseArray_items
    end
    if pjsJsonParseArray_char != ","
        return pjsJsonFail(pjsJsonParseArray_state, "Expected ',' or ']' at position " + toString(pjsJsonParseArray_state.pos - 1))
    end
end
end
function pjsJsonParseObject(pjsJsonParseObject_state)
    pjsJsonParseObject_state.pos += 1
    pjsJsonParseObject_fields = {}
    pjsJsonSkipWs(pjsJsonParseObject_state)
    if pjsJsonParseObject_state.pos < len(pjsJsonParseObject_state.chars) and pjsJsonParseObject_state.chars[pjsJsonParseObject_state.pos] == "\}"
        pjsJsonParseObject_state.pos += 1
        return pjsJsonParseObject_fields
    end
    while true
    pjsJsonSkipWs(pjsJsonParseObject_state)
    if pjsJsonParseObject_state.pos >= len(pjsJsonParseObject_state.chars) or pjsJsonParseObject_state.chars[pjsJsonParseObject_state.pos] != "\""
        return pjsJsonFail(pjsJsonParseObject_state, "Expected a string key at position " + toString(pjsJsonParseObject_state.pos))
    end
    pjsJsonParseObject_key = pjsJsonParseString(pjsJsonParseObject_state)
    if pjsJsonParseObject_state.error != ""
        return null
    end
    pjsJsonSkipWs(pjsJsonParseObject_state)
    if pjsJsonParseObject_state.pos >= len(pjsJsonParseObject_state.chars) or pjsJsonParseObject_state.chars[pjsJsonParseObject_state.pos] != ":"
        return pjsJsonFail(pjsJsonParseObject_state, "Expected ':' at position " + toString(pjsJsonParseObject_state.pos))
    end
    pjsJsonParseObject_state.pos += 1
    pjsJsonSkipWs(pjsJsonParseObject_state)
    pjsJsonParseObject_value = pjsJsonParseValue(pjsJsonParseObject_state)
    if pjsJsonParseObject_state.error != ""
        return null
    end
    pjsJsonParseObject_fields.set(pjsJsonParseObject_key, pjsJsonParseObject_value)
    pjsJsonSkipWs(pjsJsonParseObject_state)
    if pjsJsonParseObject_state.pos >= len(pjsJsonParseObject_state.chars)
        return pjsJsonFail(pjsJsonParseObject_state, "Expected ',' or '\}' at position " + toString(pjsJsonParseObject_state.pos))
    end
    pjsJsonParseObject_char = pjsJsonParseObject_state.chars[pjsJsonParseObject_state.pos]
    pjsJsonParseObject_state.pos += 1
    if pjsJsonParseObject_char == "\}"
        return pjsJsonParseObject_fields
    end
    if pjsJsonParseObject_char != ","
        return pjsJsonFail(pjsJsonParseObject_state, "Expected ',' or '\}' at position " + toString(pjsJsonParseObject_state.pos - 1))
    end
end
end
function pjsJsonParseValue(pjsJsonParseValue_state)
    if pjsJsonParseValue_state.error != ""
        return null
    end
    pjsJsonSkipWs(pjsJsonParseValue_state)
    if pjsJsonParseValue_state.pos >= len(pjsJsonParseValue_state.chars)
        return pjsJsonFail(pjsJsonParseValue_state, "Unexpected JSON character at position " + toString(pjsJsonParseValue_state.pos))
    end
    pjsJsonParseValue_char = pjsJsonParseValue_state.chars[pjsJsonParseValue_state.pos]
    if pjsJsonParseValue_char == "\""
        return pjsJsonParseString(pjsJsonParseValue_state)
    end
    if pjsJsonParseValue_char == "\{"
        return pjsJsonParseObject(pjsJsonParseValue_state)
    end
    if pjsJsonParseValue_char == "["
        return pjsJsonParseArray(pjsJsonParseValue_state)
    end
    if pjsJsonParseValue_char == "t"
        if pjsJsonConsumeLiteral(pjsJsonParseValue_state, "true")
            return true
        end
        return pjsJsonFail(pjsJsonParseValue_state, "Unexpected JSON character at position " + toString(pjsJsonParseValue_state.pos))
    end
    if pjsJsonParseValue_char == "f"
        if pjsJsonConsumeLiteral(pjsJsonParseValue_state, "false")
            return false
        end
        return pjsJsonFail(pjsJsonParseValue_state, "Unexpected JSON character at position " + toString(pjsJsonParseValue_state.pos))
    end
    if pjsJsonParseValue_char == "n"
        if pjsJsonConsumeLiteral(pjsJsonParseValue_state, "null")
            return null
        end
        return pjsJsonFail(pjsJsonParseValue_state, "Unexpected JSON character at position " + toString(pjsJsonParseValue_state.pos))
    end
    if pjsJsonParseValue_char == "-" or pjsAsciiDigit(pjsJsonParseValue_char)
        return pjsJsonParseNumber(pjsJsonParseValue_state)
    end
    return pjsJsonFail(pjsJsonParseValue_state, "Unexpected JSON character at position " + toString(pjsJsonParseValue_state.pos))
end
function pjsJsonDecode(pjsJsonDecode_text)
    assert(type(pjsJsonDecode_text) == "string", "json.decode expects a string")
    pjsJsonDecode_state = pjsJsonState(pjsJsonDecode_text, true)
    pjsJsonDecode_value = pjsJsonParseValue(pjsJsonDecode_state)
    pjsJsonSkipWs(pjsJsonDecode_state)
    assert(pjsJsonDecode_state.pos == len(pjsJsonDecode_state.chars), "Unexpected trailing JSON characters at position " + toString(pjsJsonDecode_state.pos))
    return pjsJsonDecode_value
end
function pjsJsonIsValid(pjsJsonIsValid_text)
    if type(pjsJsonIsValid_text) != "string"
        return false
    end
    pjsJsonIsValid_state = pjsJsonState(pjsJsonIsValid_text, false)
    pjsJsonParseValue(pjsJsonIsValid_state)
    if pjsJsonIsValid_state.error != ""
        return false
    end
    pjsJsonSkipWs(pjsJsonIsValid_state)
    return pjsJsonIsValid_state.pos == len(pjsJsonIsValid_state.chars)
end
$- ---------------------------------------------------------------------------
   JSON paths and pretty printing
   --------------------------------------------------------------------------- -$
function pjsJsonIndent(pjsJsonIndent_level)
    return pjsRepeatText("  ", pjsJsonIndent_level)
end
function pjsJsonPrettyInner(pjsJsonPrettyInner_value, pjsJsonPrettyInner_level)
    if pjsJsonPrettyInner_level > 100
        assert(false, "JSON value is nested too deeply")
    end
    pjsJsonPrettyInner_type = type(pjsJsonPrettyInner_value)
    if pjsJsonPrettyInner_type == "array"
        if len(pjsJsonPrettyInner_value) == 0
            return "[]"
        end
        pjsJsonPrettyInner_out = "[\n"
        pjsJsonPrettyInner_i = 0
        while pjsJsonPrettyInner_i < len(pjsJsonPrettyInner_value)
