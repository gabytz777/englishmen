    pmtSinSmall_term = value
    pmtSinSmall_sum = value
    pmtSinSmall_i = 1
    while pmtSinSmall_i <= 20
    pmtSinSmall_term = (0 - pmtSinSmall_term) * pmtSinSmall_squared / ((2 * pmtSinSmall_i) * (2 * pmtSinSmall_i + 1))
    pmtSinSmall_sum += pmtSinSmall_term
    pmtSinSmall_i += 1
end
return pmtSinSmall_sum
end
function pmtCosSmall(value)
    pmtCosSmall_squared = value * value
    pmtCosSmall_term = 1
    pmtCosSmall_sum = 1
    pmtCosSmall_i = 1
    while pmtCosSmall_i <= 20
    pmtCosSmall_term = (0 - pmtCosSmall_term) * pmtCosSmall_squared / ((2 * pmtCosSmall_i - 1) * (2 * pmtCosSmall_i))
    pmtCosSmall_sum += pmtCosSmall_term
