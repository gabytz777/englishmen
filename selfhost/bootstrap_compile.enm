function vmName(vmName_chunk, vmName_index, vmName_instr)
    vmName_constants = vmName_chunk.get("constants", [])
    if not isNumber(vmName_index) or vmName_index < 0 or vmName_index >= len(vmName_constants)
        return vmRaiseAt("runtime", "name index " + toString(vmName_index) + " out of range", vmName_instr)
