    end
    vmScopeAssign_cursor = vmScopeAssign_cursor.parent
end
vmScopeDefine(vmScopeAssign_scope, vmScopeAssign_name, vmScopeAssign_value)
end
function vmGetProperty(vmGetProperty_base, vmGetProperty_name, vmGetProperty_instr)
    if isObject(vmGetProperty_base)
        if vmGetProperty_base.has(vmGetProperty_name)
            return vmGetProperty_base.get(vmGetProperty_name, null)
