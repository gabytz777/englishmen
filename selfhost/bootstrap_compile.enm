end
if method == "titleCase"
    out = ""
    start = true
    for ch in text.chars()
        if trim(ch) == ""
            out += ch
            start = true
        else if start
            out += upper(ch)
            start = false
        else
            out += lower(ch)
        end
    end
    return out
end
if method == "reverse"
    chars = rtStringChars(text)
    out = ""
    i = len(chars) - 1
    while i >= 0
    out += chars[i]
    i -= 1
end
return out
end
if method == "repeat"
    return rtStringRepeat(text, rtArg(args, 0, null))
end
if method == "padLeft"
    return rtStringPad(text, rtArg(args, 0, null), rtArg(args, 1, " "), true)
end
if method == "padRight"
    return rtStringPad(text, rtArg(args, 0, null), rtArg(args, 1, " "), false)
