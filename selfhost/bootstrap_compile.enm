    if isNaN(left) or isNaN(right)
        return pmtNaN()
    end
    pmtMathHypot_x = abs(left)
    pmtMathHypot_y = abs(right)
    if not pmtFinite(left) or not pmtFinite(right)
        return pmtInfinity()
    end
    pmtMathHypot_scale = pmtMathHypot_x
    if pmtMathHypot_y > pmtMathHypot_scale
        pmtMathHypot_scale = pmtMathHypot_y
    end
    if pmtMathHypot_scale == 0
        return 0
