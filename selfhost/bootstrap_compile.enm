end
if vmValidateChunk_op == "MakeClosure"
    if not vmValidateFunctionIndex(vmValidateChunk_chunk, vmValidateChunk_instr.get("a", 0), vmValidateChunk_instr, vmValidateChunk_path_i)
        return false
    end
end
vmValidateChunk_nameKey = vmNameOperandKey(vmValidateChunk_op)
if vmValidateChunk_nameKey != ""
    if not vmValidateNameIndex(vmValidateChunk_chunk, vmValidateChunk_instr.get(vmValidateChunk_nameKey, 0), vmValidateChunk_instr, vmValidateChunk_path_i)
        return false
    end
end
vmValidateChunk_jumpKey = vmJumpOperandKey(vmValidateChunk_op)
if vmValidateChunk_jumpKey != ""
    if vmValidateChunk_instr.get(vmValidateChunk_jumpKey, 0) > len(vmValidateChunk_code)
