    end
    return vmRaiseAt("runtime", "cannot access property '" + vmGetProperty_name + "' on a " + type(vmGetProperty_base), vmGetProperty_instr)
end
function vmSetProperty(vmSetProperty_base, vmSetProperty_name, vmSetProperty_value, vmSetProperty_instr)
    if not isObject(vmSetProperty_base)
        return vmRaiseAt("runtime", "cannot set property '" + vmSetProperty_name + "' on a " + type(vmSetProperty_base), vmSetProperty_instr)
