$- ---------------------------------------------------------------------------
   Self-tests: native json is an oracle only below this point.
   --------------------------------------------------------------------------- -$
$- === inlined selfhost/pure_math_text.enm === -$
$- Pure Englishmen implementations of the native `math` and `text` modules.

   Self-contained by design: no local `.enm` imports exist, so every globally
   visible helper is prefixed with `pmt`. `pmtMathModule()` and
   `pmtTextModule()` return ordinary objects whose keys are the native member
   names and whose values are Englishmen functions. `pmtAllModules()` bundles
   both objects for an import bridge.

   Implementations use global builtins only. The native `math` and `text`
   modules are imported solely in the guarded parity test at the bottom,
   where they act as reference oracles.
-$
$- ---------------------------------------------------------------------------
   Shared argument and value helpers
   --------------------------------------------------------------------------- -$
function pmtFinite(value)
    if type(value) != "number"
        return false
    end
    if isNaN(value)
        return false
    end
    return abs(value) <= 
end
function pmtNumberArg(value, context)
    assert(type(value) == "number", "Expected a number " + context)
    return value
end
function pmtStringArg(value, context)
    assert(type(value) == "string", "Expected a string " + context)
    return value
end
function pmtWhole(value)
    if not pmtFinite(value)
        return false
    end
    if floor(value) != value
        return false
    end
    return value >= -9223372036854776000 and value <= 9223372036854776000
end
function pmtWholeArg(value, context)
    assert(pmtWhole(value), "Expected a whole number " + context)
    return value
end
function pmtWidthArg(value, context)
    assert(pmtFinite(value) and floor(value) == value and value >= 0 and value <= 18446744073709552000, "Expected a non-negative whole number " + context)
    return value
end
function pmtNaN()
    return pow(-1, 0.5)
end
function pmtInfinity()
    return pow(10, 1000)
end
function pmtChars(text)
    return split(text, "")
end
function pmtMin2(left, right)
    if isNaN(left)
        return right
    end
    if isNaN(right)
        return left
    end
    if right < left
        return right
    end
    return left
end
function pmtMax2(left, right)
    if isNaN(left)
        return right
    end
    if isNaN(right)
        return left
    end
    if right > left
        return right
    end
    return left
end
$- ---------------------------------------------------------------------------
   Math internals
   --------------------------------------------------------------------------- -$
function pmtLn(value)
    if isNaN(value)
        return pmtNaN()
    end
    if not pmtFinite(value)
        return pmtInfinity()
    end
    return log10(value) * 2.302585092994046
end
function pmtReduceAngle(value)
    return value - floor(value / 6.283185307179586) * 6.283185307179586
end
function pmtSinSmall(value)
