        if vmError != null
            return
        end
        vmScopeAssign(vmExec_frame.scope, vmExec_name, vmExec_value)
        return
    end
    if vmExec_op == "DefineVar"
        vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
        if vmError != null
            return
