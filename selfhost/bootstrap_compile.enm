end
function vmScopeAssign(vmScopeAssign_scope, vmScopeAssign_name, vmScopeAssign_value)
    vmScopeAssign_cursor = vmScopeAssign_scope
    while vmScopeAssign_cursor != null
    if vmScopeAssign_cursor.vars.has(vmScopeAssign_name)
        vmScopeAssign_cursor.vars.set(vmScopeAssign_name, vmScopeAssign_value)
