function rtBoolMethod(value, method, args)
    if method == "toggle"
        return not value
    end
    if method == "toString"
        if value
            return "true"
        end
        return "false"
    end
    if method == "and"
        return value and rtExpectBool(rtArg(args, 0, null), "an operand")
    end
    if method == "or"
        return value or rtExpectBool(rtArg(args, 0, null), "an operand")
    end
    if method == "xor"
        return value != rtExpectBool(rtArg(args, 0, null), "an operand")
    end
    if method == "implies"
        other = rtExpectBool(rtArg(args, 0, null), "an operand")
        return not value or other
    end
    if method == "nand"
        other = rtExpectBool(rtArg(args, 0, null), "an operand")
        return not (value and other)
    end
