    if name == "floor"
        return floor(rtArg(args, 0, 0))
    end
    if name == "ceil"
        return ceil(rtArg(args, 0, 0))
    end
    if name == "round"
        return round(rtArg(args, 0, 0))
    end
    if name == "sign"
        return sign(rtArg(args, 0, 0))
    end
    if name == "trim"
        return trim(rtArg(args, 0, ""))
    end
    if name == "upper"
        return upper(rtArg(args, 0, ""))
    end
    if name == "lower"
        return lower(rtArg(args, 0, ""))
