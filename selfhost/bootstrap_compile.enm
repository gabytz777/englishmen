end
function pmtMathMax(left, right)
    pmtNumberArg(left, "for math.max")
    pmtNumberArg(right, "for math.max")
    return pmtMax2(left, right)
end
function pmtMathLog(value, base)
    pmtNumberArg(value, "for math.log")
