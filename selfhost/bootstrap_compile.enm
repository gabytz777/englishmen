        vmExec_value = vmPop(vmExec_instr)
        if vmError != null
            return
        end
        vmScopeDefine(vmExec_frame.scope, vmExec_name, vmExec_value)
        return
    end
    if vmExec_op == "GetProp"
        vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
        if vmError != null
            return
        end
        vmExec_base = vmPop(vmExec_instr)
        if vmError != null
            return
        end
        vmExec_value = vmGetProperty(vmExec_base, vmExec_name, vmExec_instr)
        if vmError != null
            return
        end
        vmPush(vmExec_value)
        return
    end
    if vmExec_op == "SetProp"
        vmExec_name = vmName(vmExec_chunk, vmExec_a, vmExec_instr)
        if vmError != null
            return
        end
        vmExec_base = vmPop(vmExec_instr)
        if vmError != null
            return
        end
        vmExec_value = vmPop(vmExec_instr)
        if vmError != null
            return
        end
        vmSetProperty(vmExec_base, vmExec_name, vmExec_value, vmExec_instr)
