        paSkipNewlines()
        paExpect("RParen", "to close parenthesized expression")
        return paParsePrimary_expr
    end
    if paParsePrimary_t == "LBracket"
        return paParseArray()
    end
    if paParsePrimary_t == "LBrace"
        return paParseObject()
    end
    if paParsePrimary_nextIsCall
        paParsePrimary_name = paKeywordName(paParsePrimary_t)
        if paParsePrimary_name != null
            paAdvance()
            return eVariable(paParsePrimary_name)
        end
    end
    assert(false, "Unexpected token " + paParsePrimary_t)
end
function parse(parse_tokens)
    paTokens = parse_tokens
    paPos = 0
    paLoopDepth = 0
    parse_statements = []
    paSkipNewlines()
    while not paAtEnd()
    parse_statements.add(paParseStatement())
    paSkipNewlines()
end
return {version: 1, statements: parse_statements}
end
$- ---------------------------------------------------------------------------
   CLI. `args` currently contains the full process argv, so
   `em run selfhost/compiler.enm <file>` yields
   [em, run, selfhost/compiler.enm, <file>]. Use the last argument, and when
   the script path is present scan for the first non-flag argument after it.
   This also works if the parent later narrows `args` to script-only values.
   --------------------------------------------------------------------------- -$
$- === inlined selfhost/codegen_ir.enm === -$
$- Pure-Englishmen AST -> emb IR code generator.
   Self-contained: no local .enm imports and no native module imports in the
   generator.  The native `emb` oracle is imported only inside the guarded
   self-tests at the bottom; the guard uses the global `env` builtin. -$
$- A compilation context is one chunk. Functions get a fresh context so their
   constant pools, jumps and nested prototypes stay independent. -$
function cgCtx()
    return {constants: [], functions: [], code: [], breaks: [], heads: [], pops: []}
end
function cgField(cgField_node, cgField_key, cgField_fallback)
    if cgField_node == null or type(cgField_node) != "object"
        return cgField_fallback
    end
    cgField_value = cgField_node.get(cgField_key, null)
    if cgField_value == null
        return cgField_fallback
    end
    return cgField_value
end
function cgNeed(cgNeed_node, cgNeed_key, cgNeed_context)
    assert(cgNeed_node != null and type(cgNeed_node) == "object", "cgCodegen: expected an object for " + cgNeed_context)
    assert(cgNeed_node.has(cgNeed_key), "cgCodegen: missing '" + cgNeed_key + "' in " + cgNeed_context)
    return cgNeed_node.get(cgNeed_key)
end
function cgExpectString(cgExpectString_value, cgExpectString_context)
    assert(type(cgExpectString_value) == "string", "cgCodegen: expected a string for " + cgExpectString_context + ", found " + type(cgExpectString_value))
    return cgExpectString_value
end
function cgExpectArray(cgExpectArray_value, cgExpectArray_context)
    assert(type(cgExpectArray_value) == "array", "cgCodegen: expected an array for " + cgExpectArray_context + ", found " + type(cgExpectArray_value))
    return cgExpectArray_value
end
function cgSpanOf(cgSpanOf_node, cgSpanOf_fallback)
    if cgSpanOf_node == null or type(cgSpanOf_node) != "object"
        return cgSpanOf_fallback
    end
    cgSpanOf_span = cgSpanOf_node.get("span", null)
    if type(cgSpanOf_span) != "object"
        return cgSpanOf_fallback
    end
    cgSpanOf_line = cgSpanOf_span.get("line", cgSpanOf_fallback.line)
    cgSpanOf_col = cgSpanOf_span.get("col", cgSpanOf_fallback.col)
    assert(type(cgSpanOf_line) == "number", "cgCodegen: span line must be a number")
    assert(type(cgSpanOf_col) == "number", "cgCodegen: span col must be a number")
    assert(cgSpanOf_line >= 1 and floor(cgSpanOf_line) == cgSpanOf_line, "cgCodegen: span line must be a positive whole number")
    assert(cgSpanOf_col >= 1 and floor(cgSpanOf_col) == cgSpanOf_col, "cgCodegen: span col must be a positive whole number")
    return {line: cgSpanOf_line, col: cgSpanOf_col}
end
$- Constant pool: intern scalars exactly like Chunk::add_const / add_name. -$
function cgConstEqual(cgConstEqual_left, cgConstEqual_right)
    cgConstEqual_leftTag = cgConstEqual_left.get("tag", null)
    cgConstEqual_rightTag = cgConstEqual_right.get("tag", null)
    if cgConstEqual_leftTag != cgConstEqual_rightTag
        return false
    end
    if cgConstEqual_leftTag == "null"
        return true
    end
    return cgConstEqual_left.get("value", null) == cgConstEqual_right.get("value", null)
end
function cgIntern(cgIntern_ctx, cgIntern_constant)
    assert(type(cgIntern_constant) == "object", "cgCodegen: expected a constant object")
    cgIntern_i = 0
    while cgIntern_i < len(cgIntern_ctx.constants)
    if cgConstEqual(cgIntern_ctx.constants[cgIntern_i], cgIntern_constant)
        return cgIntern_i
    end
    cgIntern_i += 1
end
cgIntern_index = len(cgIntern_ctx.constants)
cgIntern_ctx.constants.add(cgIntern_constant)
return cgIntern_index
end
function cgConst(cgConst_ctx, cgConst_tag, cgConst_value)
    if cgConst_tag == "null"
        return cgIntern(cgConst_ctx, {tag: "null"})
    end
    return cgIntern(cgConst_ctx, {tag: cgConst_tag, value: cgConst_value})
end
function cgName(cgName_ctx, cgName_name)
    return cgConst(cgName_ctx, "string", cgName_name)
end
$- Instruction stream. Jump operands are patched in place once targets are known. -$
function cgEmit(cgEmit_ctx, cgEmit_op, cgEmit_a, cgEmit_b, cgEmit_span)
    assert(type(cgEmit_op) == "string", "cgCodegen: opcode must be a string")
    assert(type(cgEmit_a) == "number" and cgEmit_a >= 0 and floor(cgEmit_a) == cgEmit_a, "cgCodegen: operand 'a' must be a whole number")
    assert(type(cgEmit_b) == "number" and cgEmit_b >= 0 and floor(cgEmit_b) == cgEmit_b, "cgCodegen: operand 'b' must be a whole number")
    cgEmit_instruction = {op: cgEmit_op, a: cgEmit_a, b: cgEmit_b, line: cgEmit_span.line, col: cgEmit_span.col}
    cgEmit_index = len(cgEmit_ctx.code)
    cgEmit_ctx.code.add(cgEmit_instruction)
    return cgEmit_index
end
function cgHere(cgHere_ctx)
    return len(cgHere_ctx.code)
end
function cgPatch(cgPatch_ctx, cgPatch_index, cgPatch_target)
    assert(cgPatch_index >= 0 and cgPatch_index < len(cgPatch_ctx.code), "cgCodegen: jump index out of range")
    assert(type(cgPatch_target) == "number" and cgPatch_target >= 0 and floor(cgPatch_target) == cgPatch_target, "cgCodegen: jump target must be a whole number")
    cgPatch_instruction = cgPatch_ctx.code[cgPatch_index]
    cgPatch_op = cgPatch_instruction.op
    assert(cgPatch_op == "Jump" or cgPatch_op == "JumpIfFalse" or cgPatch_op == "JumpIfFalsePeek" or cgPatch_op == "JumpIfTruePeek" or cgPatch_op == "JumpIfNullPeek" or cgPatch_op == "RepeatNext" or cgPatch_op == "IterNext", "cgCodegen: cannot patch non-jump op '" + cgPatch_op + "'")
$- IterNext stores (nameIndex, target); every other jump stores the target in a. -$
    if cgPatch_op == "IterNext"
        cgPatch_instruction.b = cgPatch_target
    else
        cgPatch_instruction.a = cgPatch_target
    end
end
$- Loop bookkeeping: one head, one break list (including the exit jump) and one
   number of stack values a `break` must discard. -$
function cgOpenLoop(cgOpenLoop_ctx, cgOpenLoop_head, cgOpenLoop_pops, cgOpenLoop_exitIndex)
    cgOpenLoop_ctx.heads.add(cgOpenLoop_head)
    cgOpenLoop_ctx.pops.add(cgOpenLoop_pops)
    cgOpenLoop_ctx.breaks.add([cgOpenLoop_exitIndex])
end
function cgCloseLoop(cgCloseLoop_ctx, cgCloseLoop_span)
    assert(len(cgCloseLoop_ctx.heads) > 0, "cgCodegen: unmatched loop")
    cgCloseLoop_head = cgCloseLoop_ctx.heads.pop()
    cgCloseLoop_unused = cgCloseLoop_ctx.pops.pop()
    cgCloseLoop_pending = cgCloseLoop_ctx.breaks.pop()
    cgEmit(cgCloseLoop_ctx, "Jump", cgCloseLoop_head, 0, cgCloseLoop_span)
    cgCloseLoop_endAddress = cgHere(cgCloseLoop_ctx)
    cgCloseLoop_i = 0
    while cgCloseLoop_i < len(cgCloseLoop_pending)
    cgPatch(cgCloseLoop_ctx, cgCloseLoop_pending[cgCloseLoop_i], cgCloseLoop_endAddress)
    cgCloseLoop_i += 1
end
end
$- Scalar operand for an eager binary operator. Logical operators are emitted
   as short-circuiting jump sequences instead. -$
function cgArithmeticOp(cgArithmeticOp_op)
    if cgArithmeticOp_op == "+"
        return "Add"
    end
    if cgArithmeticOp_op == "-"
        return "Sub"
    end
    if cgArithmeticOp_op == "*"
        return "Mul"
    end
    if cgArithmeticOp_op == "/"
        return "Div"
    end
    if cgArithmeticOp_op == "%"
        return "Mod"
    end
    if cgArithmeticOp_op == "//"
        return "FloorDiv"
    end
    if cgArithmeticOp_op == "**"
        return "Pow"
    end
    if cgArithmeticOp_op == "&"
        return "BitAnd"
    end
    if cgArithmeticOp_op == "|"
        return "BitOr"
    end
    if cgArithmeticOp_op == "^"
        return "BitXor"
    end
    if cgArithmeticOp_op == "<<"
        return "Shl"
    end
    if cgArithmeticOp_op == ">>"
        return "Shr"
    end
    if cgArithmeticOp_op == "=="
        return "Eq"
    end
    if cgArithmeticOp_op == "!="
        return "NotEq"
    end
    if cgArithmeticOp_op == ">"
        return "Gt"
    end
    if cgArithmeticOp_op == "<"
        return "Lt"
    end
    if cgArithmeticOp_op == ">="
        return "GtEq"
    end
    if cgArithmeticOp_op == "<="
        return "LtEq"
    end
    if cgArithmeticOp_op == "and" or cgArithmeticOp_op == "or" or cgArithmeticOp_op == "??"
        assert(false, "cgCodegen: logical operator '" + cgArithmeticOp_op + "' is not an arithmetic operator")
    end
    assert(false, "cgCodegen: unsupported binary operator '" + cgArithmeticOp_op + "'")
end
function cgDescribeCallee(cgDescribeCallee_callee)
    if type(cgDescribeCallee_callee) == "object"
        cgDescribeCallee_kind = cgDescribeCallee_callee.get("kind", null)
        if cgDescribeCallee_kind == "Variable" or cgDescribeCallee_kind == "PropertyAccess"
            return cgDescribeCallee_callee.get("name", "value")
        end
    end
    return "value"
end
$- Push the base of a property assignment, creating missing objects like the
   Rust compiler's object_base does. -$
function cgObjectBase(cgObjectBase_ctx, cgObjectBase_expr, cgObjectBase_span)
    if type(cgObjectBase_expr) == "object" and cgObjectBase_expr.get("kind", null) == "Variable"
        cgObjectBase_name = cgExpectString(cgNeed(cgObjectBase_expr, "name", "property base"), "property base name")
        cgEmit(cgObjectBase_ctx, "GetVarOrObject", cgName(cgObjectBase_ctx, cgObjectBase_name), 0, cgObjectBase_span)
        return null
    end
    if type(cgObjectBase_expr) == "object" and cgObjectBase_expr.get("kind", null) == "PropertyAccess"
        cgObjectBase(cgObjectBase_ctx, cgNeed(cgObjectBase_expr, "base", "nested property base"), cgObjectBase_span)
        cgObjectBase_name = cgExpectString(cgNeed(cgObjectBase_expr, "name", "nested property base"), "property name")
        cgEmit(cgObjectBase_ctx, "GetPropOrObject", cgName(cgObjectBase_ctx, cgObjectBase_name), 0, cgObjectBase_span)
        return null
    end
    cgExpr(cgObjectBase_ctx, cgObjectBase_expr, cgObjectBase_span)
end
$- The right-hand side is already on the stack when an assignment store runs. -$
function cgAssign(cgAssign_ctx, cgAssign_target, cgAssign_span)
    assert(type(cgAssign_target) == "object", "cgCodegen: expected an assignment target object")
    cgAssign_kind = cgNeed(cgAssign_target, "kind", "assignment target")
    if cgAssign_kind == "Variable"
        cgAssign_name = cgExpectString(cgNeed(cgAssign_target, "name", "Variable target"), "target name")
        cgEmit(cgAssign_ctx, "SetVar", cgName(cgAssign_ctx, cgAssign_name), 0, cgAssign_span)
        return null
    end
    if cgAssign_kind == "Property"
        cgObjectBase(cgAssign_ctx, cgNeed(cgAssign_target, "base", "Property target"), cgAssign_span)
        cgAssign_name = cgExpectString(cgNeed(cgAssign_target, "name", "Property target"), "property name")
        cgEmit(cgAssign_ctx, "SetProp", cgName(cgAssign_ctx, cgAssign_name), 0, cgAssign_span)
        return null
    end
    if cgAssign_kind == "Index"
        cgExpr(cgAssign_ctx, cgNeed(cgAssign_target, "base", "Index target"), cgAssign_span)
        cgExpr(cgAssign_ctx, cgNeed(cgAssign_target, "index", "Index target"), cgAssign_span)
        cgEmit(cgAssign_ctx, "SetIndex", 0, 0, cgAssign_span)
        return null
    end
    assert(false, "cgCodegen: unsupported assignment target '" + toString(cgAssign_kind) + "'")
end
function cgCompoundAssign(cgCompoundAssign_ctx, cgCompoundAssign_target, cgCompoundAssign_op, cgCompoundAssign_value, cgCompoundAssign_span)
    cgCompoundAssign_instruction = cgArithmeticOp(cgCompoundAssign_op)
    assert(type(cgCompoundAssign_target) == "object", "cgCodegen: expected a compound assignment target object")
    cgCompoundAssign_kind = cgNeed(cgCompoundAssign_target, "kind", "compound assignment target")
    if cgCompoundAssign_kind == "Variable"
        cgCompoundAssign_name = cgExpectString(cgNeed(cgCompoundAssign_target, "name", "Variable target"), "target name")
        cgCompoundAssign_nameIndex = cgName(cgCompoundAssign_ctx, cgCompoundAssign_name)
        cgEmit(cgCompoundAssign_ctx, "GetVar", cgCompoundAssign_nameIndex, 0, cgCompoundAssign_span)
        cgExpr(cgCompoundAssign_ctx, cgCompoundAssign_value, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, cgCompoundAssign_instruction, 0, 0, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, "SetVar", cgCompoundAssign_nameIndex, 0, cgCompoundAssign_span)
        return null
    end
    if cgCompoundAssign_kind == "Property"
        cgObjectBase(cgCompoundAssign_ctx, cgNeed(cgCompoundAssign_target, "base", "Property target"), cgCompoundAssign_span)
        cgCompoundAssign_name = cgExpectString(cgNeed(cgCompoundAssign_target, "name", "Property target"), "property name")
        cgCompoundAssign_nameIndex = cgName(cgCompoundAssign_ctx, cgCompoundAssign_name)
        cgEmit(cgCompoundAssign_ctx, "GetPropKeep", cgCompoundAssign_nameIndex, 0, cgCompoundAssign_span)
        cgExpr(cgCompoundAssign_ctx, cgCompoundAssign_value, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, cgCompoundAssign_instruction, 0, 0, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, "Rotate", 1, 0, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, "SetProp", cgCompoundAssign_nameIndex, 0, cgCompoundAssign_span)
        return null
    end
    if cgCompoundAssign_kind == "Index"
        cgExpr(cgCompoundAssign_ctx, cgNeed(cgCompoundAssign_target, "base", "Index target"), cgCompoundAssign_span)
        cgExpr(cgCompoundAssign_ctx, cgNeed(cgCompoundAssign_target, "index", "Index target"), cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, "GetIndexKeep", 0, 0, cgCompoundAssign_span)
        cgExpr(cgCompoundAssign_ctx, cgCompoundAssign_value, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, cgCompoundAssign_instruction, 0, 0, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, "Rotate", 2, 0, cgCompoundAssign_span)
        cgEmit(cgCompoundAssign_ctx, "SetIndex", 0, 0, cgCompoundAssign_span)
        return null
    end
    assert(false, "cgCodegen: unsupported compound assignment target '" + toString(cgCompoundAssign_kind) + "'")
end
$- Expressions. Each node emits instructions only into the current chunk. -$
function cgBinary(cgBinary_ctx, cgBinary_expr, cgBinary_span)
    cgBinary_op = cgExpectString(cgNeed(cgBinary_expr, "op", "Binary"), "binary operator")
    cgBinary_left = cgNeed(cgBinary_expr, "left", "Binary")
    cgBinary_right = cgNeed(cgBinary_expr, "right", "Binary")
    if cgBinary_op == "and" or cgBinary_op == "or"
        cgExpr(cgBinary_ctx, cgBinary_left, cgBinary_span)
        cgEmit(cgBinary_ctx, "ToBool", 0, 0, cgBinary_span)
        cgBinary_jumpOp = "JumpIfFalsePeek"
        if cgBinary_op == "or"
            cgBinary_jumpOp = "JumpIfTruePeek"
        end
        cgBinary_jump = cgEmit(cgBinary_ctx, cgBinary_jumpOp, 0, 0, cgBinary_span)
        cgEmit(cgBinary_ctx, "Pop", 0, 0, cgBinary_span)
        cgExpr(cgBinary_ctx, cgBinary_right, cgBinary_span)
        cgEmit(cgBinary_ctx, "ToBool", 0, 0, cgBinary_span)
        cgPatch(cgBinary_ctx, cgBinary_jump, cgHere(cgBinary_ctx))
        return null
    end
    if cgBinary_op == "??"
        cgExpr(cgBinary_ctx, cgBinary_left, cgBinary_span)
        cgBinary_nullJump = cgEmit(cgBinary_ctx, "JumpIfNullPeek", 0, 0, cgBinary_span)
        cgBinary_endJump = cgEmit(cgBinary_ctx, "Jump", 0, 0, cgBinary_span)
        cgPatch(cgBinary_ctx, cgBinary_nullJump, cgHere(cgBinary_ctx))
        cgEmit(cgBinary_ctx, "Pop", 0, 0, cgBinary_span)
        cgExpr(cgBinary_ctx, cgBinary_right, cgBinary_span)
        cgPatch(cgBinary_ctx, cgBinary_endJump, cgHere(cgBinary_ctx))
        return null
    end
    cgBinary_instruction = cgArithmeticOp(cgBinary_op)
    cgExpr(cgBinary_ctx, cgBinary_left, cgBinary_span)
    cgExpr(cgBinary_ctx, cgBinary_right, cgBinary_span)
    cgEmit(cgBinary_ctx, cgBinary_instruction, 0, 0, cgBinary_span)
end
function cgPostfix(cgPostfix_ctx, cgPostfix_expr, cgPostfix_span)
    cgPostfix_op = cgExpectString(cgNeed(cgPostfix_expr, "op", "Postfix"), "postfix operator")
    assert(cgPostfix_op == "++" or cgPostfix_op == "--", "cgCodegen: unsupported postfix operator '" + cgPostfix_op + "'")
    cgPostfix_instruction = "Add"
    if cgPostfix_op == "--"
        cgPostfix_instruction = "Sub"
    end
    cgPostfix_target = cgNeed(cgPostfix_expr, "target", "Postfix")
    assert(type(cgPostfix_target) == "object", "cgCodegen: expected a postfix target object")
    cgPostfix_kind = cgNeed(cgPostfix_target, "kind", "postfix target")
    if cgPostfix_kind == "Variable"
        cgPostfix_name = cgExpectString(cgNeed(cgPostfix_target, "name", "Variable target"), "target name")
        cgPostfix_nameIndex = cgName(cgPostfix_ctx, cgPostfix_name)
        cgEmit(cgPostfix_ctx, "GetVar", cgPostfix_nameIndex, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "Dup", 0, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "LoadConst", cgConst(cgPostfix_ctx, "number", 1), 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, cgPostfix_instruction, 0, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "SetVar", cgPostfix_nameIndex, 0, cgPostfix_span)
        return null
    end
    if cgPostfix_kind == "Property"
        cgObjectBase(cgPostfix_ctx, cgNeed(cgPostfix_target, "base", "Property target"), cgPostfix_span)
        cgPostfix_name = cgExpectString(cgNeed(cgPostfix_target, "name", "Property target"), "property name")
        cgPostfix_nameIndex = cgName(cgPostfix_ctx, cgPostfix_name)
        cgEmit(cgPostfix_ctx, "GetPropKeep", cgPostfix_nameIndex, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "Dup", 0, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "LoadConst", cgConst(cgPostfix_ctx, "number", 1), 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, cgPostfix_instruction, 0, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "Rotate", 2, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "Rotate", 2, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "SetProp", cgPostfix_nameIndex, 0, cgPostfix_span)
        return null
    end
    if cgPostfix_kind == "Index"
        cgExpr(cgPostfix_ctx, cgNeed(cgPostfix_target, "base", "Index target"), cgPostfix_span)
        cgExpr(cgPostfix_ctx, cgNeed(cgPostfix_target, "index", "Index target"), cgPostfix_span)
        cgEmit(cgPostfix_ctx, "GetIndexKeep", 0, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "Dup", 0, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "LoadConst", cgConst(cgPostfix_ctx, "number", 1), 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, cgPostfix_instruction, 0, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "Rotate", 3, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "Rotate", 3, 0, cgPostfix_span)
        cgEmit(cgPostfix_ctx, "SetIndex", 0, 0, cgPostfix_span)
        return null
    end
    assert(false, "cgCodegen: unsupported postfix target '" + toString(cgPostfix_kind) + "'")
end
function cgExpr(cgExpr_ctx, cgExpr_expr, cgExpr_inheritedSpan)
    assert(type(cgExpr_expr) == "object", "cgCodegen: expected an expression object")
    cgExpr_kind = cgNeed(cgExpr_expr, "kind", "expression")
    cgExpr_span = cgSpanOf(cgExpr_expr, cgExpr_inheritedSpan)
    if cgExpr_kind == "Number"
        cgExpr_value = cgNeed(cgExpr_expr, "value", "Number")
        assert(type(cgExpr_value) == "number", "cgCodegen: Number value must be a number")
        cgEmit(cgExpr_ctx, "LoadConst", cgConst(cgExpr_ctx, "number", cgExpr_value), 0, cgExpr_span)
        return null
    end
    if cgExpr_kind == "String"
        cgExpr_value = cgNeed(cgExpr_expr, "value", "String")
        cgExpectString(cgExpr_value, "String value")
        cgEmit(cgExpr_ctx, "LoadConst", cgConst(cgExpr_ctx, "string", cgExpr_value), 0, cgExpr_span)
        return null
    end
    if cgExpr_kind == "Bool"
        cgExpr_value = cgNeed(cgExpr_expr, "value", "Bool")
        assert(type(cgExpr_value) == "boolean", "cgCodegen: Bool value must be a boolean")
        cgEmit(cgExpr_ctx, "LoadConst", cgConst(cgExpr_ctx, "bool", cgExpr_value), 0, cgExpr_span)
        return null
    end
    if cgExpr_kind == "Null"
        cgEmit(cgExpr_ctx, "LoadConst", cgConst(cgExpr_ctx, "null", null), 0, cgExpr_span)
        return null
    end
    if cgExpr_kind == "Variable"
        cgExpr_name = cgExpectString(cgNeed(cgExpr_expr, "name", "Variable"), "variable name")
        cgEmit(cgExpr_ctx, "GetVar", cgName(cgExpr_ctx, cgExpr_name), 0, cgExpr_span)
        return null
    end
    if cgExpr_kind == "PropertyAccess"
        cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "base", "PropertyAccess"), cgExpr_span)
        cgExpr_name = cgExpectString(cgNeed(cgExpr_expr, "name", "PropertyAccess"), "property name")
        cgEmit(cgExpr_ctx, "GetProp", cgName(cgExpr_ctx, cgExpr_name), 0, cgExpr_span)
        return null
    end
    if cgExpr_kind == "Index"
        cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "base", "Index"), cgExpr_span)
        cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "index", "Index"), cgExpr_span)
        cgEmit(cgExpr_ctx, "GetIndex", 0, 0, cgExpr_span)
        return null
    end
    if cgExpr_kind == "Array"
        cgExpr_items = cgExpectArray(cgNeed(cgExpr_expr, "items", "Array"), "Array items")
        cgExpr_i = 0
        while cgExpr_i < len(cgExpr_items)
        cgExpr(cgExpr_ctx, cgExpr_items[cgExpr_i], cgExpr_span)
        cgExpr_i += 1
    end
    cgEmit(cgExpr_ctx, "MakeArray", len(cgExpr_items), 0, cgExpr_span)
    return null
end
if cgExpr_kind == "Object"
    cgExpr_fields = cgExpectArray(cgNeed(cgExpr_expr, "fields", "Object"), "Object fields")
    cgExpr_i = 0
    while cgExpr_i < len(cgExpr_fields)
    cgExpr_field = cgExpr_fields[cgExpr_i]
    assert(type(cgExpr_field) == "object", "cgCodegen: expected an object field entry")
    cgExpr_key = cgExpectString(cgNeed(cgExpr_field, "name", "object field"), "object field name")
    cgEmit(cgExpr_ctx, "LoadConst", cgConst(cgExpr_ctx, "string", cgExpr_key), 0, cgExpr_span)
    cgExpr(cgExpr_ctx, cgNeed(cgExpr_field, "value", "object field"), cgExpr_span)
    cgExpr_i += 1
end
cgEmit(cgExpr_ctx, "MakeObject", len(cgExpr_fields), 0, cgExpr_span)
return null
end
if cgExpr_kind == "Call"
    cgExpr_callee = cgNeed(cgExpr_expr, "callee", "Call")
    cgExpr_args = cgExpectArray(cgNeed(cgExpr_expr, "args", "Call"), "Call arguments")
    cgExpr_isSay = type(cgExpr_callee) == "object" and cgExpr_callee.get("kind", null) == "Variable" and cgExpr_callee.get("name", null) == "say"
    if not cgExpr_isSay
        cgExpr(cgExpr_ctx, cgExpr_callee, cgExpr_span)
    end
    cgExpr_i = 0
    while cgExpr_i < len(cgExpr_args)
    cgExpr(cgExpr_ctx, cgExpr_args[cgExpr_i], cgExpr_span)
    cgExpr_i += 1
end
if cgExpr_isSay
    cgEmit(cgExpr_ctx, "Say", len(cgExpr_args), 0, cgExpr_span)
else
    cgEmit(cgExpr_ctx, "Call", len(cgExpr_args), cgName(cgExpr_ctx, cgDescribeCallee(cgExpr_callee)), cgExpr_span)
end
return null
end
if cgExpr_kind == "MethodCall"
    cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "receiver", "MethodCall"), cgExpr_span)
    cgExpr_name = cgExpectString(cgNeed(cgExpr_expr, "name", "MethodCall"), "method name")
    cgExpr_args = cgExpectArray(cgNeed(cgExpr_expr, "args", "MethodCall"), "MethodCall arguments")
    cgExpr_i = 0
    while cgExpr_i < len(cgExpr_args)
    cgExpr(cgExpr_ctx, cgExpr_args[cgExpr_i], cgExpr_span)
    cgExpr_i += 1
end
cgEmit(cgExpr_ctx, "MethodCall", cgName(cgExpr_ctx, cgExpr_name), len(cgExpr_args), cgExpr_span)
return null
end
if cgExpr_kind == "Binary"
    cgBinary(cgExpr_ctx, cgExpr_expr, cgExpr_span)
    return null
end
if cgExpr_kind == "Unary"
    cgExpr_op = cgExpectString(cgNeed(cgExpr_expr, "op", "Unary"), "unary operator")
    cgExpr_instruction = ""
    if cgExpr_op == "-"
        cgExpr_instruction = "Neg"
    else if cgExpr_op == "not"
        cgExpr_instruction = "Not"
    else if cgExpr_op == "~"
        cgExpr_instruction = "BitNot"
    else
        assert(false, "cgCodegen: unsupported unary operator '" + cgExpr_op + "'")
    end
    cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "operand", "Unary"), cgExpr_span)
    cgEmit(cgExpr_ctx, cgExpr_instruction, 0, 0, cgExpr_span)
    return null
end
if cgExpr_kind == "Ternary"
    cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "condition", "Ternary"), cgExpr_span)
    cgExpr_falseJump = cgEmit(cgExpr_ctx, "JumpIfFalse", 0, 0, cgExpr_span)
    cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "whenTrue", "Ternary"), cgExpr_span)
    cgExpr_endJump = cgEmit(cgExpr_ctx, "Jump", 0, 0, cgExpr_span)
    cgPatch(cgExpr_ctx, cgExpr_falseJump, cgHere(cgExpr_ctx))
    cgExpr(cgExpr_ctx, cgNeed(cgExpr_expr, "whenFalse", "Ternary"), cgExpr_span)
    cgPatch(cgExpr_ctx, cgExpr_endJump, cgHere(cgExpr_ctx))
    return null
end
if cgExpr_kind == "Postfix"
    cgPostfix(cgExpr_ctx, cgExpr_expr, cgExpr_span)
    return null
end
assert(false, "cgCodegen: unsupported expression kind '" + toString(cgExpr_kind) + "'")
end
$- Statements. Every statement lowers into the current chunk. -$
function cgStmt(cgStmt_ctx, cgStmt_stmt, cgStmt_inheritedSpan)
    assert(type(cgStmt_stmt) == "object", "cgCodegen: expected a statement object")
    cgStmt_kind = cgNeed(cgStmt_stmt, "kind", "statement")
    cgStmt_span = cgSpanOf(cgStmt_stmt, cgStmt_inheritedSpan)
    if cgStmt_kind == "Assign"
        cgExpr(cgStmt_ctx, cgNeed(cgStmt_stmt, "value", "Assign"), cgStmt_span)
        cgAssign(cgStmt_ctx, cgNeed(cgStmt_stmt, "target", "Assign"), cgStmt_span)
        return null
    end
    if cgStmt_kind == "CompoundAssign"
        cgStmt_op = cgExpectString(cgNeed(cgStmt_stmt, "op", "CompoundAssign"), "compound assignment operator")
        cgCompoundAssign(cgStmt_ctx, cgNeed(cgStmt_stmt, "target", "CompoundAssign"), cgStmt_op, cgNeed(cgStmt_stmt, "value", "CompoundAssign"), cgStmt_span)
        return null
    end
    if cgStmt_kind == "ExprStmt"
        cgExpr(cgStmt_ctx, cgNeed(cgStmt_stmt, "expr", "ExprStmt"), cgStmt_span)
        cgEmit(cgStmt_ctx, "Pop", 0, 0, cgStmt_span)
        return null
    end
    if cgStmt_kind == "If"
        cgStmt_branches = cgExpectArray(cgNeed(cgStmt_stmt, "branches", "If"), "If branches")
        assert(len(cgStmt_branches) > 0, "cgCodegen: If statement needs at least one branch")
        cgStmt_endJumps = []
        cgStmt_i = 0
        while cgStmt_i < len(cgStmt_branches)
        cgStmt_branch = cgStmt_branches[cgStmt_i]
        assert(type(cgStmt_branch) == "object", "cgCodegen: expected an If branch object")
        cgExpr(cgStmt_ctx, cgNeed(cgStmt_branch, "condition", "If branch"), cgStmt_span)
        cgStmt_skip = cgEmit(cgStmt_ctx, "JumpIfFalse", 0, 0, cgStmt_span)
        cgBlock(cgStmt_ctx, cgExpectArray(cgNeed(cgStmt_branch, "body", "If branch"), "If branch body"), cgStmt_span)
        cgStmt_endJumps.add(cgEmit(cgStmt_ctx, "Jump", 0, 0, cgStmt_span))
        cgPatch(cgStmt_ctx, cgStmt_skip, cgHere(cgStmt_ctx))
        cgStmt_i += 1
    end
    cgStmt_elseBody = cgStmt_stmt.get("else", null)
    if cgStmt_elseBody != null
        cgBlock(cgStmt_ctx, cgExpectArray(cgStmt_elseBody, "If else body"), cgStmt_span)
    end
    cgStmt_endAddress = cgHere(cgStmt_ctx)
    cgStmt_i = 0
    while cgStmt_i < len(cgStmt_endJumps)
    cgPatch(cgStmt_ctx, cgStmt_endJumps[cgStmt_i], cgStmt_endAddress)
    cgStmt_i += 1
end
return null
end
if cgStmt_kind == "FunctionDef"
    cgStmt_name = cgExpectString(cgNeed(cgStmt_stmt, "name", "FunctionDef"), "function name")
    cgStmt_params = cgExpectArray(cgNeed(cgStmt_stmt, "params", "FunctionDef"), "function parameters")
    cgStmt_body = cgExpectArray(cgNeed(cgStmt_stmt, "body", "FunctionDef"), "function body")
    cgStmt_copiedParams = []
    cgStmt_i = 0
    while cgStmt_i < len(cgStmt_params)
    cgStmt_param = cgExpectString(cgStmt_params[cgStmt_i], "function parameter")
    cgStmt_j = 0
    while cgStmt_j < len(cgStmt_copiedParams)
    assert(cgStmt_copiedParams[cgStmt_j] != cgStmt_param, "cgCodegen: function '" + cgStmt_name + "' has two parameters named '" + cgStmt_param + "'")
    cgStmt_j += 1
end
cgStmt_copiedParams.add(cgStmt_param)
cgStmt_i += 1
end
cgStmt_inner = cgCtx()
cgBlock(cgStmt_inner, cgStmt_body, cgStmt_span)
cgEmit(cgStmt_inner, "ReturnNull", 0, 0, cgStmt_span)
cgStmt_prototype = {name: cgStmt_name, params: cgStmt_copiedParams, chunk: {constants: cgStmt_inner.constants, functions: cgStmt_inner.functions, code: cgStmt_inner.code}}
cgStmt_functionIndex = len(cgStmt_ctx.functions)
cgStmt_ctx.functions.add(cgStmt_prototype)
cgEmit(cgStmt_ctx, "MakeClosure", cgStmt_functionIndex, 0, cgStmt_span)
cgEmit(cgStmt_ctx, "DefineVar", cgName(cgStmt_ctx, cgStmt_name), 0, cgStmt_span)
return null
end
if cgStmt_kind == "Return"
    cgStmt_value = cgStmt_stmt.get("value", null)
    if cgStmt_value == null
        cgEmit(cgStmt_ctx, "ReturnNull", 0, 0, cgStmt_span)
    else
        cgExpr(cgStmt_ctx, cgStmt_value, cgStmt_span)
        cgEmit(cgStmt_ctx, "Return", 0, 0, cgStmt_span)
    end
    return null
end
if cgStmt_kind == "While"
    cgStmt_condition = cgNeed(cgStmt_stmt, "condition", "While")
    cgStmt_body = cgExpectArray(cgNeed(cgStmt_stmt, "body", "While"), "While body")
    cgStmt_head = cgHere(cgStmt_ctx)
    cgExpr(cgStmt_ctx, cgStmt_condition, cgStmt_span)
    cgStmt_exitIndex = cgEmit(cgStmt_ctx, "JumpIfFalse", 0, 0, cgStmt_span)
    cgOpenLoop(cgStmt_ctx, cgStmt_head, 0, cgStmt_exitIndex)
    cgBlock(cgStmt_ctx, cgStmt_body, cgStmt_span)
    cgCloseLoop(cgStmt_ctx, cgStmt_span)
    return null
end
if cgStmt_kind == "Repeat"
    cgStmt_count = cgNeed(cgStmt_stmt, "count", "Repeat")
    cgStmt_body = cgExpectArray(cgNeed(cgStmt_stmt, "body", "Repeat"), "Repeat body")
    cgExpr(cgStmt_ctx, cgStmt_count, cgStmt_span)
    cgEmit(cgStmt_ctx, "RepeatSetup", 0, 0, cgStmt_span)
    cgStmt_head = cgHere(cgStmt_ctx)
    cgStmt_exitIndex = cgEmit(cgStmt_ctx, "RepeatNext", 0, 0, cgStmt_span)
    cgOpenLoop(cgStmt_ctx, cgStmt_head, 1, cgStmt_exitIndex)
    cgBlock(cgStmt_ctx, cgStmt_body, cgStmt_span)
    cgCloseLoop(cgStmt_ctx, cgStmt_span)
    return null
end
if cgStmt_kind == "ForIn"
    cgStmt_name = cgExpectString(cgNeed(cgStmt_stmt, "name", "ForIn"), "loop variable")
    cgStmt_iterable = cgNeed(cgStmt_stmt, "iterable", "ForIn")
    cgStmt_body = cgExpectArray(cgNeed(cgStmt_stmt, "body", "ForIn"), "ForIn body")
    cgExpr(cgStmt_ctx, cgStmt_iterable, cgStmt_span)
    cgEmit(cgStmt_ctx, "IterSetup", 0, 0, cgStmt_span)
    cgStmt_nameIndex = cgName(cgStmt_ctx, cgStmt_name)
    cgStmt_head = cgHere(cgStmt_ctx)
    cgStmt_exitIndex = cgEmit(cgStmt_ctx, "IterNext", cgStmt_nameIndex, 0, cgStmt_span)
    cgOpenLoop(cgStmt_ctx, cgStmt_head, 2, cgStmt_exitIndex)
    cgBlock(cgStmt_ctx, cgStmt_body, cgStmt_span)
    cgCloseLoop(cgStmt_ctx, cgStmt_span)
    return null
end
if cgStmt_kind == "Break"
    assert(len(cgStmt_ctx.heads) > 0, "cgCodegen: 'break' can only be used inside a loop")
    cgStmt_pops = cgStmt_ctx.pops[len(cgStmt_ctx.pops) - 1]
    cgStmt_i = 0
    while cgStmt_i < cgStmt_pops
    cgEmit(cgStmt_ctx, "Pop", 0, 0, cgStmt_span)
    cgStmt_i += 1
end
cgStmt_jumpIndex = cgEmit(cgStmt_ctx, "Jump", 0, 0, cgStmt_span)
cgStmt_breaks = cgStmt_ctx.breaks[len(cgStmt_ctx.breaks) - 1]
cgStmt_breaks.add(cgStmt_jumpIndex)
return null
end
if cgStmt_kind == "Continue"
    assert(len(cgStmt_ctx.heads) > 0, "cgCodegen: 'continue' can only be used inside a loop")
    cgEmit(cgStmt_ctx, "Jump", cgStmt_ctx.heads[len(cgStmt_ctx.heads) - 1], 0, cgStmt_span)
    return null
end
if cgStmt_kind == "Import"
    cgStmt_name = cgExpectString(cgNeed(cgStmt_stmt, "name", "Import"), "module name")
    cgEmit(cgStmt_ctx, "Import", cgName(cgStmt_ctx, cgStmt_name), 0, cgStmt_span)
    return null
end
assert(false, "cgCodegen: unsupported statement kind '" + toString(cgStmt_kind) + "'")
end
function cgBlock(cgBlock_ctx, cgBlock_statements, cgBlock_inheritedSpan)
    cgExpectArray(cgBlock_statements, "statement block")
    cgBlock_i = 0
    while cgBlock_i < len(cgBlock_statements)
    cgStmt(cgBlock_ctx, cgBlock_statements[cgBlock_i], cgBlock_inheritedSpan)
    cgBlock_i += 1
end
end
$- Public entry point: AST envelope -> version 2 emb IR. -$
function cgCodegen(cgCodegen_ast)
    assert(type(cgCodegen_ast) == "object", "cgCodegen: expected an AST envelope object")
    cgCodegen_version = cgNeed(cgCodegen_ast, "version", "AST envelope")
    assert(cgCodegen_version == 1, "cgCodegen: unsupported AST version " + toString(cgCodegen_version))
    cgCodegen_statements = cgExpectArray(cgNeed(cgCodegen_ast, "statements", "AST envelope"), "AST statements")
    cgCodegen_ctx = cgCtx()
    cgBlock(cgCodegen_ctx, cgCodegen_statements, {line: 1, col: 1})
    cgEmit(cgCodegen_ctx, "ReturnNull", 0, 0, {line: 1, col: 1})
    return {version: 2, constants: cgCodegen_ctx.constants, functions: cgCodegen_ctx.functions, code: cgCodegen_ctx.code}
end
$- ---------------------------------------------------------------------------
   Inline self-tests. These build AST fixtures by hand and assert IR shape.
   Native `emb` is used only as an oracle that the generated IR is encodable.
   --------------------------------------------------------------------------- -$
$- === inlined selfhost/ir_encode.enm === -$
$-!
    selfhost/ir_encode.enm

    Pure-Englishmen encoder for the `emb` IR described in
    docs/selfhost/EMB_AND_MANIFEST.md.  `ieEncode(ir)` returns the exact byte
    array that native `emb.encode(ir)` / bytecode::serialize would produce.

    Every helper is self-contained and prefixed with `ie`; the encoder itself
    uses no native module.  Native `emb` is imported only inside the guarded
    self-tests at the bottom.  The guard uses the global `env` builtin so no
    native module is needed merely to detect EM_SELFTEST.
!-$
$- Name -> [tag, operand shape].  Shape 0 means both operands are zeroed,
   shape 1 keeps `a`, and shape 2 keeps `a` and `b`.  This mirrors the table in
   src/modules/emb.rs and bytecode::encode_op. -$
ieOps = {LoadConst: [0, 1], Pop: [1, 0], GetVar: [2, 1], SetVar: [3, 1], DefineVar: [4, 1], GetProp: [5, 1], SetProp: [6, 1], GetVarOrObject: [7, 1], GetPropOrObject: [8, 1], GetIndex: [9, 0], SetIndex: [10, 0], MakeArray: [11, 1], MakeObject: [12, 1], MakeClosure: [13, 1], Call: [14, 2], MethodCall: [15, 2], Say: [16, 1], Add: [17, 0], Sub: [18, 0], Mul: [19, 0], Div: [20, 0], Mod: [21, 0], FloorDiv: [42, 0], Pow: [43, 0], BitAnd: [44, 0], BitOr: [45, 0], BitXor: [46, 0], Shl: [47, 0], Shr: [48, 0], Eq: [22, 0], NotEq: [23, 0], Gt: [24, 0], Lt: [25, 0], GtEq: [26, 0], LtEq: [27, 0], Neg: [28, 0], Not: [29, 0], BitNot: [49, 0], ToBool: [30, 0], Jump: [31, 1], JumpIfFalse: [32, 1], JumpIfFalsePeek: [33, 1], JumpIfTruePeek: [34, 1], RepeatSetup: [35, 0], RepeatNext: [36, 1], IterSetup: [37, 0], IterNext: [38, 2], Return: [39, 0], ReturnNull: [40, 0], Import: [41, 1], Dup: [50, 0], Rotate: [51, 1], GetPropKeep: [52, 1], GetIndexKeep: [53, 0], JumpIfNullPeek: [54, 1]}
$- Append the low `count` bytes of a non-negative whole number, little-endian. -$
function ieAppendUint(out, value, count)
    assert(isNumber(value), "ieEncode: expected a whole number")
    assert(value >= 0, "ieEncode: expected a non-negative whole number")
    for i in range(count)
        out.add(value % 256)
        value = floor(value / 256)
    end
end
$- Append a u32 exactly as bytecode::write_u32 does. -$
function ieAppendU32(out, value)
    assert(isNumber(value) and value <= 4294967295, "ieEncode: u32 out of range")
    ieAppendUint(out, value, 4)
end
$- UTF-8 bytes for one string, matching Rust's String::as_bytes. -$
function ieTextBytes(text)
    out = []
    for i in range(len(text))
        code = charCode(text[i])
        if code <= 127
            out.add(code)
        else if code <= 2047
            out.add(192 | (code >> 6))
            out.add(128 | (code & 63))
        else if code <= 65535
            out.add(224 | (code >> 12))
            out.add(128 | ((code >> 6) & 63))
            out.add(128 | (code & 63))
        else
            out.add(240 | (code >> 18))
            out.add(128 | ((code >> 12) & 63))
            out.add(128 | ((code >> 6) & 63))
            out.add(128 | (code & 63))
        end
    end
    return out
end
$- A length-prefixed UTF-8 string (write_str in bytecode.rs). -$
function ieAppendStr(out, text)
    assert(isString(text), "ieEncode: expected a string")
    bytes = ieTextBytes(text)
    ieAppendU32(out, len(bytes))
    for byte in bytes
        out.add(byte)
    end
end
$- IEEE-754 binary64, little-endian.  Scaling by powers of two is exact, so
   the recovered 52-bit fraction is bit-identical to f64::to_le_bytes. -$
function ieAppendF64(out, number)
    assert(isNumber(number), "ieEncode: expected a number constant")
    ieSign = 0
    if isNaN(number)
        if number.toFixed(1).startsWith("-")
            ieSign = 1
        end
    else if number == 0
        if number.toFixed(1).startsWith("-")
            ieSign = 1
        end
    else if number < 0
        ieSign = 1
    end
    exponent = 0
    fraction = 0
    if isNaN(number)
        exponent = 2047
        fraction = 2251799813685248 $- 2^51, canonical quiet NaN -$
    else if not number.isFinite()
        exponent = 2047
        fraction = 0
    else
        magnitude = abs(number)
        if magnitude > 0
            scaled = magnitude
            unbiased = 0
            for i in range(1100)
                if scaled >= 2
                    scaled = scaled / 2
                    unbiased += 1
                else
                    break
                end
            end
            for i in range(1100)
                if scaled < 1 and unbiased > -1022
                    scaled = scaled * 2
                    unbiased -= 1
                else
                    break
                end
            end
            if unbiased == -1022 and scaled < 1
$- Subnormal: `scaled` is already magnitude * 2^1022. -$
                exponent = 0
                fraction = scaled
            else
                exponent = unbiased + 1023
                fraction = scaled - 1
            end
            for i in range(52)
                fraction = fraction * 2
            end
            fraction = floor(fraction)
        end
    end
$- Fraction bytes 0..5; the top four fraction bits share byte 6 with the
       low four exponent bits.  Byte 7 holds the remaining exponent bits and
       the sign bit. -$
    for i in range(6)
        out.add(fraction % 256)
        fraction = floor(fraction / 256)
    end
    out.add((fraction % 16) + ((exponent % 16) * 16))
    out.add(floor(exponent / 16) + (ieSign * 128))
end
$- Validate and append a u32 operand; absent fields use the Rust defaults. -$
function ieOperand(instruction, name, fallback)
    if not instruction.has(name)
        return fallback
    end
    value = instruction.get(name)
    assert(isNumber(value) and value.isFinite(), "ieEncode: operand must be a finite number")
    assert(value >= 0 and value <= 4294967295 and value == floor(value), "ieEncode: operand must be a u32")
    return value
end
function ieAppendConstant(out, constant)
    tag = constant.get("tag", null)
    assert(isString(tag), "ieEncode: constant tag must be a string")
    if tag == "number"
        value = constant.get("value")
        assert(isNumber(value), "ieEncode: number constant needs a numeric value")
        out.add(0)
        ieAppendF64(out, value)
    else if tag == "string"
        value = constant.get("value")
        out.add(1)
        ieAppendStr(out, value)
    else if tag == "bool"
        value = constant.get("value")
        assert(isBool(value), "ieEncode: bool constant needs a boolean value")
        out.add(2)
        if value
            out.add(1)
        else
            out.add(0)
        end
    else if tag == "null"
        out.add(3)
    else
        assert(false, "ieEncode: unknown constant tag '" + tag + "'")
    end
end
function ieAppendInstruction(out, instruction)
    name = instruction.get("op", null)
    assert(isString(name) and ieOps.has(name), "ieEncode: unknown op name")
    info = ieOps.get(name)
    a = ieOperand(instruction, "a", 0)
    b = ieOperand(instruction, "b", 0)
    line = ieOperand(instruction, "line", 1)
    col = ieOperand(instruction, "col", 1)
    if info[1] == 0
        a = 0
        b = 0
    else if info[1] == 1
        b = 0
    end
    out.add(info[0])
    ieAppendU32(out, a)
    ieAppendU32(out, b)
    ieAppendU32(out, line)
    ieAppendU32(out, col)
end
$- Chunks are recursive: constants, functions (with their own chunk), code. -$
function ieAppendChunk(out, chunk, depth)
    assert(depth <= 32, "ieEncode: functions are nested too deeply")
    constants = chunk.get("constants")
    functions = chunk.get("functions")
    code = chunk.get("code")
    assert(isArray(constants), "ieEncode: chunk needs a constants array")
    assert(isArray(functions), "ieEncode: chunk needs a functions array")
    assert(isArray(code), "ieEncode: chunk needs a code array")
    ieAppendU32(out, len(constants))
    for constant in constants
        ieAppendConstant(out, constant)
    end
    ieAppendU32(out, len(functions))
    for prototype in functions
        name = prototype.get("name")
        params = prototype.get("params")
        body = prototype.get("chunk")
        assert(isString(name), "ieEncode: function needs a string name")
        assert(isArray(params), "ieEncode: function needs a params array")
        ieAppendStr(out, name)
        ieAppendU32(out, len(params))
        for param in params
            ieAppendStr(out, param)
        end
        ieAppendChunk(out, body, depth + 1)
    end
    ieAppendU32(out, len(code))
    for instruction in code
        ieAppendInstruction(out, instruction)
    end
end
$- Public entry point: magic, LE u16 version, then the root chunk. -$
function ieEncode(ir)
    assert(ir.get("version") == 2, "ieEncode: version mismatch, expected 2")
    out = []
    out.add(charCode("E"))
    out.add(charCode("M"))
    out.add(charCode("B"))
    out.add(charCode("C"))
    out.add(2)
    out.add(0)
    ieAppendChunk(out, ir, 0)
    return out
end
$- ---------------------------------------------------------------- self-tests -$
$- === inlined selfhost/lib_bytes.enm === -$
$- Pure Englishmen implementation of the native `bytes` module.

   A buffer is an ordinary array of whole numbers from 0 to 255. Every
   conversion packs into a fresh array; `btSet` is the one mutating helper
   and returns the same buffer it was given. All helpers are prefixed with
   `bt` so this file can be concatenated with the other self-hosted pieces.

   The native `bytes` module is imported only inside the self-test guard at
   the bottom, where it acts as a reference oracle. It is not used by any
   function above that guard; the guard itself uses the `env` builtin instead
   of importing `os`.

   Englishmen functions have fixed arity, so the two variadic native helpers
   have array-shaped equivalents here:
     - btOf(values) accepts a single number or an array of numbers.
     - btConcat(buffers) accepts an array of buffers.
   btSlice(buffer, start, end) uses `null` for `end` to mean "to the end",
   matching a native call that omits the third argument.
-$
$- ---------------------------------------------------------------------------
   Argument validation
   --------------------------------------------------------------------------- -$
function btIsNumber(btValue_arg)
    return type(btValue_arg) == "number"
end
function btIsFiniteNumber(btValue_arg)
    if not btIsNumber(btValue_arg)
        return false
    end
    if isNaN(btValue_arg)
        return false
    end
    return btValue_arg <=  and btValue_arg >= -
end
function btIsWhole(btValue_arg)
    if not btIsFiniteNumber(btValue_arg)
        return false
    end
    return btValue_arg == floor(btValue_arg)
end
function btAssertWhole(btValue_arg, btContext_arg)
    assert(btIsWhole(btValue_arg), "Expected a whole number " + btContext_arg)
end
function btByte(btValue_arg, btContext_arg)
    btAssertWhole(btValue_arg, btContext_arg)
    assert(btValue_arg >= 0 and btValue_arg <= 255, "Expected a byte from 0 to 255 " + btContext_arg)
    return btValue_arg
end
function btBuffer(btBuffer_arg, btContext_arg)
    assert(type(btBuffer_arg) == "array", "Expected a byte buffer " + btContext_arg)
    btBuffer_i = 0
    while btBuffer_i < len(btBuffer_arg)
    btByte(btBuffer_arg[btBuffer_i], "at index " + toString(btBuffer_i) + " " + btContext_arg)
    btBuffer_i += 1
end
return btBuffer_arg
end
function btExactIndex(btLength_arg, btIndex_arg, btContext_arg)
    btAssertWhole(btIndex_arg, btContext_arg)
    btResolved = btIndex_arg
    if btIndex_arg < 0
        btResolved = btLength_arg + btIndex_arg
    end
    assert(btResolved >= 0 and btResolved < btLength_arg, "Index " + toString(btIndex_arg) + " is outside a buffer of " + toString(btLength_arg) + " bytes")
    return btResolved
end
function btSliceIndex(btLength_arg, btIndex_arg, btContext_arg)
    btAssertWhole(btIndex_arg, btContext_arg)
    if btIndex_arg < 0
        btResolved = btLength_arg + btIndex_arg
        if btResolved < 0
            return 0
        end
        return btResolved
    end
    if btIndex_arg > btLength_arg
        return btLength_arg
    end
    return btIndex_arg
end
$- ---------------------------------------------------------------------------
   Text conversion
   --------------------------------------------------------------------------- -$
function btFromString(btText_arg)
    assert(type(btText_arg) == "string", "btFromString expects a string")
    btOut = []
    btIndex = 0
    while btIndex < len(btText_arg)
    btCode = charCode(btText_arg[btIndex])
    if btCode <= 127
        btOut.add(btCode)
    else if btCode <= 2047
        btOut.add(192 | ((btCode >> 6) & 31))
        btOut.add(128 | (btCode & 63))
    else if btCode <= 65535
        btOut.add(224 | ((btCode >> 12) & 15))
        btOut.add(128 | ((btCode >> 6) & 63))
        btOut.add(128 | (btCode & 63))
    else
        btOut.add(240 | ((btCode >> 18) & 7))
        btOut.add(128 | ((btCode >> 12) & 63))
        btOut.add(128 | ((btCode >> 6) & 63))
        btOut.add(128 | (btCode & 63))
    end
    btIndex += 1
end
return btOut
end
function btUtf8Continuation(btByte_arg)
    return btByte_arg >= 128 and btByte_arg <= 191
end
function btToString(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btToString")
    btOut = ""
    btSize = len(btBuffer_arg)
    btIndex = 0
    while btIndex < btSize
    btLead = btBuffer_arg[btIndex]
    if btLead < 128
        btOut += fromCharCode(btLead)
    else if btLead >= 194 and btLead <= 223
        assert(btIndex + 1 < btSize, "Truncated UTF-8 sequence for btToString")
        btNext = btBuffer_arg[btIndex + 1]
        assert(btUtf8Continuation(btNext), "Invalid UTF-8 continuation byte for btToString")
        btCode = ((btLead & 31) << 6) | (btNext & 63)
        assert(btCode >= 128, "Overlong UTF-8 sequence for btToString")
        btOut += fromCharCode(btCode)
        btIndex += 1
    else if btLead >= 224 and btLead <= 239
        assert(btIndex + 2 < btSize, "Truncated UTF-8 sequence for btToString")
        btNext = btBuffer_arg[btIndex + 1]
        btLast = btBuffer_arg[btIndex + 2]
        assert(btUtf8Continuation(btNext) and btUtf8Continuation(btLast), "Invalid UTF-8 continuation byte for btToString")
        if btLead == 224
            assert(btNext >= 160, "Overlong UTF-8 sequence for btToString")
        end
        if btLead == 237
            assert(btNext <= 159, "UTF-8 surrogate is not a scalar value for btToString")
        end
        btCode = ((btLead & 15) << 12) | ((btNext & 63) << 6) | (btLast & 63)
        assert(btCode >= 2048 and not (btCode >= 55296 and btCode <= 57343), "Invalid UTF-8 code point for btToString")
        btOut += fromCharCode(btCode)
        btIndex += 2
    else if btLead >= 240 and btLead <= 244
        assert(btIndex + 3 < btSize, "Truncated UTF-8 sequence for btToString")
        btNext = btBuffer_arg[btIndex + 1]
        btSecond = btBuffer_arg[btIndex + 2]
        btLast = btBuffer_arg[btIndex + 3]
        assert(btUtf8Continuation(btNext) and btUtf8Continuation(btSecond) and btUtf8Continuation(btLast), "Invalid UTF-8 continuation byte for btToString")
        if btLead == 240
            assert(btNext >= 144, "Overlong UTF-8 sequence for btToString")
        end
        if btLead == 244
            assert(btNext <= 143, "UTF-8 code point above U+10FFFF for btToString")
        end
        btCode = ((btLead & 7) << 18) | ((btNext & 63) << 12) | ((btSecond & 63) << 6) | (btLast & 63)
        assert(btCode >= 65536 and btCode <= 1114111, "Invalid UTF-8 code point for btToString")
        btOut += fromCharCode(btCode)
        btIndex += 3
    else
        assert(false, "Invalid UTF-8 lead byte for btToString")
    end
    btIndex += 1
end
return btOut
end
$- ---------------------------------------------------------------------------
   Buffers, indexing and slicing
   --------------------------------------------------------------------------- -$
function btOf(btValues_arg)
    if type(btValues_arg) == "number"
        return [btByte(btValues_arg, "as a byte for btOf")]
    end
    assert(type(btValues_arg) == "array", "btOf expects a number or an array of numbers")
    btOut = []
    btIndex = 0
    while btIndex < len(btValues_arg)
    btOut.add(btByte(btValues_arg[btIndex], "as byte " + toString(btIndex + 1) + " for btOf"))
    btIndex += 1
end
return btOut
end
function btLength(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btLength")
    return len(btBuffer_arg)
end
function btGet(btBuffer_arg, btIndex_arg)
    btBuffer(btBuffer_arg, "for btGet")
    btResolved = btExactIndex(len(btBuffer_arg), btIndex_arg, "as the index for btGet")
    return btBuffer_arg[btResolved]
end
function btSet(btBuffer_arg, btIndex_arg, btValue_arg)
$- Validate the whole buffer before changing any of it, like the native module. -$
    btBuffer(btBuffer_arg, "for btSet")
    btResolved = btExactIndex(len(btBuffer_arg), btIndex_arg, "as the index for btSet")
    btByte(btValue_arg, "as the byte for btSet")
    btBuffer_arg[btResolved] = btValue_arg
    return btBuffer_arg
end
function btConcat(btBuffers_arg)
    assert(type(btBuffers_arg) == "array", "btConcat expects an array of buffers")
    btOut = []
    btIndex = 0
    while btIndex < len(btBuffers_arg)
    btPart = btBuffer(btBuffers_arg[btIndex], "as buffer " + toString(btIndex + 1) + " for btConcat")
    btInner = 0
    while btInner < len(btPart)
    btOut.add(btPart[btInner])
    btInner += 1
end
btIndex += 1
end
return btOut
end
function btSlice(btBuffer_arg, btStart_arg, btEnd_arg)
    btBuffer(btBuffer_arg, "for btSlice")
    if btEnd_arg == null
        btStop = len(btBuffer_arg)
    else
        btStop = btEnd_arg
    end
    btFrom = btSliceIndex(len(btBuffer_arg), btStart_arg, "as the start index for btSlice")
    btTo = btSliceIndex(len(btBuffer_arg), btStop, "as the end index for btSlice")
    btOut = []
    btIndex = btFrom
    while btIndex < btTo
    btOut.add(btBuffer_arg[btIndex])
    btIndex += 1
end
return btOut
end
function btCopy(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btCopy")
    btOut = []
    btIndex = 0
    while btIndex < len(btBuffer_arg)
    btOut.add(btBuffer_arg[btIndex])
    btIndex += 1
end
return btOut
end
$- ---------------------------------------------------------------------------
   Hex conversion
   --------------------------------------------------------------------------- -$
function btHexDigit(btChar_arg)
    btCode = charCode(btChar_arg)
    if btCode >= 48 and btCode <= 57
        return btCode - 48
    end
    if btCode >= 97 and btCode <= 102
        return btCode - 87
    end
    if btCode >= 65 and btCode <= 70
        return btCode - 55
    end
    return -1
end
function btIsAsciiWhitespace(btCode_arg)
    return btCode_arg == 9 or btCode_arg == 10 or btCode_arg == 11 or btCode_arg == 12 or btCode_arg == 13 or btCode_arg == 32
end
function btFromHex(btText_arg)
    assert(type(btText_arg) == "string", "btFromHex expects hex text")
    btCompact = ""
    btIndex = 0
    while btIndex < len(btText_arg)
    btChar = btText_arg[btIndex]
    if not btIsAsciiWhitespace(charCode(btChar))
        btCompact += btChar
    end
    btIndex += 1
end
assert(len(btCompact) % 2 == 0, "btFromHex expects an even number of hex digits")
btOut = []
btIndex = 0
while btIndex < len(btCompact)
btHigh = btHexDigit(btCompact[btIndex])
btLow = btHexDigit(btCompact[btIndex + 1])
assert(btHigh >= 0 and btLow >= 0, "Invalid hex byte for btFromHex")
btOut.add(btHigh * 16 + btLow)
btIndex += 2
end
return btOut
end
function btHexPair(btByte_arg)
    btDigits = "0123456789abcdef"
    return btDigits[floor(btByte_arg / 16)] + btDigits[btByte_arg % 16]
end
function btToHex(btBuffer_arg)
    btBuffer(btBuffer_arg, "for btToHex")
    btParts = []
    btIndex = 0
    while btIndex < len(btBuffer_arg)
    btParts.add(btHexPair(btBuffer_arg[btIndex]))
    btIndex += 1
end
return join(btParts, " ")
end
$- ---------------------------------------------------------------------------
   Little-endian integer packing
   --------------------------------------------------------------------------- -$
function btLeBytes(btValue_arg, btCount_arg)
    btOut = []
    btIndex = 0
    while btIndex < btCount_arg
    btOut.add(btValue_arg % 256)
    btValue_arg = floor(btValue_arg / 256)
    btIndex += 1
end
return btOut
end
function btUnsignedArg(btValue_arg, btUpper_arg, btName_arg, btMaxLabel_arg)
    btAssertWhole(btValue_arg, "as the number for " + btName_arg)
    assert(btValue_arg >= 0 and btValue_arg < btUpper_arg, btName_arg + " expects a whole number from 0 to " + btMaxLabel_arg)
    return btValue_arg
end
function btSignedLeBytes(btValue_arg, btCount_arg)
    btOut = []
    btIndex = 0
    while btIndex < btCount_arg
    btOut.add(btValue_arg & 255)
    btValue_arg = btValue_arg >> 8
    btIndex += 1
end
return btOut
end
function btSignedArg(btValue_arg, btLower_arg, btUpper_arg, btName_arg, btMinLabel_arg, btMaxLabel_arg)
    btAssertWhole(btValue_arg, "as the number for " + btName_arg)
    assert(btValue_arg >= btLower_arg and btValue_arg < btUpper_arg, btName_arg + " expects a whole number from " + btMinLabel_arg + " to " + btMaxLabel_arg)
    return btValue_arg
end
function btU8(btValue_arg)
    return btLeBytes(btUnsignedArg(btValue_arg, 256, "btU8", "255"), 1)
end
function btU16(btValue_arg)
    return btLeBytes(btUnsignedArg(btValue_arg, 65536, "btU16", "65535"), 2)
end
function btU32(btValue_arg)
    return btLeBytes(btUnsignedArg(btValue_arg, 4294967296, "btU32", "4294967295"), 4)
end
function btU64(btValue_arg)
$- 2^64 is exactly representable as an f64 and keeps an out-of-range input from becoming u64::MAX. -$
    return btLeBytes(btUnsignedArg(btValue_arg, pow(2, 64), "btU64", "18446744073709551615"), 8)
end
function btI16(btValue_arg)
    return btSignedLeBytes(btSignedArg(btValue_arg, -32768, 32768, "btI16", "-32768", "32767"), 2)
end
function btI32(btValue_arg)
    return btSignedLeBytes(btSignedArg(btValue_arg, -2147483648, 2147483648, "btI32", "-2147483648", "2147483647"), 4)
end
function btI64(btValue_arg)
    return btSignedLeBytes(btSignedArg(btValue_arg, -9223372036854776000, 9223372036854776000, "btI64", "-9223372036854775808", "9223372036854775807"), 8)
end
$- ---------------------------------------------------------------------------
   IEEE-754 binary64 packing and unpacking
   --------------------------------------------------------------------------- -$
function btSetBit(btBytes_arg, btIndex_arg, btBit_arg)
    btByteIndex = floor(btIndex_arg / 8)
    btBitIndex = btIndex_arg % 8
    btBytes_arg[btByteIndex] = btBytes_arg[btByteIndex] + (btBit_arg << btBitIndex)
end
function btPutBits(btBytes_arg, btValue_arg, btStart_arg, btCount_arg)
    btIndex = 0
    while btIndex < btCount_arg
    btBit = floor(btValue_arg / pow(2, btIndex)) % 2
    btSetBit(btBytes_arg, btStart_arg + btIndex, btBit)
    btIndex += 1
end
end
function btBitAt(btBytes_arg, btIndex_arg)
    btByteIndex = floor(btIndex_arg / 8)
    btBitIndex = btIndex_arg % 8
    return floor(btBytes_arg[btByteIndex] / pow(2, btBitIndex)) % 2
end
function btF64Bits(btValue_arg)
    btNegative = btValue_arg < 0
    if btValue_arg == 0 and pow(btValue_arg, -1) < 0
        btNegative = true
    end
    btBytes = [0, 0, 0, 0, 0, 0, 0, 0]
    if isNaN(btValue_arg)
$- Englishmen arithmetic produces a negative quiet NaN; keep its sign bit. -$
        btNegative = true
        btExponent = 2047
        btMantissa = pow(2, 51)
    else if btValue_arg >  or btValue_arg < -
        btExponent = 2047
        btMantissa = 0
    else if btValue_arg == 0
        btExponent = 0
        btMantissa = 0
    else
        btMagnitude = abs(btValue_arg)
        btScale = btMagnitude
        btExponentCount = 0
        while btScale >= 2
        btScale = btScale / 2
        btExponentCount += 1
    end
    while btScale < 1
    btScale = btScale * 2
    btExponentCount -= 1
end
if btExponentCount >= -1022
    btExponent = btExponentCount + 1023
    btMantissa = floor((btScale - 1) * pow(2, 52))
else
$- Subnormals have no implicit leading 1: divide by the smallest double. -$
    btExponent = 0
    btMantissa = floor(btMagnitude / pow(2, -1074))
end
end
if btNegative
    btSetBit(btBytes, 63, 1)
end
btPutBits(btBytes, btExponent, 52, 11)
btPutBits(btBytes, btMantissa, 0, 52)
return btBytes
end
function btF64(btValue_arg)
    assert(btIsNumber(btValue_arg), "btF64 expects a number")
    return btF64Bits(btValue_arg)
end
function btReadU16(btBuffer_arg, btOffset_arg)
    btBuffer(btBuffer_arg, "for btReadU16")
    btAssertWhole(btOffset_arg, "as the offset for btReadU16")
    assert(btOffset_arg >= 0 and btOffset_arg + 2 <= len(btBuffer_arg), "btReadU16 needs two bytes inside the buffer")
    return btBuffer_arg[btOffset_arg] + btBuffer_arg[btOffset_arg + 1] * 256
end
function btReadU32(btBuffer_arg, btOffset_arg)
    btBuffer(btBuffer_arg, "for btReadU32")
    btAssertWhole(btOffset_arg, "as the offset for btReadU32")
    assert(btOffset_arg >= 0 and btOffset_arg + 4 <= len(btBuffer_arg), "btReadU32 needs four bytes inside the buffer")
    return btBuffer_arg[btOffset_arg] + btBuffer_arg[btOffset_arg + 1] * 256 + btBuffer_arg[btOffset_arg + 2] * 65536 + btBuffer_arg[btOffset_arg + 3] * 16777216
end
function btReadF64(btBuffer_arg, btOffset_arg)
    btBuffer(btBuffer_arg, "for btReadF64")
    btAssertWhole(btOffset_arg, "as the offset for btReadF64")
    assert(btOffset_arg >= 0 and btOffset_arg + 8 <= len(btBuffer_arg), "btReadF64 needs eight bytes inside the buffer")
    btExponent = 0
    btBit = 0
    while btBit < 11
    btExponent += btBitAt(btBuffer_arg, btOffset_arg * 8 + 52 + btBit) * pow(2, btBit)
    btBit += 1
end
btMantissa = 0
btBit = 0
while btBit < 52
btMantissa += btBitAt(btBuffer_arg, btOffset_arg * 8 + btBit) * pow(2, btBit)
btBit += 1
end
if btExponent == 2047
    if btMantissa == 0
        btValue = pow(2, 1024)
    else
        btValue = pow(-1, 0.5)
    end
else if btExponent == 0
    btValue = btMantissa * pow(2, -1074)
else
    btValue = pow(2, btExponent - 1023) * (1 + btMantissa / pow(2, 52))
end
if btBitAt(btBuffer_arg, btOffset_arg * 8 + 63) == 1
    btValue = -btValue
end
return btValue
end
$- ---------------------------------------------------------------------------
   Self-tests: the native bytes module is an oracle only inside this guard.
   --------------------------------------------------------------------------- -$
$- === inlined selfhost/lib_project.enm === -$
$- Pure Englishmen implementation of the native `project` manifest API.
   Self-contained by design: Englishmen has no local `.enm` imports yet, so
   every helper is global and prefixed with `pj` to survive concatenation into
   `selfhost/full.enm`. The native `project` module is imported only inside the
   self-test guard, where it acts as an oracle; the guard itself uses the
   `env` builtin rather than importing `os`. -$
$- Return the value of one hexadecimal digit, or -1 for anything else. -$
function pjHexDigit(pjHexDigit_c)
    pjHexDigit_n = charCode(pjHexDigit_c)
    if pjHexDigit_n >= 48 and pjHexDigit_n <= 57
        return pjHexDigit_n - 48
    end
    if pjHexDigit_n >= 97 and pjHexDigit_n <= 102
        return pjHexDigit_n - 87
    end
    if pjHexDigit_n >= 65 and pjHexDigit_n <= 70
        return pjHexDigit_n - 55
    end
    return -1
end
$- Reverse `u32::from_str_radix(digits, 16)` for the 1-4 digits after `\u`.
   A leading '+' is accepted; a leading '-' is always rejected by u32. -$
function pjHexValue(pjHexValue_digits)
    if pjHexValue_digits.length() == 0
        return -1
    end
    pjHexValue_start = 0
    if pjHexValue_digits[0] == "+"
        pjHexValue_start = 1
    else if pjHexValue_digits[0] == "-"
        return -1
    end
    if pjHexValue_start >= pjHexValue_digits.length()
        return -1
    end
    pjHexValue_value = 0
    pjHexValue_i = pjHexValue_start
    while pjHexValue_i < pjHexValue_digits.length()
    pjHexValue_digit = pjHexDigit(pjHexValue_digits[pjHexValue_i])
    if pjHexValue_digit < 0
        return -1
    end
    pjHexValue_value = pjHexValue_value * 16 + pjHexValue_digit
    pjHexValue_i += 1
end
return pjHexValue_value
end
$- Four lowercase hex digits, matching Rust's `\u{:04x}` writer. -$
function pjHex4(pjHex4_n)
    pjHex4_digits = "0123456789abcdef"
    pjHex4_out = ""
    pjHex4_i = 3
    while pjHex4_i >= 0
    pjHex4_out = pjHex4_digits[pjHex4_n % 16] + pjHex4_out
    pjHex4_n = floor(pjHex4_n / 16)
    pjHex4_i -= 1
end
return pjHex4_out
end
$- `char::from_u32` accepts scalars only: no surrogates and nothing above U+10FFFF. -$
function pjIsScalar(pjIsScalar_n)
    if pjIsScalar_n < 0 or pjIsScalar_n > 1114111
        return false
    end
    if pjIsScalar_n >= 55296 and pjIsScalar_n <= 57343
        return false
    end
    return true
end
$- Reverse `write_quoted` escape by escape. Unknown escapes and malformed
   `\uXXXX` sequences are kept literally, exactly as native `project.parse`
   does. -$
function pjUnescape(pjUnescape_text)
    pjUnescape_chars = pjUnescape_text.chars()
    pjUnescape_out = ""
    pjUnescape_i = 0
    while pjUnescape_i < pjUnescape_chars.length()
    pjUnescape_c = pjUnescape_chars[pjUnescape_i]
    if pjUnescape_c != "\\"
        pjUnescape_out += pjUnescape_c
        pjUnescape_i += 1
        continue
    end
    if pjUnescape_i + 1 >= pjUnescape_chars.length()
        pjUnescape_out += "\\"
        pjUnescape_i += 1
        continue
    end
    pjUnescape_next = pjUnescape_chars[pjUnescape_i + 1]
    if pjUnescape_next == "\""
        pjUnescape_out += "\""
        pjUnescape_i += 2
    else if pjUnescape_next == "\\"
        pjUnescape_out += "\\"
        pjUnescape_i += 2
    else if pjUnescape_next == "n"
        pjUnescape_out += "\n"
        pjUnescape_i += 2
    else if pjUnescape_next == "r"
        pjUnescape_out += fromCharCode(13)
        pjUnescape_i += 2
    else if pjUnescape_next == "t"
        pjUnescape_out += "\t"
        pjUnescape_i += 2
    else if pjUnescape_next == "u"
        pjUnescape_digits = ""
        pjUnescape_j = pjUnescape_i + 2
        while pjUnescape_j < pjUnescape_chars.length() and pjUnescape_j < pjUnescape_i + 6
        pjUnescape_digits += pjUnescape_chars[pjUnescape_j]
        pjUnescape_j += 1
    end
    pjUnescape_code = pjHexValue(pjUnescape_digits)
    if pjUnescape_code >= 0 and pjIsScalar(pjUnescape_code)
        pjUnescape_out += fromCharCode(pjUnescape_code)
    else
        pjUnescape_out += "\\u"
        pjUnescape_out += pjUnescape_digits
    end
    pjUnescape_i = pjUnescape_j
else
    pjUnescape_out += "\\"
    pjUnescape_out += pjUnescape_next
    pjUnescape_i += 2
end
end
return pjUnescape_out
end
$- Trim, strip one pair of surrounding double quotes, then unescape. -$
function pjParseValue(pjParseValue_raw)
    pjParseValue_trimmed = pjParseValue_raw.trim()
    if pjParseValue_trimmed.length() >= 2 and pjParseValue_trimmed.startsWith("\"") and pjParseValue_trimmed.endsWith("\"")
        return pjUnescape(pjParseValue_trimmed.slice(1, pjParseValue_trimmed.length() - 1))
    end
    return pjParseValue_trimmed
end
$- Parse `.emc` text into `{root: object, sections: object}`. Values are read
   as strings; bare numbers, booleans and null keep their textual form. -$
function pjParse(pjParse_text)
    if isString(pjParse_text) == false
        assert(false, "Type mismatch: expected a string as the manifest text for project.parse, found " + type(pjParse_text))
    end
    pjParse_root = {}
    pjParse_sections = {}
    pjParse_current = null
    pjParse_lines = pjParse_text.lines()
    pjParse_i = 0
    while pjParse_i < pjParse_lines.length()
    pjParse_line = pjParse_lines[pjParse_i].trim()
    if pjParse_line == "" or pjParse_line.startsWith("#")
        pjParse_i += 1
        continue
    end
    if pjParse_line.startsWith("[") and pjParse_line.endsWith("]")
        pjParse_name = pjParse_line.slice(1, pjParse_line.length() - 1).trim()
        if pjParse_sections.has(pjParse_name) == false
            pjParse_sections.set(pjParse_name, {})
        end
        pjParse_current = pjParse_name
        pjParse_i += 1
        continue
    end
    pjParse_equals = pjParse_line.indexOf("=")
    if pjParse_equals >= 0
        pjParse_key = pjParse_line.slice(0, pjParse_equals).trim()
        pjParse_value = pjParseValue(pjParse_line.slice(pjParse_equals + 1))
        if pjParse_current == null
            pjParse_root.set(pjParse_key, pjParse_value)
        else
            pjParse_sections.get(pjParse_current).set(pjParse_key, pjParse_value)
        end
    end
    pjParse_i += 1
end
return {root: pjParse_root, sections: pjParse_sections}
end
$- Snapshot and validate the two objects of a parsed config. `op` is the native
   function name used in error messages (name, version, main or write). -$
function pjConfig(pjConfig_manifest, pjConfig_op)
    if isObject(pjConfig_manifest) == false
        assert(false, "Type mismatch: expected a project config object for project." + pjConfig_op + ", found " + type(pjConfig_manifest))
    end
    pjConfig_root = pjConfig_manifest.get("root")
    if isObject(pjConfig_root) == false
        if pjConfig_manifest.has("root")
            assert(false, "project." + pjConfig_op + " expects 'root' to be an object, found " + type(pjConfig_root))
        end
        assert(false, "project." + pjConfig_op + " expects a config with a 'root' object")
    end
    pjConfig_sections = pjConfig_manifest.get("sections")
    if isObject(pjConfig_sections) == false
        if pjConfig_manifest.has("sections")
            assert(false, "project." + pjConfig_op + " expects 'sections' to be an object, found " + type(pjConfig_sections))
        end
        assert(false, "project." + pjConfig_op + " expects a config with a 'sections' object")
    end
    for pjConfig_name in pjConfig_sections.keys()
        pjConfig_section = pjConfig_sections.get(pjConfig_name)
        if isObject(pjConfig_section) == false
            assert(false, "project." + pjConfig_op + " expects section '" + pjConfig_name + "' to be an object, found " + type(pjConfig_section))
        end
    end
    return {root: pjConfig_root, sections: pjConfig_sections}
end
function pjRootValue(pjRootValue_manifest, pjRootValue_op, pjRootValue_key)
    pjRootValue_parts = pjConfig(pjRootValue_manifest, pjRootValue_op)
    return pjRootValue_parts.get("root").get(pjRootValue_key)
end
function pjName(pjName_manifest)
    return pjRootValue(pjName_manifest, "name", "name")
end
function pjVersion(pjVersion_manifest)
    return pjRootValue(pjVersion_manifest, "version", "version")
end
function pjMain(pjMain_manifest)
    return pjRootValue(pjMain_manifest, "main", "main")
end
$- Rust `char::is_whitespace` (Unicode White_Space), used by the writer's name
   validation. Parsing itself uses `.trim()`, which has the same definition. -$
function pjIsWhitespaceCode(pjIsWhitespaceCode_n)
    if pjIsWhitespaceCode_n >= 9 and pjIsWhitespaceCode_n <= 13
        return true
    end
    if pjIsWhitespaceCode_n == 32 or pjIsWhitespaceCode_n == 133 or pjIsWhitespaceCode_n == 160 or pjIsWhitespaceCode_n == 5760
        return true
    end
    if pjIsWhitespaceCode_n >= 8192 and pjIsWhitespaceCode_n <= 8202
        return true
    end
    if pjIsWhitespaceCode_n == 8232 or pjIsWhitespaceCode_n == 8233 or pjIsWhitespaceCode_n == 8239 or pjIsWhitespaceCode_n == 8287 or pjIsWhitespaceCode_n == 12288
        return true
    end
    return false
end
$- Keys and section names must survive the parser unchanged. -$
function pjValidateName(pjValidateName_name, pjValidateName_what)
    pjValidateName_message = "Invalid " + pjValidateName_what + " '" + pjValidateName_name + "' for project.write"
    if pjValidateName_name == "" or pjValidateName_name.startsWith("#")
        assert(false, pjValidateName_message)
    end
    pjValidateName_chars = pjValidateName_name.chars()
    for pjValidateName_c in pjValidateName_chars
        if pjIsWhitespaceCode(charCode(pjValidateName_c)) or pjValidateName_c == "[" or pjValidateName_c == "]" or pjValidateName_c == "="
            assert(false, pjValidateName_message)
        end
    end
end
$- Quote a string value, escaping exactly the characters native writes. -$
function pjQuoted(pjQuoted_text)
    pjQuoted_out = "\""
    for pjQuoted_c in pjQuoted_text.chars()
        if pjQuoted_c == "\""
            pjQuoted_out += "\\\""
        else if pjQuoted_c == "\\"
            pjQuoted_out += "\\\\"
        else if pjQuoted_c == "\n"
            pjQuoted_out += "\\n"
        else if pjQuoted_c == fromCharCode(13)
            pjQuoted_out += "\\r"
        else if pjQuoted_c == "\t"
            pjQuoted_out += "\\t"
        else if charCode(pjQuoted_c) < 32
            pjQuoted_out += "\\u" + pjHex4(charCode(pjQuoted_c))
        else
            pjQuoted_out += pjQuoted_c
        end
    end
    return pjQuoted_out + "\""
end
$- One `key = value` line, including its trailing newline. -$
function pjWritePair(pjWritePair_key, pjWritePair_value)
    pjValidateName(pjWritePair_key, "manifest key")
    pjWritePair_kind = type(pjWritePair_value)
    if pjWritePair_kind == "string"
        return pjWritePair_key + " = " + pjQuoted(pjWritePair_value) + "\n"
    end
    if pjWritePair_kind == "number"
        if isNaN(pjWritePair_value) or pjWritePair_value > pow(10, 308) or pjWritePair_value < -pow(10, 308)
            assert(false, "Cannot write a non-finite number for key '" + pjWritePair_key + "'")
        end
        return pjWritePair_key + " = " + toString(pjWritePair_value) + "\n"
    end
    if pjWritePair_kind == "boolean" or pjWritePair_kind == "null"
        return pjWritePair_key + " = " + toString(pjWritePair_value) + "\n"
    end
    assert(false, "Cannot write a " + pjWritePair_kind + " for key '" + pjWritePair_key + "' in a manifest")
end
$- Serialize a manifest to `.emc` text. Native `project.write` takes a path as
   well; this pure function returns the text so callers can choose where to
   store it. Key and section order is the shared BTreeMap order. -$
function pjWrite(pjWrite_manifest)
    pjWrite_parts = pjConfig(pjWrite_manifest, "write")
    pjWrite_root = pjWrite_parts.get("root")
    pjWrite_sections = pjWrite_parts.get("sections")
    pjWrite_out = ""
    for pjWrite_key in pjWrite_root.keys()
        pjWrite_out += pjWritePair(pjWrite_key, pjWrite_root.get(pjWrite_key))
    end
    for pjWrite_name in pjWrite_sections.keys()
        pjValidateName(pjWrite_name, "section name")
        pjWrite_out += "[" + pjWrite_name + "]\n"
        pjWrite_fields = pjWrite_sections.get(pjWrite_name)
        for pjWrite_key in pjWrite_fields.keys()
            pjWrite_out += pjWritePair(pjWrite_key, pjWrite_fields.get(pjWrite_key))
        end
    end
    return pjWrite_out
end
$- Inline parity self-test. The native module is loaded only here and is never
   used by the implementation above. -$
function pjSelfTest()
    pjSelfTest_samples = ["", "name = \"Demo\"\nversion = \"1.0.0\"\nmain = \"main.enm\"\n", "# leading comment\n\n  name = \"  spaced  \"  \nbare = plain\nsingle = 'quoted'\n\n[installer]\ninstall_dir = \"C:/em\"\nprojects_enabled = \"true\"\n", "name = \"Demo\"" + fromCharCode(13) + "\n\tversion = \"2.1\"" + fromCharCode(13) + "\n# comment" + fromCharCode(13) + "\n[notes]" + fromCharCode(13) + "\nbody = \"hello\"" + fromCharCode(13) + "\n", "a = \"quote \\\" slash \\\\ newline \\n return \\r tab \\t control \\u001f\"\n", "a = \"short \\u41 plus \\u+42 bad \\uZZZZ surrogate \\ud800 high \\u\{1f600\}\"\n", "[a]\nx = \"first\"\n[a]\nx = \"last\"\ny = \"a=b\"\n[ü]\nключ = \"значение\"\n", "dup = \"first\"\ndup = \"second\"\n[sec]\nq = \"# not a comment\"\n", "name = \"\\u00e9\\u263a\"\nx = \"" + fromCharCode(1) + "☺\"\n"]
    pjSelfTest_path = os.tempDir() + "/lib_project_selftest_" + os.pid() + ".emc"
    pjSelfTest_i = 0
    while pjSelfTest_i < pjSelfTest_samples.length()
    pjSelfTest_text = pjSelfTest_samples[pjSelfTest_i]
    pjSelfTest_pure = pjParse(pjSelfTest_text)
    pjSelfTest_native = project.parse(pjSelfTest_text)
    assert(jsonEncode(pjSelfTest_pure) == jsonEncode(pjSelfTest_native), "pjParse mismatch for sample")
    for pjSelfTest_key in ["name", "version", "main"]
        if pjSelfTest_key == "name"
            assert(jsonEncode(pjName(pjSelfTest_pure)) == jsonEncode(project.name(pjSelfTest_native)), "pjName mismatch for sample")
        else if pjSelfTest_key == "version"
            assert(jsonEncode(pjVersion(pjSelfTest_pure)) == jsonEncode(project.version(pjSelfTest_native)), "pjVersion mismatch for sample")
        else
            assert(jsonEncode(pjMain(pjSelfTest_pure)) == jsonEncode(project.main(pjSelfTest_native)), "pjMain mismatch for sample")
        end
    end
    assert(project.write(pjSelfTest_path, pjSelfTest_native), "project.write failed for sample")
    pjSelfTest_expected = readFile(pjSelfTest_path)
    assert(pjWrite(pjSelfTest_pure) == pjSelfTest_expected, "pjWrite mismatch for sample")
    assert(jsonEncode(pjParse(pjSelfTest_expected)) == jsonEncode(project.parse(pjSelfTest_expected)), "round trip mismatch for sample")
    pjSelfTest_i += 1
end
pjSelfTest_manifest = {root: {z: 3, name: "Demo", enabled: true, nothing: null, big: 100000000000000000000, small: 0.00001, tricky: "quote \" slash \\ newline \n return " + fromCharCode(13) + " tab \t control " + fromCharCode(31) + " unicode ☺", unicode: "é☺"}, sections: {alpha: {b: "two", a: 1}, empty: {}}}
assert(project.write(pjSelfTest_path, pjSelfTest_manifest), "project.write failed for mixed manifest")
pjSelfTest_expected = readFile(pjSelfTest_path)
assert(pjWrite(pjSelfTest_manifest) == pjSelfTest_expected, "pjWrite mismatch for mixed manifest")
assert(jsonEncode(pjParse(pjSelfTest_expected)) == jsonEncode(project.parse(pjSelfTest_expected)), "mixed manifest round trip mismatch")
deleteFile(pjSelfTest_path)
end
$- === inlined selfhost/lib_modules.enm === -$
$- Pure Englishmen implementations of the native `string` and `json` modules.

   This file is self-contained: it never imports another `.enm` file and every
   globally visible helper is prefixed with `lm`. `lmStringModule()` and
   `lmJsonModule()` return ordinary objects whose keys are native-style member
   names and whose values are Englishmen functions. `lmAllModules()` bundles
   both objects for the round-3 import bridge.

   Optional native arguments are passed as `null` because Englishmen functions
   have fixed arity. For example `string.slice(text, 1, null)` means the same
   thing as native `string.slice(text, 1)`, and `string.pad(text, 5, null,
   null)` uses the default fill and alignment.

   Native `string` and `json` modules are imported only inside the self-test
   guard at the bottom, where they act as reference oracles. The guard itself
   uses the `env` builtin rather than importing `os`.
-$
$- ---------------------------------------------------------------------------
   Shared argument helpers
   --------------------------------------------------------------------------- -$
function lmText(lmText_value)
    assert(type(lmText_value) == "string", "Expected a string")
    return lmText_value
end
function lmFinite(lmFinite_value)
    if type(lmFinite_value) != "number"
        return false
    end
    if isNaN(lmFinite_value)
        return false
    end
    return lmFinite_value <=  and lmFinite_value >= -
end
function lmWhole(lmWhole_value)
    if not lmFinite(lmWhole_value)
        return false
    end
    return floor(lmWhole_value) == lmWhole_value
end
function lmIndex(lmIndex_value)
    if not lmWhole(lmIndex_value) or lmIndex_value < 0
        return false
    end
    return true
end
function lmChars(lmChars_source)
    return split(lmChars_source, "")
end
function lmByteLength(lmByteLength_source)
    lmByteLength_chars = lmChars(lmByteLength_source)
    lmByteLength_total = 0
    lmByteLength_i = 0
    while lmByteLength_i < len(lmByteLength_chars)
    lmByteLength_code = charCode(lmByteLength_chars[lmByteLength_i])
    if lmByteLength_code <= 127
        lmByteLength_total += 1
    else if lmByteLength_code <= 2047
        lmByteLength_total += 2
    else if lmByteLength_code <= 65535
        lmByteLength_total += 3
    else
        lmByteLength_total += 4
    end
    lmByteLength_i += 1
end
return lmByteLength_total
end
function lmClampIndex(lmClampIndex_length, lmClampIndex_value)
    if not lmFinite(lmClampIndex_value)
        if lmClampIndex_value < 0
            return 0
        end
        return lmClampIndex_length
    end
    if lmClampIndex_value < 0
        lmClampIndex_resolved = lmClampIndex_length - floor(-lmClampIndex_value)
        if lmClampIndex_resolved < 0
            return 0
        end
        return lmClampIndex_resolved
    end
    lmClampIndex_resolved = floor(lmClampIndex_value)
    if lmClampIndex_resolved > lmClampIndex_length
        return lmClampIndex_length
    end
    return lmClampIndex_resolved
end
function lmSliceChars(lmSliceChars_source, lmSliceChars_from, lmSliceChars_to)
    lmSliceChars_chars = lmChars(lmSliceChars_source)
    if lmSliceChars_to < lmSliceChars_from
        lmSliceChars_to = lmSliceChars_from
    end
    return join(slice(lmSliceChars_chars, lmSliceChars_from, lmSliceChars_to), "")
end
function lmAsciiDigit(lmAsciiDigit_char)
    lmAsciiDigit_code = charCode(lmAsciiDigit_char)
    return lmAsciiDigit_code >= 48 and lmAsciiDigit_code <= 57
end
function lmNumericText(lmNumericText_source)
    lmNumericText_chars = lmChars(lmNumericText_source)
    lmNumericText_size = len(lmNumericText_chars)
    lmNumericText_pos = 0
    if lmNumericText_size == 0
        return false
    end
    if lmNumericText_chars[0] == "+" or lmNumericText_chars[0] == "-"
        lmNumericText_pos = 1
    end
    lmNumericText_before = 0
    lmNumericText_after = 0
    lmNumericText_dot = false
    while lmNumericText_pos < lmNumericText_size
    lmNumericText_char = lmNumericText_chars[lmNumericText_pos]
    if lmAsciiDigit(lmNumericText_char)
        if lmNumericText_dot
            lmNumericText_after += 1
        else
            lmNumericText_before += 1
        end
        lmNumericText_pos += 1
        continue
    end
    if lmNumericText_char == "." and not lmNumericText_dot
        lmNumericText_dot = true
        lmNumericText_pos += 1
        continue
    end
    if lmNumericText_char == "e" or lmNumericText_char == "E"
        lmNumericText_pos += 1
        if lmNumericText_pos < lmNumericText_size
            if lmNumericText_chars[lmNumericText_pos] == "+" or lmNumericText_chars[lmNumericText_pos] == "-"
                lmNumericText_pos += 1
            end
        end
        lmNumericText_exp = 0
        while lmNumericText_pos < lmNumericText_size
        if not lmAsciiDigit(lmNumericText_chars[lmNumericText_pos])
            return false
        end
        lmNumericText_exp += 1
        lmNumericText_pos += 1
    end
    if lmNumericText_exp == 0
        return false
    end
    break
end
return false
end
if lmNumericText_before + lmNumericText_after == 0
    return false
end
return lmNumericText_pos == lmNumericText_size
end
function lmRepeatText(lmRepeatText_source, lmRepeatText_count)
    lmRepeatText_out = ""
    lmRepeatText_i = 0
    while lmRepeatText_i < lmRepeatText_count
    lmRepeatText_out += lmRepeatText_source
    lmRepeatText_i += 1
end
return lmRepeatText_out
end
function lmRepeatChar(lmRepeatChar_char, lmRepeatChar_count)
    return lmRepeatText(lmRepeatChar_char, lmRepeatChar_count)
end
function lmIsUpperChar(lmIsUpperChar_char)
    return lmIsUpperChar_char == upper(lmIsUpperChar_char) and lower(lmIsUpperChar_char) != lmIsUpperChar_char
end
function lmIsLowerChar(lmIsLowerChar_char)
    return lmIsLowerChar_char == lower(lmIsLowerChar_char) and upper(lmIsLowerChar_char) != lmIsLowerChar_char
end
$- ---------------------------------------------------------------------------
   String module functions
   --------------------------------------------------------------------------- -$
function lmStringLength(lmStringLength_source)
    return len(lmText(lmStringLength_source))
end
function lmStringUpper(lmStringUpper_source)
    return upper(lmText(lmStringUpper_source))
end
function lmStringLower(lmStringLower_source)
    return lower(lmText(lmStringLower_source))
end
function lmStringTrim(lmStringTrim_source)
    return trim(lmText(lmStringTrim_source))
end
function lmStringSplit(lmStringSplit_source, lmStringSplit_separator)
    lmStringSplit_text = lmText(lmStringSplit_source)
    if lmStringSplit_separator == null
        return lmChars(lmStringSplit_text)
    end
    lmStringSplit_sep = lmText(lmStringSplit_separator)
    if lmStringSplit_sep == ""
        return lmChars(lmStringSplit_text)
    end
    return split(lmStringSplit_text, lmStringSplit_sep)
end
function lmStringJoin(lmStringJoin_items, lmStringJoin_separator)
    assert(type(lmStringJoin_items) == "array", "Expected an array for join")
    if lmStringJoin_separator == null
        return join(lmStringJoin_items, "")
    end
    return join(lmStringJoin_items, lmText(lmStringJoin_separator))
end
function lmStringContains(lmStringContains_source, lmStringContains_needle)
    return contains(lmText(lmStringContains_source), lmText(lmStringContains_needle))
end
function lmStringStartsWith(lmStringStartsWith_source, lmStringStartsWith_prefix)
    return startsWith(lmText(lmStringStartsWith_source), lmText(lmStringStartsWith_prefix))
end
function lmStringEndsWith(lmStringEndsWith_source, lmStringEndsWith_suffix)
    return endsWith(lmText(lmStringEndsWith_source), lmText(lmStringEndsWith_suffix))
end
function lmStringReplace(lmStringReplace_source, lmStringReplace_old, lmStringReplace_new)
    return replace(lmText(lmStringReplace_source), lmText(lmStringReplace_old), lmText(lmStringReplace_new))
end
function lmStringReplaceAll(lmStringReplaceAll_source, lmStringReplaceAll_old, lmStringReplaceAll_new)
    return lmStringReplace(lmStringReplaceAll_source, lmStringReplaceAll_old, lmStringReplaceAll_new)
end
function lmStringSlice(lmStringSlice_source, lmStringSlice_start, lmStringSlice_end)
    lmStringSlice_text = lmText(lmStringSlice_source)
    lmStringSlice_len = len(lmStringSlice_text)
    if lmStringSlice_start == null
        lmStringSlice_start = 0
    end
    if lmStringSlice_end == null
        lmStringSlice_end = lmStringSlice_len
    end
    assert(type(lmStringSlice_start) == "number" and type(lmStringSlice_end) == "number", "string.slice expects numeric bounds")
    lmStringSlice_from = lmClampIndex(lmStringSlice_len, lmStringSlice_start)
    lmStringSlice_to = lmClampIndex(lmStringSlice_len, lmStringSlice_end)
    return lmSliceChars(lmStringSlice_text, lmStringSlice_from, lmStringSlice_to)
end
function lmStringSubstring(lmStringSubstring_source, lmStringSubstring_start, lmStringSubstring_end)
    lmStringSubstring_text = lmText(lmStringSubstring_source)
    lmStringSubstring_len = len(lmStringSubstring_text)
    assert(lmIndex(lmStringSubstring_start), "string.substring expects a non-negative whole start")
    if lmStringSubstring_end == null
        lmStringSubstring_end = lmStringSubstring_len
    end
    assert(lmIndex(lmStringSubstring_end), "string.substring expects a non-negative whole end")
    assert(lmStringSubstring_start <= lmStringSubstring_end and lmStringSubstring_end <= lmStringSubstring_len, "string.substring expects 0 <= start <= end <= length")
    return lmSliceChars(lmStringSubstring_text, lmStringSubstring_start, lmStringSubstring_end)
end
function lmStringIndexOf(lmStringIndexOf_source, lmStringIndexOf_needle)
    lmStringIndexOf_text = lmText(lmStringIndexOf_source)
    lmStringIndexOf_find = lmText(lmStringIndexOf_needle)
    if lmStringIndexOf_find == ""
        return 0
    end
    lmStringIndexOf_chars = lmChars(lmStringIndexOf_find)
    lmStringIndexOf_needleLen = len(lmStringIndexOf_chars)
    lmStringIndexOf_last = len(lmStringIndexOf_text) - lmStringIndexOf_needleLen
    lmStringIndexOf_i = 0
    while lmStringIndexOf_i <= lmStringIndexOf_last
    if lmSliceChars(lmStringIndexOf_text, lmStringIndexOf_i, lmStringIndexOf_i + lmStringIndexOf_needleLen) == lmStringIndexOf_find
        return lmStringIndexOf_i
    end
    lmStringIndexOf_i += 1
end
return -1
end
function lmStringLastIndexOf(lmStringLastIndexOf_source, lmStringLastIndexOf_needle)
    lmStringLastIndexOf_text = lmText(lmStringLastIndexOf_source)
    lmStringLastIndexOf_find = lmText(lmStringLastIndexOf_needle)
    if lmStringLastIndexOf_find == ""
        return len(lmStringLastIndexOf_text)
    end
    lmStringLastIndexOf_chars = lmChars(lmStringLastIndexOf_find)
    lmStringLastIndexOf_needleLen = len(lmStringLastIndexOf_chars)
    lmStringLastIndexOf_last = len(lmStringLastIndexOf_text) - lmStringLastIndexOf_needleLen
    lmStringLastIndexOf_found = -1
    lmStringLastIndexOf_i = 0
    while lmStringLastIndexOf_i <= lmStringLastIndexOf_last
    if lmSliceChars(lmStringLastIndexOf_text, lmStringLastIndexOf_i, lmStringLastIndexOf_i + lmStringLastIndexOf_needleLen) == lmStringLastIndexOf_find
        lmStringLastIndexOf_found = lmStringLastIndexOf_i
    end
    lmStringLastIndexOf_i += 1
end
return lmStringLastIndexOf_found
end
function lmStringCharAt(lmStringCharAt_source, lmStringCharAt_index)
    lmStringCharAt_text = lmText(lmStringCharAt_source)
    assert(lmIndex(lmStringCharAt_index), "string.charAt expects a non-negative whole index")
    lmStringCharAt_chars = lmChars(lmStringCharAt_text)
    assert(lmStringCharAt_index < len(lmStringCharAt_chars), "string.charAt index is out of range")
    return lmStringCharAt_chars[lmStringCharAt_index]
end
function lmStringToNumber(lmStringToNumber_source)
    lmStringToNumber_text = trim(lmText(lmStringToNumber_source))
    if not lmNumericText(lmStringToNumber_text)
        return null
    end
    lmStringToNumber_value = parseFloat(lmStringToNumber_text)
    if not lmFinite(lmStringToNumber_value)
        return null
    end
    return lmStringToNumber_value
end
function lmStringCapitalize(lmStringCapitalize_source)
    lmStringCapitalize_text = lmText(lmStringCapitalize_source)
    if lmStringCapitalize_text == ""
        return ""
    end
    lmStringCapitalize_chars = lmChars(lmStringCapitalize_text)
    return upper(lmStringCapitalize_chars[0]) + lmSliceChars(lmStringCapitalize_text, 1, len(lmStringCapitalize_chars))
end
function lmStringTitleCase(lmStringTitleCase_source)
    lmStringTitleCase_text = lmText(lmStringTitleCase_source)
    lmStringTitleCase_chars = lmChars(lmStringTitleCase_text)
    lmStringTitleCase_out = ""
    lmStringTitleCase_start = true
    lmStringTitleCase_i = 0
    while lmStringTitleCase_i < len(lmStringTitleCase_chars)
    lmStringTitleCase_char = lmStringTitleCase_chars[lmStringTitleCase_i]
    if lmStringTitleCase_char.isBlank()
        lmStringTitleCase_out += lmStringTitleCase_char
        lmStringTitleCase_start = true
    else if lmStringTitleCase_start
        lmStringTitleCase_out += upper(lmStringTitleCase_char)
        lmStringTitleCase_start = false
    else
        lmStringTitleCase_out += lower(lmStringTitleCase_char)
    end
    lmStringTitleCase_i += 1
end
return lmStringTitleCase_out
end
function lmStringReverse(lmStringReverse_source)
    lmStringReverse_text = lmText(lmStringReverse_source)
    lmStringReverse_chars = lmChars(lmStringReverse_text)
    lmStringReverse_out = ""
    lmStringReverse_i = len(lmStringReverse_chars) - 1
    while lmStringReverse_i >= 0
    lmStringReverse_out += lmStringReverse_chars[lmStringReverse_i]
    lmStringReverse_i -= 1
end
return lmStringReverse_out
end
function lmStringRepeat(lmStringRepeat_source, lmStringRepeat_count)
    lmStringRepeat_text = lmText(lmStringRepeat_source)
    assert(lmIndex(lmStringRepeat_count), "string.repeat expects a non-negative whole count")
    assert(lmByteLength(lmStringRepeat_text) * lmStringRepeat_count <= 10000000, "string.repeat would produce a string that is too long")
    return lmRepeatText(lmStringRepeat_text, lmStringRepeat_count)
end
function lmStringPad(lmStringPad_source, lmStringPad_width, lmStringPad_fill, lmStringPad_align)
    lmStringPad_text = lmText(lmStringPad_source)
    assert(lmIndex(lmStringPad_width), "string.pad expects a non-negative whole width")
    lmStringPad_fillText = " "
    if lmStringPad_fill != null
        lmStringPad_fillText = lmText(lmStringPad_fill)
    end
    lmStringPad_unit = " "
    if lmStringPad_fillText != ""
        lmStringPad_unit = lmChars(lmStringPad_fillText)[0]
    end
    lmStringPad_alignment = "left"
    if lmStringPad_align != null
        lmStringPad_alignment = lmText(lmStringPad_align)
    end
    lmStringPad_current = len(lmStringPad_text)
    if lmStringPad_current >= lmStringPad_width
        return lmStringPad_text
    end
    lmStringPad_missing = lmStringPad_width - lmStringPad_current
    if lmStringPad_alignment == "left"
        return lmStringPad_text + lmRepeatChar(lmStringPad_unit, lmStringPad_missing)
    end
    if lmStringPad_alignment == "right"
        return lmRepeatChar(lmStringPad_unit, lmStringPad_missing) + lmStringPad_text
    end
    if lmStringPad_alignment != "both" and lmStringPad_alignment != "center"
        assert(false, "string.pad alignment must be 'left', 'right' or 'center'")
    end
    lmStringPad_left = floor(lmStringPad_missing / 2)
    if lmStringPad_missing % 2 == 1
        lmStringPad_left += 1
    end
    lmStringPad_right = lmStringPad_missing - lmStringPad_left
    return lmRepeatChar(lmStringPad_unit, lmStringPad_left) + lmStringPad_text + lmRepeatChar(lmStringPad_unit, lmStringPad_right)
end
function lmStringPadLeft(lmStringPadLeft_source, lmStringPadLeft_width, lmStringPadLeft_fill)
    lmStringPadLeft_text = lmText(lmStringPadLeft_source)
    assert(lmIndex(lmStringPadLeft_width), "padLeft expects a non-negative whole width")
    lmStringPadLeft_target = lmStringPadLeft_width
    if lmStringPadLeft_target > 100000
        lmStringPadLeft_target = 100000
    end
    lmStringPadLeft_missing = lmStringPadLeft_target - len(lmStringPadLeft_text)
    if lmStringPadLeft_missing <= 0
        return lmStringPadLeft_text
    end
    lmStringPadLeft_unit = " "
    if lmStringPadLeft_fill != null
        lmStringPadLeft_unit = lmText(lmStringPadLeft_fill)
    end
    if lmStringPadLeft_unit == ""
        lmStringPadLeft_unit = " "
    end
    lmStringPadLeft_padding = ""
    while len(lmStringPadLeft_padding) < lmStringPadLeft_missing
    lmStringPadLeft_padding += lmStringPadLeft_unit
end
return lmSliceChars(lmStringPadLeft_padding, 0, lmStringPadLeft_missing) + lmStringPadLeft_text
end
function lmStringPadRight(lmStringPadRight_source, lmStringPadRight_width, lmStringPadRight_fill)
    lmStringPadRight_text = lmText(lmStringPadRight_source)
    assert(lmIndex(lmStringPadRight_width), "padRight expects a non-negative whole width")
    lmStringPadRight_target = lmStringPadRight_width
    if lmStringPadRight_target > 100000
        lmStringPadRight_target = 100000
    end
    lmStringPadRight_missing = lmStringPadRight_target - len(lmStringPadRight_text)
    if lmStringPadRight_missing <= 0
        return lmStringPadRight_text
    end
    lmStringPadRight_unit = " "
    if lmStringPadRight_fill != null
        lmStringPadRight_unit = lmText(lmStringPadRight_fill)
    end
    if lmStringPadRight_unit == ""
        lmStringPadRight_unit = " "
    end
    lmStringPadRight_padding = ""
    while len(lmStringPadRight_padding) < lmStringPadRight_missing
    lmStringPadRight_padding += lmStringPadRight_unit
end
return lmStringPadRight_text + lmSliceChars(lmStringPadRight_padding, 0, lmStringPadRight_missing)
end
function lmStringIsDigit(lmStringIsDigit_source)
    lmStringIsDigit_chars = lmChars(lmText(lmStringIsDigit_source))
    if len(lmStringIsDigit_chars) == 0
        return false
    end
    lmStringIsDigit_i = 0
    while lmStringIsDigit_i < len(lmStringIsDigit_chars)
    if not lmAsciiDigit(lmStringIsDigit_chars[lmStringIsDigit_i])
        return false
    end
    lmStringIsDigit_i += 1
end
return true
end
function lmStringIsAlpha(lmStringIsAlpha_source)
    lmStringIsAlpha_chars = lmChars(lmText(lmStringIsAlpha_source))
    if len(lmStringIsAlpha_chars) == 0
        return false
    end
    lmStringIsAlpha_i = 0
    while lmStringIsAlpha_i < len(lmStringIsAlpha_chars)
    if not lmStringIsAlpha_chars[lmStringIsAlpha_i].isAlpha()
        return false
    end
    lmStringIsAlpha_i += 1
end
return true
end
function lmStringIsAlphanumeric(lmStringIsAlphanumeric_source)
    lmStringIsAlphanumeric_chars = lmChars(lmText(lmStringIsAlphanumeric_source))
    if len(lmStringIsAlphanumeric_chars) == 0
        return false
    end
    lmStringIsAlphanumeric_i = 0
    while lmStringIsAlphanumeric_i < len(lmStringIsAlphanumeric_chars)
    lmStringIsAlphanumeric_char = lmStringIsAlphanumeric_chars[lmStringIsAlphanumeric_i]
    if not lmStringIsAlphanumeric_char.isAlpha() and not lmAsciiDigit(lmStringIsAlphanumeric_char)
        return false
    end
    lmStringIsAlphanumeric_i += 1
end
return true
end
function lmStringIsWhitespace(lmStringIsWhitespace_source)
    lmStringIsWhitespace_chars = lmChars(lmText(lmStringIsWhitespace_source))
    if len(lmStringIsWhitespace_chars) == 0
        return false
    end
    lmStringIsWhitespace_i = 0
    while lmStringIsWhitespace_i < len(lmStringIsWhitespace_chars)
    if not lmStringIsWhitespace_chars[lmStringIsWhitespace_i].isBlank()
        return false
    end
    lmStringIsWhitespace_i += 1
end
return true
end
function lmStringIsEmpty(lmStringIsEmpty_source)
    return len(lmText(lmStringIsEmpty_source)) == 0
end
function lmStringIsBlank(lmStringIsBlank_source)
    lmStringIsBlank_chars = lmChars(lmText(lmStringIsBlank_source))
    lmStringIsBlank_i = 0
    while lmStringIsBlank_i < len(lmStringIsBlank_chars)
    if not lmStringIsBlank_chars[lmStringIsBlank_i].isBlank()
        return false
    end
    lmStringIsBlank_i += 1
end
return true
end
function lmStringLines(lmStringLines_source)
    lmStringLines_text = lmText(lmStringLines_source)
    if lmStringLines_text == ""
        return []
    end
    lmStringLines_raw = split(lmStringLines_text, "\n")
    lmStringLines_count = len(lmStringLines_raw)
    lmStringLines_dropLast = lmStringLines_count > 0 and lmStringLines_raw[lmStringLines_count - 1] == "" and lmStringLines_text.endsWith("\n")
    lmStringLines_out = []
    lmStringLines_i = 0
    while lmStringLines_i < lmStringLines_count
    lmStringLines_part = lmStringLines_raw[lmStringLines_i]
    if lmStringLines_i < lmStringLines_count - 1 and lmStringLines_part.endsWith("\n")
        lmStringLines_part = lmSliceChars(lmStringLines_part, 0, len(lmStringLines_part) - 1)
    end
    if not (lmStringLines_dropLast and lmStringLines_i == lmStringLines_count - 1)
        lmStringLines_out.add(lmStringLines_part)
    end
    lmStringLines_i += 1
end
return lmStringLines_out
end
function lmStringChars(lmStringChars_source)
    return lmChars(lmText(lmStringChars_source))
end
function lmStringSwapCase(lmStringSwapCase_source)
    lmStringSwapCase_chars = lmChars(lmText(lmStringSwapCase_source))
    lmStringSwapCase_out = ""
    lmStringSwapCase_i = 0
    while lmStringSwapCase_i < len(lmStringSwapCase_chars)
    lmStringSwapCase_char = lmStringSwapCase_chars[lmStringSwapCase_i]
    if lmIsUpperChar(lmStringSwapCase_char)
        lmStringSwapCase_out += lower(lmStringSwapCase_char)
    else if lmIsLowerChar(lmStringSwapCase_char)
        lmStringSwapCase_out += upper(lmStringSwapCase_char)
    else
        lmStringSwapCase_out += lmStringSwapCase_char
    end
    lmStringSwapCase_i += 1
end
return lmStringSwapCase_out
end
function lmStringTruncate(lmStringTruncate_source, lmStringTruncate_width, lmStringTruncate_suffix)
    lmStringTruncate_text = lmText(lmStringTruncate_source)
    assert(lmIndex(lmStringTruncate_width), "truncate expects a non-negative whole width")
    lmStringTruncate_target = lmStringTruncate_width
    if lmStringTruncate_target > 100000
        lmStringTruncate_target = 100000
    end
    if len(lmStringTruncate_text) <= lmStringTruncate_target
        return lmStringTruncate_text
    end
    lmStringTruncate_tail = "..."
    if lmStringTruncate_suffix != null
        lmStringTruncate_tail = lmText(lmStringTruncate_suffix)
    end
    lmStringTruncate_chars = lmChars(lmStringTruncate_text)
    lmStringTruncate_tailChars = lmChars(lmStringTruncate_tail)
    lmStringTruncate_kept = lmStringTruncate_target - len(lmStringTruncate_tailChars)
    if lmStringTruncate_kept < 0
        lmStringTruncate_kept = 0
    end
    lmStringTruncate_out = lmSliceChars(lmStringTruncate_text, 0, lmStringTruncate_kept)
    lmStringTruncate_left = lmStringTruncate_target - lmStringTruncate_kept
    lmStringTruncate_tailI = 0
    while lmStringTruncate_tailI < lmStringTruncate_left and lmStringTruncate_tailI < len(lmStringTruncate_tailChars)
    lmStringTruncate_out += lmStringTruncate_tailChars[lmStringTruncate_tailI]
    lmStringTruncate_tailI += 1
end
return lmStringTruncate_out
end
function lmStringModule()
    return {length: lmStringLength, upper: lmStringUpper, lower: lmStringLower, trim: lmStringTrim, split: lmStringSplit, join: lmStringJoin, contains: lmStringContains, startsWith: lmStringStartsWith, endsWith: lmStringEndsWith, replace: lmStringReplace, replaceAll: lmStringReplaceAll, slice: lmStringSlice, substring: lmStringSubstring, indexOf: lmStringIndexOf, lastIndexOf: lmStringLastIndexOf, charAt: lmStringCharAt, toNumber: lmStringToNumber, capitalize: lmStringCapitalize, titleCase: lmStringTitleCase, reverse: lmStringReverse, repeat: lmStringRepeat, pad: lmStringPad, padLeft: lmStringPadLeft, padRight: lmStringPadRight, isDigit: lmStringIsDigit, isAlpha: lmStringIsAlpha, isAlphanumeric: lmStringIsAlphanumeric, isWhitespace: lmStringIsWhitespace, isEmpty: lmStringIsEmpty, isBlank: lmStringIsBlank, lines: lmStringLines, chars: lmStringChars, swapCase: lmStringSwapCase, truncate: lmStringTruncate}
end
$- ---------------------------------------------------------------------------
   JSON encoding
   --------------------------------------------------------------------------- -$
function lmJsonHexDigit(lmJsonHexDigit_n)
    lmJsonHexDigit_digits = "0123456789abcdef"
    if lmJsonHexDigit_n < 0 or lmJsonHexDigit_n > 15
        return -1
    end
    return lmJsonHexDigit_digits[lmJsonHexDigit_n]
end
function lmJsonHex4(lmJsonHex4_n)
    lmJsonHex4_out = ""
    lmJsonHex4_i = 3
    while lmJsonHex4_i >= 0
    lmJsonHex4_out = lmJsonHexDigit(floor(lmJsonHex4_n / pow(16, lmJsonHex4_i)) % 16) + lmJsonHex4_out
    lmJsonHex4_i -= 1
end
return lmJsonHex4_out
end
function lmJsonQuote(lmJsonQuote_source)
    lmJsonQuote_chars = lmChars(lmText(lmJsonQuote_source))
    lmJsonQuote_out = "\""
    lmJsonQuote_i = 0
    while lmJsonQuote_i < len(lmJsonQuote_chars)
    lmJsonQuote_char = lmJsonQuote_chars[lmJsonQuote_i]
    if lmJsonQuote_char == "\""
        lmJsonQuote_out += "\\\""
    else if lmJsonQuote_char == "\\"
        lmJsonQuote_out += "\\\\"
    else if lmJsonQuote_char == "\n"
        lmJsonQuote_out += "\\n"
    else if lmJsonQuote_char == "\n"
        lmJsonQuote_out += "\\r"
    else if lmJsonQuote_char == "\t"
        lmJsonQuote_out += "\\t"
    else if lmJsonQuote_char == ""
        lmJsonQuote_out += "\\b"
    else if lmJsonQuote_char == ""
        lmJsonQuote_out += "\\f"
    else if charCode(lmJsonQuote_char) < 32
        lmJsonQuote_out += "\\u00" + lmJsonHex4(charCode(lmJsonQuote_char))
    else
        lmJsonQuote_out += lmJsonQuote_char
    end
    lmJsonQuote_i += 1
end
return lmJsonQuote_out + "\""
end
function lmJsonEncodeInner(lmJsonEncodeInner_value, lmJsonEncodeInner_depth)
    if lmJsonEncodeInner_depth > 100
        assert(false, "JSON value is nested too deeply")
    end
    lmJsonEncodeInner_type = type(lmJsonEncodeInner_value)
    if lmJsonEncodeInner_type == "null"
        return "null"
    end
    if lmJsonEncodeInner_type == "boolean"
        if lmJsonEncodeInner_value
            return "true"
        end
        return "false"
    end
    if lmJsonEncodeInner_type == "number"
        assert(lmFinite(lmJsonEncodeInner_value), "Cannot encode a non-finite number as JSON")
        return toString(lmJsonEncodeInner_value)
    end
    if lmJsonEncodeInner_type == "string"
        return lmJsonQuote(lmJsonEncodeInner_value)
    end
    if lmJsonEncodeInner_type == "array"
        lmJsonEncodeInner_out = "["
        lmJsonEncodeInner_i = 0
        while lmJsonEncodeInner_i < len(lmJsonEncodeInner_value)
        if lmJsonEncodeInner_i > 0
            lmJsonEncodeInner_out += ","
        end
        lmJsonEncodeInner_out += lmJsonEncodeInner(lmJsonEncodeInner_value[lmJsonEncodeInner_i], lmJsonEncodeInner_depth + 1)
        lmJsonEncodeInner_i += 1
    end
    return lmJsonEncodeInner_out + "]"
end
if lmJsonEncodeInner_type == "object"
    lmJsonEncodeInner_out = "\{"
    lmJsonEncodeInner_keys = keys(lmJsonEncodeInner_value)
    lmJsonEncodeInner_i = 0
    while lmJsonEncodeInner_i < len(lmJsonEncodeInner_keys)
    if lmJsonEncodeInner_i > 0
        lmJsonEncodeInner_out += ","
    end
    lmJsonEncodeInner_key = lmJsonEncodeInner_keys[lmJsonEncodeInner_i]
    lmJsonEncodeInner_out += lmJsonQuote(lmJsonEncodeInner_key) + ":"
    lmJsonEncodeInner_out += lmJsonEncodeInner(lmJsonEncodeInner_value.get(lmJsonEncodeInner_key), lmJsonEncodeInner_depth + 1)
    lmJsonEncodeInner_i += 1
end
return lmJsonEncodeInner_out + "\}"
end
assert(false, "Cannot encode a " + lmJsonEncodeInner_type + " as JSON")
end
function lmJsonEncode(lmJsonEncode_value)
    return lmJsonEncodeInner(lmJsonEncode_value, 0)
end
$- ---------------------------------------------------------------------------
   JSON decoding
   --------------------------------------------------------------------------- -$
function lmJsonState(lmJsonState_text, lmJsonState_strict)
    return {chars: split(lmJsonState_text, ""), pos: 0, strict: lmJsonState_strict, error: ""}
end
function lmJsonFail(lmJsonFail_state, lmJsonFail_message)
    lmJsonFail_state.error = lmJsonFail_message
    if lmJsonFail_state.strict
        assert(false, lmJsonFail_message)
    end
    return null
end
function lmJsonSkipWs(lmJsonSkipWs_state)
    while lmJsonSkipWs_state.pos < len(lmJsonSkipWs_state.chars)
    lmJsonSkipWs_char = lmJsonSkipWs_state.chars[lmJsonSkipWs_state.pos]
    if lmJsonSkipWs_char != " " and lmJsonSkipWs_char != "\t" and lmJsonSkipWs_char != "\n" and lmJsonSkipWs_char != "\n"
        break
    end
    lmJsonSkipWs_state.pos += 1
end
end
function lmJsonTail(lmJsonTail_state)
    lmJsonTail_out = ""
    lmJsonTail_i = lmJsonTail_state.pos
    while lmJsonTail_i < len(lmJsonTail_state.chars)
    lmJsonTail_out += lmJsonTail_state.chars[lmJsonTail_i]
    lmJsonTail_i += 1
end
return lmJsonTail_out
end
function lmJsonConsumeLiteral(lmJsonConsumeLiteral_state, lmJsonConsumeLiteral_literal)
    if startsWith(lmJsonTail(lmJsonConsumeLiteral_state), lmJsonConsumeLiteral_literal)
        lmJsonConsumeLiteral_state.pos += len(lmJsonConsumeLiteral_literal)
        return true
    end
    return false
end
function lmJsonHexValue(lmJsonHexValue_char)
    lmJsonHexValue_digits = "0123456789abcdefABCDEF"
    lmJsonHexValue_i = 0
    while lmJsonHexValue_i < len(lmJsonHexValue_digits)
    if lmJsonHexValue_digits[lmJsonHexValue_i] == lmJsonHexValue_char
        if lmJsonHexValue_i < 16
            return lmJsonHexValue_i
        end
        return lmJsonHexValue_i - 6
    end
    lmJsonHexValue_i += 1
end
return -1
end
function lmJsonParseHex4(lmJsonParseHex4_state)
    if lmJsonParseHex4_state.pos + 4 > len(lmJsonParseHex4_state.chars)
        return lmJsonFail(lmJsonParseHex4_state, "Incomplete Unicode escape in JSON string")
    end
    lmJsonParseHex4_value = 0
    lmJsonParseHex4_i = 0
    while lmJsonParseHex4_i < 4
    lmJsonParseHex4_digit = lmJsonHexValue(lmJsonParseHex4_state.chars[lmJsonParseHex4_state.pos])
    if lmJsonParseHex4_digit < 0
        return lmJsonFail(lmJsonParseHex4_state, "Invalid Unicode escape in JSON string")
    end
    lmJsonParseHex4_value = lmJsonParseHex4_value * 16 + lmJsonParseHex4_digit
    lmJsonParseHex4_state.pos += 1
    lmJsonParseHex4_i += 1
end
return lmJsonParseHex4_value
end
function lmJsonParseString(lmJsonParseString_state)
    lmJsonParseString_state.pos += 1
    lmJsonParseString_out = ""
    while true
    if lmJsonParseString_state.pos >= len(lmJsonParseString_state.chars)
        return lmJsonFail(lmJsonParseString_state, "Unterminated JSON string")
    end
    lmJsonParseString_char = lmJsonParseString_state.chars[lmJsonParseString_state.pos]
    lmJsonParseString_state.pos += 1
    if lmJsonParseString_char == "\""
        return lmJsonParseString_out
    end
    if lmJsonParseString_char == "\\"
        if lmJsonParseString_state.pos >= len(lmJsonParseString_state.chars)
            return lmJsonFail(lmJsonParseString_state, "Unterminated JSON escape sequence")
        end
        lmJsonParseString_escape = lmJsonParseString_state.chars[lmJsonParseString_state.pos]
        lmJsonParseString_state.pos += 1
        if lmJsonParseString_escape == "\""
            lmJsonParseString_out += "\""
        else if lmJsonParseString_escape == "\\"
            lmJsonParseString_out += "\\"
        else if lmJsonParseString_escape == "/"
            lmJsonParseString_out += "/"
        else if lmJsonParseString_escape == "b"
            lmJsonParseString_out += ""
        else if lmJsonParseString_escape == "f"
            lmJsonParseString_out += ""
        else if lmJsonParseString_escape == "n"
            lmJsonParseString_out += "\n"
        else if lmJsonParseString_escape == "r"
            lmJsonParseString_out += "\n"
        else if lmJsonParseString_escape == "t"
            lmJsonParseString_out += "\t"
        else if lmJsonParseString_escape == "u"
            lmJsonParseString_code = lmJsonParseHex4(lmJsonParseString_state)
            if lmJsonParseString_state.error != ""
                return null
            end
            if lmJsonParseString_code >= 55296 and lmJsonParseString_code <= 57343
                if lmJsonParseString_code > 56319
                    return lmJsonFail(lmJsonParseString_state, "Expected a high surrogate in JSON string")
                end
                if lmJsonParseString_state.pos + 1 >= len(lmJsonParseString_state.chars) or lmJsonParseString_state.chars[lmJsonParseString_state.pos] != "\\" or lmJsonParseString_state.chars[lmJsonParseString_state.pos + 1] != "u"
                    return lmJsonFail(lmJsonParseString_state, "Expected a low surrogate in JSON string")
                end
                lmJsonParseString_state.pos += 2
                lmJsonParseString_low = lmJsonParseHex4(lmJsonParseString_state)
                if lmJsonParseString_state.error != ""
                    return null
                end
                if lmJsonParseString_low < 56320 or lmJsonParseString_low > 57343
                    return lmJsonFail(lmJsonParseString_state, "Invalid low surrogate in JSON string")
                end
                lmJsonParseString_code = 65536 + (lmJsonParseString_code - 55296) * 1024 + (lmJsonParseString_low - 56320)
            end
            if lmJsonParseString_code >= 55296 and lmJsonParseString_code <= 57343
                return lmJsonFail(lmJsonParseString_state, "Invalid Unicode escape in JSON string")
            end
            lmJsonParseString_out += fromCharCode(lmJsonParseString_code)
        else
            return lmJsonFail(lmJsonParseString_state, "Invalid JSON escape sequence")
        end
    else if charCode(lmJsonParseString_char) < 32
        return lmJsonFail(lmJsonParseString_state, "Control character in JSON string")
    else
        lmJsonParseString_out += lmJsonParseString_char
    end
end
end
function lmJsonValidNumber(lmJsonValidNumber_text)
    lmJsonValidNumber_chars = lmChars(lmJsonValidNumber_text)
    lmJsonValidNumber_size = len(lmJsonValidNumber_chars)
    lmJsonValidNumber_pos = 0
    if lmJsonValidNumber_size == 0
        return false
    end
    if lmJsonValidNumber_chars[0] == "-"
        lmJsonValidNumber_pos = 1
    end
    if lmJsonValidNumber_pos >= lmJsonValidNumber_size
        return false
    end
    if lmJsonValidNumber_chars[lmJsonValidNumber_pos] == "0"
        lmJsonValidNumber_pos += 1
        if lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
            return false
        end
    else if lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        while lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        lmJsonValidNumber_pos += 1
    end
else
    return false
end
if lmJsonValidNumber_pos < lmJsonValidNumber_size and lmJsonValidNumber_chars[lmJsonValidNumber_pos] == "."
    lmJsonValidNumber_pos += 1
    if lmJsonValidNumber_pos >= lmJsonValidNumber_size or not lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        return false
    end
    while lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
    lmJsonValidNumber_pos += 1
end
end
if lmJsonValidNumber_pos < lmJsonValidNumber_size
    lmJsonValidNumber_exp = lmJsonValidNumber_chars[lmJsonValidNumber_pos]
    if lmJsonValidNumber_exp == "e" or lmJsonValidNumber_exp == "E"
        lmJsonValidNumber_pos += 1
        if lmJsonValidNumber_pos < lmJsonValidNumber_size
            lmJsonValidNumber_sign = lmJsonValidNumber_chars[lmJsonValidNumber_pos]
            if lmJsonValidNumber_sign == "+" or lmJsonValidNumber_sign == "-"
                lmJsonValidNumber_pos += 1
            end
        end
        if lmJsonValidNumber_pos >= lmJsonValidNumber_size or not lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
            return false
        end
        while lmJsonValidNumber_pos < lmJsonValidNumber_size and lmAsciiDigit(lmJsonValidNumber_chars[lmJsonValidNumber_pos])
        lmJsonValidNumber_pos += 1
    end
end
end
return lmJsonValidNumber_pos == lmJsonValidNumber_size
end
function lmJsonParseNumber(lmJsonParseNumber_state)
    lmJsonParseNumber_start = lmJsonParseNumber_state.pos
    while lmJsonParseNumber_state.pos < len(lmJsonParseNumber_state.chars)
    lmJsonParseNumber_char = lmJsonParseNumber_state.chars[lmJsonParseNumber_state.pos]
    if lmAsciiDigit(lmJsonParseNumber_char) or lmJsonParseNumber_char == "-" or lmJsonParseNumber_char == "+" or lmJsonParseNumber_char == "." or lmJsonParseNumber_char == "e" or lmJsonParseNumber_char == "E"
        lmJsonParseNumber_state.pos += 1
        continue
    end
    break
end
lmJsonParseNumber_text = lmJsonTailSlice(lmJsonParseNumber_state, lmJsonParseNumber_start, lmJsonParseNumber_state.pos)
if not lmJsonValidNumber(lmJsonParseNumber_text)
    return lmJsonFail(lmJsonParseNumber_state, "Invalid JSON number '" + lmJsonParseNumber_text + "'")
end
return parseFloat(lmJsonParseNumber_text)
end
function lmJsonTailSlice(lmJsonTailSlice_state, lmJsonTailSlice_from, lmJsonTailSlice_to)
    return join(slice(lmJsonTailSlice_state.chars, lmJsonTailSlice_from, lmJsonTailSlice_to), "")
end
function lmJsonParseArray(lmJsonParseArray_state)
    lmJsonParseArray_state.pos += 1
    lmJsonParseArray_items = []
    lmJsonSkipWs(lmJsonParseArray_state)
    if lmJsonParseArray_state.pos < len(lmJsonParseArray_state.chars) and lmJsonParseArray_state.chars[lmJsonParseArray_state.pos] == "]"
        lmJsonParseArray_state.pos += 1
        return lmJsonParseArray_items
    end
    while true
    lmJsonSkipWs(lmJsonParseArray_state)
    lmJsonParseArray_value = lmJsonParseValue(lmJsonParseArray_state)
    if lmJsonParseArray_state.error != ""
        return null
    end
    lmJsonParseArray_items.add(lmJsonParseArray_value)
    lmJsonSkipWs(lmJsonParseArray_state)
    if lmJsonParseArray_state.pos >= len(lmJsonParseArray_state.chars)
        return lmJsonFail(lmJsonParseArray_state, "Expected ',' or ']' at position " + toString(lmJsonParseArray_state.pos))
    end
    lmJsonParseArray_char = lmJsonParseArray_state.chars[lmJsonParseArray_state.pos]
    lmJsonParseArray_state.pos += 1
    if lmJsonParseArray_char == "]"
        return lmJsonParseArray_items
    end
    if lmJsonParseArray_char != ","
        return lmJsonFail(lmJsonParseArray_state, "Expected ',' or ']' at position " + toString(lmJsonParseArray_state.pos - 1))
    end
end
end
function lmJsonParseObject(lmJsonParseObject_state)
    lmJsonParseObject_state.pos += 1
    lmJsonParseObject_fields = {}
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos < len(lmJsonParseObject_state.chars) and lmJsonParseObject_state.chars[lmJsonParseObject_state.pos] == "\}"
        lmJsonParseObject_state.pos += 1
        return lmJsonParseObject_fields
    end
    while true
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos >= len(lmJsonParseObject_state.chars) or lmJsonParseObject_state.chars[lmJsonParseObject_state.pos] != "\""
        return lmJsonFail(lmJsonParseObject_state, "Expected a string key at position " + toString(lmJsonParseObject_state.pos))
    end
    lmJsonParseObject_key = lmJsonParseString(lmJsonParseObject_state)
    if lmJsonParseObject_state.error != ""
        return null
    end
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos >= len(lmJsonParseObject_state.chars) or lmJsonParseObject_state.chars[lmJsonParseObject_state.pos] != ":"
        return lmJsonFail(lmJsonParseObject_state, "Expected ':' at position " + toString(lmJsonParseObject_state.pos))
    end
    lmJsonParseObject_state.pos += 1
    lmJsonSkipWs(lmJsonParseObject_state)
    lmJsonParseObject_value = lmJsonParseValue(lmJsonParseObject_state)
    if lmJsonParseObject_state.error != ""
        return null
    end
    lmJsonParseObject_fields.set(lmJsonParseObject_key, lmJsonParseObject_value)
    lmJsonSkipWs(lmJsonParseObject_state)
    if lmJsonParseObject_state.pos >= len(lmJsonParseObject_state.chars)
        return lmJsonFail(lmJsonParseObject_state, "Expected ',' or '\}' at position " + toString(lmJsonParseObject_state.pos))
    end
    lmJsonParseObject_char = lmJsonParseObject_state.chars[lmJsonParseObject_state.pos]
    lmJsonParseObject_state.pos += 1
    if lmJsonParseObject_char == "\}"
        return lmJsonParseObject_fields
    end
    if lmJsonParseObject_char != ","
        return lmJsonFail(lmJsonParseObject_state, "Expected ',' or '\}' at position " + toString(lmJsonParseObject_state.pos - 1))
    end
end
end
function lmJsonParseValue(lmJsonParseValue_state)
    if lmJsonParseValue_state.error != ""
        return null
    end
    lmJsonSkipWs(lmJsonParseValue_state)
    if lmJsonParseValue_state.pos >= len(lmJsonParseValue_state.chars)
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    lmJsonParseValue_char = lmJsonParseValue_state.chars[lmJsonParseValue_state.pos]
    if lmJsonParseValue_char == "\""
        return lmJsonParseString(lmJsonParseValue_state)
    end
    if lmJsonParseValue_char == "\{"
        return lmJsonParseObject(lmJsonParseValue_state)
    end
    if lmJsonParseValue_char == "["
        return lmJsonParseArray(lmJsonParseValue_state)
    end
    if lmJsonParseValue_char == "t"
        if lmJsonConsumeLiteral(lmJsonParseValue_state, "true")
            return true
        end
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    if lmJsonParseValue_char == "f"
        if lmJsonConsumeLiteral(lmJsonParseValue_state, "false")
            return false
        end
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    if lmJsonParseValue_char == "n"
        if lmJsonConsumeLiteral(lmJsonParseValue_state, "null")
            return null
        end
        return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
    end
    if lmJsonParseValue_char == "-" or lmAsciiDigit(lmJsonParseValue_char)
        return lmJsonParseNumber(lmJsonParseValue_state)
    end
    return lmJsonFail(lmJsonParseValue_state, "Unexpected JSON character at position " + toString(lmJsonParseValue_state.pos))
end
function lmJsonDecode(lmJsonDecode_text)
    assert(type(lmJsonDecode_text) == "string", "json.decode expects a string")
    lmJsonDecode_state = lmJsonState(lmJsonDecode_text, true)
    lmJsonDecode_value = lmJsonParseValue(lmJsonDecode_state)
    lmJsonSkipWs(lmJsonDecode_state)
    assert(lmJsonDecode_state.pos == len(lmJsonDecode_state.chars), "Unexpected trailing JSON characters at position " + toString(lmJsonDecode_state.pos))
    return lmJsonDecode_value
end
function lmJsonIsValid(lmJsonIsValid_text)
    if type(lmJsonIsValid_text) != "string"
        return false
    end
    lmJsonIsValid_state = lmJsonState(lmJsonIsValid_text, false)
    lmJsonParseValue(lmJsonIsValid_state)
    if lmJsonIsValid_state.error != ""
        return false
    end
    lmJsonSkipWs(lmJsonIsValid_state)
    return lmJsonIsValid_state.pos == len(lmJsonIsValid_state.chars)
end
$- ---------------------------------------------------------------------------
   JSON paths and pretty printing
   --------------------------------------------------------------------------- -$
function lmJsonIndent(lmJsonIndent_level)
    return lmRepeatText("  ", lmJsonIndent_level)
end
function lmJsonPrettyInner(lmJsonPrettyInner_value, lmJsonPrettyInner_level)
    if lmJsonPrettyInner_level > 100
        assert(false, "JSON value is nested too deeply")
    end
    lmJsonPrettyInner_type = type(lmJsonPrettyInner_value)
    if lmJsonPrettyInner_type == "array"
        if len(lmJsonPrettyInner_value) == 0
            return "[]"
        end
        lmJsonPrettyInner_out = "[\n"
        lmJsonPrettyInner_i = 0
        while lmJsonPrettyInner_i < len(lmJsonPrettyInner_value)
        lmJsonPrettyInner_out += lmJsonIndent(lmJsonPrettyInner_level + 1)
        lmJsonPrettyInner_out += lmJsonPrettyInner(lmJsonPrettyInner_value[lmJsonPrettyInner_i], lmJsonPrettyInner_level + 1)
        if lmJsonPrettyInner_i + 1 < len(lmJsonPrettyInner_value)
            lmJsonPrettyInner_out += ","
        end
        lmJsonPrettyInner_out += "\n"
        lmJsonPrettyInner_i += 1
    end
    return lmJsonPrettyInner_out + lmJsonIndent(lmJsonPrettyInner_level) + "]"
end
if lmJsonPrettyInner_type == "object"
    lmJsonPrettyInner_keys = keys(lmJsonPrettyInner_value)
    if len(lmJsonPrettyInner_keys) == 0
        return "\{\}"
    end
    lmJsonPrettyInner_out = "\{\n"
    lmJsonPrettyInner_i = 0
    while lmJsonPrettyInner_i < len(lmJsonPrettyInner_keys)
    lmJsonPrettyInner_out += lmJsonIndent(lmJsonPrettyInner_level + 1)
    lmJsonPrettyInner_key = lmJsonPrettyInner_keys[lmJsonPrettyInner_i]
    lmJsonPrettyInner_out += lmJsonQuote(lmJsonPrettyInner_key) + ": "
    lmJsonPrettyInner_out += lmJsonPrettyInner(lmJsonPrettyInner_value.get(lmJsonPrettyInner_key), lmJsonPrettyInner_level + 1)
    if lmJsonPrettyInner_i + 1 < len(lmJsonPrettyInner_keys)
        lmJsonPrettyInner_out += ","
    end
    lmJsonPrettyInner_out += "\n"
    lmJsonPrettyInner_i += 1
end
return lmJsonPrettyInner_out + lmJsonIndent(lmJsonPrettyInner_level) + "\}"
end
return lmJsonEncodeInner(lmJsonPrettyInner_value, lmJsonPrettyInner_level)
end
function lmJsonPretty(lmJsonPretty_value)
    return lmJsonPrettyInner(lmJsonPretty_value, 0)
end
function lmJsonArrayIndex(lmJsonArrayIndex_segment)
    if not lmNumericText(lmJsonArrayIndex_segment)
        return -1
    end
    lmJsonArrayIndex_number = parseFloat(lmJsonArrayIndex_segment)
    if not lmIndex(lmJsonArrayIndex_number)
        return -1
    end
    return lmJsonArrayIndex_number
end
function lmJsonGet(lmJsonGet_root, lmJsonGet_path)
    assert(type(lmJsonGet_path) == "string", "json.get expects a path string")
    if lmJsonGet_path == ""
        return lmJsonGet_root
    end
    lmJsonGet_segments = split(lmJsonGet_path, ".")
    lmJsonGet_current = lmJsonGet_root
    lmJsonGet_i = 0
    while lmJsonGet_i < len(lmJsonGet_segments)
    lmJsonGet_segment = lmJsonGet_segments[lmJsonGet_i]
    if type(lmJsonGet_current) == "object"
        lmJsonGet_current = lmJsonGet_current.get(lmJsonGet_segment, null)
    else if type(lmJsonGet_current) == "array"
        lmJsonGet_index = lmJsonArrayIndex(lmJsonGet_segment)
        if lmJsonGet_index < 0 or lmJsonGet_index >= len(lmJsonGet_current)
            lmJsonGet_current = null
        else
            lmJsonGet_current = lmJsonGet_current[lmJsonGet_index]
        end
    else
        lmJsonGet_current = null
    end
    lmJsonGet_i += 1
end
return lmJsonGet_current
end
function lmJsonSetAt(lmJsonSetAt_container, lmJsonSetAt_segments, lmJsonSetAt_pos, lmJsonSetAt_value)
    lmJsonSetAt_segment = lmJsonSetAt_segments[lmJsonSetAt_pos]
    lmJsonSetAt_last = lmJsonSetAt_pos == len(lmJsonSetAt_segments) - 1
    if type(lmJsonSetAt_container) == "object"
        if lmJsonSetAt_last
            lmJsonSetAt_container.set(lmJsonSetAt_segment, lmJsonSetAt_value)
            return
        end
        lmJsonSetAt_child = lmJsonSetAt_container.get(lmJsonSetAt_segment, null)
        if type(lmJsonSetAt_child) == "object" or type(lmJsonSetAt_child) == "array"
            lmJsonSetAt(lmJsonSetAt_child, lmJsonSetAt_segments, lmJsonSetAt_pos + 1, lmJsonSetAt_value)
            return
        end
        if type(lmJsonSetAt_child) != "null"
            assert(false, "Cannot descend into a " + type(lmJsonSetAt_child) + " at '" + lmJsonSetAt_segment + "' for json.set")
        end
        lmJsonSetAt_child = {}
        lmJsonSetAt_container.set(lmJsonSetAt_segment, lmJsonSetAt_child)
        lmJsonSetAt(lmJsonSetAt_child, lmJsonSetAt_segments, lmJsonSetAt_pos + 1, lmJsonSetAt_value)
        return
    end
    if type(lmJsonSetAt_container) == "array"
        lmJsonSetAt_index = lmJsonArrayIndex(lmJsonSetAt_segment)
        assert(lmJsonSetAt_index >= 0, "Expected an array index in path, found '" + lmJsonSetAt_segment + "'")
        if lmJsonSetAt_last
            if lmJsonSetAt_index < len(lmJsonSetAt_container)
                lmJsonSetAt_container[lmJsonSetAt_index] = lmJsonSetAt_value
            else if lmJsonSetAt_index == len(lmJsonSetAt_container)
                lmJsonSetAt_container.add(lmJsonSetAt_value)
            else
                assert(false, "json.set array index is past the end of the array")
            end
            return
        end
        assert(lmJsonSetAt_index < len(lmJsonSetAt_container), "json.set array index is past the end of the array")
        lmJsonSetAt_child = lmJsonSetAt_container[lmJsonSetAt_index]
        if type(lmJsonSetAt_child) != "object" and type(lmJsonSetAt_child) != "array"
            assert(false, "Cannot descend into a non-container for json.set")
        end
        lmJsonSetAt(lmJsonSetAt_child, lmJsonSetAt_segments, lmJsonSetAt_pos + 1, lmJsonSetAt_value)
        return
    end
    assert(false, "json.set cannot descend into a " + type(lmJsonSetAt_container) + " at '" + lmJsonSetAt_segment + "'")
end
function lmJsonSet(lmJsonSet_root, lmJsonSet_path, lmJsonSet_value)
    assert(type(lmJsonSet_path) == "string", "json.set expects a path string")
    if lmJsonSet_path == ""
        return lmJsonSet_value
    end
    lmJsonSet_result = lmJsonSet_root
    if lmJsonSet_result == null
        lmJsonSet_result = {}
    end
    assert(type(lmJsonSet_result) == "object" or type(lmJsonSet_result) == "array", "json.set expects an object, array or null root")
    lmJsonSet_segments = split(lmJsonSet_path, ".")
    lmJsonSetAt(lmJsonSet_result, lmJsonSet_segments, 0, lmJsonSet_value)
    return lmJsonSet_result
end
function lmJsonModule()
    return {encode: lmJsonEncode, decode: lmJsonDecode, pretty: lmJsonPretty, isValid: lmJsonIsValid, get: lmJsonGet, set: lmJsonSet}
end
function lmAllModules()
    return {string: lmStringModule(), json: lmJsonModule()}
end
$- ---------------------------------------------------------------------------
   Self-tests: native modules are oracles only below this point.
   --------------------------------------------------------------------------- -$
$- === inlined selfhost/vm_core.enm === -$
$- Pure-Englishmen core of the Englishmen bytecode VM.

   Englishmen has no local .enm imports, so this file is self-contained. It
   executes the `emb` IR object described in docs/selfhost/EMB_IR.md without
   calling the native VM: constants, scopes, the operand stack, arithmetic and
   comparisons, jumps, calls/returns, arrays, objects and Say are all handled
   here. Native modules are not used by the implementation; the selftest guard
   below uses the `env` builtin rather than importing `os`.

   Execution entry points are omitted from this compile-only bootstrap;
   the Rust host remains the oracle for validating generated bytecode.

   C2 can layer a runtime over this core by setting these optional hooks:
   vmCallHook(callee, name, args)     -> value or structured error
   vmMethodHook(receiver, name, args) -> value or structured error
   vmImportHook(name)                 -> value or structured error
   All globals and helper functions use the `vm` prefix so this file can be
   concatenated into a combined self-hosted program. -$
vmError = null
vmOutput = []
vmStack = []
vmFrames = []
vmCallHook = null
vmMethodHook = null
vmImportHook = null
vmCallPushedFrame = false
vmMaxFrames = 512
function vmErr(vmErr_kind, vmErr_message, vmErr_op, vmErr_line, vmErr_col)
    return {__vmError: true, kind: vmErr_kind, error: vmErr_message, op: vmErr_op, line: vmErr_line, col: vmErr_col}
end
function vmIsError(vmIsError_value)
    return isObject(vmIsError_value) and vmIsError_value.get("__vmError", false) == true
end
function vmLastError()
    return vmError
end
function vmRaise(vmRaise_kind, vmRaise_message, vmRaise_op, vmRaise_line, vmRaise_col)
    vmError = vmErr(vmRaise_kind, vmRaise_message, vmRaise_op, vmRaise_line, vmRaise_col)
    return null
end
function vmRaiseAt(vmRaiseAt_kind, vmRaiseAt_message, vmRaiseAt_instr)
    return vmRaise(vmRaiseAt_kind, vmRaiseAt_message, vmRaiseAt_instr.get("op", ""), vmRaiseAt_instr.get("line", 1), vmRaiseAt_instr.get("col", 1))
end
function vmReset()
    vmError = null
    vmOutput = []
    vmStack = []
    vmFrames = []
    vmCallPushedFrame = false
end
function vmIntegral(vmIntegral_value)
    if not isNumber(vmIntegral_value)
        return false
    end
    if isNaN(vmIntegral_value)
        return false
    end
    return vmIntegral_value >= 0 and vmIntegral_value <= 4294967295 and floor(vmIntegral_value) == vmIntegral_value
end
function vmIsOp(vmIsOp_op, vmIsOp_names)
    return vmIsOp_names.indexOf(vmIsOp_op) >= 0
end
function vmNameOperandKey(vmNameOperandKey_op)
    if vmNameOperandKey_op == "Call"
        return "b"
    end
    vmNameOperandKey_names = ["GetVar", "SetVar", "DefineVar", "GetProp", "SetProp", "GetVarOrObject", "GetPropOrObject", "GetPropKeep", "Import", "MethodCall", "IterNext"]
    if vmIsOp(vmNameOperandKey_op, vmNameOperandKey_names)
        return "a"
    end
    return ""
end
function vmJumpOperandKey(vmJumpOperandKey_op)
    if vmJumpOperandKey_op == "IterNext"
        return "b"
    end
    vmJumpOperandKey_names = ["Jump", "JumpIfFalse", "JumpIfFalsePeek", "JumpIfTruePeek", "JumpIfNullPeek", "RepeatNext"]
    if vmIsOp(vmJumpOperandKey_op, vmJumpOperandKey_names)
        return "a"
    end
    return ""
end
function vmSupportedOps()
    return ["LoadConst", "Pop", "GetVar", "SetVar", "DefineVar", "GetProp", "SetProp", "GetVarOrObject", "GetPropOrObject", "GetIndex", "SetIndex", "MakeArray", "MakeObject", "MakeClosure", "Call", "MethodCall", "Say", "Add", "Sub", "Mul", "Div", "Mod", "FloorDiv", "Pow", "BitAnd", "BitOr", "BitXor", "Shl", "Shr", "Eq", "NotEq", "Gt", "Lt", "GtEq", "LtEq", "Neg", "Not", "BitNot", "ToBool", "Jump", "JumpIfFalse", "JumpIfFalsePeek", "JumpIfTruePeek", "RepeatSetup", "RepeatNext", "IterSetup", "IterNext", "Return", "ReturnNull", "Import", "Dup", "Rotate", "GetPropKeep", "GetIndexKeep", "JumpIfNullPeek"]
end
function vmValidateOperand(vmValidateOperand_instr, vmValidateOperand_key, vmValidateOperand_op, vmValidateOperand_path)
    vmValidateOperand_value = vmValidateOperand_instr.get(vmValidateOperand_key, 0)
    if not vmIntegral(vmValidateOperand_value)
        vmRaise("validation", vmValidateOperand_path + ": operand '" + vmValidateOperand_key + "' must be a non-negative integer", vmValidateOperand_op, vmValidateOperand_instr.get("line", 1), vmValidateOperand_instr.get("col", 1))
        return false
    end
    return true
end
function vmValidateConstantIndex(vmValidateConstantIndex_chunk, vmValidateConstantIndex_index, vmValidateConstantIndex_instr, vmValidateConstantIndex_path)
    vmValidateConstantIndex_constants = vmValidateConstantIndex_chunk.get("constants", [])
    if vmValidateConstantIndex_index >= len(vmValidateConstantIndex_constants)
        vmRaiseAt("validation", vmValidateConstantIndex_path + ": constant index " + toString(vmValidateConstantIndex_index) + " out of range", vmValidateConstantIndex_instr)
        return false
    end
    return true
end
function vmValidateNameIndex(vmValidateNameIndex_chunk, vmValidateNameIndex_index, vmValidateNameIndex_instr, vmValidateNameIndex_path)
    if not vmValidateConstantIndex(vmValidateNameIndex_chunk, vmValidateNameIndex_index, vmValidateNameIndex_instr, vmValidateNameIndex_path)
        return false
    end
    vmValidateNameIndex_constant = vmValidateNameIndex_chunk.get("constants", [])[vmValidateNameIndex_index]
    if not isString(vmValidateNameIndex_constant.get("tag", "")) or vmValidateNameIndex_constant.get("tag", "") != "string"
        vmRaiseAt("validation", vmValidateNameIndex_path + ": name index " + toString(vmValidateNameIndex_index) + " is not a string constant", vmValidateNameIndex_instr)
        return false
    end
    return true
end
function vmValidateFunctionIndex(vmValidateFunctionIndex_chunk, vmValidateFunctionIndex_index, vmValidateFunctionIndex_instr, vmValidateFunctionIndex_path)
    vmValidateFunctionIndex_functions = vmValidateFunctionIndex_chunk.get("functions", [])
    if vmValidateFunctionIndex_index >= len(vmValidateFunctionIndex_functions)
        vmRaiseAt("validation", vmValidateFunctionIndex_path + ": function index " + toString(vmValidateFunctionIndex_index) + " out of range", vmValidateFunctionIndex_instr)
        return false
    end
    return true
end
function vmValidateChunk(vmValidateChunk_chunk, vmValidateChunk_depth, vmValidateChunk_isRoot, vmValidateChunk_path)
    if vmValidateChunk_depth > 32
        vmRaise("validation", vmValidateChunk_path + ": functions are nested too deeply", "", 1, 1)
        return false
    end
    if not isObject(vmValidateChunk_chunk)
        vmRaise("validation", vmValidateChunk_path + " must be an object", "", 1, 1)
        return false
    end
    if vmValidateChunk_isRoot and vmValidateChunk_chunk.get("version", null) != 2
        vmRaise("validation", "IR version must be 2", "", 1, 1)
        return false
    end
    vmValidateChunk_constants = vmValidateChunk_chunk.get("constants", null)
    vmValidateChunk_functions = vmValidateChunk_chunk.get("functions", null)
    vmValidateChunk_code = vmValidateChunk_chunk.get("code", null)
    if not isArray(vmValidateChunk_constants)
        vmRaise("validation", vmValidateChunk_path + ".constants must be an array", "", 1, 1)
        return false
    end
    if not isArray(vmValidateChunk_functions)
        vmRaise("validation", vmValidateChunk_path + ".functions must be an array", "", 1, 1)
        return false
    end
    if not isArray(vmValidateChunk_code)
        vmRaise("validation", vmValidateChunk_path + ".code must be an array", "", 1, 1)
        return false
    end
    vmValidateChunk_i = 0
    while vmValidateChunk_i < len(vmValidateChunk_constants)
    vmValidateChunk_constant = vmValidateChunk_constants[vmValidateChunk_i]
    if not isObject(vmValidateChunk_constant)
        vmRaise("validation", vmValidateChunk_path + ".constants[" + toString(vmValidateChunk_i) + "] must be an object", "", 1, 1)
        return false
    end
    vmValidateChunk_tag = vmValidateChunk_constant.get("tag", "")
    if vmValidateChunk_tag == "number" and not isNumber(vmValidateChunk_constant.get("value", null))
        vmRaise("validation", vmValidateChunk_path + ".constants[" + toString(vmValidateChunk_i) + "] needs a number value", "", 1, 1)
        return false
    end
    if vmValidateChunk_tag == "string" and not isString(vmValidateChunk_constant.get("value", null))
        vmRaise("validation", vmValidateChunk_path + ".constants[" + toString(vmValidateChunk_i) + "] needs a string value", "", 1, 1)
        return false
    end
    if vmValidateChunk_tag == "bool" and not isBool(vmValidateChunk_constant.get("value", null))
        vmRaise("validation", vmValidateChunk_path + ".constants[" + toString(vmValidateChunk_i) + "] needs a boolean value", "", 1, 1)
        return false
    end
    if vmValidateChunk_tag != "number" and vmValidateChunk_tag != "string" and vmValidateChunk_tag != "bool" and vmValidateChunk_tag != "null"
        vmRaise("validation", vmValidateChunk_path + ".constants[" + toString(vmValidateChunk_i) + "]: unknown constant tag '" + toString(vmValidateChunk_tag) + "'", "", 1, 1)
        return false
    end
    vmValidateChunk_i += 1
end
vmValidateChunk_supported = vmSupportedOps()
vmValidateChunk_i = 0
while vmValidateChunk_i < len(vmValidateChunk_code)
vmValidateChunk_instr = vmValidateChunk_code[vmValidateChunk_i]
vmValidateChunk_path_i = vmValidateChunk_path + ".code[" + toString(vmValidateChunk_i) + "]"
if not isObject(vmValidateChunk_instr)
    vmRaise("validation", vmValidateChunk_path_i + " must be an object", "", 1, 1)
    return false
end
vmValidateChunk_op = vmValidateChunk_instr.get("op", "")
if not isString(vmValidateChunk_op) or not vmIsOp(vmValidateChunk_op, vmValidateChunk_supported)
    vmRaise("validation", vmValidateChunk_path_i + ": unknown opcode '" + toString(vmValidateChunk_op) + "'", "", 1, 1)
    return false
end
if not vmValidateOperand(vmValidateChunk_instr, "a", vmValidateChunk_op, vmValidateChunk_path_i)
    return false
end
if not vmValidateOperand(vmValidateChunk_instr, "b", vmValidateChunk_op, vmValidateChunk_path_i)
    return false
end
if not vmValidateOperand(vmValidateChunk_instr, "line", vmValidateChunk_op, vmValidateChunk_path_i)
    return false
end
if not vmValidateOperand(vmValidateChunk_instr, "col", vmValidateChunk_op, vmValidateChunk_path_i)
    return false
end
if vmValidateChunk_op == "LoadConst"
    if not vmValidateConstantIndex(vmValidateChunk_chunk, vmValidateChunk_instr.get("a", 0), vmValidateChunk_instr, vmValidateChunk_path_i)
        return false
