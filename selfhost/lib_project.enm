$- Pure Englishmen implementation of the native `project` manifest API.
   Self-contained by design: Englishmen has no local `.enm` imports yet, so
   every helper is global and prefixed with `pj` to survive concatenation into
   `selfhost/full.enm`. The native `project` module is imported only inside the
   self-test guard, where it acts as an oracle. -$
import os
$- Return the value of one hexadecimal digit, or -1 for anything else. -$
function pjHexDigit(pjHexDigit_c)
    pjHexDigit_n = charCode(pjHexDigit_c)
    if pjHexDigit_n >= 48 and pjHexDigit_n <= 57
        return pjHexDigit_n - 48
    end
    if pjHexDigit_n >= 97 and pjHexDigit_n <= 102
        return pjHexDigit_n - 87
    end
    if pjHexDigit_n >= 65 and pjHexDigit_n <= 70
        return pjHexDigit_n - 55
    end
    return -1
end
$- Reverse `u32::from_str_radix(digits, 16)` for the 1-4 digits after `\u`.
   A leading '+' is accepted; a leading '-' is always rejected by u32. -$
function pjHexValue(pjHexValue_digits)
    if pjHexValue_digits.length() == 0
        return -1
    end
    pjHexValue_start = 0
    if pjHexValue_digits[0] == "+"
        pjHexValue_start = 1
    else if pjHexValue_digits[0] == "-"
        return -1
    end
    if pjHexValue_start >= pjHexValue_digits.length()
        return -1
    end
    pjHexValue_value = 0
    pjHexValue_i = pjHexValue_start
    while pjHexValue_i < pjHexValue_digits.length()
    pjHexValue_digit = pjHexDigit(pjHexValue_digits[pjHexValue_i])
    if pjHexValue_digit < 0
        return -1
    end
    pjHexValue_value = pjHexValue_value * 16 + pjHexValue_digit
    pjHexValue_i += 1
end
return pjHexValue_value
end
$- Four lowercase hex digits, matching Rust's `\u{:04x}` writer. -$
function pjHex4(pjHex4_n)
    pjHex4_digits = "0123456789abcdef"
    pjHex4_out = ""
    pjHex4_i = 3
    while pjHex4_i >= 0
    pjHex4_out = pjHex4_digits[pjHex4_n % 16] + pjHex4_out
    pjHex4_n = floor(pjHex4_n / 16)
    pjHex4_i -= 1
end
return pjHex4_out
end
$- `char::from_u32` accepts scalars only: no surrogates and nothing above U+10FFFF. -$
function pjIsScalar(pjIsScalar_n)
    if pjIsScalar_n < 0 or pjIsScalar_n > 1114111
        return false
    end
    if pjIsScalar_n >= 55296 and pjIsScalar_n <= 57343
        return false
    end
    return true
end
$- Reverse `write_quoted` escape by escape. Unknown escapes and malformed
   `\uXXXX` sequences are kept literally, exactly as native `project.parse`
   does. -$
function pjUnescape(pjUnescape_text)
    pjUnescape_chars = pjUnescape_text.chars()
    pjUnescape_out = ""
    pjUnescape_i = 0
    while pjUnescape_i < pjUnescape_chars.length()
    pjUnescape_c = pjUnescape_chars[pjUnescape_i]
    if pjUnescape_c != "\\"
        pjUnescape_out += pjUnescape_c
        pjUnescape_i += 1
        continue
    end
    if pjUnescape_i + 1 >= pjUnescape_chars.length()
        pjUnescape_out += "\\"
        pjUnescape_i += 1
        continue
    end
    pjUnescape_next = pjUnescape_chars[pjUnescape_i + 1]
    if pjUnescape_next == "\""
        pjUnescape_out += "\""
        pjUnescape_i += 2
    else if pjUnescape_next == "\\"
        pjUnescape_out += "\\"
        pjUnescape_i += 2
    else if pjUnescape_next == "n"
        pjUnescape_out += "\n"
        pjUnescape_i += 2
    else if pjUnescape_next == "r"
        pjUnescape_out += fromCharCode(13)
        pjUnescape_i += 2
    else if pjUnescape_next == "t"
        pjUnescape_out += "\t"
        pjUnescape_i += 2
    else if pjUnescape_next == "u"
        pjUnescape_digits = ""
        pjUnescape_j = pjUnescape_i + 2
        while pjUnescape_j < pjUnescape_chars.length() and pjUnescape_j < pjUnescape_i + 6
        pjUnescape_digits += pjUnescape_chars[pjUnescape_j]
        pjUnescape_j += 1
    end
    pjUnescape_code = pjHexValue(pjUnescape_digits)
    if pjUnescape_code >= 0 and pjIsScalar(pjUnescape_code)
        pjUnescape_out += fromCharCode(pjUnescape_code)
    else
        pjUnescape_out += "\\u"
        pjUnescape_out += pjUnescape_digits
    end
    pjUnescape_i = pjUnescape_j
else
    pjUnescape_out += "\\"
    pjUnescape_out += pjUnescape_next
    pjUnescape_i += 2
end
end
return pjUnescape_out
end
$- Trim, strip one pair of surrounding double quotes, then unescape. -$
function pjParseValue(pjParseValue_raw)
    pjParseValue_trimmed = pjParseValue_raw.trim()
    if pjParseValue_trimmed.length() >= 2 and pjParseValue_trimmed.startsWith("\"") and pjParseValue_trimmed.endsWith("\"")
        return pjUnescape(pjParseValue_trimmed.slice(1, pjParseValue_trimmed.length() - 1))
    end
    return pjParseValue_trimmed
end
$- Parse `.emc` text into `{root: object, sections: object}`. Values are read
   as strings; bare numbers, booleans and null keep their textual form. -$
function pjParse(pjParse_text)
    if isString(pjParse_text) == false
        assert(false, "Type mismatch: expected a string as the manifest text for project.parse, found " + type(pjParse_text))
    end
    pjParse_root = {}
    pjParse_sections = {}
    pjParse_current = null
    pjParse_lines = pjParse_text.lines()
    pjParse_i = 0
    while pjParse_i < pjParse_lines.length()
    pjParse_line = pjParse_lines[pjParse_i].trim()
    if pjParse_line == "" or pjParse_line.startsWith("#")
        pjParse_i += 1
        continue
    end
    if pjParse_line.startsWith("[") and pjParse_line.endsWith("]")
        pjParse_name = pjParse_line.slice(1, pjParse_line.length() - 1).trim()
        if pjParse_sections.has(pjParse_name) == false
            pjParse_sections.set(pjParse_name, {})
        end
        pjParse_current = pjParse_name
        pjParse_i += 1
        continue
    end
    pjParse_equals = pjParse_line.indexOf("=")
    if pjParse_equals >= 0
        pjParse_key = pjParse_line.slice(0, pjParse_equals).trim()
        pjParse_value = pjParseValue(pjParse_line.slice(pjParse_equals + 1))
        if pjParse_current == null
            pjParse_root.set(pjParse_key, pjParse_value)
        else
            pjParse_sections.get(pjParse_current).set(pjParse_key, pjParse_value)
        end
    end
    pjParse_i += 1
end
return {root: pjParse_root, sections: pjParse_sections}
end
$- Snapshot and validate the two objects of a parsed config. `op` is the native
   function name used in error messages (name, version, main or write). -$
function pjConfig(pjConfig_manifest, pjConfig_op)
    if isObject(pjConfig_manifest) == false
        assert(false, "Type mismatch: expected a project config object for project." + pjConfig_op + ", found " + type(pjConfig_manifest))
    end
    pjConfig_root = pjConfig_manifest.get("root")
    if isObject(pjConfig_root) == false
        if pjConfig_manifest.has("root")
            assert(false, "project." + pjConfig_op + " expects 'root' to be an object, found " + type(pjConfig_root))
        end
        assert(false, "project." + pjConfig_op + " expects a config with a 'root' object")
    end
    pjConfig_sections = pjConfig_manifest.get("sections")
    if isObject(pjConfig_sections) == false
        if pjConfig_manifest.has("sections")
            assert(false, "project." + pjConfig_op + " expects 'sections' to be an object, found " + type(pjConfig_sections))
        end
        assert(false, "project." + pjConfig_op + " expects a config with a 'sections' object")
    end
    for pjConfig_name in pjConfig_sections.keys()
        pjConfig_section = pjConfig_sections.get(pjConfig_name)
        if isObject(pjConfig_section) == false
            assert(false, "project." + pjConfig_op + " expects section '" + pjConfig_name + "' to be an object, found " + type(pjConfig_section))
        end
    end
    return {root: pjConfig_root, sections: pjConfig_sections}
end
function pjRootValue(pjRootValue_manifest, pjRootValue_op, pjRootValue_key)
    pjRootValue_parts = pjConfig(pjRootValue_manifest, pjRootValue_op)
    return pjRootValue_parts.get("root").get(pjRootValue_key)
end
function pjName(pjName_manifest)
    return pjRootValue(pjName_manifest, "name", "name")
end
function pjVersion(pjVersion_manifest)
    return pjRootValue(pjVersion_manifest, "version", "version")
end
function pjMain(pjMain_manifest)
    return pjRootValue(pjMain_manifest, "main", "main")
end
$- Rust `char::is_whitespace` (Unicode White_Space), used by the writer's name
   validation. Parsing itself uses `.trim()`, which has the same definition. -$
function pjIsWhitespaceCode(pjIsWhitespaceCode_n)
    if pjIsWhitespaceCode_n >= 9 and pjIsWhitespaceCode_n <= 13
        return true
    end
    if pjIsWhitespaceCode_n == 32 or pjIsWhitespaceCode_n == 133 or pjIsWhitespaceCode_n == 160 or pjIsWhitespaceCode_n == 5760
        return true
    end
    if pjIsWhitespaceCode_n >= 8192 and pjIsWhitespaceCode_n <= 8202
        return true
    end
    if pjIsWhitespaceCode_n == 8232 or pjIsWhitespaceCode_n == 8233 or pjIsWhitespaceCode_n == 8239 or pjIsWhitespaceCode_n == 8287 or pjIsWhitespaceCode_n == 12288
        return true
    end
    return false
end
$- Keys and section names must survive the parser unchanged. -$
function pjValidateName(pjValidateName_name, pjValidateName_what)
    pjValidateName_message = "Invalid " + pjValidateName_what + " '" + pjValidateName_name + "' for project.write"
    if pjValidateName_name == "" or pjValidateName_name.startsWith("#")
        assert(false, pjValidateName_message)
    end
    pjValidateName_chars = pjValidateName_name.chars()
    for pjValidateName_c in pjValidateName_chars
        if pjIsWhitespaceCode(charCode(pjValidateName_c)) or pjValidateName_c == "[" or pjValidateName_c == "]" or pjValidateName_c == "="
            assert(false, pjValidateName_message)
        end
    end
end
$- Quote a string value, escaping exactly the characters native writes. -$
function pjQuoted(pjQuoted_text)
    pjQuoted_out = "\""
    for pjQuoted_c in pjQuoted_text.chars()
        if pjQuoted_c == "\""
            pjQuoted_out += "\\\""
        else if pjQuoted_c == "\\"
            pjQuoted_out += "\\\\"
        else if pjQuoted_c == "\n"
            pjQuoted_out += "\\n"
        else if pjQuoted_c == fromCharCode(13)
            pjQuoted_out += "\\r"
        else if pjQuoted_c == "\t"
            pjQuoted_out += "\\t"
        else if charCode(pjQuoted_c) < 32
            pjQuoted_out += "\\u" + pjHex4(charCode(pjQuoted_c))
        else
            pjQuoted_out += pjQuoted_c
        end
    end
    return pjQuoted_out + "\""
end
$- One `key = value` line, including its trailing newline. -$
function pjWritePair(pjWritePair_key, pjWritePair_value)
    pjValidateName(pjWritePair_key, "manifest key")
    pjWritePair_kind = type(pjWritePair_value)
    if pjWritePair_kind == "string"
        return pjWritePair_key + " = " + pjQuoted(pjWritePair_value) + "\n"
    end
    if pjWritePair_kind == "number"
        if isNaN(pjWritePair_value) or pjWritePair_value > pow(10, 308) or pjWritePair_value < -pow(10, 308)
            assert(false, "Cannot write a non-finite number for key '" + pjWritePair_key + "'")
        end
        return pjWritePair_key + " = " + toString(pjWritePair_value) + "\n"
    end
    if pjWritePair_kind == "boolean" or pjWritePair_kind == "null"
        return pjWritePair_key + " = " + toString(pjWritePair_value) + "\n"
    end
    assert(false, "Cannot write a " + pjWritePair_kind + " for key '" + pjWritePair_key + "' in a manifest")
end
$- Serialize a manifest to `.emc` text. Native `project.write` takes a path as
   well; this pure function returns the text so callers can choose where to
   store it. Key and section order is the shared BTreeMap order. -$
function pjWrite(pjWrite_manifest)
    pjWrite_parts = pjConfig(pjWrite_manifest, "write")
    pjWrite_root = pjWrite_parts.get("root")
    pjWrite_sections = pjWrite_parts.get("sections")
    pjWrite_out = ""
    for pjWrite_key in pjWrite_root.keys()
        pjWrite_out += pjWritePair(pjWrite_key, pjWrite_root.get(pjWrite_key))
    end
    for pjWrite_name in pjWrite_sections.keys()
        pjValidateName(pjWrite_name, "section name")
        pjWrite_out += "[" + pjWrite_name + "]\n"
        pjWrite_fields = pjWrite_sections.get(pjWrite_name)
        for pjWrite_key in pjWrite_fields.keys()
            pjWrite_out += pjWritePair(pjWrite_key, pjWrite_fields.get(pjWrite_key))
        end
    end
    return pjWrite_out
end
$- Inline parity self-test. The native module is loaded only here and is never
   used by the implementation above. -$
function pjSelfTest()
    pjSelfTest_samples = ["", "name = \"Demo\"\nversion = \"1.0.0\"\nmain = \"main.enm\"\n", "# leading comment\n\n  name = \"  spaced  \"  \nbare = plain\nsingle = 'quoted'\n\n[installer]\ninstall_dir = \"C:/em\"\nprojects_enabled = \"true\"\n", "name = \"Demo\"" + fromCharCode(13) + "\n\tversion = \"2.1\"" + fromCharCode(13) + "\n# comment" + fromCharCode(13) + "\n[notes]" + fromCharCode(13) + "\nbody = \"hello\"" + fromCharCode(13) + "\n", "a = \"quote \\\" slash \\\\ newline \\n return \\r tab \\t control \\u001f\"\n", "a = \"short \\u41 plus \\u+42 bad \\uZZZZ surrogate \\ud800 high \\u\{1f600\}\"\n", "[a]\nx = \"first\"\n[a]\nx = \"last\"\ny = \"a=b\"\n[ü]\nключ = \"значение\"\n", "dup = \"first\"\ndup = \"second\"\n[sec]\nq = \"# not a comment\"\n", "name = \"\\u00e9\\u263a\"\nx = \"" + fromCharCode(1) + "☺\"\n"]
    pjSelfTest_path = os.tempDir() + "/lib_project_selftest_" + os.pid() + ".emc"
    pjSelfTest_i = 0
    while pjSelfTest_i < pjSelfTest_samples.length()
    pjSelfTest_text = pjSelfTest_samples[pjSelfTest_i]
    pjSelfTest_pure = pjParse(pjSelfTest_text)
    pjSelfTest_native = project.parse(pjSelfTest_text)
    assert(jsonEncode(pjSelfTest_pure) == jsonEncode(pjSelfTest_native), "pjParse mismatch for sample")
    for pjSelfTest_key in ["name", "version", "main"]
        if pjSelfTest_key == "name"
            assert(jsonEncode(pjName(pjSelfTest_pure)) == jsonEncode(project.name(pjSelfTest_native)), "pjName mismatch for sample")
        else if pjSelfTest_key == "version"
            assert(jsonEncode(pjVersion(pjSelfTest_pure)) == jsonEncode(project.version(pjSelfTest_native)), "pjVersion mismatch for sample")
        else
            assert(jsonEncode(pjMain(pjSelfTest_pure)) == jsonEncode(project.main(pjSelfTest_native)), "pjMain mismatch for sample")
        end
    end
    assert(project.write(pjSelfTest_path, pjSelfTest_native), "project.write failed for sample")
    pjSelfTest_expected = readFile(pjSelfTest_path)
    assert(pjWrite(pjSelfTest_pure) == pjSelfTest_expected, "pjWrite mismatch for sample")
    assert(jsonEncode(pjParse(pjSelfTest_expected)) == jsonEncode(project.parse(pjSelfTest_expected)), "round trip mismatch for sample")
    pjSelfTest_i += 1
end
pjSelfTest_manifest = {root: {z: 3, name: "Demo", enabled: true, nothing: null, big: 100000000000000000000, small: 0.00001, tricky: "quote \" slash \\ newline \n return " + fromCharCode(13) + " tab \t control " + fromCharCode(31) + " unicode ☺", unicode: "é☺"}, sections: {alpha: {b: "two", a: 1}, empty: {}}}
assert(project.write(pjSelfTest_path, pjSelfTest_manifest), "project.write failed for mixed manifest")
pjSelfTest_expected = readFile(pjSelfTest_path)
assert(pjWrite(pjSelfTest_manifest) == pjSelfTest_expected, "pjWrite mismatch for mixed manifest")
assert(jsonEncode(pjParse(pjSelfTest_expected)) == jsonEncode(project.parse(pjSelfTest_expected)), "mixed manifest round trip mismatch")
deleteFile(pjSelfTest_path)
end
if os.env("EM_SELFTEST", "") == "1"
    import project
    pjSelfTest()
    say("ok")
end
